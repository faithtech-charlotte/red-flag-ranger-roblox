  </Item>
  <Item class="SoundService" referent="62">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="63">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="64">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="65">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Red Flag Rangers client entry point. Builds one ScreenGui and starts the
	controllers. Controllers only display state and send requests; the
	server decides every outcome.
]]

local Players = game:GetService("Players")

local Controllers = script.Controllers
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "RedFlagRangersUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local controllers = {
	State = require(Controllers.State),
	HUD = require(Controllers.HUDController),
	Adoption = require(Controllers.AdoptionController),
	Dialogue = require(Controllers.DialogueController),
	Shop = require(Controllers.ShopController),
	Pet = require(Controllers.PetController),
	ActionBar = require(Controllers.ActionBarController),
	Petting = require(Controllers.PettingController),
	Ball = require(Controllers.BallController),
	Frisbee = require(Controllers.FrisbeeController),
	Activity = require(Controllers.ActivityController),
	Missions = require(Controllers.MissionsController),
	World = require(Controllers.WorldController),
	Whistle = require(Controllers.WhistleController),
}

controllers.HUD.start(gui, controllers)
controllers.Dialogue.start(gui, controllers)
controllers.Shop.start(gui, controllers)
controllers.Adoption.start(gui, controllers)
controllers.Pet.start()
controllers.ActionBar.start(gui, controllers)
controllers.Petting.start(gui, controllers)
controllers.Ball.start(gui, controllers)
controllers.Frisbee.start(gui, controllers)
controllers.Activity.start(gui, controllers)
controllers.Missions.start(gui, controllers)
controllers.World.start(gui, controllers)
controllers.Whistle.start(gui, controllers)
]]></string>
        </Properties>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">ActionBarController</string>
              <string name="Source"><![CDATA[--[[
	ActionBarController: a small contextual action bar for your dog.

	It slides in at the bottom of the screen when you stop near your dog,
	and tucks away when you walk off or start playing (petting, fetch, a
	conversation, the spa). It never covers the dog.

	  ✋ Pet      hands-on petting (PettingController)
	  🎾 Ball     equip the ball (BallController)
	  🦴 Care     food and brushing (small popover)
	  🐕 Sit / 📣 Come   one button that does what makes sense now
	  ✋ Stay     once unlocked
	  ⭐ Tricks   once any trick is unlocked (small popover)

	Keyboard Q / gamepad Y open it from anywhere and select the first
	button; the HUD's 🐶 button does the same on touch screens.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local BondCatalog = require(ReplicatedStorage.Shared.Catalogs.BondCatalog)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local PetActions = require(ReplicatedStorage.Shared.Catalogs.PetActions)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new
local player = Players.LocalPlayer

local SHOW_DISTANCE = 12
local STILL_SECONDS = 0.5

local Bar = {}
local ctl
local root: Frame
local row: Frame
local popover: Frame
local bondChip: TextLabel
local bondFill: Frame
local statusLabel: TextLabel
local shown = false
local pinned = false -- opened on purpose (Q / Y / 🐶): stays until dismissed
local stillFor = 0
local busy = false
local buttons: { { button: TextButton, check: () -> (boolean, string?) } } = {}
local popButtons: { { button: TextButton, check: () -> (boolean, string?) } } = {}
local popKind: string? = nil

local function pet(): Model?
	return ctl.Pet.ownPet()
end

local function distance(): number
	local model = pet()
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not model or not model.PrimaryPart or not hrp then
		return math.huge
	end
	return (model.PrimaryPart.Position - hrp.Position).Magnitude
end

local function petState(): string
	local m = pet()
	return m and m:GetAttribute("PetState") or "Following"
end

local function level(): number
	return State.data and State.data.pet and State.data.pet.level or 1
end

local function cooldownLeft(key: string): number
	local t = State.data and State.data.cooldowns and State.data.cooldowns[key]
	return t and math.max(0, t - workspace:GetServerTimeNow()) or 0
end

local function busyOutside(): boolean
	return ctl.Dialogue.isOpen() or ctl.Petting.isActive() or ctl.Ball.isEquipped() or ctl.Frisbee.isEquipped() or ctl.Activity.isBusy()
end

local function send(payload)
	if busy then
		return
	end
	busy = true
	Sounds.play("click")
	local ok, err = State.request(Remotes.RequestKinds.PetAction, payload)
	busy = false
	statusLabel.Text = (not ok and err) or ""
	if not ok and err then
		task.delay(2.5, function()
			if statusLabel.Text == err then
				statusLabel.Text = ""
			end
		end)
	end
end

local function roundButton(parent: Instance, list, icon: string, label: string, order: number, check: () -> (boolean, string?), onClick: () -> ())
	local b = new("TextButton", {
		Name = "Action_" .. label,
		LayoutOrder = order,
		Size = UDim2.fromOffset(62, 70),
		BackgroundTransparency = 1,
		Text = "",
		Parent = parent,
	}) :: TextButton
	local circle = new("Frame", {
		Name = "Circle",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = C.white,
		Parent = b,
		Children = {
			Theme.corner(26),
			Theme.stroke(C.pink, 2),
			Theme.label(icon, { Name = "Icon", Size = UDim2.fromScale(1, 1), TextSize = 26 }),
			Theme.label("", {
				Name = "Badge",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.82, 0.12),
				Size = UDim2.fromOffset(30, 18),
				BackgroundColor3 = C.ink,
				BackgroundTransparency = 0.1,
				TextColor3 = C.white,
				TextSize = 11,
				Font = Theme.Fonts.bold,
				Visible = false,
				Children = { Theme.corner(9) },
			}),
		},
	})
	Theme.label(label, { Name = "Label", Position = UDim2.fromOffset(0, 53), Size = UDim2.new(1, 0, 0, 16), TextSize = 12, Font = Theme.Fonts.bold, TextColor3 = C.white, TextStrokeTransparency = 0.4, Parent = b })
	b.Activated:Connect(function()
		local ok = check()
		local scale = circle:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = circle })
		;(scale :: UIScale).Scale = 0.85
		TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		if ok then
			onClick()
		end
	end)
	table.insert(list, { button = b, check = check })
	return b
end

local function refresh(list)
	for _, entry in list do
		local ok, reason = entry.check()
		local circle = entry.button:FindFirstChild("Circle") :: Frame
		circle.BackgroundColor3 = ok and C.white or Color3.fromRGB(225, 220, 230)
		;(circle:FindFirstChild("Icon") :: TextLabel).TextTransparency = ok and 0 or 0.55
		local badge = circle:FindFirstChild("Badge") :: TextLabel
		badge.Visible = reason ~= nil
		badge.Text = reason or ""
	end
end

local function touchCheck(def): (boolean, string?)
	local state = petState()
	if state == "Fetching" or state == "Returning" or state == "MovingToTarget" then
		return false, "busy"
	end
	if def and def.touch and distance() > PetActions.TOUCH_DISTANCE then
		return false, "far"
	end
	local left = def and def.cooldown > 0 and cooldownLeft(def.id) or 0
	if left > 0 then
		return false, `{math.ceil(left)}s`
	end
	return true, nil
end

local function closePopover()
	popKind = nil
	popover.Visible = false
	for _, e in popButtons do
		e.button:Destroy()
	end
	table.clear(popButtons)
end

local function openPopover(kind: string)
	if popKind == kind then
		closePopover()
		return
	end
	closePopover()
	popKind = kind
	local order = 0
	local function add(icon, label, check, onClick)
		order += 1
		roundButton(popover, popButtons, icon, label, order, check, onClick)
	end
	if kind == "care" then
		add("🥣", "Kibble", function()
			local ok, reason = touchCheck(PetActions.Actions.feed)
			if not ok then
				return ok, reason
			end
			local left = cooldownLeft("kibble")
			return left <= 0, left > 0 and `{math.ceil(left)}s` or "free"
		end, function()
			send({ action = "feed", food = PetActions.FreeFood.id })
		end)
		for _, item in ItemCatalog.sorted(function(it)
			return it.kind == "consumable"
		end) do
			if (State.data.inventory[item.id] or 0) > 0 then
				add("🦴", item.name:match("%S+$") or item.name, function()
					local ok, reason = touchCheck(PetActions.Actions.feed)
					if not ok then
						return ok, reason
					end
					return true, `x{State.data.inventory[item.id] or 0}`
				end, function()
					send({ action = "feed", food = item.id })
				end)
			end
		end
		add("🪮", "Brush", function()
			return touchCheck(PetActions.Actions.brush)
		end, function()
			send({ action = "brush" })
		end)
	elseif kind == "tricks" then
		for _, id in PetActions.TrickOrder do
			local trick = PetActions.Tricks[id]
			local need = BondCatalog.requiredLevel("trick", id) or 99
			if level() >= need then
				add(trick.icon, trick.label, function()
					local ok, reason = touchCheck(PetActions.Actions.tricks)
					if not ok then
						return ok, reason
					end
					local left = cooldownLeft("trick")
					return left <= 0, left > 0 and `{math.ceil(left)}s` or nil
				end, function()
					send({ action = "trick", trick = id })
				end)
			end
		end
	end
	popover.Visible = true
	refresh(popButtons)
end

local function rebuild()
	for _, e in buttons do
		e.button:Destroy()
	end
	table.clear(buttons)
	local state = petState()
	roundButton(row, buttons, "✋", "Pet", 1, function()
		return touchCheck({ touch = true, cooldown = 0, id = "pet" })
	end, function()
		closePopover()
		ctl.Petting.begin()
	end)
	roundButton(row, buttons, "🎾", "Ball", 2, function()
		return true, nil
	end, function()
		closePopover()
		ctl.Ball.equip()
	end)
	roundButton(row, buttons, "🦴", "Care", 3, function()
		return true, nil
	end, function()
		openPopover("care")
	end)
	if state == "Sitting" or state == "Staying" then
		roundButton(row, buttons, "📣", "Come", 4, function()
			return true, nil
		end, function()
			send({ action = "come" })
		end)
	else
		roundButton(row, buttons, "🐕", "Sit", 4, function()
			return touchCheck(nil)
		end, function()
			send({ action = "sit" })
		end)
	end
	if BondCatalog.isUnlocked(level(), "command", "stay") and state ~= "Staying" then
		roundButton(row, buttons, "🛑", "Stay", 5, function()
			return true, nil
		end, function()
			send({ action = "stay" })
		end)
	end
	if BondCatalog.isUnlocked(level(), "trick", "spin") then
		roundButton(row, buttons, "⭐", "Tricks", 6, function()
			return touchCheck(PetActions.Actions.tricks)
		end, function()
			openPopover("tricks")
		end)
	end
	refresh(buttons)
end

local lastState = ""
local function renderBond()
	local p = State.data and State.data.pet
	if not p then
		return
	end
	bondChip.Text = `♥ {p.name} · Bond Lv {p.level}` .. (p.nextUnlock and `  →  {p.nextUnlock.label}` or "")
	bondFill.Size = UDim2.fromScale(p.xpNeed and math.clamp(p.xpInto / p.xpNeed, 0, 1) or 1, 1)
end

local function setShown(v: boolean)
	if shown == v then
		return
	end
	shown = v
	if v then
		lastState = petState()
		rebuild()
		renderBond()
		root.Visible = true
		root.Position = UDim2.new(0, -40, 1, -14)
		TweenService:Create(root, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 14, 1, -14) }):Play()
	else
		pinned = false
		closePopover()
		root.Visible = false
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(root) then
			GuiService.SelectedObject = nil
		end
	end
end

function Bar.close()
	setShown(false)
end

function Bar.open()
	if not (State.data and State.data.pet) then
		ctl.HUD.toast("Adopt a dog first!")
		return
	end
	if busyOutside() then
		if ctl.Ball.isEquipped() then
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:UnequipTools()
			end
		else
			return
		end
	end
	pinned = true
	setShown(true)
	if UserInputService.GamepadEnabled and buttons[1] then
		GuiService.SelectedObject = buttons[1].button
	end
end

function Bar.toggle()
	if shown then
		Bar.close()
	else
		Bar.open()
	end
end

function Bar.start(gui: ScreenGui, controllers)
	ctl = controllers
	root = new("Frame", {
		Name = "PetActionBar",
		-- Bottom-left: clear of the dog (it trots on your right) and the hotbar.
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
		Children = { Theme.list(nil, 4, Enum.HorizontalAlignment.Left) },
	}) :: Frame
	statusLabel = Theme.label("", { LayoutOrder = 0, Size = UDim2.fromOffset(360, 20), TextSize = 15, Font = Theme.Fonts.bold, TextColor3 = C.white, TextStrokeTransparency = 0.3, Parent = root })
	popover = new("Frame", {
		Name = "Popover",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Visible = false,
		Parent = root,
		Children = { Theme.corner(20), Theme.padding(6), Theme.list(Enum.FillDirection.Horizontal, 4) },
	}) :: Frame
	local chip = new("Frame", {
		Name = "BondChip",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(0, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Parent = root,
		Children = { Theme.corner(13), new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) },
	})
	bondChip = Theme.label("", { Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, TextSize = 14, Font = Theme.Fonts.bold, TextColor3 = C.white, TextWrapped = false, Parent = chip })
	local track = new("Frame", { Position = UDim2.new(0, 0, 1, -4), Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = Color3.fromRGB(90, 80, 100), BorderSizePixel = 0, Parent = chip })
	bondFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.pink, BorderSizePixel = 0, Parent = track }) :: Frame
	row = new("Frame", {
		Name = "Row",
		LayoutOrder = 3,
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		Parent = root,
		Children = { Theme.corner(24), Theme.padding(6), Theme.list(Enum.FillDirection.Horizontal, 4) },
	}) :: Frame

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if (input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.ButtonY) and not ctl.Petting.isActive() then
			Bar.toggle()
		elseif input.KeyCode == Enum.KeyCode.ButtonB and shown then
			Bar.close()
		end
	end)

	State.changed:Connect(function()
		if shown then
			renderBond()
			if popKind == "care" then
				local k = popKind
				popKind = nil
				openPopover(k)
			end
		end
	end)
	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.Bond then
			local model = pet()
			if model and payload.gained and payload.gained > 0 then
				ctl.Pet.floatText(model, `+{payload.gained} ♥`)
			end
		elseif kind == Remotes.PushKinds.Celebrate and payload.title and payload.title:find("Bond Level") then
			Sounds.play("levelup")
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local moving = hrp ~= nil and Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude > 1.5
		stillFor = moving and 0 or stillFor + dt
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		local hasPet = State.data ~= nil and State.data.pet ~= nil and pet() ~= nil
		local near = distance() <= SHOW_DISTANCE
		if not hasPet or busyOutside() then
			setShown(false)
		elseif pinned then
			if moving and not near then
				setShown(false)
			end
		else
			setShown(near and stillFor >= STILL_SECONDS)
		end
		if shown then
			if petState() ~= lastState then
				lastState = petState()
				rebuild()
			else
				refresh(buttons)
			end
			if popKind then
				refresh(popButtons)
			end
		end
	end)
end

return Bar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">ActivityController</string>
              <string name="Source"><![CDATA[--[[
	ActivityController: on-screen parts of the spa and trick-training games.

	Spa (grooming): four steps (brush, wash, rinse, dry). Spots appear around
	your dog on screen; clear each one by tapping/clicking it or by sweeping
	over it with the mouse button held. Gamepad: move the selection and
	press A. Each finished step is sent to the server, which checks order
	and timing.

	Trick training: press when the moving marker is inside the green zone.
	The server times the press with its own clock.
]]

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new

local STEP_INFO = {
	brush = { label = "Brush out the tangles", icon = "🪮", color = C.yellow },
	wash = { label = "Scrub-a-dub with bubbles", icon = "🫧", color = Color3.fromRGB(180, 220, 255) },
	rinse = { label = "Rinse off the suds", icon = "💧", color = C.blue },
	dry = { label = "Fluff dry!", icon = "💨", color = C.orange },
}
local SPOTS_PER_STEP = 5

local Activity = {}
local ctl
local gui: ScreenGui

----------------------------------------------------------------------------
-- Spa
----------------------------------------------------------------------------

local spa = {
	active = false,
	steps = {} :: { string },
	index = 0,
	spots = {} :: { { button: TextButton, offset: Vector2, cleared: boolean } },
	sending = false,
}
local spaPanel: Frame
local spaTitle: TextLabel
local spaLayer: Frame

local function clearSpots()
	for _, s in spa.spots do
		s.button:Destroy()
	end
	table.clear(spa.spots)
end

local function sendStep()
	if spa.sending then
		return
	end
	spa.sending = true
	task.spawn(function()
		for _ = 1, 6 do
			local ok, err = State.request(Remotes.RequestKinds.GroomStep, { step = spa.index })
			if ok or not spa.active then
				break
			end
			if err ~= "Keep scrubbing!" then
				break
			end
			task.wait(0.4)
		end
		spa.sending = false
		if spa.active and spa.index < #spa.steps then
			Activity.nextSpaStep()
		end
	end)
end

local function clearSpot(spot)
	if spot.cleared then
		return
	end
	spot.cleared = true
	spot.button.Visible = false
	Sounds.play("pop")
	for _, s in spa.spots do
		if not s.cleared then
			if UserInputService.GamepadEnabled then
				GuiService.SelectedObject = s.button
			end
			return
		end
	end
	sendStep()
end

function Activity.nextSpaStep()
	clearSpots()
	spa.index += 1
	local stepName = spa.steps[spa.index]
	if not stepName then
		return
	end
	local info = STEP_INFO[stepName]
	spaTitle.Text = `Spa Day {spa.index}/{#spa.steps}: {info.label}`
	if stepName == "wash" or stepName == "rinse" then
		Sounds.play("splash")
	end
	for i = 1, SPOTS_PER_STEP do
		local angle = (i / SPOTS_PER_STEP) * math.pi * 2 + math.random() * 0.6
		local radius = 50 + math.random() * 70
		local b = new("TextButton", {
			Size = UDim2.fromOffset(64, 64),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = info.color,
			BackgroundTransparency = 0.15,
			Text = info.icon,
			TextSize = 34,
			AutoButtonColor = true,
			Parent = spaLayer,
			Children = { Theme.corner(32), Theme.stroke(C.white, 3) },
		}) :: TextButton
		local spot = { button = b, offset = Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius * 0.7), cleared = false }
		b.Activated:Connect(function()
			clearSpot(spot)
		end)
		b.MouseEnter:Connect(function()
			if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
				clearSpot(spot)
			end
		end)
		table.insert(spa.spots, spot)
	end
	if UserInputService.GamepadEnabled and spa.spots[1] then
		GuiService.SelectedObject = spa.spots[1].button
	end
end

local function endSpa()
	spa.active = false
	clearSpots()
	spaPanel.Visible = false
end

----------------------------------------------------------------------------
-- Trick training
----------------------------------------------------------------------------

local training = { active = false, round = nil :: any, pressed = false }
local trainPanel: Frame
local trainTitle: TextLabel
local trainInfo: TextLabel
local zone: Frame
local cursor: Frame
local pressButton: TextButton

local function press()
	if not training.active or not training.round or training.pressed then
		return
	end
	training.pressed = true
	pressButton.BackgroundColor3 = C.disabled
	task.spawn(State.request, Remotes.RequestKinds.TrainPress)
end

local function endTraining()
	training.active = false
	training.round = nil
	trainPanel.Visible = false
end

----------------------------------------------------------------------------

function Activity.isBusy(): boolean
	return spa.active or training.active
end

function Activity.start(screenGui: ScreenGui, controllers)
	gui = screenGui
	ctl = controllers

	-- Spa UI
	spaLayer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = gui }) :: Frame
	spaPanel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(420, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.bg,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(18), Theme.stroke(C.purple, 3), Theme.padding(10), Theme.list(nil, 8) },
	}) :: Frame
	spaTitle = Theme.label("", { Font = Theme.Fonts.title, TextSize = 22, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Parent = spaPanel })
	Theme.label("Tap each spot, or hold the mouse button and sweep over them!", { TextSize = 14, TextColor3 = C.inkSoft, LayoutOrder = 2, Parent = spaPanel })
	Theme.button("Stop", C.inkSoft, function()
		State.request(Remotes.RequestKinds.ActivityCancel)
	end, { Size = UDim2.new(0.4, 0, 0, 40), TextSize = 18, LayoutOrder = 3, Parent = spaPanel })

	-- Training UI
	trainPanel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.bg,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(18), Theme.stroke(C.purple, 3), Theme.padding(12), Theme.list(nil, 8) },
	}) :: Frame
	trainTitle = Theme.label("", { Font = Theme.Fonts.title, TextSize = 22, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Parent = trainPanel })
	trainInfo = Theme.label("", { TextSize = 16, Font = Theme.Fonts.bold, LayoutOrder = 2, Parent = trainPanel })
	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Color3.fromRGB(230, 225, 240),
		LayoutOrder = 3,
		Parent = trainPanel,
		Children = { Theme.corner(10) },
	})
	zone = new("Frame", { BackgroundColor3 = C.green, Size = UDim2.fromScale(0.2, 1), Parent = track, Children = { Theme.corner(10) } }) :: Frame
	cursor = new("Frame", { BackgroundColor3 = C.ink, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.new(0, 6, 1, 8), Position = UDim2.new(0, 0, 0, -4), Parent = track, Children = { Theme.corner(3) } }) :: Frame
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 1, LayoutOrder = 4, Parent = trainPanel, Children = { Theme.list(Enum.FillDirection.Horizontal, 10) } })
	pressButton = Theme.button("Now! [F]", C.purple, press, { Size = UDim2.new(0.62, 0, 1, 0), TextSize = 24, LayoutOrder = 1, Parent = row })
	Theme.button("Stop", C.inkSoft, function()
		State.request(Remotes.RequestKinds.ActivityCancel)
	end, { Size = UDim2.new(0.32, 0, 1, 0), TextSize = 18, LayoutOrder = 2, Parent = row })

	UserInputService.InputBegan:Connect(function(input, processed)
		if training.active and (input.KeyCode == Enum.KeyCode.F or input.KeyCode == Enum.KeyCode.ButtonR2) and not processed then
			press()
		end
	end)

	RunService.RenderStepped:Connect(function()
		if spa.active then
			local model = ctl.Pet.ownPet()
			local body = model and model:FindFirstChild("Body") :: BasePart?
			if body then
				local screen, onScreen = workspace.CurrentCamera:WorldToViewportPoint(body.Position)
				local inset = GuiService:GetGuiInset()
				for _, s in spa.spots do
					s.button.Position = UDim2.fromOffset(screen.X + s.offset.X, screen.Y - inset.Y + s.offset.Y)
					s.button.Visible = not s.cleared and onScreen
				end
			end
		end
		local r = training.round
		if training.active and r then
			local t = workspace:GetServerTimeNow() - r.startAt
			local pos = t < 0 and 0 or (t / r.period) % 1
			cursor.Position = UDim2.new(pos, 0, 0, -4)
		end
	end)

	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.Grooming then
			if payload.state == "start" then
				spa.active = true
				spa.steps = payload.steps
				spa.index = 0
				spaPanel.Visible = true
				spaLayer.Visible = true
				Activity.nextSpaStep()
			elseif payload.state == "done" or payload.state == "cancel" then
				endSpa()
				spaLayer.Visible = false
			end
		elseif kind == Remotes.PushKinds.Training then
			if payload.state == "start" then
				training.active = true
				trainPanel.Visible = true
				trainTitle.Text = `Trick Training · Level {payload.tier}`
				trainInfo.Text = `Practice: {payload.move}`
			elseif payload.state == "round" then
				training.round = payload
				training.pressed = false
				pressButton.BackgroundColor3 = C.purple
				zone.Position = UDim2.fromScale(payload.zoneStart, 0)
				zone.Size = UDim2.fromScale(payload.zoneEnd - payload.zoneStart, 1)
				trainInfo.Text = `Round {payload.round}/{payload.rounds}: press when the line is in the green!  ({payload.move})`
			elseif payload.state == "result" then
				trainInfo.Text = payload.hit and "Nice timing! ⭐" or "Missed. You've got this!"
				if payload.hit then
					Sounds.play("chime")
				end
			elseif payload.state == "done" then
				trainInfo.Text = payload.success and `Great job! {payload.hits}/{payload.rounds}` or `{payload.hits}/{payload.rounds}. Try again!`
				task.delay(1.6, endTraining)
			elseif payload.state == "cancel" then
				endTraining()
			end
		end
	end)
end

return Activity
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">AdoptionController</string>
              <string name="Source"><![CDATA[--[[
	AdoptionController: choose a dog and name it. Opens automatically for a
	player without a dog, and when talking to Maya at the Pet Store.
	The server filters the name; this screen only checks the basics.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local DogRig = require(ReplicatedStorage.Shared.DogRig)
local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new

local Adoption = {}
local overlay: Frame
local cards: { [string]: Frame } = {}
local selected = PetCatalog.Order[1]
local nameBox: TextBox
local errorLabel: TextLabel
local adoptButton: TextButton
local spinning: { Model } = {}
local busy = false

local function preview(parent: Instance, breed: PetCatalog.Breed)
	local vp = new("ViewportFrame", {
		Size = UDim2.new(1, 0, 0, 130),
		BackgroundColor3 = C.bg,
		LightDirection = Vector3.new(-1, -1, -1),
		Ambient = Color3.fromRGB(200, 200, 200),
		Parent = parent,
		Children = { Theme.corner(12) },
	}) :: ViewportFrame
	local dog = DogRig.build({ furColor = breed.furColor, accentColor = breed.accentColor, earStyle = breed.earStyle, scale = breed.scale, anchored = true })
	dog:PivotTo(CFrame.new())
	dog.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(4.5, 2.5, -5.5), Vector3.new(0, 0.2, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	table.insert(spinning, dog)
end

local function selectBreed(breedId: string)
	selected = breedId
	for id, card in cards do
		local stroke = card:FindFirstChildOfClass("UIStroke") :: UIStroke
		stroke.Color = id == breedId and C.orange or C.disabled
		stroke.Thickness = id == breedId and 5 or 2
	end
end

function Adoption.open()
	if State.data and State.data.pet then
		return
	end
	overlay.Visible = true
	errorLabel.Text = ""
	Theme.pop(overlay:FindFirstChild("Panel") :: GuiObject)
	if UserInputService.GamepadEnabled then
		GuiService.SelectedObject = cards[selected]:FindFirstChildOfClass("TextButton")
	end
end

function Adoption.close()
	overlay.Visible = false
end

local function submit()
	if busy then
		return
	end
	local name, problem = PetCatalog.cleanName(nameBox.Text)
	if not name then
		errorLabel.Text = problem or ""
		return
	end
	busy = true
	adoptButton.Text = "Adopting…"
	local ok, err = State.request(Remotes.RequestKinds.Adopt, { breedId = selected, name = name })
	busy = false
	adoptButton.Text = "Adopt!"
	if ok then
		Adoption.close()
	else
		errorLabel.Text = err or "Try again!"
	end
end

function Adoption.start(gui: ScreenGui)
	overlay = new("Frame", {
		Name = "Adoption",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}) :: Frame
	local panel = new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.bg,
		Parent = overlay,
		Children = {
			Theme.corner(24),
			Theme.stroke(C.orange, 5),
			Theme.padding(18),
			Theme.list(nil, 12),
			new("UISizeConstraint", { MaxSize = Vector2.new(720, 900) }),
		},
	}) :: Frame
	Theme.label("Choose your new best friend!", { Font = Theme.Fonts.title, TextSize = 32, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, Parent = panel })

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = panel,
		Children = {
			new("UIGridLayout", {
				CellSize = UDim2.new(0.31, 0, 0, 236),
				CellPadding = UDim2.new(0.03, 0, 0, 10),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		},
	})
	for i, breedId in PetCatalog.Order do
		local breed = PetCatalog.get(breedId) :: PetCatalog.Breed
		local card = new("Frame", {
			LayoutOrder = i,
			BackgroundColor3 = C.panel,
			Parent = row,
			Children = { Theme.corner(16), Theme.stroke(C.disabled, 2) },
		}) :: Frame
		local content = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Parent = card,
			Children = { Theme.padding(8), Theme.list(nil, 4) },
		})
		preview(content, breed)
		Theme.label(breed.displayName, { Font = Theme.Fonts.title, TextSize = 20, Parent = content })
		Theme.label(breed.description, { TextSize = 14, TextColor3 = C.inkSoft, Size = UDim2.new(1, 0, 0, 36), Parent = content })
		-- The whole card is one button (works with mouse, touch, and gamepad).
		local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = card }) :: TextButton
		hit.Activated:Connect(function()
			selectBreed(breedId)
		end)
		cards[breedId] = card
	end

	local nameRow = new("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, LayoutOrder = 3, Parent = panel })
	nameBox = new("TextBox", {
		Size = UDim2.new(1, -64, 1, 0),
		BackgroundColor3 = C.panel,
		Font = Theme.Fonts.title,
		TextSize = 24,
		TextColor3 = C.ink,
		PlaceholderText = "Name your dog",
		PlaceholderColor3 = C.inkSoft,
		ClearTextOnFocus = false,
		Text = "",
		Parent = nameRow,
		Children = { Theme.corner(12), Theme.stroke(C.orange, 3) },
	}) :: TextBox
	nameBox:GetPropertyChangedSignal("Text"):Connect(function()
		if #nameBox.Text > PetCatalog.NameRules.maxLength then
			nameBox.Text = nameBox.Text:sub(1, PetCatalog.NameRules.maxLength)
		end
	end)
	Theme.button("🎲", C.teal, function()
		local breed = PetCatalog.get(selected) :: PetCatalog.Breed
		nameBox.Text = breed.defaultNames[math.random(1, #breed.defaultNames)]
	end, { Size = UDim2.fromOffset(56, 52), Position = UDim2.new(1, -56, 0, 0), Parent = nameRow })

	errorLabel = Theme.label("", { TextColor3 = C.orange, Font = Theme.Fonts.bold, LayoutOrder = 4, Parent = panel })
	adoptButton = Theme.button("Adopt!", C.green, submit, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 56), TextSize = 28, Parent = panel })

	selectBreed(selected)

	RunService.RenderStepped:Connect(function()
		if overlay.Visible then
			local t = os.clock()
			for _, dog in spinning do
				dog:PivotTo(CFrame.Angles(0, t * 0.8, 0))
			end
		end
	end)

	State.push:Connect(function(kind)
		if kind == Remotes.PushKinds.OpenAdoption then
			Adoption.open()
		end
	end)
	-- First visit: open as soon as we know there's no dog.
	local function check(data)
		if data and not data.pet and not overlay.Visible then
			Adoption.open()
		elseif data and data.pet then
			Adoption.close()
		end
	end
	State.changed:Connect(check)
	if State.data then
		check(State.data)
	end
end

return Adoption
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">BallController</string>
              <string name="Source"><![CDATA[--[[
	BallController: playing fetch with the Ball tool.

	  Equip the ball (hotbar, the 🎾 button, or the park's ball bucket)
	    -> your dog bounces and barks, eyes on the ball
	  Hold (mouse / touch / RT) to wind up
	    -> a dotted arc and landing ring grow with power; your dog crouches
	  Release
	    -> arm swing, whoosh; the ball really flies, bounces, and rolls
	  Your dog sprints, grabs it (mid-air catches get extra fanfare),
	  trots back, drops it at your feet, and the ball pops back into your hand.

	Aim: mouse pointer, the spot you touch, or where the camera faces.
	The server decides the real throw; this only predicts it for the preview.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new
local player = Players.LocalPlayer

-- Must match Server/Activities/Fetch.luau
local MIN_THROW, MAX_THROW = 10, 46
local FULL_CHARGE = 0.9
local DOTS = 14

local Ball = {}
local ctl
local tool: Tool? = nil
local charging = false
local chargeStart = 0
local touchAim: Vector2? = nil
local equips = 0
local streak = 0

local hintPill: TextLabel
local powerBar: Frame
local powerFill: Frame
local burstLabel: TextLabel
local previewFolder: Folder
local dots: { BasePart } = {}
local ring: BasePart

local function hrp(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function petName(): string
	local m = ctl.Pet.ownPet()
	return m and m:GetAttribute("PetName") or "your dog"
end

local function ballInHand(): boolean
	local handle = tool and tool:FindFirstChild("Handle") :: BasePart?
	return handle ~= nil and handle.Transparency < 0.5
end

local function power(): number
	if not charging then
		return 0
	end
	return math.clamp((os.clock() - chargeStart) / FULL_CHARGE, 0.12, 1)
end

local function aimPoint(): Vector3?
	local root = hrp()
	if not root then
		return nil
	end
	local camera = workspace.CurrentCamera
	local screen: Vector2?
	local input = UserInputService:GetLastInputType()
	if input == Enum.UserInputType.Touch then
		screen = touchAim
	elseif input.Name:find("Gamepad") then
		screen = nil
	else
		screen = UserInputService:GetMouseLocation()
	end
	if screen then
		local ray = camera:ViewportPointToRay(screen.X, screen.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore: { Instance } = { previewFolder }
		if player.Character then
			table.insert(ignore, player.Character)
		end
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
		if hit then
			return hit.Position
		end
	end
	local look = camera.CFrame.LookVector
	return root.Position + Vector3.new(look.X, 0, look.Z).Unit * 20
end

local function showHint(text: string?)
	hintPill.Visible = text ~= nil
	hintPill.Text = text or ""
end

local function clearPreview()
	for _, d in dots do
		d.Transparency = 1
	end
	ring.Transparency = 1
	powerBar.Visible = false
end

-- Predicts the arc with the same launch math as the server.
local function updatePreview()
	local root = hrp()
	local aim = aimPoint()
	if not root or not aim then
		return
	end
	local p = power()
	local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
	if flat.Magnitude < 0.5 then
		flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	end
	local dir = flat.Unit
	local distance = MIN_THROW + (MAX_THROW - MIN_THROW) * p
	local g = workspace.Gravity
	local T = 0.55 + distance / 70
	local v = dir * (distance / T) + Vector3.new(0, g * T / 2, 0)
	local start = root.Position + Vector3.new(0, 1.2, 0) + dir * 1.2
	for i, d in dots do
		local t = (i / DOTS) * T
		local pos = start + v * t + Vector3.new(0, -0.5 * g * t * t, 0)
		d.Position = pos
		d.Transparency = 0.15 + (i / DOTS) * 0.4
	end
	local landing = start + dir * distance
	ring.CFrame = CFrame.new(landing.X, 0.12, landing.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.3
	powerBar.Visible = true
	powerFill.Size = UDim2.fromScale(p, 1)
	powerFill.BackgroundColor3 = C.yellow:Lerp(C.orange, p)
end

local function swingArm()
	if not tool then
		return
	end
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash" -- the default Animate script plays an arm swing
	anim.Parent = tool
	task.delay(0.4, function()
		anim:Destroy()
	end)
end

local function beginCharge()
	if charging or not ballInHand() then
		return
	end
	charging = true
	chargeStart = os.clock()
	showHint(nil)
	task.spawn(State.request, Remotes.RequestKinds.FetchReady, { ready = true })
end

local function release()
	if not charging then
		return
	end
	local p = power()
	charging = false
	clearPreview()
	local aim = aimPoint()
	swingArm()
	Sounds.play("whoosh", 0.9 + p * 0.4)
	task.spawn(function()
		local ok, err = State.request(Remotes.RequestKinds.FetchThrow, { target = aim, power = p })
		if not ok then
			task.spawn(State.request, Remotes.RequestKinds.FetchReady, { ready = false })
			if err then
				ctl.HUD.toast(err)
			end
		end
	end)
end

local function burst(text: string, color: Color3)
	burstLabel.Text = text
	burstLabel.TextColor3 = color
	burstLabel.Visible = true
	burstLabel.TextTransparency = 0
	local scale = burstLabel:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.4
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1.2, function()
		TweenService:Create(burstLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
	end)
end

local function hookTool(t: Tool)
	tool = t
	t.Equipped:Connect(function()
		equips += 1
		ctl.ActionBar.close()
		if equips <= 3 then
			local input = UserInputService:GetLastInputType()
			if input == Enum.UserInputType.Touch then
				showHint("Press and hold, then let go to throw!")
			elseif input.Name:find("Gamepad") then
				showHint("Hold RT to wind up, release to throw!")
			else
				showHint("Hold the mouse button to wind up, release to throw!")
			end
			task.delay(5, function()
				if not charging then
					showHint(nil)
				end
			end)
		end
	end)
	t.Unequipped:Connect(function()
		charging = false
		clearPreview()
		showHint(nil)
	end)
	t.Activated:Connect(beginCharge)
	t.Deactivated:Connect(release)
end

-- Equip the ball from anywhere (action bar, ball bucket).
function Ball.equip()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local t = player.Backpack:FindFirstChild("Ball") or (character and character:FindFirstChild("Ball"))
	if humanoid and t and t:IsA("Tool") then
		humanoid:EquipTool(t)
	else
		ctl.HUD.toast("Adopt a dog to get a ball!")
	end
end

function Ball.isEquipped(): boolean
	return tool ~= nil and tool.Parent == player.Character
end

function Ball.start(gui: ScreenGui, controllers)
	ctl = controllers

	hintPill = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(440, 34),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		TextColor3 = C.white,
		Font = Theme.Fonts.bold,
		TextSize = 18,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(17) },
	})
	powerBar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(220, 14),
		BackgroundColor3 = Color3.fromRGB(40, 40, 50),
		BackgroundTransparency = 0.3,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(7) },
	}) :: Frame
	powerFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.yellow, Parent = powerBar, Children = { Theme.corner(7) } }) :: Frame
	burstLabel = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(500, 60),
		Font = Theme.Fonts.title,
		TextSize = 44,
		TextStrokeTransparency = 0.2,
		Visible = false,
		Parent = gui,
		Children = { new("UIScale", { Scale = 1 }) },
	})

	previewFolder = Instance.new("Folder")
	previewFolder.Name = "FetchPreview"
	previewFolder.Parent = workspace
	for i = 1, DOTS do
		local d = Instance.new("Part")
		d.Shape = Enum.PartType.Ball
		d.Size = Vector3.one * (0.6 - i * 0.02)
		d.Color = C.yellow
		d.Material = Enum.Material.Neon
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.CastShadow = false
		d.Transparency = 1
		d.Parent = previewFolder
		dots[i] = d
	end
	ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.15, 4, 4)
	ring.Color = C.yellow
	ring.Material = Enum.Material.Neon
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Transparency = 1
	ring.Parent = previewFolder

	local function watchBackpack()
		local backpack = player:WaitForChild("Backpack")
		local function check(child: Instance)
			if child.Name == "Ball" and child:IsA("Tool") and child ~= tool then
				hookTool(child)
			end
		end
		backpack.ChildAdded:Connect(check)
		for _, c in backpack:GetChildren() do
			check(c)
		end
	end
	player.CharacterAdded:Connect(function()
		tool = nil
		task.defer(watchBackpack)
	end)
	if player.Character then
		task.defer(watchBackpack)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.Touch and not processed then
			touchAim = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and charging then
			touchAim = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	-- Bounce sounds for balls in flight (everyone's, so the park sounds lively).
	local lastVy: { [BasePart]: number } = {}
	RunService.RenderStepped:Connect(function()
		if charging then
			updatePreview()
		end
		for _, b in workspace:GetChildren() do
			if b.Name == "FetchBall" and b:IsA("BasePart") then
				local vy = b.AssemblyLinearVelocity.Y
				local prev = lastVy[b]
				if prev and prev < -4 and vy > 1 then
					Sounds.play("bounce", 0.9 + math.random() * 0.3)
				end
				lastVy[b] = vy
			end
		end
		for b in lastVy do
			if not b.Parent then
				lastVy[b] = nil
			end
		end
	end)

	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.FetchAim then
			Ball.equip()
		elseif kind == Remotes.PushKinds.Fetch then
			if payload.grabbed then
				Sounds.play("catch", payload.air and 1.4 or 1)
				if payload.air then
					burst("AIR CATCH!", C.yellow)
				end
			elseif payload.caught then
				streak = payload.streak or streak + 1
				Sounds.play("chime", 1 + math.min(streak, 6) * 0.06)
				local text = streak >= 3 and `Good dog! Streak x{streak}` or "Good dog!"
				if payload.done then
					text = "Park challenge done!"
				elseif payload.inPark and payload.count then
					text ..= `  ({payload.count}/{payload.goal})`
				end
				burst(text, streak >= 3 and C.orange or C.white)
				local model = ctl.Pet.ownPet()
				if model then
					ctl.Pet.woof(model, "Woof!")
				end
			elseif payload.lost then
				streak = 0
				ctl.HUD.toast(payload.text or `{petName()} couldn't reach it. Here's another ball!`)
			end
		end
	end)
end

return Ball
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">DialogueController</string>
              <string name="Source"><![CDATA[--[[
	DialogueController: shows NPC lines and choices sent by the server, and
	sends back only the chosen id. It never decides what happens next.

	Conversations with other kids ("peer" NPCs) show practice Block / Report /
	Get help buttons, the same way real chat has those tools. "Walk away"
	(the ✕) is always available.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new

local Dialogue = {}
local panel: Frame
local nameChip: Frame
local nameLabel: TextLabel
local textLabel: TextLabel
local choiceList: Frame
local safetyBar: Frame
local current: any = nil
local waiting = false
local typeStarted = 0
local choiceButtons: { TextButton } = {}

local TYPE_SPEED = 70 -- characters per second

local function send(kind: string, payload: any)
	if waiting then
		return
	end
	waiting = true
	local ok, err = State.request(kind, payload)
	waiting = false
	if not ok and err then
		-- Errors are rare (e.g. walked too far). Close quietly.
		panel.Visible = false
		current = nil
	end
end

local function clearChoices()
	for _, child in choiceList:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(choiceButtons)
end

local function show(view)
	current = view
	panel.Visible = true
	local isTip = view.speaker == "tip"
	panel.BackgroundColor3 = isTip and C.tip or C.panel
	;(panel:FindFirstChildOfClass("UIStroke") :: UIStroke).Color = isTip and C.help or C.ink
	nameChip.BackgroundColor3 = isTip and C.help or C.orange
	nameLabel.Text = isTip and "💡 Ranger Tip" or (view.subtitle and `{view.npcName} · {view.subtitle}` or view.npcName)
	textLabel.TextColor3 = isTip and C.tipInk or C.ink
	textLabel.Text = view.text
	textLabel.MaxVisibleGraphemes = 0
	typeStarted = os.clock()

	clearChoices()
	for i, choice in view.choices do
		local b = Theme.button(`{i}.  {choice.text}`, C.white, function()
			if current and current.sessionId == view.sessionId then
				send(Remotes.RequestKinds.DialogueChoose, { sessionId = view.sessionId, choiceId = choice.id })
			end
		end, {
			LayoutOrder = i,
			TextColor3 = C.ink,
			TextXAlignment = Enum.TextXAlignment.Left,
			Font = Theme.Fonts.bold,
			TextSize = 20,
			Size = UDim2.new(1, 0, 0, 46),
			Parent = choiceList,
		})
		;(b:FindFirstChildOfClass("UIStroke") :: UIStroke).Color = isTip and C.help or C.teal
		new("UIPadding", { PaddingLeft = UDim.new(0, 14), Parent = b })
		table.insert(choiceButtons, b)
	end

	safetyBar.Visible = view.safetyTools == true and not isTip
	Theme.pop(panel)
	if UserInputService.GamepadEnabled and choiceButtons[1] then
		GuiService.SelectedObject = choiceButtons[1]
	end
end

local function hide()
	current = nil
	panel.Visible = false
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(panel) then
		GuiService.SelectedObject = nil
	end
end

function Dialogue.isOpen(): boolean
	return current ~= nil
end

function Dialogue.start(gui: ScreenGui)
	panel = new("Frame", {
		Name = "Dialogue",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(0.94, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel,
		Visible = false,
		ZIndex = 5,
		Parent = gui,
		Children = {
			Theme.corner(20),
			Theme.stroke(C.ink, 3),
			new("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), PaddingTop = UDim.new(0, 28), PaddingBottom = UDim.new(0, 14) }),
			Theme.list(nil, 10),
			new("UISizeConstraint", { MaxSize = Vector2.new(760, 700) }),
		},
	}) :: Frame

	nameChip = new("Frame", {
		Size = UDim2.new(0, 0, 0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(0, -46),
		BackgroundColor3 = C.orange,
		ZIndex = 6,
		Parent = panel,
		Children = { Theme.corner(17), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) },
	}) :: Frame
	-- The chip floats above the panel edge, outside the list layout.
	local chipHolder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, LayoutOrder = 0, Parent = panel })
	nameChip.Parent = chipHolder
	nameLabel = Theme.label("", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Font = Theme.Fonts.title, TextSize = 20, TextColor3 = C.white, TextWrapped = false, ZIndex = 6, Parent = nameChip })

	local close = Theme.button("✕ Walk away", C.inkSoft, function()
		if current then
			send(Remotes.RequestKinds.DialogueClose, { sessionId = current.sessionId })
		end
	end, { Size = UDim2.fromOffset(130, 34), Position = UDim2.new(1, -130, 0, -46), TextSize = 16, ZIndex = 6, Parent = chipHolder })
	close.AnchorPoint = Vector2.new(0, 0)

	textLabel = Theme.label("", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
		Parent = panel,
	})
	-- Tap the text to show it all at once.
	local skip = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", Selectable = false, Parent = textLabel }) :: TextButton
	skip.Activated:Connect(function()
		textLabel.MaxVisibleGraphemes = -1
	end)

	choiceList = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = panel,
		Children = { Theme.list(nil, 6) },
	}) :: Frame

	safetyBar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = panel,
		Children = { Theme.list(nil, 4) },
	}) :: Frame
	local toolRow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = safetyBar,
		Children = { Theme.list(Enum.FillDirection.Horizontal, 8) },
	})
	local function tool(text: string, color: Color3, id: string, order: number)
		Theme.button(text, color, function()
			if current then
				send(Remotes.RequestKinds.DialogueSafety, { sessionId = current.sessionId, tool = id })
			end
		end, { Size = UDim2.new(0.32, 0, 1, 0), TextSize = 17, LayoutOrder = order, Parent = toolRow })
	end
	tool("🚫 Block", C.inkSoft, "block", 1)
	tool("🚩 Report", C.orange, "report", 2)
	tool("💙 Get help", C.help, "help", 3)
	Theme.label("Practice tools: they don't contact Roblox.", { TextSize = 13, TextColor3 = C.inkSoft, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 2, Parent = safetyBar })

	RunService.RenderStepped:Connect(function()
		if current and textLabel.MaxVisibleGraphemes >= 0 then
			local n = math.floor((os.clock() - typeStarted) * TYPE_SPEED)
			if n >= #textLabel.Text then
				textLabel.MaxVisibleGraphemes = -1
			else
				textLabel.MaxVisibleGraphemes = n
			end
		end
	end)

	-- Number keys pick choices on keyboard.
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not current then
			return
		end
		local n = input.KeyCode.Value - Enum.KeyCode.One.Value + 1
		if n >= 1 and n <= #choiceButtons and input.UserInputType == Enum.UserInputType.Keyboard then
			local choice = current.choices[n]
			send(Remotes.RequestKinds.DialogueChoose, { sessionId = current.sessionId, choiceId = choice.id })
		end
	end)

	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.Dialogue then
			show(payload)
		elseif kind == Remotes.PushKinds.DialogueClose then
			hide()
		end
	end)
end

return Dialogue
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">FrisbeeController</string>
              <string name="Source"><![CDATA[--[[
	FrisbeeController: the Frisbee Field catch game.

	  Grab a frisbee at the field -> the Frisbee tool is equipped, a small
	    panel shows your catches (x/3) and a Stop button
	  Hold (mouse / touch / RT) to wind up
	    -> a dotted preview of the real flight (it curves: discs turn and
	       fade), a landing ring, and a power bar
	  Aim: the pointer (or where you touch / the camera faces) sets the
	    direction. Aim at the sky for a higher, floatier throw; aim at the
	    ground for a flat, fast one.
	  Release -> FrisbeeThrow { target, pitch, power }

	Flying discs are anchored parts the server moves. Every client replays
	the same flight (Shared/FrisbeeMath) from the launch attributes each
	frame, so the disc glides smoothly instead of stepping at network rate.
	The server still decides where it lands and whether the dog caught it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local FrisbeeMath = require(ReplicatedStorage.Shared.FrisbeeMath)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new
local player = Players.LocalPlayer

local TOOL_NAME = "Frisbee"
local DISC_NAME = "Frisbee"
local FULL_CHARGE = 1.0
local DOTS = 24
local PINK = Color3.fromRGB(255, 90, 140)

local Frisbee = {}
local ctl
local tool: Tool? = nil
local charging = false
local chargeStart = 0
local touchAim: Vector2? = nil
local active = false

local panel: Frame
local panelText: TextLabel
local hintPill: TextLabel
local powerBar: Frame
local powerFill: Frame
local burstLabel: TextLabel
local previewFolder: Folder
local dots: { BasePart } = {}
local ring: BasePart

-- Flights being replayed locally, keyed by disc part.
local flights: { [BasePart]: { launchAt: number, launch: FrisbeeMath.Launch, state: FrisbeeMath.FlightState } } = {}

local function hrp(): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function petName(): string
	local m = ctl.Pet.ownPet()
	return m and m:GetAttribute("PetName") or "your dog"
end

local function discInHand(): boolean
	return tool ~= nil and tool:GetAttribute("InHand") ~= false
end

local function power(): number
	if not charging then
		return 0
	end
	return math.clamp((os.clock() - chargeStart) / FULL_CHARGE, 0.1, 1)
end

local function rayParams(): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { previewFolder }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local pets = workspace:FindFirstChild("Pets")
	if pets then
		table.insert(ignore, pets)
	end
	params.FilterDescendantsInstances = ignore
	return params
end

-- Where you're aiming: (target point, ray pitch in degrees).
local function aim(): (Vector3?, number)
	local root = hrp()
	if not root then
		return nil, -10
	end
	local camera = workspace.CurrentCamera
	local screen: Vector2?
	local input = UserInputService:GetLastInputType()
	if input == Enum.UserInputType.Touch then
		screen = touchAim
	elseif input.Name:find("Gamepad") then
		screen = nil
	else
		screen = UserInputService:GetMouseLocation()
	end
	local origin, direction
	if screen then
		local ray = camera:ViewportPointToRay(screen.X, screen.Y)
		origin, direction = ray.Origin, ray.Direction.Unit
	else
		origin, direction = camera.CFrame.Position, camera.CFrame.LookVector
	end
	local pitch = math.deg(math.asin(math.clamp(direction.Y, -1, 1)))
	local hit = workspace:Raycast(origin, direction * 400, rayParams())
	return hit and hit.Position or origin + direction * 400, pitch
end

local function showHint(text: string?)
	hintPill.Visible = text ~= nil
	hintPill.Text = text or ""
end

local function clearPreview()
	for _, d in dots do
		d.Transparency = 1
	end
	ring.Transparency = 1
	powerBar.Visible = false
end

-- Predicts the flight with the same model and inputs the server will use.
local function updatePreview()
	local root = hrp()
	local target, pitch = aim()
	if not root or not target then
		return
	end
	local dir = FrisbeeMath.flatDirection(root.Position, target, root.CFrame.LookVector)
	local character = player.Character
	local hand = character and (character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")) :: BasePart?
	local origin = (hand and hand.Position or root.Position + Vector3.new(0, 1.5, 0)) + dir * 1.2
	local p = power()
	local launch = FrisbeeMath.launch(origin, dir, FrisbeeMath.elevationFromPitch(pitch), p)
	local floor = workspace:Raycast(root.Position, Vector3.new(0, -20, 0), rayParams())
	local groundY = floor and floor.Position.Y or root.Position.Y - 3
	local points = FrisbeeMath.predict(launch, groundY, 7, 2)
	local n = #points
	for i, d in dots do
		local pt = points[math.max(1, math.floor(i / DOTS * n))]
		if pt then
			d.Position = pt.position
			d.Transparency = 0.15 + (i / DOTS) * 0.45
		else
			d.Transparency = 1
		end
	end
	local landing = points[n]
	if landing then
		ring.CFrame = CFrame.new(landing.position.X, groundY + 0.12, landing.position.Z) * CFrame.Angles(0, 0, math.rad(90))
		ring.Transparency = 0.3
	end
	powerBar.Visible = true
	powerFill.Size = UDim2.fromScale(p, 1)
	powerFill.BackgroundColor3 = C.yellow:Lerp(C.orange, p)
end

local function swingArm()
	if not tool then
		return
	end
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash" -- the default Animate script plays an arm swing
	anim.Parent = tool
	task.delay(0.4, function()
		anim:Destroy()
	end)
end

local function beginCharge()
	if charging or not discInHand() then
		return
	end
	charging = true
	chargeStart = os.clock()
	showHint(nil)
	task.spawn(State.request, Remotes.RequestKinds.FetchReady, { ready = true })
end

local function release()
	if not charging then
		return
	end
	local p = power()
	charging = false
	clearPreview()
	local target, pitch = aim()
	swingArm()
	Sounds.play("whoosh", 1.1 + p * 0.3)
	task.spawn(function()
		local ok, err = State.request(Remotes.RequestKinds.FrisbeeThrow, { target = target, pitch = pitch, power = p })
		if not ok then
			task.spawn(State.request, Remotes.RequestKinds.FetchReady, { ready = false })
			if err then
				ctl.HUD.toast(err)
			end
		end
	end)
end

local function burst(text: string, color: Color3)
	burstLabel.Text = text
	burstLabel.TextColor3 = color
	burstLabel.Visible = true
	burstLabel.TextTransparency = 0
	local scale = burstLabel:FindFirstChildOfClass("UIScale") :: UIScale
	scale.Scale = 0.4
	TweenService:Create(scale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1.4, function()
		TweenService:Create(burstLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
	end)
end

local function setCount(count: number, goal: number)
	local marks = {}
	for i = 1, goal do
		table.insert(marks, i <= count and "🥏" or "○")
	end
	panelText.Text = `Catches  {table.concat(marks, " ")}  ({count}/{goal})`
end

local function hookTool(t: Tool)
	tool = t
	t.Equipped:Connect(function()
		ctl.ActionBar.close()
		local input = UserInputService:GetLastInputType()
		if input == Enum.UserInputType.Touch then
			showHint("Press and hold, then let go to throw! Aim up for a floaty throw.")
		elseif input.Name:find("Gamepad") then
			showHint("Hold RT to wind up, release to throw! Tilt the camera up for a floaty throw.")
		else
			showHint("Hold the mouse to wind up, release to throw! Aim at the sky for a floaty throw.")
		end
		task.delay(5, function()
			if not charging then
				showHint(nil)
			end
		end)
	end)
	t.Unequipped:Connect(function()
		charging = false
		clearPreview()
		showHint(nil)
	end)
	t.Activated:Connect(beginCharge)
	t.Deactivated:Connect(release)
	t.AncestryChanged:Connect(function()
		if not t:IsDescendantOf(game) and tool == t then
			tool = nil
			charging = false
			clearPreview()
			showHint(nil)
		end
	end)
end

local function equip()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChild("Backpack")
	local t = (backpack and backpack:WaitForChild(TOOL_NAME, 3)) or (character and character:FindFirstChild(TOOL_NAME))
	if humanoid and t and t:IsA("Tool") and t.Parent ~= character then
		humanoid:EquipTool(t)
	end
end

function Frisbee.isEquipped(): boolean
	return tool ~= nil and tool.Parent == player.Character
end

function Frisbee.isActive(): boolean
	return active
end

-- Replays every flying disc locally so it moves smoothly every frame.
local function renderDiscs()
	local now = workspace:GetServerTimeNow()
	for _, d in workspace:GetChildren() do
		if d.Name == DISC_NAME and d:IsA("BasePart") then
			local launchAt = d:GetAttribute("LaunchAt")
			if d:GetAttribute("Flying") == true and typeof(launchAt) == "number" then
				local f = flights[d]
				if not f or f.launchAt ~= launchAt then
					local launch: FrisbeeMath.Launch = {
						origin = d:GetAttribute("LaunchOrigin") :: Vector3,
						velocity = d:GetAttribute("LaunchVelocity") :: Vector3,
						normal = d:GetAttribute("LaunchNormal") :: Vector3,
						spin = d:GetAttribute("LaunchSpin") :: number,
					}
					if typeof(launch.origin) ~= "Vector3" or typeof(launch.velocity) ~= "Vector3" or typeof(launch.normal) ~= "Vector3" then
						continue
					end
					f = { launchAt = launchAt, launch = launch, state = FrisbeeMath.start(launch) }
					flights[d] = f
				end
				local flight = f :: any
				FrisbeeMath.advanceTo(flight.state, now - launchAt)
				d.CFrame = FrisbeeMath.cframe(FrisbeeMath.worldPosition(flight.launch, flight.state), flight.state)
			else
				flights[d] = nil
			end
		end
	end
	for d in flights do
		if d.Parent ~= workspace then
			flights[d] = nil
		end
	end
end

function Frisbee.start(gui: ScreenGui, controllers)
	ctl = controllers

	panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.bg,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(14), Theme.stroke(PINK, 3), Theme.padding(6), Theme.list(Enum.FillDirection.Horizontal, 10) },
	}) :: Frame
	panelText = Theme.label("", {
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = Theme.Fonts.title,
		TextSize = 20,
		LayoutOrder = 1,
		Parent = panel,
	})
	Theme.button("Stop", C.inkSoft, function()
		State.request(Remotes.RequestKinds.ActivityCancel)
	end, { Size = UDim2.fromOffset(70, 32), TextSize = 16, LayoutOrder = 2, Parent = panel })

	hintPill = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(560, 34),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		TextColor3 = C.white,
		Font = Theme.Fonts.bold,
		TextSize = 17,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(17) },
	})
	powerBar = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.fromOffset(220, 14),
		BackgroundColor3 = Color3.fromRGB(40, 40, 50),
		BackgroundTransparency = 0.3,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(7) },
	}) :: Frame
	powerFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.yellow, Parent = powerBar, Children = { Theme.corner(7) } }) :: Frame
	burstLabel = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(560, 60),
		Font = Theme.Fonts.title,
		TextSize = 42,
		TextStrokeTransparency = 0.2,
		Visible = false,
		Parent = gui,
		Children = { new("UIScale", { Scale = 1 }) },
	})

	previewFolder = Instance.new("Folder")
	previewFolder.Name = "FrisbeePreview"
	previewFolder.Parent = workspace
	for i = 1, DOTS do
		local d = Instance.new("Part")
		d.Shape = Enum.PartType.Ball
		d.Size = Vector3.one * (0.55 - i * 0.012)
		d.Color = PINK
		d.Material = Enum.Material.Neon
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.CastShadow = false
		d.Transparency = 1
		d.Parent = previewFolder
		dots[i] = d
	end
	ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.15, 4, 4)
	ring.Color = PINK
	ring.Material = Enum.Material.Neon
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Transparency = 1
	ring.Parent = previewFolder

	local function watchBackpack()
		local backpack = player:WaitForChild("Backpack")
		local function check(child: Instance)
			if child.Name == TOOL_NAME and child:IsA("Tool") and child ~= tool then
				hookTool(child)
			end
		end
		backpack.ChildAdded:Connect(check)
		for _, c in backpack:GetChildren() do
			check(c)
		end
	end
	player.CharacterAdded:Connect(function()
		tool = nil
		task.defer(watchBackpack)
	end)
	if player.Character then
		task.defer(watchBackpack)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.Touch and not processed then
			touchAim = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and charging then
			touchAim = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	RunService.RenderStepped:Connect(function()
		if charging then
			updatePreview()
		end
		renderDiscs()
	end)

	State.push:Connect(function(kind, payload)
		if kind ~= Remotes.PushKinds.Frisbee then
			return
		end
		local goal = payload.goal or 3
		local count = payload.count or 0
		local state = payload.state
		if state == "start" then
			active = true
			panel.Visible = true
			setCount(count, goal)
			task.spawn(equip)
			if (payload.throws or 0) == 0 then
				burst(`{petName()} runs out. Throw!`, PINK)
			end
		elseif state == "caught" then
			setCount(count, goal)
			Sounds.play("catch", payload.air and 1.4 or 1)
			burst(count >= goal and "AIR CATCH! 🏆" or `AIR CATCH! {count}/{goal}`, C.yellow)
		elseif state == "landed" then
			Sounds.play("bounce", 0.8)
			burst("It landed first!", C.white)
		elseif state == "grabbed" then
			Sounds.play("catch", 0.9)
		elseif state == "returned" then
			local model = ctl.Pet.ownPet()
			if model then
				ctl.Pet.woof(model, "Woof!")
			end
			if payload.caught then
				Sounds.play("chime", 1 + count * 0.08)
			elseif count < goal then
				ctl.HUD.toast(`Only mid-air catches count. Try a floatier throw so {petName()} can get under it!`)
			end
		elseif state == "lost" then
			ctl.HUD.toast(payload.text or "Lost that one. Here's another frisbee!")
		elseif state == "end" then
			active = false
			panel.Visible = false
			charging = false
			clearPreview()
			showHint(nil)
		end
	end)
end

return Frisbee
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	HUDController: coins, next objective, toasts, celebrations, and the side
	buttons (My Dog, Missions, Wardrobe, Help). Help is ALWAYS visible.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuestCatalog = require(ReplicatedStorage.Shared.Catalogs.QuestCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new

local HUD = {}
local controllers
local gui: ScreenGui
local coinLabel: TextLabel
local saveChip: Frame
local objectiveTitle: TextLabel
local objectiveHint: TextLabel
local lastObjective = ""
local objectiveShownAt = 0
local toastList: Frame
local helpPanel: Frame
local petButton: TextButton

local function playChime()
	Sounds.play("chime")
end

function HUD.toast(text: string, style: string?)
	local color = ({
		coins = C.yellow,
		success = C.green,
		warn = C.orange,
		info = C.white,
	})[style or "info"] or C.white
	local dark = style == "info" or style == "coins" or style == nil
	local toast = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = color,
		Children = {
			Theme.corner(12),
			Theme.padding(8),
			Theme.label(text, {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Font = Theme.Fonts.bold,
				TextColor3 = dark and C.ink or C.white,
			}),
		},
	}) :: Frame
	toast.Parent = toastList
	Theme.pop(toast)
	task.delay(3.5, function()
		toast:Destroy()
	end)
end

function HUD.celebrate(title: string, coins: number?, subtitle: string?)
	playChime()
	local banner = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromOffset(440, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.yellow,
		Parent = gui,
		Children = {
			Theme.corner(20),
			Theme.stroke(C.orange, 4),
			Theme.padding(14),
			Theme.list(nil, 4),
			new("UISizeConstraint", { MaxSize = Vector2.new(440, 400) }),
			Theme.label("🎉 " .. title, { Font = Theme.Fonts.title, TextSize = 30, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 1 }),
			subtitle and Theme.label(subtitle, { Font = Theme.Fonts.bold, TextSize = 18, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }) or nil,
			coins and Theme.label(`+{coins} Paw Coins`, { Font = Theme.Fonts.title, TextSize = 22, TextColor3 = C.orange, LayoutOrder = 3 }) or nil,
		},
	}) :: Frame
	Theme.pop(banner)
	task.delay(2.4, function()
		banner:Destroy()
	end)
end

local function sideButton(text: string, color: Color3, order: number, onClick): TextButton
	return Theme.button(text, color, onClick, {
		Size = UDim2.fromOffset(150, 50),
		LayoutOrder = order,
		TextSize = 20,
	})
end

local function popup(title: string, color: Color3): (Frame, Frame)
	local frame = new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -176, 0.5, 0),
		Size = UDim2.fromOffset(330, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel,
		Visible = false,
		Parent = gui,
		Children = {
			Theme.corner(18),
			Theme.stroke(color, 4),
			Theme.padding(14),
			Theme.list(nil, 8),
		},
	}) :: Frame
	local header = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 0, Parent = frame }) :: Frame
	Theme.label(title, { Font = Theme.Fonts.title, TextSize = 26, TextColor3 = color, Size = UDim2.new(1, -44, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = header })
	Theme.button("✕", C.inkSoft, function()
		frame.Visible = false
	end, { Size = UDim2.fromOffset(40, 34), Position = UDim2.new(1, -40, 0, 0), Parent = header })
	local body = new("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = frame,
		Children = { Theme.list(nil, 8) },
	}) :: Frame
	return frame, body
end

local function clear(body: Instance)
	for _, child in body:GetChildren() do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

local function renderHelp()
	local data = State.data
	local body = helpPanel:FindFirstChild("Body") :: Frame
	clear(body)
	Theme.label("If anything feels weird, worrying, or pressuring, in this game or anywhere online, you can talk to a trusted adult.", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = body,
	})
	Theme.button("Talk to Ranger Lee", C.help, function()
		helpPanel.Visible = false
		State.request(Remotes.RequestKinds.RequestHelp)
	end, { LayoutOrder = 2, Parent = body })
	Theme.label("A trusted adult could be a parent, caregiver, teacher, coach, or school counselor.", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextColor3 = C.inkSoft,
		TextSize = 16,
		LayoutOrder = 3,
		Parent = body,
	})
	local blocked = data and data.blocked or {}
	if next(blocked) then
		Theme.label("Blocked in this game", { Font = Theme.Fonts.bold, LayoutOrder = 4, Parent = body })
		for npcId, name in blocked do
			Theme.button(`Unblock {name}`, C.inkSoft, function()
				State.request(Remotes.RequestKinds.Unblock, { npcId = npcId })
			end, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 40), TextSize = 18, Parent = body })
		end
	end
	Theme.label("Block and Report in this game are for practice and don't contact Roblox. On real Roblox, you can block or report someone from the menu or their profile.", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextColor3 = C.inkSoft,
		TextSize = 14,
		LayoutOrder = 6,
		Parent = body,
	})
end

-- Hide the HUD's buttons and objective during hands-on play (petting).
-- The Help button is never in this list.
local focusFrames: { GuiObject } = {}
function HUD.setFocus(on: boolean)
	for _, f in focusFrames do
		f.Visible = not on
	end
end

function HUD.showObjectiveHint()
	objectiveHint.Visible = true
	objectiveShownAt = os.clock()
	local at = objectiveShownAt
	task.delay(7, function()
		if objectiveShownAt == at then
			objectiveHint.Visible = false
		end
	end)
end

local function renderObjective()
	local data = State.data
	if not data then
		return
	end
	coinLabel.Text = `🐾 {data.coins}`
	saveChip.Visible = data.persistent == false
	petButton.Text = data.pet and `🐶 {data.pet.name}` or "🐶 My Dog"
	local nextQuest = nil
	for _, quest in QuestCatalog.Ordered do
		if not data.quests[quest.id] then
			nextQuest = quest
			break
		end
	end
	if nextQuest then
		objectiveTitle.Text = "NEXT: " .. nextQuest.title
		objectiveHint.Text = nextQuest.hint
	else
		objectiveTitle.Text = "Explore with your dog!"
		objectiveHint.Text = "Earn Paw Coins for new looks. Jordan, Riley and friends are around."
	end
	-- Show the hint when the objective changes, then tuck it away so the
	-- screen stays clear. Tapping the card shows it again.
	if objectiveTitle.Text ~= lastObjective then
		lastObjective = objectiveTitle.Text
		HUD.showObjectiveHint()
	end
	if helpPanel.Visible then
		renderHelp()
	end
end

function HUD.start(screenGui: ScreenGui, ctl)
	gui = screenGui
	controllers = ctl

	-- Coins (top-left)
	local coins = new("Frame", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(150, 48),
		BackgroundColor3 = C.yellow,
		Parent = gui,
		Children = { Theme.corner(24), Theme.stroke(C.orange, 3) },
	}) :: Frame
	coinLabel = Theme.label("🐾 0", { Size = UDim2.fromScale(1, 1), Font = Theme.Fonts.title, TextSize = 26, Parent = coins })
	saveChip = new("Frame", {
		Position = UDim2.fromOffset(12, 66),
		Size = UDim2.fromOffset(150, 26),
		BackgroundColor3 = C.orange,
		Visible = false,
		Parent = gui,
		Children = { Theme.corner(13), Theme.label("Not saving", { Size = UDim2.fromScale(1, 1), TextColor3 = C.white, Font = Theme.Fonts.bold, TextSize = 14 }) },
	}) :: Frame

	-- Objective (top-center)
	local objective = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.new(0.5, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.05,
		Parent = gui,
		Children = {
			Theme.corner(16),
			Theme.stroke(C.teal, 3),
			Theme.padding(8),
			Theme.list(nil, 2),
			new("UISizeConstraint", { MinSize = Vector2.new(280, 0), MaxSize = Vector2.new(520, 200) }),
		},
	}) :: Frame
	objectiveTitle = Theme.label("Loading…", { Font = Theme.Fonts.title, TextSize = 22, LayoutOrder = 1, Parent = objective, Size = UDim2.new(1, 0, 0, 26) })
	objectiveHint = Theme.label("", { TextSize = 16, TextColor3 = C.inkSoft, LayoutOrder = 2, Parent = objective, Size = UDim2.new(1, 0, 0, 20) })
	objective.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			HUD.showObjectiveHint()
		end
	end)

	toastList = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 100),
		Size = UDim2.fromOffset(380, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = gui,
		Children = { Theme.list(nil, 6) },
	}) :: Frame

	-- Side buttons (right)
	local side = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(150, 240),
		BackgroundTransparency = 1,
		Parent = gui,
		Children = { Theme.list(nil, 10) },
	})
	helpPanel = popup("Help & Safety", C.help)
	petButton = sideButton("🐶 My Dog", C.pink, 1, function()
		helpPanel.Visible = false
		controllers.ActionBar.toggle()
	end)
	petButton.Parent = side
	local missionsButton = sideButton("📜 Missions", C.green, 2, function()
		controllers.Missions.open()
	end)
	missionsButton.Parent = side
	local wardrobeButton = sideButton("👕 Wardrobe", C.purple, 3, function()
		controllers.Shop.open("wardrobe")
	end)
	wardrobeButton.Parent = side
	sideButton("💙 Help", C.help, 4, function()
		controllers.ActionBar.close()
		helpPanel.Visible = not helpPanel.Visible
		renderHelp()
	end).Parent = side

	-- Help stays out of this list: it must never be hidden, even while petting.
	focusFrames = { objective :: GuiObject, petButton :: GuiObject, missionsButton :: GuiObject, wardrobeButton :: GuiObject }
	State.changed:Connect(renderObjective)
	if State.data then
		renderObjective()
	end
	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.Toast then
			HUD.toast(payload.text, payload.style)
		elseif kind == Remotes.PushKinds.Celebrate then
			HUD.celebrate(payload.title, payload.coins, payload.subtitle)
		end
	end)
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">MissionsController</string>
              <string name="Source"><![CDATA[--[[
	MissionsController: the Ranger Journal. Opens from the HUD "Missions"
	button or the Mission Board at Ranger HQ. Lists every quest with its
	status and hint, so players always have something fun to do next.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local QuestCatalog = require(ReplicatedStorage.Shared.Catalogs.QuestCatalog)
local Places = require(ReplicatedStorage.Shared.Places)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new

local Missions = {}
local overlay: Frame
local list: ScrollingFrame
local summary: TextLabel

local function render()
	if not overlay.Visible then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local data = State.data
	if not data then
		return
	end
	local done = 0
	for i, quest in QuestCatalog.Ordered do
		local complete = data.quests[quest.id] == true
		if complete then
			done += 1
		end
		local place = quest.waypoint and Places.get(quest.waypoint)
		new("Frame", {
			LayoutOrder = (complete and 1000 or 0) + i,
			Size = UDim2.new(1, -8, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = complete and Color3.fromRGB(232, 248, 236) or C.white,
			Parent = list,
			Children = {
				Theme.corner(12),
				Theme.stroke(complete and C.green or C.yellow, 2),
				Theme.padding(10),
				Theme.list(nil, 2, Enum.HorizontalAlignment.Left),
				Theme.label((complete and "✅ " or "⭐ ") .. quest.title, {
					Font = Theme.Fonts.title,
					TextSize = 19,
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 1,
				}),
				Theme.label(complete and "Done!" or (quest.hint .. (place and `  ({place.displayName})` or "")), {
					TextSize = 14,
					TextColor3 = C.inkSoft,
					TextXAlignment = Enum.TextXAlignment.Left,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = 2,
				}),
			},
		})
	end
	local pet = data.pet
	summary.Text = `{done}/{#QuestCatalog.Ordered} missions done`
		.. (pet and `  ·  {pet.name}: Bond Level {pet.level}` or "")
end

function Missions.open()
	overlay.Visible = true
	render()
	Theme.pop(overlay:FindFirstChild("Panel") :: GuiObject)
end

function Missions.close()
	overlay.Visible = false
end

function Missions.start(gui: ScreenGui)
	overlay = new("Frame", {
		Name = "Missions",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Visible = false,
		ZIndex = 8,
		Parent = gui,
	}) :: Frame
	local panel = new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.9, 0.82),
		BackgroundColor3 = C.bg,
		Parent = overlay,
		Children = { Theme.corner(24), Theme.stroke(C.green, 5), Theme.padding(16), new("UISizeConstraint", { MaxSize = Vector2.new(560, 640) }) },
	})
	Theme.label("📜 Ranger Journal", { Font = Theme.Fonts.title, TextSize = 30, Size = UDim2.new(1, -60, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, Parent = panel })
	summary = Theme.label("", { TextSize = 15, TextColor3 = C.inkSoft, Size = UDim2.new(1, -60, 0, 20), Position = UDim2.fromOffset(0, 38), TextXAlignment = Enum.TextXAlignment.Left, Parent = panel })
	Theme.button("✕", C.inkSoft, Missions.close, { Size = UDim2.fromOffset(48, 44), Position = UDim2.new(1, -48, 0, 0), Parent = panel })
	list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 66),
		Size = UDim2.new(1, 0, 1, -66),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
		Children = { Theme.list(nil, 8) },
	}) :: ScrollingFrame

	State.changed:Connect(render)
	State.push:Connect(function(kind)
		if kind == Remotes.PushKinds.OpenMissions then
			Missions.open()
		end
	end)
end

return Missions
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">PetController</string>
              <string name="Source"><![CDATA[--[[
	PetController: makes every dog feel alive. Client-side, procedural.

	The server owns behavior and replicates it as attributes on each dog:
	  PetState, PetStateAt, Trick, FaceOwner   behavior state
	  Mood, MoodAt                             short flourish (hearts, "Woof!")
	  Joy (0..1)                               how much it's enjoying petting
	  ToyOut, Ready, Carrying                  fetch: ball out, wind-up, ball in mouth
	  GroomFx, ShinyUntil                      spa effects
	Every client animates every dog from those, so everyone sees the same
	behavior without streaming animation data.

	Layers, in order:
	  1. Locomotion: trot with speed, sit/lie when resting
	  2. State poses: eating, being petted, tricks, chasing, carrying
	  3. Life: blinking, looking at you (or the ball), and small spontaneous
	     moments (head tilt, sniff, scratch, play bow, hop, yawn, lie down)
	  4. Local petting reaction (owner only): leaning into your hand,
	     squinty eyes, the happy back-leg thump

	Uploaded animations in PetCatalog.AnimationIds replace layers 1-2 for a
	state when present; this procedural version is the fallback.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)

local player = Players.LocalPlayer

local PetController = {}

type Eye = { part: BasePart, size: Vector3 }
type Rig = {
	model: Model,
	root: BasePart,
	body: BasePart?,
	head: BasePart?,
	motors: { [string]: Motor6D },
	eyes: { Eye },
	shines: { BasePart },
	phase: number,
	stillFor: number,
	sit: number,
	lie: number,
	lookYaw: number,
	lookPitch: number,
	wagAmp: number,
	idle: { name: string, at: number, duration: number }?,
	nextIdleAt: number,
	nextBlinkAt: number,
	blinkUntil: number,
	lastMoodAt: number,
	toyOut: boolean,
	own: boolean,
	fx: ParticleEmitter?,
	fxName: string?,
	sparkles: Sparkles?,
	animator: Animator?,
	track: AnimationTrack?,
	trackState: string?,
	nextNomAt: number,
}

local rigs: { [Model]: Rig } = {}

-- Local petting input for your own dog (set by PettingController).
local petting = { active = false, intensity = 0, side = 0, scratch = 0 }

local MOOD_SECONDS = 1.8
local MOOD_ICON = { happy = "⭐", love = "❤️", sparkle = "✨", comfort = "💙", confused = "❓" }
local WOOF = { excited = "Woof!", happy = "Arf!", love = "♥", confused = "...?", alert = "!" }

local IDLE_MOVES = {
	{ name = "tilt", weight = 3, duration = 1.3 },
	{ name = "look", weight = 4, duration = 2.2 },
	{ name = "sniff", weight = 3, duration = 1.6 },
	{ name = "scratch", weight = 1, duration = 1.4 },
	{ name = "bow", weight = 1, duration = 1.2 },
	{ name = "hop", weight = 1, duration = 0.7 },
	{ name = "yawn", weight = 1, duration = 1.4 },
}

local FX = {
	brush = { color = Color3.fromRGB(255, 250, 220), size = 0.35, rate = 18, speed = 2 },
	wash = { color = Color3.fromRGB(255, 255, 255), size = 0.8, rate = 26, speed = 1.5, transparency = 0.3 },
	rinse = { color = Color3.fromRGB(120, 190, 255), size = 0.3, rate = 40, speed = 6 },
	dry = { color = Color3.fromRGB(255, 230, 180), size = 0.5, rate = 20, speed = 4, transparency = 0.5 },
}

----------------------------------------------------------------------------
-- Little bubbles and icons above the head
----------------------------------------------------------------------------

local function bubble(head: BasePart, text: string, color: Color3?, size: number?, offset: Vector3?)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(size or 90, (size or 90) * 0.45)
	gui.StudsOffset = offset or Vector3.new(0, 2.2, 0)
	gui.Adornee = head
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.new(1, 1, 1)
	label.BackgroundTransparency = color and 1 or 0
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color or Color3.fromRGB(52, 44, 66)
	label.TextStrokeTransparency = color and 0.3 or 1
	label.Text = text
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = label
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = label
	label.Parent = gui
	gui.Parent = head
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(gui, TweenInfo.new(1.1), { StudsOffset = gui.StudsOffset + Vector3.new(0, 1.2, 0) }):Play()
	task.delay(0.8, function()
		TweenService:Create(label, TweenInfo.new(0.35), { TextTransparency = 1, BackgroundTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	task.delay(1.2, function()
		gui:Destroy()
	end)
end

function PetController.floatText(model: Model, text: string, color: Color3?)
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		bubble(head, text, color or Color3.fromRGB(255, 120, 190), 130, Vector3.new(0, 2.8, 0))
	end
end

function PetController.woof(model: Model, text: string?)
	local head = model:FindFirstChild("Head") :: BasePart?
	if head then
		bubble(head, text or "Woof!", nil, 80)
	end
end

local function floatIcons(rig: Rig, icon: string)
	local head = rig.head
	if not head then
		return
	end
	for i = 1, 3 do
		task.delay((i - 1) * 0.15, function()
			if head.Parent then
				bubble(head, icon, Color3.new(1, 1, 1), 46, Vector3.new((i - 2) * 0.9, 1.6, 0))
			end
		end)
	end
end

function PetController.ownPet(): Model?
	for model, rig in rigs do
		if rig.own and model.Parent then
			return model
		end
	end
	return nil
end

-- PettingController feeds hand input here for instant local reactions.
function PetController.setPetting(active: boolean, intensity: number?, side: number?, scratch: number?)
	petting.active = active
	petting.intensity = intensity or 0
	petting.side = side or 0
	petting.scratch = scratch or 0
end

----------------------------------------------------------------------------
-- Tracking
----------------------------------------------------------------------------

local function track(model: Instance)
	if not model:IsA("Model") or rigs[model] then
		return
	end
	local root = model:WaitForChild("Root", 5) :: BasePart?
	if not root then
		return
	end
	local motors, eyes, shines = {}, {}, {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		elseif d:IsA("BasePart") and d.Name == "Eye" then
			table.insert(eyes, { part = d, size = d.Size })
		elseif d:IsA("BasePart") and d.Name == "EyeShine" then
			table.insert(shines, d)
		end
	end
	local now = os.clock()
	rigs[model] = {
		model = model,
		root = root,
		body = model:FindFirstChild("Body") :: BasePart?,
		head = model:FindFirstChild("Head") :: BasePart?,
		motors = motors,
		eyes = eyes,
		shines = shines,
		phase = 0,
		stillFor = 0,
		sit = 0,
		lie = 0,
		lookYaw = 0,
		lookPitch = 0,
		wagAmp = 0.55,
		idle = nil,
		nextIdleAt = now + 2 + math.random() * 3,
		nextBlinkAt = now + 1 + math.random() * 3,
		blinkUntil = 0,
		lastMoodAt = model:GetAttribute("MoodAt") or 0,
		toyOut = model:GetAttribute("ToyOut") == true,
		own = model:GetAttribute("OwnerUserId") == player.UserId,
		nextNomAt = 0,
	}
end

local function untrack(model: Instance)
	local rig = rigs[model :: Model]
	if rig then
		if rig.track then
			rig.track:Stop(0)
		end
		rigs[model :: Model] = nil
	end
end

local function playAsset(rig: Rig, state: string): boolean
	local id = (PetCatalog.AnimationIds or {})[state]
	if not id then
		if rig.track then
			rig.track:Stop(0.15)
			rig.track = nil
			rig.trackState = nil
		end
		return false
	end
	if rig.trackState == state and rig.track then
		return true
	end
	local ok = pcall(function()
		if not rig.animator then
			local controller = Instance.new("AnimationController")
			controller.Parent = rig.model
			local animator = Instance.new("Animator")
			animator.Parent = controller
			rig.animator = animator
		end
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		if rig.track then
			rig.track:Stop(0.15)
		end
		rig.track = (rig.animator :: Animator):LoadAnimation(anim)
		rig.track.Looped = true
		rig.track:Play(0.15)
		rig.trackState = state
	end)
	return ok
end

local function updateFx(rig: Rig)
	local body = rig.body
	if not body then
		return
	end
	local fxName = rig.model:GetAttribute("GroomFx")
	if fxName ~= rig.fxName then
		rig.fxName = fxName
		if rig.fx then
			rig.fx.Enabled = false
			local old = rig.fx
			task.delay(1.5, function()
				old:Destroy()
			end)
			rig.fx = nil
		end
		local spec = fxName and FX[fxName]
		if spec then
			local e = Instance.new("ParticleEmitter")
			e.Color = ColorSequence.new(spec.color)
			e.Size = NumberSequence.new(spec.size, spec.size * 0.4)
			e.Transparency = NumberSequence.new(spec.transparency or 0, 1)
			e.Rate = spec.rate
			e.Speed = NumberRange.new(spec.speed * 0.5, spec.speed)
			e.Lifetime = NumberRange.new(0.6, 1.2)
			e.SpreadAngle = Vector2.new(180, 180)
			e.LightInfluence = 0
			e.Parent = body
			rig.fx = e
		end
	end
	local shiny = (rig.model:GetAttribute("ShinyUntil") or 0) > workspace:GetServerTimeNow()
	if shiny and not rig.sparkles then
		local sp = Instance.new("Sparkles")
		sp.SparkleColor = Color3.fromRGB(255, 240, 160)
		sp.Parent = body
		rig.sparkles = sp
	elseif not shiny and rig.sparkles then
		rig.sparkles:Destroy()
		rig.sparkles = nil
	end
end

----------------------------------------------------------------------------
-- Where should the dog look?
----------------------------------------------------------------------------

local function ownerOf(rig: Rig): Model?
	local userId = rig.model:GetAttribute("OwnerUserId")
	local owner = userId and Players:GetPlayerByUserId(userId)
	return owner and owner.Character
end

local function lookTarget(rig: Rig, state: string): Vector3?
	if state == "Fetching" then
		return nil -- eyes on the path ahead
	end
	local character = ownerOf(rig)
	if not character then
		return nil
	end
	if rig.toyOut then
		local hand = character:FindFirstChild("RightHand") :: BasePart?
		if hand then
			return hand.Position
		end
	end
	local head = character:FindFirstChild("Head") :: BasePart?
	return head and head.Position or nil
end

-- Keep your own dog's movement target on the ground (we simulate its
-- physics, so local changes steer it smoothly at frame rate):
--   following: when you jump, the dog stays on the ground instead of floating up
--   fetching: run to the spot under the ball, not to the ball in the air
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundY(at: Vector3, extra: Instance?): number?
	local ignore: { Instance } = { extra :: Instance }
	if player.Character then
		table.insert(ignore, player.Character)
	end
	local pets = workspace:FindFirstChild("Pets")
	if pets then
		table.insert(ignore, pets)
	end
	groundParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(at + Vector3.new(0, 1, 0), Vector3.new(0, -40, 0), groundParams)
	return hit and hit.Position.Y or nil
end

local function groundTargets(rig: Rig, state: string)
	local feet = rig.model:GetAttribute("GroundOffset") or 1.5
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local follow = hrp and hrp:FindFirstChild("PetFollow") :: Attachment?
	if hrp and follow then
		local side = hrp.CFrame * Vector3.new(follow.Position.X, 0, follow.Position.Z)
		local g = groundY(Vector3.new(side.X, hrp.Position.Y, side.Z))
		if g then
			follow.Position = Vector3.new(follow.Position.X, g + feet - hrp.Position.Y, follow.Position.Z)
		end
	end
	if state == "Fetching" then
		local chase = workspace.Terrain:FindFirstChild(`PetChase_{player.UserId}`) :: Attachment?
		local ball = nil
		for _, b in workspace:GetChildren() do
			if b.Name == "FetchBall" and b:GetAttribute("OwnerUserId") == player.UserId then
				ball = b :: BasePart
			end
		end
		if chase and ball then
			local g = groundY(ball.Position, ball) or 0
			chase.WorldPosition = Vector3.new(ball.Position.X, g + feet, ball.Position.Z)
		end
	end
end

local function steerOwnDog(rig: Rig, state: string, flatVel: Vector3)
	if state == "Sitting" or state == "Staying" or state == "Grooming" then
		return
	end
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local align = rig.root:FindFirstChildOfClass("AlignOrientation")
	if not hrp or not align then
		return
	end
	local dir
	if rig.model:GetAttribute("FaceOwner") or (rig.toyOut and flatVel.Magnitude < 3) then
		local d = hrp.Position - rig.root.Position
		dir = Vector3.new(d.X, 0, d.Z)
	elseif flatVel.Magnitude > 2 then
		dir = flatVel
	else
		local look = hrp.CFrame.LookVector
		dir = Vector3.new(look.X, 0, look.Z)
	end
	if dir.Magnitude < 0.1 then
		return
	end
	align.CFrame = CFrame.lookAt(Vector3.zero, dir.Unit)
end

local function pickIdle(rig: Rig, now: number)
	local total = 0
	for _, m in IDLE_MOVES do
		total += m.weight
	end
	local r = math.random() * total
	for _, m in IDLE_MOVES do
		r -= m.weight
		if r <= 0 then
			rig.idle = { name = m.name, at = now, duration = m.duration }
			if m.name == "hop" and rig.head and math.random() < 0.5 then
				bubble(rig.head, "Arf!", nil, 70)
			end
			return
		end
	end
end

----------------------------------------------------------------------------
-- The pose
----------------------------------------------------------------------------

local function animate(rig: Rig, dt: number)
	local m = rig.motors
	local model = rig.model
	local state = model:GetAttribute("PetState") or "Following"
	local now = workspace:GetServerTimeNow()
	local st = now - (model:GetAttribute("PetStateAt") or 0)
	local t = os.clock()

	local vel = rig.root.AssemblyLinearVelocity
	local flat = Vector3.new(vel.X, 0, vel.Z)
	local speed = flat.Magnitude
	if rig.own then
		groundTargets(rig, state)
		steerOwnDog(rig, state, flat)
	end
	updateFx(rig)

	-- Reactions to attribute changes (everyone sees these).
	local moodAt = model:GetAttribute("MoodAt") or 0
	local mood = model:GetAttribute("Mood")
	if moodAt ~= rig.lastMoodAt then
		rig.lastMoodAt = moodAt
		if MOOD_ICON[mood] then
			floatIcons(rig, MOOD_ICON[mood])
		end
		if WOOF[mood] and rig.head and (mood ~= "love" or math.random() < 0.5) then
			bubble(rig.head, WOOF[mood], nil, 80)
		end
	end
	local toyOut = model:GetAttribute("ToyOut") == true
	if toyOut and not rig.toyOut and rig.head then
		bubble(rig.head, "Woof! Woof!", nil, 110)
	end
	rig.toyOut = toyOut
	local moodActive = now - moodAt < MOOD_SECONDS
	local joy = model:GetAttribute("Joy") or 0
	local ready = model:GetAttribute("Ready") == true
	local carrying = model:GetAttribute("Carrying") == true

	if playAsset(rig, state) then
		return
	end

	rig.phase += dt * math.clamp(speed, 0, 40) * 0.9
	if speed < 0.6 then
		rig.stillFor += dt
	else
		rig.stillFor = 0
		rig.idle = nil
	end

	-- Pose targets
	local sitTarget, lieTarget = 0, 0
	local headPitch, headRoll, headYawExtra = 0, 0, 0
	local bodyYaw, bodyPitch, bodyRoll, lift = 0, 0, 0, 0
	local wag, wagAmp = 11, 0.55
	local frontRightRaise, backKick = 0, 0
	local squint = false
	local lookWeight = 1

	local resting = speed < 0.6 and (state == "Following" or state == "Idle" or state == "Sitting" or state == "Staying")

	if state == "Sitting" then
		sitTarget = 1
	elseif state == "Following" and rig.stillFor > 2.5 then
		sitTarget = 0.85
		if rig.stillFor > 14 then
			lieTarget = 1 -- long rest: lie down
		end
	elseif state == "Idle" then
		sitTarget = 0.75
		wag = 15
	elseif state == "Staying" then
		headPitch = 0.08
		wag = 6
	elseif state == "Eating" then
		headPitch = -0.55 + math.sin(t * 11) * 0.14
		lookWeight = 0
		wag = 18
		if rig.head and t >= rig.nextNomAt then
			rig.nextNomAt = t + 0.55
			bubble(rig.head, math.random() < 0.5 and "nom" or "crunch", Color3.fromRGB(255, 200, 120), 60, Vector3.new(0.8, 1.2, 0))
		end
	elseif state == "BeingPetted" then
		sitTarget = 0.6
		bodyRoll = math.sin(t * 7) * 0.06 * (0.4 + joy)
		headPitch = 0.22
		wag = 12 + joy * 16
		wagAmp = 0.5 + joy * 0.3
		squint = joy > 0.35
	elseif state == "Grooming" then
		bodyRoll = math.sin(t * 14) * 0.05
		wag = 18
	elseif state == "Fetching" or state == "Returning" then
		-- Gallop: body rocks and bounces with each stride.
		local gallop = math.clamp((speed - 6) / 20, 0, 1)
		bodyPitch = -0.06 + math.sin(rig.phase) * 0.12 * gallop
		lift = math.abs(math.sin(rig.phase)) * 0.3 * gallop
		wag = 20
		-- A quick leap for mid-air catches.
		local leapT = now - (model:GetAttribute("LeapAt") or 0)
		if leapT < 0.45 then
			lift += math.sin(leapT / 0.45 * math.pi) * 1.3
			bodyPitch -= 0.25 * math.sin(leapT / 0.45 * math.pi)
		end
	elseif state == "PerformingTrick" then
		local trick = model:GetAttribute("Trick")
		wag = 22
		lookWeight = 0.3
		if trick == "spin" then
			bodyYaw = math.clamp(st / 1.1, 0, 1) * math.pi * 2
			lift = math.sin(math.clamp(st / 1.1, 0, 1) * math.pi) * 0.5
		elseif trick == "high_five" then
			sitTarget = 1
			frontRightRaise = math.clamp(st * 4, 0, 1) * (st < 1.4 and 1 or 0)
			headPitch = 0.3
		elseif trick == "play_bow" then
			bodyPitch = -0.35 * math.clamp(st * 4, 0, 1)
			lift = -0.15
			headPitch = 0.3
			wag = 26
		elseif trick == "zoomies" then
			bodyYaw = st * 7
			lift = math.abs(math.sin(t * 12)) * 0.6
			bodyPitch = -0.1
			lookWeight = 0
		elseif trick == "play_toy" then
			bodyPitch = -0.3 * math.abs(math.sin(t * 6))
			headPitch = -0.3 * math.abs(math.sin(t * 6))
			lift = math.abs(math.sin(t * 6)) * 0.3
			wag = 26
		end
	end

	-- Fetch anticipation
	if toyOut and (state == "Following" or state == "Idle") then
		sitTarget, lieTarget = 0, 0
		wag = 24
		wagAmp = 0.7
		if ready then
			bodyPitch = -0.32 -- crouch, ready to sprint
			lift = -0.2
			headPitch = 0.15
			wagAmp = 0.8
		elseif speed < 1 then
			lift = math.abs(math.sin(t * 7)) * 0.45 -- bouncing with excitement
		end
	end
	if carrying then
		headPitch = 0.25 -- proud, ball held high
		wag = 26
		lookWeight = 0
	end

	-- Spontaneous moments when resting.
	local idle = rig.idle
	if resting and not toyOut and not moodActive and not (rig.own and petting.active) then
		if not idle and t >= rig.nextIdleAt then
			pickIdle(rig, t)
			idle = rig.idle
		end
	else
		rig.idle = nil
		idle = nil
	end
	if idle then
		local p = (t - idle.at) / idle.duration
		if p >= 1 then
			rig.idle = nil
			rig.nextIdleAt = t + 3 + math.random() * 5
		else
			local e = math.sin(p * math.pi) -- ease in and out
			if idle.name == "tilt" then
				headRoll = 0.4 * e * (math.floor(idle.at) % 2 == 0 and 1 or -1)
			elseif idle.name == "sniff" then
				headPitch = -0.45 * e + math.sin(t * 18) * 0.05 * e
				lookWeight = 0
			elseif idle.name == "scratch" then
				sitTarget = 1
				backKick = e
				headRoll = 0.25 * e
				lookWeight = 0
			elseif idle.name == "bow" then
				bodyPitch = -0.3 * e
				lift = -0.12 * e
				wag = 24
			elseif idle.name == "hop" then
				lift = math.sin(p * math.pi) * 0.7
				wag = 24
			elseif idle.name == "yawn" then
				headPitch = 0.4 * e
				lookWeight = 0
			end
		end
	end

	if moodActive then
		if mood == "happy" and (state == "Following" or state == "Idle" or state == "Returning") then
			lift = math.max(lift, math.abs(math.sin(t * 9)) * 0.9)
			sitTarget, lieTarget = 0, 0
			wag = 24
		elseif mood == "love" then
			wag = 26
			squint = true
		elseif mood == "excited" or mood == "alert" then
			-- alert: heard the whistle, bounding back
			lift = math.max(lift, math.abs(math.sin(t * 10)) * 0.6)
			sitTarget, lieTarget = 0, 0
			wag = 26
		elseif mood == "comfort" then
			wag = 5
			headRoll = math.sin(t * 2) * 0.25
		elseif mood == "confused" then
			headRoll = 0.4
			wag = 3
		end
	end

	-- Local petting: lean into the hand, squint, thump a back leg.
	if rig.own and petting.active and state == "BeingPetted" then
		local k = petting.intensity
		bodyRoll += petting.side * 0.12 * k
		headRoll += petting.side * 0.3 * k
		headPitch += 0.1 * k
		wag = 14 + 18 * k
		squint = squint or k > 0.3
		backKick = math.max(backKick, petting.scratch)
	end

	rig.sit += (sitTarget - rig.sit) * math.min(1, dt * 6)
	rig.lie += (lieTarget - rig.lie) * math.min(1, dt * 2)
	rig.wagAmp += (wagAmp - rig.wagAmp) * math.min(1, dt * 4)
	local sit, lie = rig.sit, rig.lie

	-- Look at the target with the neck (limited, smoothed).
	local targetYaw, targetPitch = 0, 0
	local target = lookWeight > 0 and lookTarget(rig, state)
	if target and rig.head then
		local rel = rig.root.CFrame:PointToObjectSpace(target)
		local horizontal = math.sqrt(rel.X * rel.X + rel.Z * rel.Z)
		if horizontal > 0.5 and horizontal < 30 then
			targetYaw = math.clamp(math.atan2(-rel.X, -rel.Z), -0.9, 0.9) * lookWeight
			targetPitch = math.clamp(math.atan2(rel.Y - 1, horizontal), -0.3, 0.45) * lookWeight
		end
	end
	rig.lookYaw += (targetYaw - rig.lookYaw) * math.min(1, dt * 5)
	rig.lookPitch += (targetPitch - rig.lookPitch) * math.min(1, dt * 5)

	local moving = math.clamp(speed / 12, 0, 1)
	local strideAmp = (state == "Fetching" or state == "Returning") and 1.0 or 0.7
	local stride = math.sin(rig.phase) * strideAmp * moving

	if m.LegFL then
		local front = lie * 1.3 -- lying: front legs stretch forward
		m.LegFL.Transform = CFrame.Angles(stride + front, 0, 0)
		m.LegFR.Transform = CFrame.Angles(-stride - frontRightRaise * 1.9 + front, 0, frontRightRaise * 0.2)
		local kick = backKick > 0 and math.sin(t * 28) * 0.6 * backKick or 0
		m.LegBR.Transform = CFrame.Angles(stride - sit * 1.2 - lie * 0.3 + kick, 0, 0)
		m.LegBL.Transform = CFrame.Angles(-stride - sit * 1.2 - lie * 0.3, 0, 0)
	end
	if m.BodyJoint then
		local bob = math.abs(math.sin(rig.phase)) * 0.08 * moving
		local down = sit * 0.35 * (1 - lie) + lie * 0.75
		m.BodyJoint.Transform = CFrame.new(0, bob + lift - down, sit * 0.15 * (1 - lie))
			* CFrame.Angles(0, bodyYaw, 0)
			* CFrame.Angles(sit * 0.35 * (1 - lie) + bodyPitch, 0, bodyRoll)
	end
	if m.Neck then
		local breathe = math.sin(t * 2.2) * 0.02
		m.Neck.Transform = CFrame.Angles(-sit * 0.25 * (1 - lie) + headPitch + rig.lookPitch + breathe + math.sin(rig.phase * 2) * 0.05 * moving, rig.lookYaw + headYawExtra, headRoll)
	end
	if m.Tail then
		m.Tail.Transform = CFrame.Angles(carrying and -0.3 or 0, math.sin(t * wag) * rig.wagAmp, 0)
	end

	-- Eyes: blink now and then; happy squint when loved.
	if t >= rig.nextBlinkAt then
		rig.blinkUntil = t + 0.12
		rig.nextBlinkAt = t + 2.2 + math.random() * 3.5
	end
	local closed = squint or t < rig.blinkUntil
	for _, eye in rig.eyes do
		local want = closed and Vector3.new(eye.size.X, eye.size.Y * 0.2, eye.size.Z) or eye.size
		if eye.part.Size ~= want then
			eye.part.Size = want
		end
	end
	for _, shine in rig.shines do
		shine.LocalTransparencyModifier = closed and 1 or 0
	end
end

function PetController.start()
	CollectionService:GetInstanceAddedSignal("Pet"):Connect(function(m)
		task.spawn(track, m)
	end)
	CollectionService:GetInstanceRemovedSignal("Pet"):Connect(untrack)
	for _, m in CollectionService:GetTagged("Pet") do
		task.spawn(track, m)
	end
	RunService.RenderStepped:Connect(function(dt)
		for model, rig in rigs do
			if model.Parent and rig.root.Parent then
				animate(rig, dt)
			else
				untrack(model)
			end
		end
	end)
end

return PetController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">PettingController</string>
              <string name="Source"><![CDATA[--[[
	PettingController: hands-on petting.

	The camera eases into a close, cozy shot of your dog (you stay right
	there, movement pauses). Your cursor becomes a hand:
	  Mouse     move the hand over your dog to stroke it
	  Touch     drag your finger over your dog
	  Gamepad / keyboard   hold A (or Space) to pet gently
	The dog reacts instantly: leans into your hand, squints happily, wags
	harder the more you pet, and thumps a back leg when you rub its side.
	Hearts float up from your hand. After a few seconds of real petting the
	server confirms it (Bond XP) and your dog says thanks.

	Ends with Done, Q / B, walking away, 8 s without petting, or anything else
	taking over (a conversation, the dog being called away).
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new
local player = Players.LocalPlayer

local SEND_INTERVAL = 0.25
local IDLE_TIMEOUT = 12
local LOCAL_RATE = 0.5 -- matches the server's petting rate

local Petting = {}
local ctl
local gui: ScreenGui
local layer: Frame
local hand: TextLabel
local hint: TextLabel
local hearts: { TextLabel } = {}
local doneButton: TextButton

local active = false
local starting = false
local startedAt = 0
local lastStrokeAt = 0
local lastSendAt = 0
local sendSum, sendCount = 0, 0
local intensity = 0
local progress = 0
local bodyRubTime = 0
local lastHeartAt = 0
local lastPatAt = 0
local lastPointer: Vector2? = nil
local touchPos: Vector2? = nil
local holdKey = false
local savedCamera: { type: Enum.CameraType, cframe: CFrame }? = nil
local setCharacterFade: (number) -> ()

local function controls()
	local ok, module = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript) :: any
		return playerModule:GetControls()
	end)
	return ok and module or nil
end

local function pet(): Model?
	return ctl.Pet.ownPet()
end

local function petName(): string
	local m = pet()
	return m and m:GetAttribute("PetName") or "your dog"
end

-- Screen-space circle covering a part.
local function screenCircle(part: BasePart, scale: number): (Vector2?, number)
	local camera = workspace.CurrentCamera
	local center, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen then
		return nil, 0
	end
	local edge = camera:WorldToViewportPoint(part.Position + camera.CFrame.RightVector * part.Size.Magnitude * 0.5 * scale)
	local inset = GuiService:GetGuiInset()
	local c = Vector2.new(center.X, center.Y - inset.Y)
	return c, (Vector2.new(edge.X, edge.Y - inset.Y) - c).Magnitude
end

local function heart(at: Vector2, big: boolean?)
	local h = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(at.X, at.Y),
		Size = UDim2.fromOffset(big and 56 or 30, big and 56 or 30),
		BackgroundTransparency = 1,
		Text = "❤️",
		TextScaled = true,
		Rotation = math.random(-20, 20),
		Parent = layer,
	}) :: TextLabel
	local drift = Vector2.new(math.random(-50, 50), -math.random(80, 150))
	TweenService:Create(h, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(at.X + drift.X, at.Y + drift.Y),
		TextTransparency = 1,
		Rotation = h.Rotation + math.random(-30, 30),
	}):Play()
	task.delay(1.15, function()
		h:Destroy()
	end)
end

local function renderMeter()
	for i, h in hearts do
		local fill = math.clamp(progress * #hearts - (i - 1), 0, 1)
		h.TextTransparency = 0.75 - fill * 0.75
		h.Size = UDim2.fromOffset(28 + fill * 6, 28 + fill * 6)
	end
end

local function cameraShot(model: Model)
	local head = model:FindFirstChild("Head") :: BasePart?
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not head or not hrp then
		return
	end
	local camera = workspace.CurrentCamera
	savedCamera = { type = camera.CameraType, cframe = camera.CFrame }
	local toward = Vector3.new(hrp.Position.X - head.Position.X, 0, hrp.Position.Z - head.Position.Z)
	toward = toward.Magnitude > 0.1 and toward.Unit or Vector3.new(0, 0, 1)
	local side = toward:Cross(Vector3.yAxis)
	-- Mostly from the side, so your character never blocks the view.
	local offset = (side * 1 + toward * 0.35).Unit * 6.5
	local eye = head.Position + offset + Vector3.new(0, 2.4, 0)
	camera.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		CFrame = CFrame.lookAt(eye, head.Position - Vector3.new(0, 0.6, 0)),
	}):Play()
end

-- Fade your own character a little so it never hides the dog.
function setCharacterFade(amount: number)
	local character = player.Character
	if not character then
		return
	end
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") or d:IsA("Decal") then
			(d :: any).LocalTransparencyModifier = amount
		end
	end
end

local function restoreCamera()
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
	savedCamera = nil
end

function Petting.isActive(): boolean
	return active or starting
end

function Petting.stop()
	if not active then
		return
	end
	active = false
	ctl.Pet.setPetting(false)
	layer.Visible = false
	UserInputService.MouseIconEnabled = true
	setCharacterFade(0)
	ctl.HUD.setFocus(false)
	restoreCamera()
	local c = controls()
	if c then
		c:Enable()
	end
	task.spawn(State.request, Remotes.RequestKinds.PetEnd)
end

function Petting.begin()
	if active or starting then
		return
	end
	local model = pet()
	if not model then
		ctl.HUD.toast("Adopt a dog first!")
		return
	end
	starting = true
	local ok, err = State.request(Remotes.RequestKinds.PetAction, { action = "petStart" })
	starting = false
	if not ok then
		if err then
			ctl.HUD.toast(err)
		end
		return
	end
	ctl.ActionBar.close()
	active = true
	startedAt = os.clock()
	lastStrokeAt = os.clock()
	progress, intensity, bodyRubTime = 0, 0, 0
	sendSum, sendCount = 0, 0
	lastPointer = nil
	local c = controls()
	if c then
		c:Disable()
	end
	setCharacterFade(0.6)
	ctl.HUD.setFocus(true)
	cameraShot(model)
	layer.Visible = true
	renderMeter()
	local input = UserInputService:GetLastInputType()
	if input == Enum.UserInputType.Touch then
		hint.Text = `Drag your finger over {petName()}!`
	elseif input.Name:find("Gamepad") then
		hint.Text = `Hold A to pet {petName()}`
	else
		hint.Text = `Move your hand over {petName()} to pet (or hold Space)`
	end
	hint.TextTransparency = 0
	UserInputService.MouseIconEnabled = input == Enum.UserInputType.Touch
	Sounds.play("pat", 1.4)
end

local function step(dt: number)
	local model = pet()
	if not model or not model.Parent then
		Petting.stop()
		return
	end
	-- Something else took over (called away, conversation, walked off).
	if os.clock() - startedAt > 0.6 and model:GetAttribute("PetState") ~= "BeingPetted" then
		Petting.stop()
		return
	end
	local head = model:FindFirstChild("Head") :: BasePart?
	local body = model:FindFirstChild("Body") :: BasePart?
	if not head or not body then
		return
	end
	local headC, headR = screenCircle(head, 1.1)
	local bodyC, bodyR = screenCircle(body, 0.9)

	-- Where is the hand?
	local pointer: Vector2?
	local auto = holdKey
	if auto and headC then
		-- Accessible petting: the hand strokes the head by itself.
		local t = os.clock()
		pointer = headC + Vector2.new(math.sin(t * 5) * headR * 0.6, math.cos(t * 2.5) * headR * 0.2)
	elseif touchPos then
		pointer = touchPos
	elseif UserInputService.MouseEnabled then
		local m = UserInputService:GetMouseLocation()
		local inset = GuiService:GetGuiInset()
		pointer = Vector2.new(m.X, m.Y - inset.Y)
	end
	hand.Visible = pointer ~= nil
	if not pointer then
		return
	end
	hand.Position = UDim2.fromOffset(pointer.X, pointer.Y)

	local zone = nil
	if headC and (pointer - headC).Magnitude <= headR then
		zone = "head"
	elseif bodyC and (pointer - bodyC).Magnitude <= bodyR then
		zone = "body"
	end

	local moved = lastPointer and (pointer - lastPointer).Magnitude or 0
	lastPointer = pointer
	local target = 0
	if zone then
		target = math.clamp(moved / math.max(dt, 1 / 120) / 500, 0, 1)
		if auto then
			target = 0.7
		end
	end
	intensity += (target - intensity) * math.min(1, dt * (target > intensity and 10 or 3))
	hand.Rotation = zone and math.sin(os.clock() * 14) * 12 * intensity or 0
	hand.TextTransparency = zone and 0 or 0.35

	if intensity > 0.08 then
		lastStrokeAt = os.clock()
		progress = math.min(1, progress + intensity * dt * LOCAL_RATE)
		if hint.TextTransparency < 1 then
			TweenService:Create(hint, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
		end
	end
	if zone == "body" and intensity > 0.3 then
		bodyRubTime += dt
	else
		bodyRubTime = math.max(0, bodyRubTime - dt * 2)
	end
	local side = 0
	if headC then
		side = math.clamp((pointer.X - headC.X) / math.max(headR, 1), -1, 1)
	end
	ctl.Pet.setPetting(true, intensity, side, math.clamp((bodyRubTime - 0.8) * 2, 0, 1))

	local now = os.clock()
	if intensity > 0.3 and now - lastHeartAt > 0.4 - intensity * 0.2 then
		lastHeartAt = now
		heart(pointer + Vector2.new(math.random(-12, 12), -20))
	end
	if intensity > 0.25 and now - lastPatAt > 0.32 then
		lastPatAt = now
		Sounds.play("pat", 0.9 + progress * 0.9)
	end
	renderMeter()

	sendSum += intensity
	sendCount += 1
	if now - lastSendAt >= SEND_INTERVAL then
		lastSendAt = now
		local avg = sendCount > 0 and sendSum / sendCount or 0
		sendSum, sendCount = 0, 0
		task.spawn(State.request, Remotes.RequestKinds.PetAction, { action = "petStroke", amount = avg })
	end

	if now - lastStrokeAt > IDLE_TIMEOUT then
		Petting.stop()
	end
end

local function celebrate(xp: number?)
	local model = pet()
	local head = model and model:FindFirstChild("Head") :: BasePart?
	local center = head and screenCircle(head, 1)
	if center then
		for i = 1, 8 do
			task.delay(i * 0.04, function()
				heart(center + Vector2.new(math.random(-60, 60), math.random(-30, 20)), i % 3 == 0)
			end)
		end
	end
	Sounds.play("chime")
	if model then
		ctl.Pet.woof(model, math.random() < 0.5 and "♥ Woof! ♥" or "Arf arf!")
		if xp and xp > 0 then
			task.delay(0.3, function()
				ctl.Pet.floatText(model, `+{xp} ♥ bond`)
			end)
		end
	end
	progress = 0
end

function Petting.start(screenGui: ScreenGui, controllers)
	gui = screenGui
	ctl = controllers
	layer = new("Frame", { Name = "Petting", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 20, Parent = gui }) :: Frame
	hand = new("TextLabel", {
		AnchorPoint = Vector2.new(0.3, 0.2),
		Size = UDim2.fromOffset(64, 64),
		BackgroundTransparency = 1,
		Text = "🖐️",
		TextScaled = true,
		ZIndex = 22,
		Parent = layer,
	}) :: TextLabel
	hint = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.fromOffset(520, 30),
		Font = Theme.Fonts.title,
		TextSize = 24,
		TextColor3 = C.white,
		TextStrokeTransparency = 0.3,
		Parent = layer,
	})
	local meter = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.fromOffset(220, 40),
		BackgroundTransparency = 1,
		Parent = layer,
		Children = { Theme.list(Enum.FillDirection.Horizontal, 4) },
	})
	for i = 1, 5 do
		hearts[i] = new("TextLabel", {
			LayoutOrder = i,
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 1,
			Text = "❤️",
			TextScaled = true,
			TextTransparency = 0.75,
			Parent = meter,
		}) :: TextLabel
	end
	doneButton = Theme.button("Done", C.inkSoft, Petting.stop, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(110, 44),
		TextSize = 20,
		Parent = layer,
	})

	UserInputService.InputBegan:Connect(function(input, processed)
		if not active then
			return
		end
		if input.KeyCode == Enum.KeyCode.ButtonA or input.KeyCode == Enum.KeyCode.Space then
			holdKey = true
		elseif input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Q then
			Petting.stop()
		elseif input.UserInputType == Enum.UserInputType.Touch and not processed then
			local inset = GuiService:GetGuiInset()
			touchPos = Vector2.new(input.Position.X, input.Position.Y - inset.Y)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if active and input.UserInputType == Enum.UserInputType.Touch and touchPos then
			local inset = GuiService:GetGuiInset()
			touchPos = Vector2.new(input.Position.X, input.Position.Y - inset.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.ButtonA or input.KeyCode == Enum.KeyCode.Space then
			holdKey = false
		elseif input.UserInputType == Enum.UserInputType.Touch then
			touchPos = nil
			lastPointer = nil
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if active then
			step(dt)
		end
	end)
	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.Petted and active then
			celebrate(payload.xp)
		elseif kind == Remotes.PushKinds.Dialogue or kind == Remotes.PushKinds.OpenShop then
			Petting.stop()
		end
	end)
	player.CharacterRemoving:Connect(Petting.stop)
end

return Petting
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--[[
	ShopController: the Fluff & Puff Salon shop and the Wardrobe. Both are
	the same catalog view; the shop can buy, the wardrobe only equips.
	All buying and equipping is decided by the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new

local Shop = {}
local hud
local overlay: Frame
local titleLabel: TextLabel
local subtitleLabel: TextLabel
local grid: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local mode: "shop" | "wardrobe" = "shop"
local shopId = "salon"
local tab: string = "dog"
local busy = false
local tabRow: Frame

local TAB_LABELS = { dog = "🐶 Dog", me = "🧢 Me", care = "🫧 Care", treats = "🦴 Treats" }
local SHOPS = {
	salon = { title = "Fluff & Puff Salon", tabs = { "dog", "me", "care" } },
	treat_shop = { title = "Bo's Treat Shop", tabs = { "treats" } },
}
local WARDROBE_TABS = { "dog", "me", "treats" }

local function swatch(item: ItemCatalog.Item): (Color3, string)
	local v = item.visual
	if item.kind == "bundle" then
		return C.yellow, "🎁"
	elseif item.kind == "consumable" then
		return C.orange, "🦴"
	elseif item.kind == "service" then
		return Color3.fromRGB(150, 220, 255), "🫧"
	elseif v and v.kind == "fur" then
		return v.color, "🐕"
	elseif v and v.kind == "leash" then
		return v.color, "🦮"
	elseif v and (v.kind == "cap" or v.kind == "party_hat") then
		return v.color, "🎩"
	elseif v and v.kind == "vest" then
		return v.color, "🦺"
	end
	return v and v.color or C.teal, "⭐"
end

local function isEquipped(data, item: ItemCatalog.Item): boolean
	if item.kind ~= "cosmetic" or not item.slot then
		return false
	end
	if item.target == "pet" then
		return data.pet ~= nil and data.pet.equipped[item.slot] == item.id
	end
	return data.playerEquipped[item.slot] == item.id
end

local function owns(data, item: ItemCatalog.Item): boolean
	if item.kind == "bundle" then
		for _, id in item.contents or {} do
			if not data.inventory[id] then
				return false
			end
		end
		return true
	end
	return (data.inventory[item.id] or 0) > 0
end

local function act(kind: string, payload)
	if busy then
		return
	end
	busy = true
	local ok, err = State.request(kind, payload)
	busy = false
	if not ok and err and hud then
		hud.toast(err, "warn")
	end
end

local function card(data, item: ItemCatalog.Item, order: number)
	local color, icon = swatch(item)
	local frame = new("Frame", {
		LayoutOrder = order,
		BackgroundColor3 = C.panel,
		Parent = grid,
		Children = { Theme.corner(14), Theme.stroke(C.disabled, 2), Theme.padding(8), Theme.list(nil, 4) },
	}) :: Frame
	new("Frame", {
		Size = UDim2.fromOffset(56, 56),
		BackgroundColor3 = color,
		LayoutOrder = 1,
		Parent = frame,
		Children = {
			Theme.corner(28),
			Theme.stroke(C.ink, 2),
			Theme.label(icon, { Size = UDim2.fromScale(1, 1), TextSize = 28 }),
		},
	})
	Theme.label(item.name, { Font = Theme.Fonts.title, TextSize = 18, LayoutOrder = 2, Parent = frame })
	Theme.label(item.description, { TextSize = 13, TextColor3 = C.inkSoft, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 3, Parent = frame })

	local owned = owns(data, item)
	local equipped = isEquipped(data, item)
	local text, bg, onClick
	if item.kind == "cosmetic" and owned then
		if equipped then
			text, bg = "Wearing ✓", C.green
			onClick = function()
				act(Remotes.RequestKinds.Unequip, { target = item.target, slot = item.slot })
			end
		else
			text, bg = "Wear", C.teal
			onClick = function()
				act(Remotes.RequestKinds.Equip, { itemId = item.id })
			end
		end
	elseif item.kind == "bundle" and owned then
		text, bg, onClick = "Owned ✓", C.disabled, function() end
	elseif item.kind == "consumable" and mode == "wardrobe" then
		local count = data.inventory[item.id] or 0
		text, bg = `Give ({count})`, count > 0 and C.orange or C.disabled
		onClick = function()
			act(Remotes.RequestKinds.UseItem, { itemId = item.id })
		end
	elseif mode == "shop" then
		local affordable = data.coins >= item.price
		local count = item.kind == "consumable" and (data.inventory[item.id] or 0) or nil
		text = `🐾 {item.price}` .. (count and count > 0 and `  (have {count})` or "")
		bg = affordable and C.orange or C.disabled
		onClick = function()
			act(Remotes.RequestKinds.Purchase, { itemId = item.id })
		end
	else
		text, bg, onClick = item.unlockOnly and "Bond reward" or "Buy in town", C.disabled, function() end
	end
	Theme.button(text, bg, onClick, { Size = UDim2.new(1, 0, 0, 40), TextSize = 18, LayoutOrder = 4, Parent = frame })
end

local function render()
	if not overlay.Visible then
		return
	end
	for _, child in grid:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for id, b in tabButtons do
		b.BackgroundColor3 = id == tab and C.purple or C.disabled
	end
	local data = State.data
	if not data then
		return
	end
	local items = ItemCatalog.sorted(function(item)
		if item.tab ~= tab then
			return false
		end
		if mode == "shop" and (item.unlockOnly or ItemCatalog.shopOf(item) ~= shopId) then
			return false
		end
		if mode == "wardrobe" then
			if item.kind == "service" or item.kind == "bundle" then
				return false
			end
			return owns(data, item) or item.kind == "consumable"
		end
		return true
	end)
	for i, item in items do
		card(data, item, i)
	end
	if #items == 0 then
		Theme.label(mode == "wardrobe" and "Nothing here yet. Visit the shops in town!" or "Coming soon!", {
			Size = UDim2.new(1, 0, 0, 40),
			Parent = grid,
		})
	end
end

local function buildTabs(ids: { string })
	for _, b in tabButtons do
		b:Destroy()
	end
	table.clear(tabButtons)
	for i, id in ids do
		tabButtons[id] = Theme.button(TAB_LABELS[id] or id, C.disabled, function()
			tab = id
			render()
		end, { Size = UDim2.fromOffset(120, 44), LayoutOrder = i, TextSize = 20, Parent = tabRow })
	end
	tab = ids[1]
end

function Shop.open(which: "shop" | "wardrobe", line: string?, npcName: string?, whichShop: string?)
	mode = which
	shopId = whichShop or "salon"
	overlay.Visible = true
	local shop = SHOPS[shopId] or SHOPS.salon
	titleLabel.Text = which == "shop" and shop.title or "Wardrobe"
	buildTabs(which == "shop" and shop.tabs or WARDROBE_TABS)
	subtitleLabel.Text = line and `{npcName or "Shopkeeper"}: "{line}"` or (which == "shop" and "Pick something fun!" or "Mix and match your looks.")
	render()
	Theme.pop(overlay:FindFirstChild("Panel") :: GuiObject)
	if UserInputService.GamepadEnabled then
		GuiService.SelectedObject = tabButtons[tab]
	end
end

function Shop.close()
	overlay.Visible = false
end

function Shop.start(gui: ScreenGui, controllers)
	hud = controllers.HUD
	overlay = new("Frame", {
		Name = "Shop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Visible = false,
		ZIndex = 8,
		Parent = gui,
	}) :: Frame
	local panel = new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.84),
		BackgroundColor3 = C.bg,
		Parent = overlay,
		Children = {
			Theme.corner(24),
			Theme.stroke(C.purple, 5),
			Theme.padding(16),
			new("UISizeConstraint", { MaxSize = Vector2.new(820, 640) }),
		},
	}) :: Frame
	titleLabel = Theme.label("", { Font = Theme.Fonts.title, TextSize = 30, Size = UDim2.new(1, -60, 0, 36), TextXAlignment = Enum.TextXAlignment.Left, Parent = panel })
	subtitleLabel = Theme.label("", { TextSize = 16, TextColor3 = C.inkSoft, Size = UDim2.new(1, -60, 0, 20), Position = UDim2.fromOffset(0, 38), TextXAlignment = Enum.TextXAlignment.Left, Parent = panel })
	Theme.button("✕", C.inkSoft, Shop.close, { Size = UDim2.fromOffset(48, 44), Position = UDim2.new(1, -48, 0, 0), Parent = panel })

	tabRow = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.fromOffset(0, 66),
		BackgroundTransparency = 1,
		Parent = panel,
		Children = { Theme.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left) },
	}) :: Frame

	grid = new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.new(1, 0, 1, -120),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
		Children = {
			new("UIGridLayout", {
				CellSize = UDim2.fromOffset(176, 210),
				CellPadding = UDim2.fromOffset(10, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		},
	}) :: ScrollingFrame

	State.changed:Connect(render)
	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.OpenShop then
			Shop.open("shop", payload and payload.line, payload and payload.npcName, payload and payload.shop)
		end
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--[[
	State: the client's read-only copy of its profile snapshot, plus a
	request() helper. The server pushes a fresh snapshot after every change.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local State = {}
State.data = nil :: any
local changed = Instance.new("BindableEvent")
State.changed = changed.Event

local requestRemote: RemoteFunction, pushRemote: RemoteEvent = Remotes.get()
State.push = pushRemote.OnClientEvent

-- Sends a request; returns (ok, error?, data?). Never throws.
function State.request(kind: string, payload: any?): (boolean, string?, any?)
	local ok, result = pcall(function()
		return requestRemote:InvokeServer(kind, payload)
	end)
	if not ok or typeof(result) ~= "table" then
		return false, "Connection hiccup. Try again!", nil
	end
	return result.ok == true, result.error, result.data
end

function State.set(data)
	State.data = data
	changed:Fire(data)
end

pushRemote.OnClientEvent:Connect(function(kind, payload)
	if kind == Remotes.PushKinds.State then
		State.set(payload)
	end
end)

task.spawn(function()
	while not State.data do
		local ok, _, data = State.request(Remotes.RequestKinds.GetState)
		if ok and data then
			State.set(data)
			break
		end
		task.wait(1)
	end
end)

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">WhistleController</string>
              <string name="Source"><![CDATA[--[[
	WhistleController: an always-on way to call your dog back from anywhere.

	  Keyboard   H ("here")
	  Gamepad    D-pad Up
	  Touch      a round 📣 button that sits just above the jump button

	The button is on screen whenever you have a dog (hidden during a
	conversation, so it can't cover a choice). Whistling plays a chirp right
	away; the server drops whatever the dog was doing, puts a "!" over it, and
	it runs back to you. See PetInteractionService handlers.whistle.
]]

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local PetActions = require(ReplicatedStorage.Shared.Catalogs.PetActions)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)
local Sounds = require(script.Parent.Parent.UI.Sounds)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local new = Theme.new
local player = Players.LocalPlayer

local KEY = Enum.KeyCode.H
local PAD = Enum.KeyCode.DPadUp
local SIZE = 60
local GAP = 10 -- space between the jump button and the whistle

local Whistle = {}
local ctl
local gui: ScreenGui
local button: TextButton
local circle: Frame
local hint: TextLabel
local readyAt = 0

local function hasDog(): boolean
	return State.data ~= nil and State.data.pet ~= nil
end

local function bounce()
	local scale = circle:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = circle })
	;(scale :: UIScale).Scale = 0.8
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function Whistle.blow()
	if not hasDog() then
		ctl.HUD.toast("Adopt a dog first!")
		return
	end
	local now = os.clock()
	if now < readyAt then
		return
	end
	readyAt = now + PetActions.Actions.whistle.cooldown
	bounce()
	-- Two quick rising chirps: instant feedback before the server answers.
	Sounds.play("whistle")
	task.delay(0.14, Sounds.play, "whistle", 1.25)
	if ctl.Petting.isActive() then
		ctl.Petting.stop()
	end
	task.spawn(function()
		local ok, err = State.request(Remotes.RequestKinds.PetAction, { action = "whistle" })
		if not ok and err then
			ctl.HUD.toast(err)
		end
	end)
end

-- Keyboard shows "H", gamepad shows the D-pad, touch shows nothing.
local function updateHint()
	local last = UserInputService:GetLastInputType()
	if last == Enum.UserInputType.Touch then
		hint.Visible = false
	elseif last.Name:find("Gamepad") then
		hint.Visible = true
		hint.Text = "D-pad ↑"
	else
		hint.Visible = true
		hint.Text = "H"
	end
end

local function jumpButton(): GuiObject?
	local touchGui = player.PlayerGui:FindFirstChild("TouchGui")
	local jump = touchGui and touchGui:FindFirstChild("JumpButton", true)
	if jump and jump:IsA("GuiObject") and jump.Visible and jump.AbsoluteSize.X > 0 then
		return jump
	end
	return nil
end

-- Above the jump button on touch screens; bottom-right otherwise.
local function place()
	local jump = jumpButton()
	if jump then
		local origin = gui.AbsolutePosition
		local x = jump.AbsolutePosition.X + jump.AbsoluteSize.X / 2 - origin.X
		local y = jump.AbsolutePosition.Y - GAP - origin.Y
		button.AnchorPoint = Vector2.new(0.5, 1)
		button.Position = UDim2.fromOffset(x, y)
	else
		button.AnchorPoint = Vector2.new(1, 1)
		button.Position = UDim2.new(1, -16, 1, -16)
	end
end

local function updateVisible()
	local v = hasDog() and not ctl.Dialogue.isOpen()
	button.Visible = v
	if not v and GuiService.SelectedObject == button then
		GuiService.SelectedObject = nil
	end
end

function Whistle.start(screenGui: ScreenGui, controllers)
	ctl = controllers
	gui = screenGui
	button = new("TextButton", {
		Name = "WhistleButton",
		Size = UDim2.fromOffset(SIZE, SIZE),
		BackgroundTransparency = 1,
		Text = "",
		Visible = false,
		Parent = gui,
	}) :: TextButton
	circle = new("Frame", {
		Name = "Circle",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.white,
		BackgroundTransparency = 0.05,
		Parent = button,
		Children = {
			Theme.corner(SIZE / 2),
			Theme.stroke(C.pink, 3),
			Theme.label("📣", { Name = "Icon", Size = UDim2.fromScale(1, 1), TextSize = 28 }),
		},
	}) :: Frame
	hint = Theme.label("H", {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(46, 18),
		BackgroundColor3 = C.ink,
		BackgroundTransparency = 0.1,
		TextColor3 = C.white,
		TextSize = 12,
		Font = Theme.Fonts.bold,
		Parent = button,
		Children = { Theme.corner(9) },
	})
	button.Activated:Connect(Whistle.blow)

	UserInputService.InputBegan:Connect(function(input, processed)
		-- processed: typing in chat, or D-pad navigating a selected menu.
		if processed then
			return
		end
		if input.KeyCode == KEY or input.KeyCode == PAD then
			Whistle.blow()
		end
	end)
	UserInputService.LastInputTypeChanged:Connect(updateHint)
	updateHint()

	-- The touch controls appear (and move) on their own schedule, so
	-- re-place a couple of times a second rather than tracking them.
	local acc = 1
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 0.5 then
			acc = 0
			place()
			updateVisible()
		end
	end)
end

return Whistle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--[[
	WorldController: client-only world helpers.

	* Waypoint arrow: a glowing beam from you to where your next objective is
	  (or to the Ranger Station when help was asked for).
	* Blocked NPCs disappear for you only (the server also refuses to start
	  conversations with them).
	* Fetch button (in the Dog Park) and agility timer.
	* Wrap-around edges: walking off the map puts you on the opposite side.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Places = require(ReplicatedStorage.Shared.Places)
local QuestCatalog = require(ReplicatedStorage.Shared.Catalogs.QuestCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local WorldBounds = require(ReplicatedStorage.Shared.WorldBounds)
local State = require(script.Parent.State)
local Theme = require(script.Parent.Parent.UI.Theme)

local C = Theme.Colors
local player = Players.LocalPlayer

local WorldController = {}
local hud
local dialogue
local activities
local petting

----------------------------------------------------------------------------
-- Waypoint
----------------------------------------------------------------------------

local marker: Part
local markerAttachment: Attachment
local markerLabel: TextLabel
local beam: Beam
local override: { placeId: string, untilTime: number }? = nil

local function buildWaypoint()
	marker = Instance.new("Part")
	marker.Name = "WaypointMarker"
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.Transparency = 1
	marker.Size = Vector3.one
	markerAttachment = Instance.new("Attachment")
	markerAttachment.Parent = marker
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(220, 60)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.Parent = marker
	markerLabel = Instance.new("TextLabel")
	markerLabel.Size = UDim2.fromScale(1, 1)
	markerLabel.BackgroundTransparency = 1
	markerLabel.Font = Theme.Fonts.title
	markerLabel.TextScaled = true
	markerLabel.TextColor3 = C.yellow
	markerLabel.TextStrokeTransparency = 0.2
	markerLabel.Parent = gui
	beam = Instance.new("Beam")
	beam.Attachment1 = markerAttachment
	beam.Color = ColorSequence.new(C.yellow)
	beam.Transparency = NumberSequence.new(0.35, 0.1)
	beam.Width0 = 0.5
	beam.Width1 = 0.5
	beam.FaceCamera = true
	beam.LightInfluence = 0
	beam.Parent = marker
	marker.Parent = workspace
end

local function currentTarget(): string?
	if override and os.clock() < override.untilTime then
		return override.placeId
	end
	override = nil
	local data = State.data
	if not data or not data.pet then
		return nil -- adoption screen is open; no arrow yet
	end
	for _, quest in QuestCatalog.Ordered do
		if not data.quests[quest.id] then
			return quest.waypoint
		end
	end
	return nil
end

local function updateWaypoint()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local target = currentTarget()
	local place = target and Places.get(target)
	if not hrp or not place or Places.isInside(place.id, hrp.Position) then
		beam.Enabled = false
		markerLabel.Visible = false
		if override and place and hrp and Places.isInside(place.id, hrp.Position) then
			override = nil
		end
		return
	end
	local a0 = hrp:FindFirstChild("WaypointFrom") :: Attachment?
	if not a0 then
		a0 = Instance.new("Attachment")
		a0.Name = "WaypointFrom"
		a0.Position = Vector3.new(0, -2.2, 0)
		a0.Parent = hrp
	end
	beam.Attachment0 = a0
	beam.Enabled = true
	markerLabel.Visible = true
	markerLabel.Text = "▼ " .. place.displayName
	marker.Position = place.entrance + Vector3.new(0, 1, 0)
end

----------------------------------------------------------------------------
-- Blocked NPCs
----------------------------------------------------------------------------

local function applyBlocked()
	local blocked = State.data and State.data.blocked or {}
	for _, model in CollectionService:GetTagged("Interactable_NPC") do
		local hidden = blocked[model:GetAttribute("NpcId")] ~= nil
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.LocalTransparencyModifier = hidden and 1 or 0
			elseif d:IsA("BillboardGui") then
				d.Enabled = not hidden
			elseif d:IsA("ProximityPrompt") then
				d.Enabled = not hidden
			elseif d:IsA("Decal") then
				d.Transparency = hidden and 1 or 0
			end
		end
	end
end

----------------------------------------------------------------------------
-- Fetch button + agility timer
----------------------------------------------------------------------------

local fetchButton: TextButton
local agilityLabel: TextLabel
local agilityRun: { started: number, ring: number, total: number }? = nil

local fetchAim
local function throw()
	fetchAim.equip()
end

local function buildActivityUI(gui: ScreenGui)
	fetchButton = Theme.button("🎾 Play fetch", C.green, throw, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(220, 64),
		TextSize = 28,
		Visible = false,
		Parent = gui,
	})
	agilityLabel = Theme.label("", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.fromOffset(320, 40),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = C.blue,
		TextColor3 = C.white,
		Font = Theme.Fonts.title,
		TextSize = 24,
		Visible = false,
		Parent = gui,
	})
	Theme.corner(14).Parent = agilityLabel

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and fetchButton.Visible and input.KeyCode == Enum.KeyCode.F then
			throw()
		end
	end)
end

local function updateActivityUI()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local inPark = hrp ~= nil and Places.isInside("dog_park", hrp.Position)
	local hasPet = State.data ~= nil and State.data.pet ~= nil
	-- The ball lives in the hotbar now; this is only a nudge for new players.
	fetchButton.Visible = inPark and hasPet and not dialogue.isOpen() and not fetchAim.isEquipped() and not activities.isBusy() and not petting.isActive() and not (State.data.quests and State.data.quests.first_fetch)
	if fetchButton.Visible then
		local keyHint = UserInputService.KeyboardEnabled and " [F]" or ""
		fetchButton.Text = `🎾 Play fetch{keyHint}`
	end
	if agilityRun then
		local t = os.clock() - agilityRun.started
		agilityLabel.Text = `Rings {agilityRun.ring}/{agilityRun.total}  ·  {string.format("%.1f", t)}s`
		agilityLabel.Visible = true
		if t > 120 then
			agilityRun = nil
		end
	end
end

-- A dog this close to you is following you, so it wraps with you. Matches
-- PetService's TELEPORT_DISTANCE: farther than that, the server re-homes it.
local PET_CARRY_DISTANCE = 45

local function ownPet(): Model?
	for _, model in CollectionService:GetTagged("Pet") do
		if model:IsA("Model") and model:GetAttribute("OwnerUserId") == player.UserId then
			return model
		end
	end
	return nil
end

-- The client owns its character's physics, so wrapping here is instant and
-- smooth. Rotation and velocity are kept so running carries straight through.
-- The client also owns its dog's physics, so the dog is moved by the same jump;
-- otherwise its AlignPosition would drag it ~500 studs across the map.
local function wrapCharacter()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not character or not hrp then
		return
	end
	local from = hrp.Position
	local wrapped = WorldBounds.wrap(from)
	if not wrapped then
		return
	end
	character:PivotTo(CFrame.new(wrapped) * hrp.CFrame.Rotation)

	local pet = ownPet()
	if pet then
		local pivot = pet:GetPivot()
		-- A dog off fetching a ball stays put; it isn't following you.
		if (pivot.Position - from).Magnitude <= PET_CARRY_DISTANCE then
			pet:PivotTo(pivot + (wrapped - from))
		end
	end
end

function WorldController.start(gui: ScreenGui, controllers)
	hud = controllers.HUD
	dialogue = controllers.Dialogue
	fetchAim = controllers.Ball
	petting = controllers.Petting
	activities = controllers.Activity
	buildWaypoint()
	buildActivityUI(gui)

	State.changed:Connect(applyBlocked)
	CollectionService:GetInstanceAddedSignal("Interactable_NPC"):Connect(function()
		task.defer(applyBlocked)
	end)
	applyBlocked()

	State.push:Connect(function(kind, payload)
		if kind == Remotes.PushKinds.Waypoint then
			override = { placeId = payload.placeId, untilTime = os.clock() + 90 }
		elseif kind == Remotes.PushKinds.Agility then
			if payload.state == "running" then
				if payload.ring == 0 or not agilityRun then
					agilityRun = { started = os.clock(), ring = payload.ring, total = payload.total }
				else
					agilityRun.ring = payload.ring
				end
			elseif payload.state == "finished" then
				agilityRun = nil
				agilityLabel.Text = `Finished in {payload.time}s!`
				agilityLabel.Visible = true
				task.delay(3, function()
					if not agilityRun then
						agilityLabel.Visible = false
					end
				end)
			end
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		wrapCharacter()
		acc += dt
		if acc >= 0.1 then
			acc = 0
			updateWaypoint()
			updateActivityUI()
		end
	end)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="81">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Sounds</string>
              <string name="Source"><![CDATA[--[[
	Sounds: small local sound effects. Uses only sounds that ship with Roblox
	(rbxasset://sounds/...), so nothing needs uploading. Custom sounds
	(barks, squeaks, chimes) would be a big upgrade: put their asset ids in
	CUSTOM and they'll be used instead.
]]

local SoundService = game:GetService("SoundService")

local Sounds = {}

local BUILTIN = {
	click = { id = "rbxasset://sounds/volume_slider.ogg", speed = 1.2, volume = 0.4 },
	chime = { id = "rbxasset://sounds/volume_slider.ogg", speed = 1.8, volume = 0.6 },
	levelup = { id = "rbxasset://sounds/volume_slider.ogg", speed = 2.4, volume = 0.7 },
	throw = { id = "rbxasset://sounds/action_jump.mp3", speed = 1.3, volume = 0.5 },
	catch = { id = "rbxasset://sounds/action_jump_land.mp3", speed = 1.2, volume = 0.6 },
	splash = { id = "rbxasset://sounds/impact_water.mp3", speed = 1.4, volume = 0.4 },
	pop = { id = "rbxasset://sounds/action_get_up.mp3", speed = 2.0, volume = 0.4 },
	pat = { id = "rbxasset://sounds/volume_slider.ogg", speed = 1.0, volume = 0.25 },
	bounce = { id = "rbxasset://sounds/action_jump_land.mp3", speed = 1.8, volume = 0.35 },
	whoosh = { id = "rbxasset://sounds/action_jump.mp3", speed = 0.9, volume = 0.4 },
	-- Placeholder: a high chirp, played twice by WhistleController. A real
	-- whistle in CUSTOM.whistle is the upgrade.
	whistle = { id = "rbxasset://sounds/volume_slider.ogg", speed = 3.2, volume = 0.8 },
}

-- Asset ids for custom sounds. Empty for now. Most wanted: bark, happy whine,
-- panting, squeaky ball, ball bounce, crunch, pat/rustle, sparkle chime.
local CUSTOM: { [string]: string } = {}

-- pitch multiplies the base playback speed (e.g. rising pops while petting).
function Sounds.play(name: string, pitch: number?)
	local spec = BUILTIN[name]
	if not spec and not CUSTOM[name] then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = CUSTOM[name] or spec.id
	s.PlaybackSpeed = (spec and spec.speed or 1) * (pitch or 1)
	s.Volume = spec and spec.volume or 0.5
	SoundService:PlayLocalSound(s)
	task.delay(3, function()
		s:Destroy()
	end)
end

return Sounds
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme: colors, fonts, and tiny helpers for building UI in code.
	Big touch targets (min 44 px) and high-contrast text for young players.
]]

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.Colors = {
	bg = Color3.fromRGB(255, 248, 236),
	panel = Color3.fromRGB(255, 255, 255),
	ink = Color3.fromRGB(52, 44, 66),
	inkSoft = Color3.fromRGB(110, 100, 125),
	orange = Color3.fromRGB(255, 140, 66),
	yellow = Color3.fromRGB(255, 209, 102),
	teal = Color3.fromRGB(46, 196, 182),
	green = Color3.fromRGB(60, 190, 110),
	blue = Color3.fromRGB(72, 149, 239),
	pink = Color3.fromRGB(255, 120, 190),
	purple = Color3.fromRGB(155, 93, 229),
	help = Color3.fromRGB(56, 128, 220),
	tip = Color3.fromRGB(232, 246, 255),
	tipInk = Color3.fromRGB(30, 80, 140),
	disabled = Color3.fromRGB(200, 196, 205),
	white = Color3.new(1, 1, 1),
}

Theme.Fonts = {
	title = Enum.Font.FredokaOne,
	body = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
}

-- new("Frame", { Size = ..., Children = { ... } })
function Theme.new(className: string, props: { [string]: any }?): Instance
	local inst = Instance.new(className)
	local children = nil
	local parent = nil
	for k, v in props or {} do
		if k == "Children" then
			children = v
		elseif k == "Parent" then
			parent = v
		else
			(inst :: any)[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.corner(radius: number?): UICorner
	return Theme.new("UICorner", { CornerRadius = UDim.new(0, radius or 14) }) :: UICorner
end

function Theme.stroke(color: Color3?, thickness: number?): UIStroke
	return Theme.new("UIStroke", {
		Color = color or Theme.Colors.ink,
		Thickness = thickness or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}) :: UIStroke
end

function Theme.padding(px: number): UIPadding
	local u = UDim.new(0, px)
	return Theme.new("UIPadding", { PaddingLeft = u, PaddingRight = u, PaddingTop = u, PaddingBottom = u }) :: UIPadding
end

function Theme.list(direction: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return Theme.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
	}) :: UIListLayout
end

function Theme.label(text: string, props: { [string]: any }?): TextLabel
	local base = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.body,
		Text = text,
		TextColor3 = Theme.Colors.ink,
		TextSize = 18,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for k, v in props or {} do
		base[k] = v
	end
	return Theme.new("TextLabel", base) :: TextLabel
end

-- A chunky, friendly button. `onClick` runs on Activated (mouse, touch, gamepad).
function Theme.button(text: string, color: Color3, onClick: () -> (), props: { [string]: any }?): TextButton
	local base = {
		AutoButtonColor = true,
		BackgroundColor3 = color,
		Font = Theme.Fonts.title,
		Text = text,
		TextColor3 = Theme.Colors.white,
		TextSize = 22,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 48),
		Children = { Theme.corner(12), Theme.stroke(color:Lerp(Color3.new(0, 0, 0), 0.25), 2) },
	}
	for k, v in props or {} do
		base[k] = v
	end
	local b = Theme.new("TextButton", base) :: TextButton
	b.Activated:Connect(onClick)
	return b
end

function Theme.pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale") or Theme.new("UIScale", { Parent = gui })
	;(scale :: UIScale).Scale = 0.85
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

return Theme
]]></string>
