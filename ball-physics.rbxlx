      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Accessories</string>
          <string name="Source"><![CDATA[--[[
	Accessories: turns an item's `visual` spec into parts welded to an
	attachment. Knows nothing about prices, ownership, or who equipped it.

	Each builder returns a list of (part, offset) pairs, where offset is
	relative to the attachment's frame.
]]

local Accessories = {}

local function newPart(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

type Piece = { part: BasePart, offset: CFrame }

local Builders: { [string]: (visual: { [string]: any }, s: number) -> { Piece } } = {}

Builders.collar = function(visual, s)
	local band = newPart({
		Name = "Collar",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.24, 1.3, 1.3) * s,
		Color = visual.color,
		Material = visual.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic,
	})
	local tag = newPart({
		Name = "Tag",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.3, 0.3, 0.3) * s,
		Color = visual.tag or Color3.fromRGB(255, 209, 102),
		Material = Enum.Material.Neon,
	})
	return {
		{ part = band, offset = CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(0, 0, 0) },
		{ part = tag, offset = CFrame.new(0, -0.62 * s, -0.25 * s) },
	}
end

Builders.party_hat = function(visual, s)
	local pieces = {}
	local tiers = { { 0.9, 0.25 }, { 0.65, 0.35 }, { 0.4, 0.6 }, { 0.2, 0.8 } }
	for i, t in tiers do
		local p = newPart({
			Name = "HatTier" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.25, t[1], t[1]) * s,
			Color = visual.color,
		})
		table.insert(pieces, { part = p, offset = CFrame.new(0, t[2] * s, 0) * CFrame.Angles(0, 0, math.rad(90)) })
	end
	local pom = newPart({ Name = "Pom", Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3) * s, Color = visual.dot or Color3.new(1, 1, 1) })
	table.insert(pieces, { part = pom, offset = CFrame.new(0, 1.0 * s, 0) })
	return pieces
end

Builders.cap = function(visual, s)
	local dome = newPart({ Name = "CapDome", Shape = Enum.PartType.Ball, Size = Vector3.new(1.15, 1.15, 1.15) * s, Color = visual.color })
	local brim = newPart({ Name = "CapBrim", Size = Vector3.new(0.9, 0.08, 0.6) * s, Color = visual.brim or visual.color })
	local button = newPart({ Name = "CapButton", Shape = Enum.PartType.Ball, Size = Vector3.new(0.18, 0.18, 0.18) * s, Color = visual.brim or Color3.new(1, 1, 1) })
	return {
		{ part = dome, offset = CFrame.new(0, -0.15 * s, 0) },
		{ part = brim, offset = CFrame.new(0, -0.12 * s, -0.75 * s) },
		{ part = button, offset = CFrame.new(0, 0.45 * s, 0) },
	}
end

Builders.vest = function(visual, s)
	local vest = newPart({ Name = "Vest", Size = Vector3.new(1.62, 0.35, 1.7) * s, Color = visual.color })
	local trim = newPart({ Name = "VestTrim", Size = Vector3.new(1.64, 0.37, 0.25) * s, Color = visual.trim or Color3.new(1, 1, 1) })
	local badge = newPart({ Name = "Badge", Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3) * s, Color = visual.trim or Color3.new(1, 1, 1), Material = Enum.Material.Neon })
	return {
		{ part = vest, offset = CFrame.new(0, -0.05 * s, 0) },
		{ part = trim, offset = CFrame.new(0, -0.05 * s, -0.4 * s) },
		{ part = badge, offset = CFrame.new(0.5 * s, 0.1 * s, 0.4 * s) },
	}
end

function Accessories.canBuild(visual: { [string]: any }?): boolean
	return visual ~= nil and Builders[visual.kind] ~= nil
end

-- Builds the visual and welds it to `attachment`. Returns the container model.
function Accessories.attach(container: Instance, attachment: Attachment, visual: { [string]: any }, scale: number?): Model?
	local builder = Builders[visual.kind]
	if not builder then
		return nil
	end
	local s = scale or 1
	local holder = Instance.new("Model")
	holder.Name = "Cosmetic"
	local base = attachment.WorldCFrame
	local anchor = attachment.Parent :: BasePart
	for _, piece in builder(visual, s) do
		piece.part.CFrame = base * piece.offset
		piece.part.Anchored = anchor.Anchored
		piece.part.Parent = holder
		local w = Instance.new("WeldConstraint")
		w.Part0 = anchor
		w.Part1 = piece.part
		w.Parent = piece.part
	end
	holder.Parent = container
	return holder
end

return Accessories
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="4">
        <Properties>
          <string name="Name">Catalogs</string>
        </Properties>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">BondCatalog</string>
            <string name="Source"><![CDATA[--[[
	BondCatalog: Bond XP, Bond Levels, what each level unlocks, and how much
	XP each kind of positive interaction gives. All balancing lives here.

	Bond never goes down. There is no decay, hunger, or sickness.

	XP sources:
	  xp        XP for one interaction
	  cooldown  seconds before this source can give XP again (the interaction
	            itself still works and still gets a happy reaction)
	  dailyCap  interactions per day that give XP. The first half give full
	            XP, the second half give half, after that 0 (still happy!)
]]

export type Unlock = {
	level: number,
	kind: "command" | "trick" | "item" | "gift",
	id: string,
	label: string,
	count: number?,
}

local BondCatalog = {}

-- Total XP needed to REACH each level (index = level).
BondCatalog.LevelXp = { 0, 40, 100, 180, 280, 400, 550, 730, 940, 1200 }
BondCatalog.MaxLevel = #BondCatalog.LevelXp

BondCatalog.Unlocks = {
	{ level = 1, kind = "command", id = "sit", label = "Sit" },
	{ level = 2, kind = "command", id = "stay", label = "Stay command" },
	{ level = 3, kind = "trick", id = "spin", label = "Spin trick" },
	{ level = 4, kind = "gift", id = "treat_pupcake", count = 2, label = "2 Pupcakes" },
	{ level = 5, kind = "trick", id = "high_five", label = "High-five trick" },
	{ level = 6, kind = "trick", id = "play_bow", label = "Play Bow trick" },
	{ level = 8, kind = "trick", id = "zoomies", label = "Zoomies (special move)" },
	{ level = 10, kind = "item", id = "collar_best_friend", label = "Best Friend Collar" },
}

BondCatalog.Sources = {
	pet = { xp = 8, cooldown = 12, dailyCap = 24 }, -- per meaningful petting session
	feed_kibble = { xp = 6, cooldown = 45, dailyCap = 12 },
	feed_treat = { xp = 10, cooldown = 6, dailyCap = 16 }, -- treats may override xp
	brush = { xp = 6, cooldown = 30, dailyCap = 10 },
	toy = { xp = 5, cooldown = 15, dailyCap = 16 },
	fetch = { xp = 5, cooldown = 0, dailyCap = 60 },
	trick = { xp = 3, cooldown = 4, dailyCap = 40 },
	groom_spa = { xp = 25, cooldown = 0, dailyCap = 8 },
	training = { xp = 15, cooldown = 0, dailyCap = 12 },
	activity = { xp = 15, cooldown = 0, dailyCap = 20 },
	care = { xp = 8, cooldown = 0, dailyCap = 12 }, -- services like Bubble Bath
}

-- (level, xpIntoLevel, xpNeededForNextLevel or nil at max)
function BondCatalog.levelFor(xp: number): (number, number, number?)
	local level = 1
	for i, need in BondCatalog.LevelXp do
		if xp >= need then
			level = i
		end
	end
	local base = BondCatalog.LevelXp[level]
	local nextNeed = BondCatalog.LevelXp[level + 1]
	return level, xp - base, nextNeed and (nextNeed - base) or nil
end

function BondCatalog.isUnlocked(level: number, kind: string, id: string): boolean
	for _, u in BondCatalog.Unlocks do
		if u.kind == kind and u.id == id then
			return level >= u.level
		end
	end
	return false
end

function BondCatalog.requiredLevel(kind: string, id: string): number?
	for _, u in BondCatalog.Unlocks do
		if u.kind == kind and u.id == id then
			return u.level
		end
	end
	return nil
end

function BondCatalog.unlocksAt(level: number): { Unlock }
	local list = {}
	for _, u in BondCatalog.Unlocks do
		if u.level == level then
			table.insert(list, u)
		end
	end
	return list
end

function BondCatalog.nextUnlock(level: number): Unlock?
	local best = nil
	for _, u in BondCatalog.Unlocks do
		if u.level > level and (best == nil or u.level < best.level) then
			best = u
		end
	end
	return best
end

-- XP actually awarded given how many times this source already paid today.
function BondCatalog.xpAfterCap(baseXp: number, countToday: number, dailyCap: number): number
	if countToday >= dailyCap then
		return 0
	elseif countToday >= math.floor(dailyCap / 2) then
		return math.ceil(baseXp / 2)
	end
	return baseXp
end

return BondCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">ItemCatalog</string>
            <string name="Source"><![CDATA[--[[
	ItemCatalog: every buyable thing, as data. Purchase, inventory, equip and
	visuals are handled generically by kind:

	  cosmetic   - owned forever, equipped into a slot (pet or player)
	  consumable - stackable, used up (treats)
	  service    - applied immediately on purchase, never stored (bubble bath)
	  bundle     - grants several items at once

	shop: which store sells it ("salon" or "treat_shop", a Places id). Items
	with unlockOnly = true can't be bought; they come from Bond Levels.

	`visual` is read only by Shared.Accessories / PetAppearanceService. Nothing
	in purchasing looks at it.
]]

export type ItemKind = "cosmetic" | "consumable" | "service" | "bundle"

export type Item = {
	id: string,
	name: string,
	description: string,
	kind: ItemKind,
	price: number,
	target: ("pet" | "player")?,
	slot: string?,
	visual: { [string]: any }?,
	contents: { string }?,
	effect: { xp: number?, mood: string? }?,
	tab: "dog" | "me" | "care" | "treats",
	shop: string?,
	unlockOnly: boolean?,
	sortOrder: number,
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local Items: { [string]: Item } = {
	-- Collars
	collar_cherry = {
		id = "collar_cherry", name = "Cherry Collar", description = "A classic red collar with a gold tag.",
		kind = "cosmetic", price = 15, target = "pet", slot = "collar", tab = "dog", sortOrder = 10,
		visual = { kind = "collar", color = rgb(230, 57, 70), tag = rgb(255, 209, 102) },
	},
	collar_sky = {
		id = "collar_sky", name = "Sky Collar", description = "Bright blue, like a sunny day.",
		kind = "cosmetic", price = 15, target = "pet", slot = "collar", tab = "dog", sortOrder = 11,
		visual = { kind = "collar", color = rgb(72, 149, 239), tag = rgb(255, 255, 255) },
	},
	collar_glow = {
		id = "collar_glow", name = "Glow Collar", description = "It sparkles!",
		kind = "cosmetic", price = 40, target = "pet", slot = "collar", tab = "dog", sortOrder = 12,
		visual = { kind = "collar", color = rgb(155, 93, 229), tag = rgb(0, 245, 212), neon = true },
	},

	-- Fur colors (a grooming upgrade you keep)
	fur_cotton_candy = {
		id = "fur_cotton_candy", name = "Cotton Candy Fur", description = "A fluffy pink makeover.",
		kind = "cosmetic", price = 30, target = "pet", slot = "fur", tab = "dog", sortOrder = 20,
		visual = { kind = "fur", color = rgb(255, 175, 204) },
	},
	fur_mint = {
		id = "fur_mint", name = "Minty Fur", description = "Cool and fresh.",
		kind = "cosmetic", price = 30, target = "pet", slot = "fur", tab = "dog", sortOrder = 21,
		visual = { kind = "fur", color = rgb(152, 245, 200) },
	},
	fur_midnight = {
		id = "fur_midnight", name = "Midnight Fur", description = "Dark blue with a starry vibe.",
		kind = "cosmetic", price = 45, target = "pet", slot = "fur", tab = "dog", sortOrder = 22,
		visual = { kind = "fur", color = rgb(58, 66, 120) },
	},

	-- Hats and outfits
	hat_party = {
		id = "hat_party", name = "Party Hat", description = "Every day is a party.",
		kind = "cosmetic", price = 25, target = "pet", slot = "head", tab = "dog", sortOrder = 30,
		visual = { kind = "party_hat", color = rgb(255, 209, 102), dot = rgb(239, 71, 111) },
	},
	hat_sun_pet = {
		id = "hat_sun_pet", name = "Pup Sun Cap", description = "Keeps the sun out of puppy eyes.",
		kind = "cosmetic", price = 20, target = "pet", slot = "head", tab = "dog", sortOrder = 31,
		visual = { kind = "cap", color = rgb(255, 214, 10), brim = rgb(255, 255, 255) },
	},
	vest_ranger = {
		id = "vest_ranger", name = "Ranger Vest", description = "Official Red Flag Ranger gear.",
		kind = "cosmetic", price = 35, target = "pet", slot = "back", tab = "dog", sortOrder = 40,
		visual = { kind = "vest", color = rgb(46, 160, 120), trim = rgb(255, 209, 102) },
	},
	leash_rope = {
		id = "leash_rope", name = "Rope Leash", description = "Walk together in style.",
		kind = "cosmetic", price = 20, target = "pet", slot = "leash", tab = "dog", sortOrder = 50,
		visual = { kind = "leash", color = rgb(239, 71, 111) },
	},

	-- Player cosmetics
	hat_sun_player = {
		id = "hat_sun_player", name = "Sun Cap", description = "A cap for you!",
		kind = "cosmetic", price = 20, target = "player", slot = "player_head", tab = "me", sortOrder = 60,
		visual = { kind = "cap", color = rgb(255, 214, 10), brim = rgb(255, 255, 255) },
	},
	bundle_sun_caps = {
		id = "bundle_sun_caps", name = "Matching Sun Caps", description = "One for you, one for your pup!",
		kind = "bundle", price = 32, tab = "me", sortOrder = 61,
		contents = { "hat_sun_player", "hat_sun_pet" },
	},

	-- Bond Level reward (not for sale)
	collar_best_friend = {
		id = "collar_best_friend", name = "Best Friend Collar", description = "Earned at Bond Level 10. You two are inseparable!",
		kind = "cosmetic", price = 0, target = "pet", slot = "collar", tab = "dog", sortOrder = 13, unlockOnly = true,
		visual = { kind = "collar", color = rgb(255, 209, 102), tag = rgb(239, 71, 111), neon = true },
	},

	-- Salon care
	groom_bubble_bath = {
		id = "groom_bubble_bath", name = "Bubble Bath", description = "Squeaky clean and extra fluffy.",
		kind = "service", price = 10, target = "pet", tab = "care", sortOrder = 71,
		effect = { mood = "sparkle" },
	},

	-- Treat Shop
	treat_biscuit = {
		id = "treat_biscuit", name = "Bone Biscuit", description = "A crunchy classic.",
		kind = "consumable", price = 5, target = "pet", tab = "treats", shop = "treat_shop", sortOrder = 80,
		effect = { xp = 10, mood = "happy" },
	},
	treat_carrot = {
		id = "treat_carrot", name = "Carrot Crunch", description = "Healthy and crunchy.",
		kind = "consumable", price = 4, target = "pet", tab = "treats", shop = "treat_shop", sortOrder = 81,
		effect = { xp = 8, mood = "happy" },
	},
	treat_pupcake = {
		id = "treat_pupcake", name = "Peanut Pupcake", description = "A special treat. Watch the tail go!",
		kind = "consumable", price = 12, target = "pet", tab = "treats", shop = "treat_shop", sortOrder = 82,
		effect = { xp = 18, mood = "love" },
	},
}

local ItemCatalog = {}
ItemCatalog.Items = Items
ItemCatalog.MaxStack = 99
ItemCatalog.DefaultShop = "salon"

-- Which store (Places id) sells this item.
function ItemCatalog.shopOf(item: Item): string
	return item.shop or ItemCatalog.DefaultShop
end

function ItemCatalog.get(id: any): Item?
	if typeof(id) ~= "string" then
		return nil
	end
	return Items[id]
end

function ItemCatalog.sorted(filter: ((Item) -> boolean)?): { Item }
	local list = {}
	for _, item in Items do
		if not filter or filter(item) then
			table.insert(list, item)
		end
	end
	table.sort(list, function(a, b)
		return a.sortOrder < b.sortOrder
	end)
	return list
end

return ItemCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">PetActions</string>
            <string name="Source"><![CDATA[--[[
	PetActions: what you can do with your dog from the interaction menu, and
	the tricks it can learn. Shared so the menu can show what's available;
	the server re-checks everything.

	  touch     the dog must be close (you can't pet a dog across the map)
	  cooldown  seconds between uses (UI shows a countdown)
	  unlock    { kind, id } from BondCatalog.Unlocks, if gated by bond level
]]

export type Action = {
	id: string,
	label: string,
	icon: string,
	touch: boolean,
	cooldown: number,
	unlock: { kind: string, id: string }?,
	submenu: string?,
	order: number,
}

export type Trick = {
	id: string,
	label: string,
	icon: string,
	duration: number,
}

local PetActions = {}

PetActions.Actions = {
	pet = { id = "pet", label = "Pet", icon = "🤚", touch = true, cooldown = 1.5, order = 1 },
	feed = { id = "feed", label = "Feed", icon = "🥣", touch = true, cooldown = 2.5, submenu = "feed", order = 2 },
	fetch = { id = "fetch", label = "Fetch", icon = "🎾", touch = false, cooldown = 0, order = 3 },
	brush = { id = "brush", label = "Brush", icon = "🪮", touch = true, cooldown = 3, order = 4 },
	sit = { id = "sit", label = "Sit", icon = "🐕", touch = false, cooldown = 0.5, order = 5 },
	stay = { id = "stay", label = "Stay", icon = "✋", touch = false, cooldown = 0.5, unlock = { kind = "command", id = "stay" }, order = 6 },
	come = { id = "come", label = "Come", icon = "📣", touch = false, cooldown = 0.5, order = 7 },
	tricks = { id = "tricks", label = "Tricks", icon = "⭐", touch = true, cooldown = 0, submenu = "tricks", order = 8 },
	-- Always on screen (WhistleController): H / gamepad D-pad Up / touch button.
	-- Works from anywhere; the dog drops whatever it's doing and runs back.
	whistle = { id = "whistle", label = "Whistle", icon = "📣", touch = false, cooldown = 1, order = 9 },
}

PetActions.Tricks = {
	spin = { id = "spin", label = "Spin", icon = "🌀", duration = 1.4 },
	high_five = { id = "high_five", label = "High-five", icon = "🖐️", duration = 1.8 },
	play_bow = { id = "play_bow", label = "Play Bow", icon = "🙇", duration = 1.8 },
	zoomies = { id = "zoomies", label = "Zoomies", icon = "💨", duration = 3.2 },
}
PetActions.TrickOrder = { "spin", "high_five", "play_bow", "zoomies" }

-- Free food is always available (basic care is never paid-only).
PetActions.FreeFood = { id = "kibble", label = "Kibble bowl", icon = "🥣", cooldown = 45 }

PetActions.TOUCH_DISTANCE = 18

function PetActions.ordered(): { Action }
	local list = {}
	for _, a in PetActions.Actions do
		table.insert(list, a)
	end
	table.sort(list, function(a, b)
		return a.order < b.order
	end)
	return list
end

return PetActions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">PetCatalog</string>
            <string name="Source"><![CDATA[--[[
	PetCatalog: PetDefinitions (breeds). Every breed shares one procedural rig
	("dog_basic", built by Shared.DogRig) and differs only by configuration.
	Adding a breed = adding an entry here.
]]

export type Breed = {
	id: string,
	displayName: string,
	description: string,
	rig: string,
	furColor: Color3,
	accentColor: Color3,
	earStyle: "floppy" | "pointy",
	scale: number,
	defaultNames: { string },
}

local Breeds: { [string]: Breed } = {
	golden = {
		id = "golden",
		displayName = "Golden Pup",
		description = "Sunny, loyal, and LOVES fetch.",
		rig = "dog_basic",
		furColor = Color3.fromRGB(230, 172, 82),
		accentColor = Color3.fromRGB(248, 220, 168),
		earStyle = "floppy",
		scale = 1,
		defaultNames = { "Sunny", "Goldie", "Biscuit" },
	},
	cocoa = {
		id = "cocoa",
		displayName = "Cocoa Lab",
		description = "Gentle, goofy, and always ready to play.",
		rig = "dog_basic",
		furColor = Color3.fromRGB(112, 74, 50),
		accentColor = Color3.fromRGB(160, 112, 80),
		earStyle = "floppy",
		scale = 1,
		defaultNames = { "Cocoa", "Mocha", "Bean" },
	},
	husky = {
		id = "husky",
		displayName = "Snowy Husky",
		description = "Fast, fluffy, and full of energy.",
		rig = "dog_basic",
		furColor = Color3.fromRGB(150, 160, 178),
		accentColor = Color3.fromRGB(250, 250, 252),
		earStyle = "pointy",
		scale = 1.05,
		defaultNames = { "Snowy", "Blizzard", "Luna" },
	},
}

local PetCatalog = {}

PetCatalog.Breeds = Breeds
PetCatalog.Order = { "golden", "cocoa", "husky" }

-- Rig conventions: every rig exposes these attachment names so cosmetics can
-- be attached without knowing anything about the breed.
PetCatalog.Slots = {
	head = { attachment = "HatAttachment", label = "Hats" },
	collar = { attachment = "CollarAttachment", label = "Collars" },
	back = { attachment = "BackAttachment", label = "Outfits" },
	leash = { attachment = "CollarAttachment", label = "Leashes" },
	fur = { attachment = nil, label = "Fur" },
}

--[[
	Optional uploaded animations, keyed by behavior state (e.g. Sitting,
	Eating, PerformingTrick). Animate the "dog_basic" rig's Motor6Ds
	(BodyJoint, Neck, Tail, LegFL/FR/BL/BR) and paste the asset ids here,
	e.g. Sitting = "rbxassetid://1234567890". Empty = procedural fallback.
]]
PetCatalog.AnimationIds = {} :: { [string]: string }

PetCatalog.NameRules = {
	minLength = 1,
	maxLength = 16,
}

function PetCatalog.get(id: string): Breed?
	return Breeds[id]
end

-- Trims and checks shape only. Text filtering happens on the server.
function PetCatalog.cleanName(raw: any): (string?, string?)
	if typeof(raw) ~= "string" then
		return nil, "Please type a name."
	end
	local name = raw:gsub("^%s+", ""):gsub("%s+$", ""):gsub("%s+", " ")
	if #name < PetCatalog.NameRules.minLength then
		return nil, "Please type a name."
	end
	if utf8.len(name) == nil or (utf8.len(name) :: number) > PetCatalog.NameRules.maxLength then
		return nil, `Names can be up to {PetCatalog.NameRules.maxLength} letters.`
	end
	if not name:match("^[%w ]+$") then
		return nil, "Use letters, numbers, and spaces only."
	end
	return name, nil
end

return PetCatalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">QuestCatalog</string>
            <string name="Source"><![CDATA[--[[
	QuestCatalog: the "Ranger Journal". Quests complete when a matching game
	event happens (see Server.Services.QuestService). They can be finished in
	any order; the HUD shows the first unfinished one as the next objective.

	completeOn.match values may be a single value or a list of allowed values.
	rewards are ActionService action lists.
]]

export type Quest = {
	id: string,
	title: string,
	hint: string,
	waypoint: string?,
	completeOn: { event: string, match: { [string]: any }? },
	rewards: { { [string]: any } },
}

local Quests: { Quest } = {
	{
		id = "adopt_dog",
		title = "Adopt a dog",
		hint = "Talk to Maya at the Pet Store.",
		waypoint = "pet_store",
		completeOn = { event = "pet.adopted" },
		rewards = { { action = "grant_currency", amount = 10, reason = "quest" } },
	},
	{
		id = "pet_dog",
		title = "Pet your dog",
		hint = "Stand still near your dog and press ✋ Pet. Then stroke!",
		completeOn = { event = "pet.interacted", match = { action = "pet" } },
		rewards = { { action = "grant_currency", amount = 5, reason = "quest" } },
	},
	{
		id = "feed_dog",
		title = "Feed your dog",
		hint = "Press 🦴 Care near your dog. Kibble is free!",
		completeOn = { event = "pet.interacted", match = { action = "feed" } },
		rewards = { { action = "grant_currency", amount = 5, reason = "quest" } },
	},
	{
		id = "first_fetch",
		title = "Play fetch at Sunny Dog Park",
		hint = "Equip the 🎾 ball, hold to wind up, release to throw!",
		waypoint = "dog_park",
		completeOn = { event = "activity.completed", match = { activityId = "fetch" } },
		rewards = { { action = "unlock_activity", activityId = "agility" } },
	},
	{
		id = "teach_sit",
		title = "Tell your dog to Sit",
		hint = "Press 🐕 Sit near your dog, then 📣 Come.",
		completeOn = { event = "pet.interacted", match = { action = "sit" } },
		rewards = { { action = "grant_currency", amount = 5, reason = "quest" } },
	},
	{
		id = "first_purchase",
		title = "Buy something at the Salon",
		hint = "Talk to Priya at Fluff & Puff.",
		waypoint = "salon",
		completeOn = { event = "item.purchased", match = { kind = { "cosmetic", "bundle" } } },
		rewards = { { action = "grant_currency", amount = 5, reason = "quest" } },
	},
	{
		id = "first_equip",
		title = "Dress up your dog",
		hint = "Open Wardrobe and equip something.",
		completeOn = { event = "item.equipped" },
		rewards = { { action = "grant_currency", amount = 5, reason = "quest" } },
	},
	{
		id = "first_agility",
		title = "Run the Agility Course",
		hint = "Step on START, pass every ring, reach the FINISH.",
		waypoint = "agility",
		completeOn = { event = "activity.completed", match = { activityId = "agility" } },
		rewards = { { action = "grant_currency", amount = 10, reason = "quest" } },
	},
	{
		id = "spa_day",
		title = "Give your dog a spa day",
		hint = "Use a grooming tub at the Fluff & Puff Salon.",
		waypoint = "salon",
		completeOn = { event = "activity.completed", match = { activityId = "grooming" } },
		rewards = { { action = "grant_currency", amount = 10, reason = "quest" } },
	},
	{
		id = "treat_shop",
		title = "Visit Bo's Treat Shop",
		hint = "Buy a treat and feed it to your dog.",
		waypoint = "treat_shop",
		completeOn = { event = "pet.interacted", match = { action = "feed", food = { "treat_biscuit", "treat_carrot", "treat_pupcake" } } },
		rewards = { { action = "grant_currency", amount = 5, reason = "quest" } },
	},
	{
		id = "trick_practice",
		title = "Practice on the training mat",
		hint = "Hit the green zone 2 out of 3 times.",
		waypoint = "agility",
		completeOn = { event = "activity.completed", match = { activityId = "trick_training" } },
		rewards = { { action = "grant_currency", amount = 10, reason = "quest" } },
	},
	{
		id = "bond_3",
		title = "Reach Bond Level 3",
		hint = "Pet, feed, play, and groom to grow your bond. Unlocks Spin!",
		completeOn = { event = "pet.levelUp", match = { level = 3 } },
		rewards = { { action = "grant_currency", amount = 15, reason = "quest" } },
	},
	{
		id = "first_trick",
		title = "Show off a trick",
		hint = "Press ⭐ Tricks near your dog.",
		completeOn = { event = "pet.interacted", match = { action = "trick" } },
		rewards = { { action = "grant_currency", amount = 10, reason = "quest" } },
	},
}

local byId = {}
for _, q in Quests do
	byId[q.id] = q
end

local QuestCatalog = {}
QuestCatalog.Ordered = Quests

function QuestCatalog.get(id: string): Quest?
	return byId[id]
end

return QuestCatalog
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DogRig</string>
          <string name="Source"><![CDATA[--[[
	DogRig: builds the one shared dog rig ("dog_basic") out of parts, so the
	game needs no uploaded assets. Used by the server (real pets, display dogs)
	and the client (adoption previews in ViewportFrames).

	Rig contract (what other systems may rely on):
	  Model.PrimaryPart = "Root" (invisible, the physics/follow part)
	  Motor6D "BodyJoint"  Root -> Body   (hop / sit)
	  Motor6D "Neck"       Body -> Head
	  Motor6D "Tail"       Body -> Tail
	  Motor6D "LegFL","LegFR","LegBL","LegBR"  Body -> legs
	  Attachments: Head.HatAttachment, Head.CollarAttachment, Body.BackAttachment,
	               Root.RootAttachment, Head.MouthAttachment
	  Parts tagged with attribute FurRole = "main" | "accent" get recolored.
	The dog faces -Z (its LookVector). Root sits 1.5 studs above the ground.
]]

local DogRig = {}

DogRig.GROUND_OFFSET = 1.5 -- Root height above the floor at scale 1

local function part(props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function motor(name: string, p0: BasePart, p1: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = c1
	m.Parent = p0
	return m
end

local function attach(parentPart: BasePart, name: string, cf: CFrame)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = cf
	a.Parent = parentPart
	return a
end

export type BuildOptions = {
	furColor: Color3,
	accentColor: Color3,
	earStyle: string?,
	scale: number?,
	anchored: boolean?,
}

function DogRig.build(opts: BuildOptions): Model
	local s = opts.scale or 1
	local fur = opts.furColor
	local accent = opts.accentColor
	local model = Instance.new("Model")
	model.Name = "Dog"

	local function v(x, y, z)
		return Vector3.new(x, y, z) * s
	end
	local function cf(x, y, z)
		return CFrame.new(x * s, y * s, z * s)
	end

	local root = part({ Name = "Root", Size = v(1.4, 1.2, 2.4), Transparency = 1, Massless = false, CastShadow = false })
	root.Parent = model
	model.PrimaryPart = root
	attach(root, "RootAttachment", CFrame.new())

	local body = part({ Name = "Body", Size = v(1.5, 1.3, 2.6), Color = fur })
	body:SetAttribute("FurRole", "main")
	body.Parent = model
	local belly = part({ Name = "Belly", Size = v(1.2, 0.3, 2.0), Color = accent })
	belly:SetAttribute("FurRole", "accent")
	belly.CFrame = body.CFrame * cf(0, -0.55, 0)
	belly.Parent = model
	weld(body, belly)
	motor("BodyJoint", root, body, CFrame.new(), CFrame.new())
	attach(body, "BackAttachment", cf(0, 0.66, 0.1))

	-- Head
	local head = part({ Name = "Head", Size = v(1.25, 1.15, 1.15), Color = fur })
	head:SetAttribute("FurRole", "main")
	head.Parent = model
	motor("Neck", body, head, cf(0, 0.55, -1.15), cf(0, -0.2, 0.4))
	head.CFrame = body.CFrame * cf(0, 0.55, -1.15) * cf(0, -0.2, 0.4):Inverse()
	attach(head, "HatAttachment", cf(0, 0.58, 0.05))
	attach(head, "CollarAttachment", cf(0, -0.5, 0.35))
	attach(head, "MouthAttachment", cf(0, -0.35, -0.95))

	local snout = part({ Name = "Snout", Size = v(0.75, 0.5, 0.6), Color = accent })
	snout:SetAttribute("FurRole", "accent")
	snout.CFrame = head.CFrame * cf(0, -0.22, -0.75)
	snout.Parent = model
	weld(head, snout)

	local nose = part({ Name = "Nose", Shape = Enum.PartType.Ball, Size = v(0.28, 0.28, 0.28), Color = Color3.fromRGB(35, 30, 35) })
	nose.CFrame = snout.CFrame * cf(0, 0.12, -0.3)
	nose.Parent = model
	weld(head, nose)

	for _, side in { -1, 1 } do
		local eye = part({ Name = "Eye", Shape = Enum.PartType.Ball, Size = v(0.24, 0.24, 0.24), Color = Color3.fromRGB(30, 25, 35) })
		eye.CFrame = head.CFrame * cf(0.3 * side, 0.18, -0.56)
		eye.Parent = model
		weld(head, eye)
		local shine = part({ Name = "EyeShine", Shape = Enum.PartType.Ball, Size = v(0.08, 0.08, 0.08), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon })
		shine.CFrame = eye.CFrame * cf(0.04, 0.05, -0.1)
		shine.Parent = model
		weld(head, shine)

		local ear
		if opts.earStyle == "pointy" then
			ear = part({ Name = "Ear",Size = v(0.2, 0.6, 0.42), Color = fur })
			ear.CFrame = head.CFrame * cf(0.38 * side, 0.75, 0.05) * CFrame.Angles(0, 0, math.rad(-12 * side))
		else
			ear = part({ Name = "Ear", Size = v(0.18, 0.8, 0.5), Color = accent })
			ear.CFrame = head.CFrame * cf(0.68 * side, 0.05, 0.05) * CFrame.Angles(0, 0, math.rad(12 * side))
		end
		ear:SetAttribute("FurRole", opts.earStyle == "pointy" and "main" or "accent")
		ear.Parent = model
		weld(head, ear)
	end

	-- Legs: pivot at the hip so the client can swing them.
	local legs = {
		LegFL = Vector3.new(-0.45, -0.5, -0.85),
		LegFR = Vector3.new(0.45, -0.5, -0.85),
		LegBL = Vector3.new(-0.45, -0.5, 0.85),
		LegBR = Vector3.new(0.45, -0.5, 0.85),
	}
	for name, hip in legs do
		local leg = part({ Name = name, Size = v(0.42, 1.0, 0.42), Color = fur })
		leg:SetAttribute("FurRole", "main")
		leg.Parent = model
		motor(name, body, leg, cf(hip.X, hip.Y, hip.Z), cf(0, 0.5, 0))
		leg.CFrame = body.CFrame * cf(hip.X, hip.Y, hip.Z) * cf(0, 0.5, 0):Inverse()
		local paw = part({ Name = "Paw", Size = v(0.46, 0.18, 0.5), Color = accent })
		paw:SetAttribute("FurRole", "accent")
		paw.CFrame = leg.CFrame * cf(0, -0.45, -0.03)
		paw.Parent = model
		weld(leg, paw)
	end

	-- Tail: pivot at the base, angled up.
	local tail = part({ Name = "Tail", Size = v(0.25, 0.25, 0.9), Color = fur })
	tail:SetAttribute("FurRole", "main")
	tail.Parent = model
	local tailC0 = cf(0, 0.45, 1.25) * CFrame.Angles(math.rad(-40), 0, 0)
	motor("Tail", body, tail, tailC0, cf(0, 0, -0.45))
	tail.CFrame = body.CFrame * tailC0 * cf(0, 0, -0.45):Inverse()
	local tip = part({ Name = "TailTip", Size = v(0.26, 0.26, 0.3), Color = accent })
	tip:SetAttribute("FurRole", "accent")
	tip.CFrame = tail.CFrame * cf(0, 0, 0.45)
	tip.Parent = model
	weld(tail, tip)

	if opts.anchored then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end

	return model
end

-- Recolor fur parts. Accent is derived when not given.
function DogRig.setFur(model: Model, main: Color3, accent: Color3?)
	local acc = accent or main:Lerp(Color3.new(1, 1, 1), 0.45)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local role = d:GetAttribute("FurRole")
			if role == "main" then
				d.Color = main
			elseif role == "accent" then
				d.Color = acc
			end
		end
	end
end

return DogRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">FrisbeeMath</string>
          <string name="Source"><![CDATA[--[[
	FrisbeeMath: flight model for a thrown flying disc. Pure and deterministic,
	so the server (which decides catches) and every client (which draws the
	disc smoothly) run the same flight from the same launch. Unit-tested.

	The model is the standard rigid-disc one used in sports-physics papers:
	  lift  = 1/2 rho v^2 A (CL0 + CLa * alpha)              (perpendicular to velocity)
	  drag  = 1/2 rho v^2 A (CD0 + CDa * (alpha - alpha0)^2)  (against velocity)
	  pitching moment = 1/2 rho v^2 A d (CM0 + CMa * alpha)
	The disc is spinning, so the pitching moment does not flip it nose-up.
	Gyroscopic precession turns it into a slow ROLL instead (rate = M / (I w)).
	For a right-handed backhand throw (clockwise spin seen from above) this
	gives the familiar flight: a slight turn right while fast, then a fade
	left as it slows down and the angle of attack grows.

	Coefficients are the ones reported for a 175 g Ultrastar-class disc
	(Hummel, 2003, "Frisbee flight simulation and throw biomechanics").
	alpha is the angle between the velocity and the disc's plane. The model
	leaves out roll/pitch damping and spin-down torque, so treat it as a good
	approximation rather than a wind-tunnel match.

	Units: the simulation runs in meters and seconds. World positions are
	origin + offset * STUDS_PER_METER. Real gravity (9.81 m/s^2), not the
	Roblox workspace gravity: a disc floats, which is the whole point.
]]

local FrisbeeMath = {}

FrisbeeMath.STUDS_PER_METER = 3 -- a 5-stud avatar is about 1.7 m tall
FrisbeeMath.DT = 1 / 60 -- fixed step: server and clients stay in sync
FrisbeeMath.MIN_SPEED = 7 -- m/s, a soft toss
FrisbeeMath.MAX_SPEED = 13 -- m/s, a strong backhand
FrisbeeMath.MIN_ELEVATION = 4 -- degrees
FrisbeeMath.MAX_ELEVATION = 22
FrisbeeMath.NOSE_UP = 3 -- degrees of extra disc pitch over the flight path
FrisbeeMath.HYZER = 8 -- degrees of bank to the left at release (normal for casual throwers)
FrisbeeMath.SPIN_RATIO = 4.5 -- spin (rad/s) per m/s of speed: an advance ratio near 0.6

local RHO = 1.23 -- air density, kg/m^3
local MASS = 0.175 -- kg
local AREA = 0.0568 -- m^2 (27 cm diameter)
local DIAMETER = 0.269 -- m
local INERTIA = 0.00235 -- kg m^2, about the spin axis
local GRAVITY = 9.81
local CL0, CLA = 0.33, 1.91
local CD0, CDA = 0.18, 0.69
local ALPHA0 = math.rad(-4)
local CM0, CMA = -0.08, 0.43
local SPIN_DECAY = 0.02 -- fraction of spin lost per second

local UP = Vector3.new(0, 1, 0)

export type Launch = {
	origin: Vector3, -- world position (studs) at release
	velocity: Vector3, -- m/s
	normal: Vector3, -- unit, the disc's "up" (top face)
	spin: number, -- rad/s
}

export type FlightState = {
	t: number,
	offset: Vector3, -- meters from origin
	velocity: Vector3, -- m/s
	normal: Vector3,
	spin: number,
}

export type PathPoint = { t: number, position: Vector3, height: number }

local function finite(n: any): boolean
	return typeof(n) == "number" and n == n and math.abs(n) < 1e6
end

local function finiteVector(v: any): boolean
	return typeof(v) == "Vector3" and finite(v.X) and finite(v.Y) and finite(v.Z)
end

-- Launch angle (degrees above horizontal) from where the player aims. Aiming
-- at the ground near you gives a flat throw; aiming at the sky, a high,
-- floaty one. `pitch` is the aim ray's angle in degrees (negative = down).
function FrisbeeMath.elevationFromPitch(pitch: any): number
	local p = finite(pitch) and pitch or -10
	return math.clamp(11 + 0.6 * (p + 8), FrisbeeMath.MIN_ELEVATION, FrisbeeMath.MAX_ELEVATION)
end

-- Horizontal unit direction from `origin` toward `target`, or `facing`.
function FrisbeeMath.flatDirection(origin: Vector3, target: any, facing: Vector3): Vector3
	if finiteVector(target) then
		local flat = Vector3.new(target.X - origin.X, 0, target.Z - origin.Z)
		if flat.Magnitude > 0.5 then
			return flat.Unit
		end
	end
	local f = Vector3.new(facing.X, 0, facing.Z)
	return if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
end

--[[
	Builds a release from player input. Everything is clamped, so the server
	can pass client values straight in.
	  direction  horizontal unit vector
	  elevation  degrees above horizontal
	  power      0..1 (how long you wound up)
]]
function FrisbeeMath.launch(origin: Vector3, direction: Vector3, elevation: any, power: any): Launch
	local p = finite(power) and math.clamp(power, 0, 1) or 0.5
	local e = math.rad(finite(elevation) and math.clamp(elevation, FrisbeeMath.MIN_ELEVATION, FrisbeeMath.MAX_ELEVATION) or 10)
	local speed = FrisbeeMath.MIN_SPEED + (FrisbeeMath.MAX_SPEED - FrisbeeMath.MIN_SPEED) * p
	local fwd = Vector3.new(direction.X, 0, direction.Z)
	fwd = if fwd.Magnitude > 0.01 then fwd.Unit else Vector3.new(0, 0, -1)
	local right = fwd:Cross(UP)
	-- Disc attitude: nose up a little more than the flight path, then banked
	-- left (hyzer) the way most right-handed backhand throws leave the hand.
	local pitch = e + math.rad(FrisbeeMath.NOSE_UP)
	local nf, nu = -math.sin(pitch), math.cos(pitch)
	local h = math.rad(FrisbeeMath.HYZER)
	local normal = (fwd * nf + UP * (nu * math.cos(h)) - right * (nu * math.sin(h))).Unit
	return {
		origin = origin,
		velocity = (fwd * math.cos(e) + UP * math.sin(e)) * speed,
		normal = normal,
		spin = FrisbeeMath.SPIN_RATIO * speed,
	}
end

function FrisbeeMath.start(launch: Launch): FlightState
	return { t = 0, offset = Vector3.zero, velocity = launch.velocity, normal = launch.normal, spin = launch.spin }
end

-- Angle of attack (radians): positive when air hits the underside.
function FrisbeeMath.angleOfAttack(velocity: Vector3, normal: Vector3): number
	local speed = velocity.Magnitude
	if speed < 1e-4 then
		return 0
	end
	return math.asin(math.clamp(-(velocity / speed):Dot(normal), -1, 1))
end

-- Advances the flight by one fixed step (semi-implicit Euler). Mutates `s`.
function FrisbeeMath.step(s: FlightState, dt: number?)
	local h = dt or FrisbeeMath.DT
	local v = s.velocity
	local speed = v.Magnitude
	local accel = Vector3.new(0, -GRAVITY, 0)
	if speed > 1e-3 then
		local vhat = v / speed
		local n = s.normal
		local alpha = math.asin(math.clamp(-vhat:Dot(n), -1, 1))
		local q = 0.5 * RHO * speed * speed * AREA
		local lift = q * (CL0 + CLA * alpha)
		local drag = q * (CD0 + CDA * (alpha - ALPHA0) ^ 2)
		local liftDir = n - vhat * n:Dot(vhat)
		if liftDir.Magnitude > 1e-4 then
			accel += liftDir.Unit * (lift / MASS)
		end
		accel -= vhat * (drag / MASS)
		-- Gyroscopic roll from the pitching moment (see header).
		local inPlane = vhat - n * vhat:Dot(n)
		if inPlane.Magnitude > 1e-4 and s.spin > 1 then
			local rollAxis = inPlane.Unit:Cross(n)
			local moment = q * DIAMETER * (CM0 + CMA * alpha)
			s.normal = (n - rollAxis * (moment / (INERTIA * s.spin)) * h).Unit
		end
	end
	s.velocity = v + accel * h
	s.offset += s.velocity * h
	s.spin *= (1 - SPIN_DECAY * h)
	s.t += h
end

function FrisbeeMath.worldPosition(launch: Launch, s: FlightState): Vector3
	return launch.origin + s.offset * FrisbeeMath.STUDS_PER_METER
end

-- Steps `s` forward until it reaches time `t` (never backward).
function FrisbeeMath.advanceTo(s: FlightState, t: number)
	local limit = 1200 -- 20 s of flight; guards against bad clocks
	while s.t + FrisbeeMath.DT <= t and limit > 0 do
		FrisbeeMath.step(s)
		limit -= 1
	end
end

-- Orientation for a Cylinder part (its round faces are on the X axis).
function FrisbeeMath.cframe(position: Vector3, s: FlightState): CFrame
	local n = s.normal
	local along = s.velocity - n * s.velocity:Dot(n)
	if along.Magnitude < 1e-4 then
		along = math.abs(n.Y) < 0.9 and UP:Cross(n) or Vector3.new(1, 0, 0):Cross(n)
	end
	along = along.Unit
	return CFrame.fromMatrix(position, n, along, n:Cross(along))
end

--[[
	Predicts the whole flight over flat ground at height `groundY` (studs).
	Returns one point every `every` steps, ending on the ground (or at maxTime).
	Used for the aiming preview and for where the dog runs to.
]]
function FrisbeeMath.predict(launch: Launch, groundY: number, maxTime: number, every: number?): { PathPoint }
	local s = FrisbeeMath.start(launch)
	local points: { PathPoint } = {}
	local n = 0
	local stride = every or 1
	while s.t < maxTime do
		FrisbeeMath.step(s)
		n += 1
		local pos = FrisbeeMath.worldPosition(launch, s)
		local height = pos.Y - groundY
		if height <= 0 then
			-- Interpolate to the ground so the landing point is exact.
			local prev = points[#points]
			local landing = pos
			if prev and prev.height > 0 then
				local f = prev.height / (prev.height - height)
				landing = prev.position:Lerp(pos, f)
			end
			table.insert(points, { t = s.t, position = Vector3.new(landing.X, groundY, landing.Z), height = 0 })
			return points
		end
		if n % stride == 0 then
			table.insert(points, { t = s.t, position = pos, height = height })
		end
	end
	return points
end

--[[
	Where should the dog run to make the catch? The earliest point along the
	predicted path that is low enough to snatch (height <= catchHeight), far
	enough from the thrower, and that the dog can reach before the disc does.
	Returns (point, reachable). If no point can be reached in time, the dog
	heads for the landing spot (reachable = false).
]]
function FrisbeeMath.pickIntercept(
	points: { PathPoint },
	dogPosition: Vector3,
	dogSpeed: number,
	reactionTime: number,
	catchHeight: number,
	minFromThrower: number
): (PathPoint?, boolean)
	local first = points[1]
	if not first then
		return nil, false
	end
	local start = first.position
	for _, p in points do
		local fromThrower = Vector3.new(p.position.X - start.X, 0, p.position.Z - start.Z).Magnitude
		if p.height <= catchHeight and fromThrower >= minFromThrower then
			local run = Vector3.new(p.position.X - dogPosition.X, 0, p.position.Z - dogPosition.Z).Magnitude
			if reactionTime + run / dogSpeed <= p.t then
				return p, true
			end
		end
	end
	return points[#points], false
end

return FrisbeeMath
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Places</string>
          <string name="Source"><![CDATA[--[[
	Places: the named areas of the world. Shared so the server can validate
	"is the player at the dog park?" and the client can draw waypoints.

	Zones are axis-aligned boxes on the ground (center + size). The world builder
	reads the same numbers, so moving an area here moves it everywhere.
]]

export type Place = {
	id: string,
	displayName: string,
	center: Vector3,
	size: Vector3,
	color: Color3,
	entrance: Vector3, -- where waypoint arrows point
}

local Places: { [string]: Place } = {
	pet_store = {
		id = "pet_store",
		displayName = "Paws & Friends Pet Store",
		center = Vector3.new(0, 0, 50),
		size = Vector3.new(48, 30, 36),
		color = Color3.fromRGB(255, 159, 67),
		entrance = Vector3.new(0, 0, 30),
	},
	ranger_station = {
		id = "ranger_station",
		displayName = "Ranger HQ",
		center = Vector3.new(24, 0, 5),
		size = Vector3.new(24, 30, 22),
		color = Color3.fromRGB(46, 160, 120),
		entrance = Vector3.new(15, 0, 5),
	},
	dog_park = {
		id = "dog_park",
		displayName = "Sunny Dog Park",
		center = Vector3.new(-90, 0, -40),
		size = Vector3.new(80, 40, 80),
		color = Color3.fromRGB(120, 200, 80),
		entrance = Vector3.new(-54, 0, -30),
	},
	salon = {
		id = "salon",
		displayName = "Fluff & Puff Salon",
		center = Vector3.new(85, 0, -30),
		size = Vector3.new(44, 30, 36),
		color = Color3.fromRGB(255, 120, 190),
		entrance = Vector3.new(60, 0, -30),
	},
	treat_shop = {
		id = "treat_shop",
		displayName = "Bo's Treat Shop",
		center = Vector3.new(-36, 0, 14),
		size = Vector3.new(24, 30, 22),
		color = Color3.fromRGB(255, 190, 90),
		entrance = Vector3.new(-22, 0, 14),
	},
	agility = {
		id = "agility",
		displayName = "Training Grounds",
		center = Vector3.new(0, 0, -120),
		size = Vector3.new(100, 40, 60),
		color = Color3.fromRGB(80, 160, 255),
		entrance = Vector3.new(0, 0, -92),
	},
	frisbee_field = {
		id = "frisbee_field",
		displayName = "Frisbee Field",
		-- East of the Training Grounds; throw from the west end toward +X.
		center = Vector3.new(104, 0, -120),
		size = Vector3.new(88, 40, 64),
		color = Color3.fromRGB(255, 90, 140),
		entrance = Vector3.new(66, 0, -120),
	},
}

local M = {}
M.All = Places

function M.get(id: string): Place?
	return Places[id]
end

-- True when a world position lies inside the place's footprint (height is generous).
function M.isInside(id: string, position: Vector3, margin: number?): boolean
	local place = Places[id]
	if not place then
		return false
	end
	local m = margin or 0
	local d = position - place.center
	return math.abs(d.X) <= place.size.X / 2 + m
		and math.abs(d.Z) <= place.size.Z / 2 + m
		and d.Y >= -10
		and d.Y <= place.size.Y + m
end

-- Which place (if any) contains this position.
function M.locate(position: Vector3): string?
	for id in Places do
		if M.isInside(id, position) then
			return id
		end
	end
	return nil
end

return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes: the only two network channels.

	  Request (RemoteFunction, client -> server):
	    Request:InvokeServer(kind, payload) -> { ok: boolean, error: string?, data: any? }
	    Every kind is validated by the server; the client never decides outcomes.

	  Push (RemoteEvent, server -> client):
	    Push:FireClient(player, kind, payload)

	The server creates the folder; the client waits for it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Remotes"

local Remotes = {}

-- Client -> server request kinds.
Remotes.RequestKinds = {
	GetState = "getState",
	Adopt = "adopt",
	Purchase = "purchase",
	Equip = "equip",
	Unequip = "unequip",
	UseItem = "useItem",
	PetAction = "petAction",
	PetEnd = "petEnd",
	FetchThrow = "fetchThrow",
	FetchReady = "fetchReady",
	FrisbeeThrow = "frisbeeThrow",
	GroomStep = "groomStep",
	ActivityCancel = "activityCancel",
	TrainPress = "trainPress",
	DialogueChoose = "dialogueChoose",
	DialogueClose = "dialogueClose",
	DialogueSafety = "dialogueSafety",
	RequestHelp = "requestHelp",
	Unblock = "unblock",
}

-- Server -> client push kinds.
Remotes.PushKinds = {
	State = "state",
	Toast = "toast",
	Dialogue = "dialogue",
	DialogueClose = "dialogueClose",
	OpenShop = "openShop",
	OpenAdoption = "openAdoption",
	Fetch = "fetch",
	Agility = "agility",
	Waypoint = "waypoint",
	Celebrate = "celebrate",
	Bond = "bond",
	Petted = "petted",
	FetchAim = "fetchAim",
	Frisbee = "frisbee",
	Grooming = "grooming",
	Training = "training",
	OpenMissions = "openMissions",
}

function Remotes.create(): (RemoteFunction, RemoteEvent)
	assert(RunService:IsServer(), "Remotes.create is server-only")
	local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME) or Instance.new("Folder")
	folder.Name = FOLDER_NAME
	local request = folder:FindFirstChild("Request") or Instance.new("RemoteFunction")
	request.Name = "Request"
	request.Parent = folder
	local push = folder:FindFirstChild("Push") or Instance.new("RemoteEvent")
	push.Name = "Push"
	push.Parent = folder
	folder.Parent = ReplicatedStorage
	return request :: RemoteFunction, push :: RemoteEvent
end

function Remotes.get(): (RemoteFunction, RemoteEvent)
	local folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	return folder:WaitForChild("Request") :: RemoteFunction, folder:WaitForChild("Push") :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">WorldBounds</string>
          <string name="Source"><![CDATA[--[[
	WorldBounds: the size of the playable floor and the wrap-around rule.

	The world wraps like Pac-Man: walking off one edge puts you on the
	opposite edge instead of falling into the void. The floor is a square
	centered at the origin with its top at Y = 0.

	TRIGGER sits just inside the edge so players wrap before they start to
	fall. LANDING is further inside than TRIGGER so a wrapped player is not
	immediately wrapped back.
]]

local WorldBounds = {}

WorldBounds.HALF_SIZE = 256
WorldBounds.TRIGGER = WorldBounds.HALF_SIZE - 2
WorldBounds.LANDING = WorldBounds.HALF_SIZE - 8
WorldBounds.RESCUE_HEIGHT = -25 -- below this Y a character is considered fallen

local function wrapAxis(v: number): (number, boolean)
	if v > WorldBounds.TRIGGER then
		return -WorldBounds.LANDING, true
	elseif v < -WorldBounds.TRIGGER then
		return WorldBounds.LANDING, true
	end
	return v, false
end

-- The wrapped position, or nil when the position is inside the map.
-- X and Z wrap independently (so corners wrap both); Y is kept.
function WorldBounds.wrap(pos: Vector3): Vector3?
	local x, wrappedX = wrapAxis(pos.X)
	local z, wrappedZ = wrapAxis(pos.Z)
	if not (wrappedX or wrappedZ) then
		return nil
	end
	return Vector3.new(x, pos.Y, z)
end

-- Where to put a character that fell below the floor: wrapped across the
-- edge it went over, otherwise straight above where it fell.
function WorldBounds.rescue(pos: Vector3): Vector3
	local p = WorldBounds.wrap(pos) or pos
	local l = WorldBounds.LANDING
	return Vector3.new(math.clamp(p.X, -l, l), 5, math.clamp(p.Z, -l, l))
end

return WorldBounds
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Red Flag Rangers server entry point.

	Every service exposes init(services) and start(). All inits run first
	(register actions, create remotes, build the world), then all starts
	(connect events, begin loops). Services reach each other through the
	shared `services` table, so there are no require cycles.
]]

local Services = script.Services
local Core = script.Core

local services = {
	Net = require(Core.Net),
	World = require(Services.WorldBuilder),
	Data = require(Services.PlayerDataService),
	Economy = require(Services.EconomyService),
	Inventory = require(Services.InventoryService),
	Appearance = require(Services.PetAppearanceService),
	Bond = require(Services.PetBondService),
	Pet = require(Services.PetService),
	Interaction = require(Services.PetInteractionService),
	Activity = require(Services.ActivityService),
	Quest = require(Services.QuestService),
	NPC = require(Services.NPCService),
	Encounter = require(Services.EncounterService),
}

local order = {
	"Net",
	"World",
	"Data",
	"Economy",
	"Inventory",
	"Appearance",
	"Bond",
	"Pet",
	"Interaction",
	"Activity",
	"Quest",
	"NPC",
	"Encounter",
}

for _, name in order do
	services[name].init(services)
end
for _, name in order do
	local start = services[name].start
	if start then
		start()
	end
end

print("[RedFlagRangers] server ready")
]]></string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Activities</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Agility</string>
            <string name="Source"><![CDATA[--[[
	Agility: the Training Grounds obstacle course. Step on START, pass rings
	1..N in order, reach FINISH. Times under the medal thresholds in
	Content/Activities earn one-time bonuses, so there's a reason to improve.

	The course is found by name inside the world (AgilityStart, AgilityFinish,
	parts with a RingIndex attribute), so builders can move pieces freely.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Agility = {}
local S, Activity
local runs: { [Player]: { started: number, nextRing: number } } = {}
local hintAt: { [Player]: number } = {}

local function hint(player: Player, text: string)
	local now = os.clock()
	if hintAt[player] and now - hintAt[player] < 3 then
		return
	end
	hintAt[player] = now
	S.Net.toast(player, text, "info")
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

local function hook(course: Instance)
	local total = 0
	for _, d in course:GetDescendants() do
		if d:GetAttribute("RingIndex") then
			total += 1
		end
	end
	local start = course:FindFirstChild("AgilityStart", true) :: BasePart?
	local finish = course:FindFirstChild("AgilityFinish", true) :: BasePart?
	if not start or not finish or total == 0 then
		warn("[Agility] course parts missing")
		return
	end
	local def = Activity.def("agility")

	start.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player or not S.Data.get(player) then
			return
		end
		local ok = Activity.canStart(player, "agility")
		if not ok then
			hint(player, "Play fetch at Sunny Dog Park first to unlock the course!")
			return
		end
		local run = runs[player]
		if run and run.nextRing > 1 and os.clock() - run.started < 60 then
			return -- mid-run; ignore stepping back on start
		end
		runs[player] = { started = os.clock(), nextRing = 1 }
		local medals = {}
		for _, m in def.medals do
			table.insert(medals, { label = m.label, under = m.under })
		end
		S.Net.push(player, Remotes.PushKinds.Agility, { state = "running", ring = 0, total = total, medals = medals })
	end)

	for _, d in course:GetDescendants() do
		local index = d:GetAttribute("RingIndex")
		if index and d:IsA("BasePart") then
			d.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				local run = player and runs[player]
				if run and run.nextRing == index then
					run.nextRing += 1
					S.Net.push(player :: Player, Remotes.PushKinds.Agility, { state = "running", ring = index, total = total })
				end
			end)
		end
	end

	finish.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local run = player and runs[player]
		if not player or not run then
			return
		end
		if run.nextRing <= total then
			hint(player, `Go through every ring first! ({run.nextRing - 1}/{total})`)
			return
		end
		local elapsed = os.clock() - run.started
		runs[player] = nil
		if elapsed < def.minSeconds then
			return
		end
		local seconds = math.floor(elapsed * 10) / 10
		S.Net.push(player, Remotes.PushKinds.Agility, { state = "finished", time = seconds, total = total })
		Activity.complete(player, "agility", { timeSeconds = seconds })
	end)
end

function Agility.init(services, activity)
	S = services
	Activity = activity
end

function Agility.start()
	local course = S.World.getAgilityCourse()
	if course then
		hook(course)
	end
	Players.PlayerRemoving:Connect(function(player)
		runs[player] = nil
		hintAt[player] = nil
	end)
end

return Agility
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Fetch</string>
            <string name="Source"><![CDATA[--[[
	Fetch: one shared, physics-based fetch game.

	The player owns a "Ball" Tool (given automatically once they have a dog).
	  Equip it         -> the dog gets excited (ToyOut attribute) and watches you
	  Hold to charge   -> the dog crouches, ready to sprint (Ready attribute)
	  Release          -> FetchThrow { target, power }

	The server launches a REAL physics ball (it bounces and rolls), lets the
	dog react for a beat, then sends it sprinting after the moving ball. The
	dog grabs it (mid-air catches are special), trots back proudly, drops it
	at your feet, and the ball pops back into your hand.

	Server authority: the server picks the launch velocity from a clamped aim
	and power, decides catches, and pays the (capped) Bond XP. Three catches
	in Sunny Dog Park complete the park challenge.

	Recovery: balls that fall out of the world, rest on a roof, or can't be
	reached in time "poof" and return to your hand. A command (Sit / Come),
	respawning, or leaving cleans everything up immediately.
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local FetchMath = require(script.Parent.Parent.Logic.FetchMath)
local Places = require(ReplicatedStorage.Shared.Places)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local MIN_THROW, MAX_THROW = 10, 46
local WORLD_HALF = 250
local CHASE_DELAY = 0.45 -- the dog watches the ball leave before sprinting
local CHASE_TIMEOUT = 9
local RETURN_TIMEOUT = 10
local TOOL_NAME = "Ball"
local BALL_GROUP, CHAR_GROUP = "FetchBall", "Characters"

local Fetch = {}
local S, Activity
local parkCatches: { [Player]: number } = {}
local streaks: { [Player]: number } = {}
local lastThrow: { [Player]: number } = {}

local function petModel(player: Player): Model?
	return S.Pet.getModel(player)
end

local function setPetAttr(player: Player, name: string, value: any)
	local model = petModel(player)
	if model then
		model:SetAttribute(name, value)
	end
end

local function toolOf(player: Player): Tool?
	local c = player.Character
	local t = (c and c:FindFirstChild(TOOL_NAME)) or player.Backpack:FindFirstChild(TOOL_NAME)
	return t and t:IsA("Tool") and t or nil
end

local function setBallInHand(player: Player, visible: boolean)
	local tool = toolOf(player)
	local handle = tool and tool:FindFirstChild("Handle") :: BasePart?
	if handle then
		handle.Transparency = visible and 0 or 1
	end
end

local function makeTool(player: Player)
	if toolOf(player) then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = "Hold to wind up, release to throw!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(0, 0, -0.2)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Shape = Enum.PartType.Ball
	handle.Size = Vector3.new(1, 1, 1)
	handle.Color = Color3.fromRGB(200, 255, 60)
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	tool.Equipped:Connect(function()
		setPetAttr(player, "ToyOut", true)
	end)
	tool.Unequipped:Connect(function()
		setPetAttr(player, "ToyOut", false)
		setPetAttr(player, "Ready", false)
	end)
	tool.Parent = player.Backpack
end

local function charGroup(character: Model)
	for _, d in character:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = CHAR_GROUP
		end
	end
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = CHAR_GROUP
		end
	end)
end

local function makeBall(position: Vector3, velocity: Vector3, owner: Player): (BasePart, Attachment)
	local ball = Instance.new("Part")
	ball.Name = "FetchBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.2, 1.2, 1.2)
	ball.Color = Color3.fromRGB(200, 255, 60)
	ball.Material = Enum.Material.SmoothPlastic
	ball.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.5, 0.62, 1, 1)
	ball.CollisionGroup = BALL_GROUP
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Position = position
	ball:SetAttribute("OwnerUserId", owner.UserId)
	local hold = Instance.new("Attachment")
	hold.Name = "BallTarget"
	-- Center of the ball: the ball spins as it rolls, so an offset would orbit.
	hold.Parent = ball
	-- Rolling resistance: without it the ball rolls forever on flat ground.
	-- A constraint (not a script loop) so it still applies while the
	-- thrower's client owns the ball's physics.
	local drag = Instance.new("AngularVelocity")
	drag.Name = "RollingResistance"
	drag.Attachment0 = hold
	drag.RelativeTo = Enum.ActuatorRelativeTo.World
	drag.AngularVelocity = Vector3.zero
	drag.Parent = ball
	ball.Parent = workspace
	drag.MaxTorque = FetchMath.rollingTorque(ball:GetMass(), ball.Size.X / 2, FetchMath.ROLL_DECEL)
	ball.AssemblyLinearVelocity = velocity
	ball.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
	pcall(function()
		ball:SetNetworkOwner(owner) -- smooth bounces for the thrower
	end)
	Debris:AddItem(ball, 45)
	return ball, hold
end

local function poof(ball: BasePart)
	local burst = Instance.new("ParticleEmitter")
	burst.Rate = 0
	burst.Speed = NumberRange.new(4, 8)
	burst.Lifetime = NumberRange.new(0.4, 0.7)
	burst.Size = NumberSequence.new(0.6, 0)
	burst.Parent = ball
	burst:Emit(18)
	ball.Anchored = true
	ball.Transparency = 1
	Debris:AddItem(ball, 1)
end

-- Height of the ground under a point. `ball` must be excluded: a colliding
-- part is always hit by raycasts (CanQuery only works on non-colliding parts).
local function groundBelow(p: Vector3, ball: BasePart?): number?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { workspace:FindFirstChild("Pets") :: Instance }
	if ball then
		table.insert(ignore, ball)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(p + Vector3.new(0, 1, 0), Vector3.new(0, -60, 0), params)
	return hit and hit.Position.Y or nil
end

-- Launch velocity that lands a ball `distance` away (flat ground) in `dir`.
local function launch(dir: Vector3, distance: number): Vector3
	local g = workspace.Gravity
	local t = 0.55 + distance / 70 -- longer throws fly a bit longer
	return dir * (distance / t) + Vector3.new(0, g * t / 2, 0)
end

function Fetch.isBusy(player: Player): boolean
	local session = Activity.current(player)
	return session ~= nil and session.id == "fetch_play"
end

function Fetch.setReady(player: Player, ready: boolean)
	if not Fetch.isBusy(player) then
		setPetAttr(player, "Ready", ready == true)
	end
end

local function done(player: Player, session, inHand: boolean)
	setPetAttr(player, "Carrying", false)
	setPetAttr(player, "Ready", false)
	Activity.finish(player, session)
	if inHand then
		setBallInHand(player, true)
	end
end

function Fetch.throw(player: Player, aim: any, power: any): (boolean, string?)
	local profile = S.Data.get(player)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not profile or not profile.activePetId or not S.Pet.getActive(player) then
		return false, "Adopt a dog first!"
	end
	if not hrp then
		return false, nil
	end
	if Fetch.isBusy(player) then
		return false, `{S.Pet.name(player)} is still on it!`
	end
	if Activity.current(player) then
		return false, "Finish what you're doing first!"
	end
	local now = os.clock()
	if lastThrow[player] and now - lastThrow[player] < 0.6 then
		return false, nil
	end
	lastThrow[player] = now

	local p = typeof(power) == "number" and power == power and math.clamp(power, 0, 1) or 0.6
	-- Aim gives the direction; how long you wound up (power) gives the distance.
	local distance = MIN_THROW + (MAX_THROW - MIN_THROW) * p
	local flat = FetchMath.clampThrow(hrp.Position, aim, hrp.CFrame.LookVector, MIN_THROW, MAX_THROW)
	local dir = Vector3.new(flat.X - hrp.Position.X, 0, flat.Z - hrp.Position.Z).Unit

	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local start = (hand and (hand :: BasePart).Position or hrp.Position + Vector3.new(0, 1.5, 0)) + dir * 1.2
	local ball: BasePart? = nil
	-- The dog chases a point ON THE GROUND under the ball, so it runs
	-- instead of flying up to meet a ball in the air.
	local chase = Instance.new("Attachment")
	chase.Name = `PetChase_{player.UserId}`
	chase.WorldPosition = hrp.Position
	chase.Parent = workspace.Terrain
	local session = Activity.begin(player, "fetch_play", function()
		if ball then
			ball:Destroy()
		end
		chase:Destroy()
		setPetAttr(player, "Carrying", false)
		setPetAttr(player, "Ready", false)
		setBallInHand(player, true)
	end)
	setBallInHand(player, false)
	local b, hold = makeBall(start, launch(dir, distance), player)
	ball = b
	S.Pet.react(player, "excited")

	task.spawn(function()
		task.wait(CHASE_DELAY)
		if Activity.current(player) ~= session then
			return
		end
		setPetAttr(player, "Ready", false)
		local pet = S.Pet.getActive(player)
		if not pet then
			Activity.interrupt(player, "no pet", session)
			return
		end
		local feet = pet.model:GetAttribute("GroundOffset") or 1.5
		local function aimChase(pos: Vector3, ground: number?)
			chase.WorldPosition = Vector3.new(pos.X, (ground or 0) + feet, pos.Z)
		end
		aimChase(b.Position, groundBelow(b.Position, b))
		local ok, _, token = S.Pet.setState(player, "Fetching", { byActivity = true, target = chase, fast = true })
		if not ok then
			Activity.interrupt(player, "no pet", session)
			return
		end

		-- Chase the moving ball.
		local t, restingHigh = 0, 0
		local caught, air, unreachable = false, false, false
		while t < CHASE_TIMEOUT do
			if not S.Pet.isCurrent(player, token) or Activity.current(player) ~= session or not b.Parent then
				Activity.interrupt(player, "interrupted", session)
				return
			end
			local pos = b.Position
			if not FetchMath.inBounds(pos, WORLD_HALF) or pos.Y < -20 then
				unreachable = true
				break
			end
			local ground = groundBelow(pos, b)
			aimChase(pos, ground)
			local slow = b.AssemblyLinearVelocity.Magnitude < 1.5
			if slow and pos.Y > 3.5 then
				restingHigh += 0.1 -- stuck on a roof, sign, or treetop
				if restingHigh > 1.2 then
					unreachable = true
					break
				end
			end
			-- Catch when the dog is under the ball and the ball is low enough
			-- to snatch (a little hop for balls still in the air).
			local flatGap = Vector3.new(pet.root.Position.X - pos.X, 0, pet.root.Position.Z - pos.Z).Magnitude
			local height = pos.Y - (ground or 0)
			if flatGap < 2.4 and height < 3.2 then
				caught = true
				air = height > 1.4
				if air then
					pet.model:SetAttribute("LeapAt", workspace:GetServerTimeNow())
				end
				break
			end
			t += task.wait(0.1)
		end

		if unreachable or not caught then
			if not unreachable and b.Parent and b.Position.Y < 3.5 then
				-- Reachable but the dog got stuck somewhere: help it over.
				local g = groundBelow(b.Position, b) or 0
				pet.model:PivotTo(CFrame.new(b.Position.X, g + feet, b.Position.Z + 1.5))
				caught = true
			else
				poof(b)
				ball = nil
				chase:Destroy()
				S.Pet.react(player, "confused")
				S.Pet.settle(player)
				streaks[player] = 0
				done(player, session, true)
				S.Net.push(player, Remotes.PushKinds.Fetch, { ready = true, lost = true, text = `Oops! {S.Pet.name(player)} can't reach that one. Here's another ball!` })
				return
			end
		end

		-- Grab it.
		b.Anchored = true
		local drag = b:FindFirstChild("RollingResistance")
		if drag then
			drag:Destroy() -- once welded it would torque the dog instead
		end
		local mouth = pet.model:FindFirstChild("MouthAttachment", true) :: Attachment?
		if mouth then
			b.Size = Vector3.new(0.8, 0.8, 0.8)
			b.CanCollide = false
			b.Massless = true
			b.CFrame = mouth.WorldCFrame
			local w = Instance.new("WeldConstraint")
			w.Part0 = mouth.Parent :: BasePart
			w.Part1 = b
			w.Parent = b
			b.Anchored = false
			b.Parent = pet.model
		end
		setPetAttr(player, "Carrying", true)
		S.Pet.react(player, air and "love" or "happy")
		S.Net.push(player, Remotes.PushKinds.Fetch, { grabbed = true, air = air })
		-- A beat to celebrate the grab before trotting back.
		local grabPos = pet.root.Position
		pet.hold.WorldPosition = grabPos
		pet.alignPosition.Attachment1 = pet.hold
		task.wait(0.4)
		if Activity.current(player) ~= session then
			return
		end

		chase:Destroy()
		local ok2, _, token2 = S.Pet.setState(player, "Returning", { byActivity = true, fast = true })
		if not ok2 then
			Activity.interrupt(player, "interrupted", session)
			return
		end
		local back = false
		local t2 = 0
		while t2 < RETURN_TIMEOUT do
			if not S.Pet.isCurrent(player, token2) or Activity.current(player) ~= session then
				Activity.interrupt(player, "interrupted", session)
				return
			end
			local h = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if h and (pet.root.Position - h.Position).Magnitude < 6 then
				back = true
				break
			end
			t2 += task.wait(0.1)
		end
		if not back then
			pet.model:PivotTo(pet.follow.WorldCFrame)
		end

		-- Drop it at your feet; it pops back into your hand.
		b.Parent = workspace
		for _, w in b:GetChildren() do
			if w:IsA("WeldConstraint") then
				w:Destroy()
			end
		end
		b.Massless = false
		b.CanCollide = true
		b.AssemblyLinearVelocity = Vector3.new(0, 6, 0)
		ball = nil
		Debris:AddItem(b, 0.8)
		S.Pet.settle(player)
		-- Proud moment: sit, look up at you, wag.
		S.Pet.setState(player, "Idle", { duration = 1.1 })
		S.Pet.react(player, "happy")
		done(player, session, false)
		task.delay(0.7, function()
			if not Fetch.isBusy(player) then
				setBallInHand(player, true)
			end
		end)

		streaks[player] = (streaks[player] or 0) + 1
		local xp = S.Bond.addXp(player, "fetch")
		local goal = Activity.def("fetch").goal
		local inPark = Activity.isAt(player, "dog_park", 4)
		if inPark then
			parkCatches[player] = (parkCatches[player] or 0) + 1
		end
		local count = parkCatches[player] or 0
		S.Net.push(player, Remotes.PushKinds.Fetch, {
			ready = true,
			caught = true,
			air = air,
			streak = streaks[player],
			xp = xp,
			count = count,
			goal = goal,
			inPark = inPark,
			done = inPark and count >= goal,
		})
		if inPark and count >= goal then
			parkCatches[player] = 0
			Activity.complete(player, "fetch")
		end
	end)
	return true, nil
end

function Fetch.init(services, activity)
	S = services
	Activity = activity
	pcall(function()
		PhysicsService:RegisterCollisionGroup(BALL_GROUP)
		PhysicsService:RegisterCollisionGroup(CHAR_GROUP)
		PhysicsService:CollisionGroupSetCollidable(BALL_GROUP, CHAR_GROUP, false)
		PhysicsService:CollisionGroupSetCollidable(BALL_GROUP, BALL_GROUP, false)
	end)
end

function Fetch.start()
	local function giveIfReady(player: Player)
		local profile = S.Data.get(player)
		if profile and profile.activePetId and player.Character then
			makeTool(player)
		end
	end
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			charGroup(character)
			task.wait(0.5)
			giveIfReady(player)
		end)
		if player.Character then
			charGroup(player.Character)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	S.Data.onLoaded(giveIfReady)
	require(script.Parent.Parent.Core.EventBus).subscribe("pet.adopted", function(player)
		task.wait(1)
		giveIfReady(player)
	end)

	S.Net.on(Remotes.RequestKinds.FetchThrow, function(player, payload)
		if typeof(payload) ~= "table" then
			return false, nil
		end
		return Fetch.throw(player, payload.target, payload.power)
	end, 0.3)
	S.Net.on(Remotes.RequestKinds.FetchReady, function(player, payload)
		Fetch.setReady(player, typeof(payload) == "table" and payload.ready == true)
		return true
	end, 0.1)
	Players.PlayerRemoving:Connect(function(player)
		parkCatches[player] = nil
		streaks[player] = nil
		lastThrow[player] = nil
	end)
end

return Fetch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Frisbee</string>
            <string name="Source"><![CDATA[--[[
	Frisbee: a catch-training game on the Frisbee Field next to the Training
	Grounds.

	  Grab a frisbee   (the stack of discs at the field's throwing line)
	    -> you get a "Frisbee" Tool; your dog runs out into the field and
	       waits, watching you
	  Hold to wind up, release to throw
	    -> FrisbeeThrow { target, pitch, power }: direction from the aim
	       point, launch angle from how high you aim, speed from the wind-up
	  The disc flies with real disc aerodynamics (Shared/FrisbeeMath): lift,
	  drag, and the gyroscopic turn-and-fade of a spinning disc.
	  Your dog reads the flight, sprints to where it will come down, and
	  leaps for it. Caught in the air: it counts. Landed first: the dog
	  still brings it back, but it doesn't count.
	  The dog trots back, drops it at your feet (it pops back into your
	  hand), then runs out again and waits for the next throw.
	  Three catches complete the game (rewards in Content/Activities).

	Server authority: the server simulates the flight with the same fixed
	step as the clients, decides catches and landings (including hitting
	trees and buildings), and pays rewards. Clients only draw the disc.

	The game ends early if you walk away from the field, whistle the dog
	back (any base command), press Stop, respawn, or leave the match.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local FetchMath = require(script.Parent.Parent.Logic.FetchMath)
local FrisbeeMath = require(ReplicatedStorage.Shared.FrisbeeMath)
local Places = require(ReplicatedStorage.Shared.Places)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ACTIVITY_ID = "frisbee"
local SESSION_ID = "frisbee_game"
local PLACE_ID = "frisbee_field"
local TOOL_NAME = "Frisbee"
local DISC_NAME = "Frisbee"
local DISC_SIZE = Vector3.new(0.3, 2.2, 2.2) -- ~2.5x a real disc so it reads on screen
local DISC_COLOR = Color3.fromRGB(255, 90, 140)

local DOG_SPEED = 30 -- studs/s, PetService's sprint (fast) speed
local REACTION = 0.35 -- the dog watches the disc leave before sprinting
local CATCH_HEIGHT = 4.2 -- studs above the ground a leaping dog can snatch
local AIM_HEIGHT = 3.4 -- the dog plans for a catch a little below its limit
local CATCH_RADIUS = 3.2
local LEAP_ABOVE = 1.6 -- catches higher than this get a leap
local MIN_FROM_THROWER = 6
local MAX_FLIGHT = 7
local PICKUP_TIMEOUT = 10
local RETURN_TIMEOUT = 12
local WAIT_DISTANCE = 22 -- how far out the dog waits for the next throw
local LEAVE_MARGIN = 30 -- walk this far outside the field and the game ends
local IDLE_TIMEOUT = 120
local WORLD_HALF = 250

type Game = {
	session: any,
	catches: number,
	throws: number,
	phase: string, -- "out" (heading out / waiting), "flight", "fetching", "returning", "done"
	disc: BasePart?,
	chase: Attachment, -- where the dog runs during a throw
	spot: Attachment, -- where the dog waits between throws
	lastDir: Vector3,
	lastActive: number,
	lastThrowAt: number,
}

local Frisbee = {}
local S, Activity
local games: { [Player]: Game } = {}

local function setPetAttr(player: Player, name: string, value: any)
	local model = S.Pet.getModel(player)
	if model then
		model:SetAttribute(name, value)
	end
end

local function toolOf(player: Player): Tool?
	local c = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack") -- gone while a player leaves
	local t = (c and c:FindFirstChild(TOOL_NAME)) or (backpack and backpack:FindFirstChild(TOOL_NAME))
	return t and t:IsA("Tool") and t or nil
end

local function setDiscInHand(player: Player, visible: boolean)
	local tool = toolOf(player)
	local handle = tool and tool:FindFirstChild("Handle") :: BasePart?
	if handle then
		handle.Transparency = visible and 0 or 1
		tool:SetAttribute("InHand", visible)
	end
end

local function discInHand(player: Player): boolean
	local tool = toolOf(player)
	return tool ~= nil and tool:GetAttribute("InHand") ~= false
end

local function makeTool(player: Player)
	if toolOf(player) then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = "Hold to wind up, release to throw! Aim higher for a floatier throw."
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- Held flat by the rim, like a backhand grip. Grip's position is where the
	-- hand sits in the handle's own space: the cylinder's round faces are on
	-- its X axis, and its +Z points back toward the arm, so (0, 0, r) is the
	-- rim nearest the hand. Just inside the radius (0.9) so the rim sits in
	-- the palm instead of the hand going through the middle of the disc.
	-- The rotation lays the disc flat (handle X = down) in the tool-hold pose.
	tool.Grip = CFrame.new(0.05, 0, 0.82) * CFrame.Angles(0, 0, math.rad(90))
	tool:SetAttribute("InHand", true)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Shape = Enum.PartType.Cylinder
	handle.Size = Vector3.new(0.25, 1.8, 1.8)
	handle.Color = DISC_COLOR
	handle.Material = Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	tool.Equipped:Connect(function()
		setPetAttr(player, "ToyOut", true)
	end)
	tool.Unequipped:Connect(function()
		setPetAttr(player, "ToyOut", false)
		setPetAttr(player, "Ready", false)
	end)
	tool.Parent = player.Backpack
end

local function removeTool(player: Player)
	local tool = toolOf(player)
	if tool then
		tool:Destroy()
	end
	setPetAttr(player, "ToyOut", false)
	setPetAttr(player, "Ready", false)
end

local function makeDisc(owner: Player, launch: FrisbeeMath.Launch, launchAt: number): BasePart
	local disc = Instance.new("Part")
	disc.Name = DISC_NAME
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = DISC_SIZE
	disc.Color = DISC_COLOR
	disc.Material = Enum.Material.SmoothPlastic
	disc.Anchored = true -- moved by the flight model, not by Roblox physics
	disc.CanCollide = false
	disc.CanQuery = false
	disc.CanTouch = false
	disc.CFrame = FrisbeeMath.cframe(launch.origin, FrisbeeMath.start(launch))
	-- Everything a client needs to replay the same flight smoothly.
	disc:SetAttribute("OwnerUserId", owner.UserId)
	disc:SetAttribute("Flying", true)
	disc:SetAttribute("LaunchAt", launchAt)
	disc:SetAttribute("LaunchOrigin", launch.origin)
	disc:SetAttribute("LaunchVelocity", launch.velocity)
	disc:SetAttribute("LaunchNormal", launch.normal)
	disc:SetAttribute("LaunchSpin", launch.spin)
	disc.Parent = workspace
	Debris:AddItem(disc, 60)
	return disc
end

local function poof(disc: BasePart)
	local burst = Instance.new("ParticleEmitter")
	burst.Rate = 0
	burst.Speed = NumberRange.new(4, 8)
	burst.Lifetime = NumberRange.new(0.4, 0.7)
	burst.Size = NumberSequence.new(0.6, 0)
	burst.Parent = disc
	burst:Emit(18)
	disc.Transparency = 1
	Debris:AddItem(disc, 1)
end

local function rayParams(extra: { Instance }?): RaycastParams
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	local pets = workspace:FindFirstChild("Pets")
	if pets then
		table.insert(ignore, pets)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	for _, d in workspace:GetChildren() do
		if d.Name == DISC_NAME or d.Name == "FetchBall" then
			table.insert(ignore, d)
		end
	end
	for _, e in extra or {} do
		table.insert(ignore, e)
	end
	params.FilterDescendantsInstances = ignore
	return params
end

local function groundBelow(p: Vector3, params: RaycastParams): number?
	local hit = workspace:Raycast(p + Vector3.new(0, 1, 0), Vector3.new(0, -60, 0), params)
	return hit and hit.Position.Y or nil
end

local function flatDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function feet(player: Player): number
	local model = S.Pet.getModel(player)
	return model and model:GetAttribute("GroundOffset") or 1.5
end

local function pushState(player: Player, match: Game, extra: { [string]: any })
	local payload = { count = match.catches, goal = Activity.def(ACTIVITY_ID).goal, throws = match.throws }
	for k, v in extra do
		payload[k] = v
	end
	S.Net.push(player, Remotes.PushKinds.Frisbee, payload)
end

-- Everything the game made goes away. Does NOT touch the dog's state:
-- the caller (completion, or the session's interrupt handler) does that.
local function cleanup(player: Player, match: Game)
	if games[player] == match then
		games[player] = nil
	end
	match.phase = "done"
	if match.disc then
		match.disc:Destroy()
		match.disc = nil
	end
	match.chase:Destroy()
	match.spot:Destroy()
	setPetAttr(player, "Carrying", false)
	setPetAttr(player, "FaceOwner", false)
	removeTool(player)
end

local function stillOn(player: Player, match: Game): boolean
	return games[player] == match and Activity.current(player) == match.session
end

-- Where the dog waits: out in front of you along your last throw, inside the field.
local function waitSpot(player: Player, match: Game): Vector3?
	local hrp = Activity.hrp(player)
	local place = Places.get(PLACE_ID)
	if not hrp or not place then
		return nil
	end
	local p = hrp.Position + match.lastDir * WAIT_DISTANCE
	local hx, hz = place.size.X / 2 - 6, place.size.Z / 2 - 6
	local x = math.clamp(p.X, place.center.X - hx, place.center.X + hx)
	local z = math.clamp(p.Z, place.center.Z - hz, place.center.Z + hz)
	local ground = groundBelow(Vector3.new(x, hrp.Position.Y + 10, z), rayParams()) or place.center.Y
	return Vector3.new(x, ground + feet(player), z)
end

-- The dog runs out into the field and waits, facing you.
local function goOut(player: Player, match: Game)
	if not stillOn(player, match) then
		return
	end
	local spot = waitSpot(player, match)
	if not spot then
		return
	end
	match.phase = "out"
	match.spot.WorldPosition = spot
	local ok, _, token = S.Pet.setState(player, "MovingToTarget", { byActivity = true, target = match.spot, fast = true })
	if not ok then
		Activity.interrupt(player, "no pet", match.session)
		return
	end
	task.spawn(function()
		-- Once there, turn around and watch the thrower.
		local t = 0
		while t < 8 and S.Pet.isCurrent(player, token) and stillOn(player, match) do
			local pet = S.Pet.getActive(player)
			if pet and flatDistance(pet.root.Position, spot) < 2.5 then
				setPetAttr(player, "FaceOwner", true)
				return
			end
			t += task.wait(0.15)
		end
	end)
end

local function finishGame(player: Player, match: Game)
	cleanup(player, match)
	Activity.finish(player, match.session)
	S.Pet.settle(player)
	S.Pet.setState(player, "Idle", { duration = 1.4 })
	S.Pet.react(player, "love")
	pushState(player, match, { state = "end", done = true })
	Activity.complete(player, ACTIVITY_ID)
end

-- One throw, start to finish: flight, catch or pickup, return, go back out.
local function runThrow(player: Player, match: Game, launch: FrisbeeMath.Launch, launchAt: number, disc: BasePart)
	local pet = S.Pet.getActive(player)
	if not pet then
		Activity.interrupt(player, "no pet", match.session)
		return
	end
	local params = rayParams({ disc })
	local fieldY = groundBelow(launch.origin, params) or 0
	local dogFeet = feet(player)
	local path = FrisbeeMath.predict(launch, fieldY, MAX_FLIGHT, 2)
	setPetAttr(player, "FaceOwner", false)
	S.Pet.react(player, "excited")

	-- Flight: step the same model the clients draw, in fixed steps.
	local s = FrisbeeMath.start(launch)
	local caught, air, landed, unreachable = false, false, false, false
	local placed = false -- disc CFrame already set where it came to rest
	local chasing = false
	local token: number? = nil
	local catchCheckAfter = 0.25
	while true do
		if not stillOn(player, match) or not disc.Parent then
			return
		end
		if token and not S.Pet.isCurrent(player, token) then
			Activity.interrupt(player, "interrupted", match.session)
			return
		end
		local now = workspace:GetServerTimeNow() - launchAt
		-- The dog reads the flight, then sprints to where it can catch it.
		if not chasing and now >= REACTION then
			chasing = true
			setPetAttr(player, "Ready", false)
			local target = FrisbeeMath.pickIntercept(path, pet.root.Position, DOG_SPEED, REACTION, AIM_HEIGHT, MIN_FROM_THROWER)
			local goal = target and target.position or FrisbeeMath.worldPosition(launch, s)
			local g = groundBelow(Vector3.new(goal.X, goal.Y + 8, goal.Z), params) or fieldY
			match.chase.WorldPosition = Vector3.new(goal.X, g + dogFeet, goal.Z)
			local ok, _, t = S.Pet.setState(player, "Fetching", { byActivity = true, target = match.chase, fast = true })
			if not ok then
				Activity.interrupt(player, "no pet", match.session)
				return
			end
			token = t
		end
		while s.t + FrisbeeMath.DT <= now and not landed do
			local before = FrisbeeMath.worldPosition(launch, s)
			FrisbeeMath.step(s)
			local after = FrisbeeMath.worldPosition(launch, s)
			local hit = workspace:Raycast(before, after - before, params)
			if hit then
				-- Ground: it lands. Anything else (tree, wall, roof): it drops.
				local ground = if hit.Normal.Y > 0.6 then hit.Position.Y else groundBelow(hit.Position - (after - before).Unit * 0.5, params)
				landed = true
				if not ground or ground > fieldY + 3.5 then
					unreachable = true
				end
				local at = hit.Position
				disc.CFrame = CFrame.new(at.X, (ground or at.Y) + DISC_SIZE.X / 2, at.Z) * CFrame.Angles(0, 0, math.rad(90))
				placed = true
				break
			end
			if not FetchMath.inBounds(after, WORLD_HALF) or after.Y < fieldY - 20 or s.t > MAX_FLIGHT then
				landed, unreachable = true, true
				break
			end
			-- No disc.CFrame write here: clients replay the flight from the
			-- launch attributes, and a replicated CFrame would fight that.
			-- Catch: the dog is under the disc and it's low enough to snatch.
			if chasing and s.t > catchCheckAfter then
				local height = after.Y - fieldY
				if height < CATCH_HEIGHT and flatDistance(pet.root.Position, after) < CATCH_RADIUS then
					caught = true
					air = true
					if height > LEAP_ABOVE then
						pet.model:SetAttribute("LeapAt", workspace:GetServerTimeNow())
					end
					break
				end
			end
		end
		if caught or landed then
			break
		end
		RunService.Heartbeat:Wait()
	end
	if not placed then
		disc.CFrame = FrisbeeMath.cframe(FrisbeeMath.worldPosition(launch, s), s)
	end
	disc:SetAttribute("Flying", false)
	match.lastActive = os.clock()

	if unreachable then
		poof(disc)
		match.disc = nil
		S.Pet.react(player, "confused")
		setDiscInHand(player, true)
		pushState(player, match, { state = "lost", text = `Oops! {S.Pet.name(player)} can't reach that one. Here's another frisbee!` })
		goOut(player, match)
		return
	end

	if landed then
		-- Missed the catch: still go get it.
		match.phase = "fetching"
		pushState(player, match, { state = "landed" })
		local spot = disc.Position
		match.chase.WorldPosition = Vector3.new(spot.X, spot.Y - DISC_SIZE.X / 2 + dogFeet, spot.Z)
		if not token then
			-- It hit something before the dog even started running.
			local ok, _, t = S.Pet.setState(player, "Fetching", { byActivity = true, target = match.chase, fast = true })
			if not ok then
				Activity.interrupt(player, "no pet", match.session)
				return
			end
			token = t
		end
		local t = 0
		while flatDistance(pet.root.Position, spot) > 2.6 do
			if not stillOn(player, match) or (token and not S.Pet.isCurrent(player, token)) then
				if stillOn(player, match) then
					Activity.interrupt(player, "interrupted", match.session)
				end
				return
			end
			if t > PICKUP_TIMEOUT then
				pet.model:PivotTo(CFrame.new(spot.X, spot.Y + dogFeet, spot.Z + 1.5))
				break
			end
			t += task.wait(0.1)
		end
	end

	-- Grab it.
	local mouth = pet.model:FindFirstChild("MouthAttachment", true) :: Attachment?
	if mouth then
		-- Flat, rim in the jaws: the mouth attachment has the head's axes (-Z
		-- forward, Y up), so turn the cylinder's face axis (X) to point up and
		-- push the disc forward by a bit less than its radius (0.825).
		disc.Size = DISC_SIZE * 0.75
		disc.CFrame = mouth.WorldCFrame * CFrame.new(0, -0.05, -0.65) * CFrame.Angles(0, 0, math.rad(90))
		local w = Instance.new("WeldConstraint")
		w.Part0 = mouth.Parent :: BasePart
		w.Part1 = disc
		w.Parent = disc
		disc.Massless = true
		disc.Anchored = false
		disc.Parent = pet.model
	end
	setPetAttr(player, "Carrying", true)
	if caught then
		match.catches += 1
		S.Pet.react(player, "love")
		pushState(player, match, { state = "caught", air = air })
	else
		S.Pet.react(player, "happy")
		pushState(player, match, { state = "grabbed" })
	end
	-- Hold still a beat to celebrate, then trot back.
	pet.hold.WorldPosition = pet.root.Position
	pet.alignPosition.Attachment1 = pet.hold
	task.wait(0.4)
	if not stillOn(player, match) then
		return
	end

	match.phase = "returning"
	local ok, _, token2 = S.Pet.setState(player, "Returning", { byActivity = true, fast = true })
	if not ok then
		Activity.interrupt(player, "interrupted", match.session)
		return
	end
	local back, t2 = false, 0
	while t2 < RETURN_TIMEOUT do
		if not S.Pet.isCurrent(player, token2) or not stillOn(player, match) then
			if stillOn(player, match) then
				Activity.interrupt(player, "interrupted", match.session)
			end
			return
		end
		local h = Activity.hrp(player)
		if h and (pet.root.Position - h.Position).Magnitude < 6 then
			back = true
			break
		end
		t2 += task.wait(0.1)
	end
	if not back then
		pet.model:PivotTo(pet.follow.WorldCFrame)
	end

	-- Drop it at your feet; it pops back into your hand.
	disc:Destroy()
	match.disc = nil
	setPetAttr(player, "Carrying", false)
	S.Pet.setState(player, "Idle", { byActivity = true })
	S.Pet.react(player, "happy")
	setDiscInHand(player, true)
	if caught then
		S.Bond.addXp(player, "fetch")
	end
	local goal = Activity.def(ACTIVITY_ID).goal
	pushState(player, match, { state = "returned", caught = caught })
	if match.catches >= goal then
		task.wait(0.5)
		if stillOn(player, match) then
			finishGame(player, match)
		end
		return
	end
	task.wait(0.7)
	goOut(player, match)
end

function Frisbee.isPlaying(player: Player): boolean
	return games[player] ~= nil
end

-- Starts a game (from the field's frisbee stack). Re-equips if one is on.
function Frisbee.startGame(player: Player): (boolean, string?)
	local existing = games[player]
	if existing and stillOn(player, existing) then
		pushState(player, existing, { state = "start" })
		return true, nil
	end
	local ok, reason = Activity.canStart(player, ACTIVITY_ID)
	if not ok then
		return false, reason
	end
	local pet = S.Pet.getActive(player)
	local hrp = Activity.hrp(player)
	if not pet or not hrp then
		return false, "Adopt a dog first!"
	end
	if Activity.current(player) then
		return false, "Finish what you're doing first!"
	end
	if not Activity.isAt(player, PLACE_ID, 6) then
		return false, "Head to the Frisbee Field to play!"
	end
	-- A dog left far away gets a lift so it doesn't run across the map.
	if S.Pet.distanceToOwner(player) > 60 then
		pet.model:PivotTo(pet.follow.WorldCFrame)
	end

	local chase = Instance.new("Attachment")
	chase.Name = `PetFrisbeeChase_{player.UserId}`
	chase.WorldPosition = hrp.Position
	chase.Parent = workspace.Terrain
	local spot = Instance.new("Attachment")
	spot.Name = `PetFrisbeeSpot_{player.UserId}`
	spot.WorldPosition = hrp.Position
	spot.Parent = workspace.Terrain

	local place = Places.get(PLACE_ID) :: Places.Place
	local match: Game
	local session = Activity.begin(player, SESSION_ID, function(reason)
		cleanup(player, match)
		-- Back to normal (a command that ended the game sets its own state right after).
		S.Pet.settle(player)
		pushState(player, match, { state = "end", reason = reason })
	end)
	match = {
		session = session,
		catches = 0,
		throws = 0,
		phase = "out",
		disc = nil,
		chase = chase,
		spot = spot,
		lastDir = FrisbeeMath.flatDirection(hrp.Position, place.center, hrp.CFrame.LookVector),
		lastActive = os.clock(),
		lastThrowAt = 0,
	}
	games[player] = match
	makeTool(player)
	pushState(player, match, { state = "start" })
	goOut(player, match)
	return true, nil
end

function Frisbee.throw(player: Player, payload: any): (boolean, string?)
	local match = games[player]
	if not match or not stillOn(player, match) then
		return false, "Grab a frisbee at the Frisbee Field first!"
	end
	local hrp = Activity.hrp(player)
	local character = player.Character
	local tool = toolOf(player)
	if not hrp or not character or not tool or tool.Parent ~= character then
		return false, nil
	end
	if match.phase ~= "out" or not discInHand(player) then
		return false, `{S.Pet.name(player)} is still on it!`
	end
	local now = os.clock()
	if now - match.lastThrowAt < 0.6 then
		return false, nil
	end
	match.lastThrowAt = now
	match.lastActive = now

	local p = typeof(payload) == "table" and payload or {}
	local dir = FrisbeeMath.flatDirection(hrp.Position, p.target, hrp.CFrame.LookVector)
	local elevation = FrisbeeMath.elevationFromPitch(p.pitch)
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local origin = (hand and (hand :: BasePart).Position or hrp.Position + Vector3.new(0, 1.5, 0)) + dir * 1.2
	local launch = FrisbeeMath.launch(origin, dir, elevation, p.power)
	local launchAt = workspace:GetServerTimeNow()

	match.throws += 1
	match.lastDir = dir
	match.phase = "flight"
	setDiscInHand(player, false)
	local disc = makeDisc(player, launch, launchAt)
	match.disc = disc
	task.spawn(runThrow, player, match, launch, launchAt, disc)
	return true, nil
end

function Frisbee.init(services, activity)
	S = services
	Activity = activity
end

function Frisbee.start()
	S.Net.on(Remotes.RequestKinds.FrisbeeThrow, function(player, payload)
		return Frisbee.throw(player, payload)
	end, 0.3)

	-- Walked away or went idle: the game ends (the dog comes back to you).
	task.spawn(function()
		while true do
			task.wait(1)
			for player, match in games do
				local hrp = Activity.hrp(player)
				local away = hrp ~= nil and not Places.isInside(PLACE_ID, hrp.Position, LEAVE_MARGIN)
				local idle = match.phase == "out" and os.clock() - match.lastActive > IDLE_TIMEOUT
				if (away or idle) and stillOn(player, match) then
					Activity.interrupt(player, away and "left" or "idle", match.session)
					S.Net.toast(player, "Frisbee game over. Grab a frisbee at the field to play again!", "info")
				end
			end
		end
	end)

	local function hook(player: Player)
		player.CharacterRemoving:Connect(function()
			local match = games[player]
			if match then
				Activity.interrupt(player, "respawn", match.session)
			end
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in Players:GetPlayers() do
		hook(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		games[player] = nil
	end)
end

return Frisbee
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Grooming</string>
            <string name="Source"><![CDATA[--[[
	Grooming: the spa minigame at the Fluff & Puff Salon.

	Walk up to a grooming tub (tagged "GroomStation") and start. The dog hops
	in, and the player clears four steps on screen: brush, wash, rinse, dry.
	The server checks the steps arrive in order and not impossibly fast, and
	that the player stays nearby. Finishing makes the dog sparkle for a few
	minutes (ShinyUntil attribute) and pays the "grooming" activity rewards.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local STEPS = { "brush", "wash", "rinse", "dry" }
local MIN_STEP_SECONDS = 1.0
local LEASH = 24
local SHINE_SECONDS = 180

local Grooming = {}
local S, Activity

local function setFx(player: Player, fx: string?)
	local model = S.Pet.getModel(player)
	if model then
		model:SetAttribute("GroomFx", fx)
	end
end

local function begin(player: Player, station: BasePart)
	local ok, reason = Activity.canStart(player, "grooming")
	if not ok then
		S.Net.toast(player, reason or "Not right now.", "info")
		return
	end
	local hrp = Activity.hrp(player)
	if not hrp or (hrp.Position - station.Position).Magnitude > 14 then
		return
	end
	local spot = station:FindFirstChild("DogSpot") :: Attachment
	local session
	session = Activity.begin(player, "grooming", function()
		setFx(player, nil)
		S.Pet.settle(player)
		S.Net.push(player, Remotes.PushKinds.Grooming, { state = "cancel" })
	end)
	session.data.step = 0
	session.data.stepAt = os.clock()
	session.data.station = station

	local moved, _, token = S.Pet.setState(player, "MovingToTarget", { byActivity = true, target = spot })
	if not moved then
		Activity.interrupt(player, "no pet")
		return
	end
	task.spawn(function()
		local pet = S.Pet.getActive(player)
		if pet and (pet.root.Position - spot.WorldPosition).Magnitude > 30 then
			-- The dog was far away (e.g. left staying elsewhere): bring it over.
			pet.model:PivotTo(CFrame.new(spot.WorldPosition + Vector3.new(4, 0, 0)))
		end
		local t = 0
		while pet and t < 4 and S.Pet.isCurrent(player, token) do
			if (pet.root.Position - spot.WorldPosition).Magnitude < 1.5 then
				break
			end
			t += task.wait(0.1)
		end
		if pet and S.Pet.isCurrent(player, token) and (pet.root.Position - spot.WorldPosition).Magnitude >= 1.5 then
			pet.model:PivotTo(CFrame.new(spot.WorldPosition)) -- hop in if it got stuck
		end
		if Activity.current(player) == session and S.Pet.isCurrent(player, token) then
			S.Pet.setState(player, "Grooming", { byActivity = true })
			-- Hold the dog in the tub (hold = where it is now).
			session.data.stepAt = os.clock()
			S.Net.push(player, Remotes.PushKinds.Grooming, { state = "start", steps = STEPS })
		end
	end)
end

local function step(player: Player, payload: any): (boolean, string?)
	local session = Activity.current(player)
	if not session or session.id ~= "grooming" or typeof(payload) ~= "table" then
		return false, nil
	end
	local n = payload.step
	if typeof(n) ~= "number" or n ~= session.data.step + 1 or n > #STEPS then
		return false, nil
	end
	local now = os.clock()
	if now - session.data.stepAt < MIN_STEP_SECONDS then
		return false, "Keep scrubbing!"
	end
	local hrp = Activity.hrp(player)
	if not hrp or (hrp.Position - session.data.station.Position).Magnitude > LEASH then
		Activity.interrupt(player, "walked away")
		return false, nil
	end
	session.data.step = n
	session.data.stepAt = now
	setFx(player, STEPS[n])
	S.Pet.react(player, n == #STEPS and "sparkle" or "happy")

	if n == #STEPS then
		Activity.finish(player, session)
		local model = S.Pet.getModel(player)
		if model then
			model:SetAttribute("ShinyUntil", workspace:GetServerTimeNow() + SHINE_SECONDS)
		end
		task.delay(1.2, function()
			setFx(player, nil)
		end)
		S.Pet.settle(player)
		S.Net.push(player, Remotes.PushKinds.Grooming, { state = "done" })
		Activity.complete(player, "grooming")
	end
	return true, nil
end

function Grooming.init(services, activity)
	S = services
	Activity = activity
end

function Grooming.start()
	local function setup(station: Instance)
		if not station:IsA("BasePart") or station:FindFirstChild("GroomPrompt") then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "GroomPrompt"
		prompt.ActionText = "Spa time"
		prompt.ObjectText = "Grooming Tub"
		prompt.HoldDuration = 0.25
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = station
		prompt.Triggered:Connect(function(player)
			begin(player, station)
		end)
	end
	CollectionService:GetInstanceAddedSignal("GroomStation"):Connect(setup)
	for _, s in CollectionService:GetTagged("GroomStation") do
		setup(s)
	end
	S.Net.on(Remotes.RequestKinds.GroomStep, step, 0.2)

	-- Walking away ends the spa session.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local session = Activity.current(player)
				if session and session.id == "grooming" then
					local hrp = Activity.hrp(player)
					if not hrp or (hrp.Position - session.data.station.Position).Magnitude > LEASH then
						Activity.interrupt(player, "walked away")
					end
				end
			end
		end
	end)
end

return Grooming
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Props</string>
            <string name="Source"><![CDATA[--[[
	Props: interactive world objects, found by CollectionService tag so
	builders can place more of them anywhere.

	  FetchStation  "Grab a ball": starts the shared fetch aiming mode
	  FrisbeeStation "Grab a frisbee": starts the Frisbee Field catch game
	  PetToy        "Squeaky toy": the dog pounces and plays (Bond XP)
	  MissionBoard  "Missions": opens the Ranger Journal
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EventBus = require(script.Parent.Parent.Core.EventBus)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Props = {}
local S, Activity

local function near(player: Player, part: BasePart, distance: number): boolean
	local hrp = Activity.hrp(player)
	return hrp ~= nil and (hrp.Position - part.Position).Magnitude <= distance
end

local HANDLERS = {
	FetchStation = {
		action = "Grab a ball",
		object = "Ball Bucket",
		run = function(player: Player)
			if not S.Pet.getActive(player) then
				S.Net.toast(player, "Adopt a dog first!", "info")
				return
			end
			S.Net.push(player, Remotes.PushKinds.FetchAim)
		end,
	},
	FrisbeeStation = {
		action = "Grab a frisbee",
		object = "Frisbees",
		run = function(player: Player)
			local ok, reason = Activity.Frisbee.startGame(player)
			if not ok and reason then
				S.Net.toast(player, reason, "info")
			end
		end,
	},
	PetToy = {
		action = "Play",
		object = "Squeaky Toy",
		run = function(player: Player, part: BasePart)
			if not S.Pet.getActive(player) then
				S.Net.toast(player, "Adopt a dog first!", "info")
				return
			end
			if Activity.current(player) then
				return
			end
			if S.Pet.distanceToOwner(player) > 24 then
				S.Net.toast(player, "Call your dog over first!", "info")
				return
			end
			local ok = S.Pet.setState(player, "PerformingTrick", { trick = "play_toy", duration = 2.4 })
			if ok then
				S.Pet.react(player, "happy")
				S.Bond.addXp(player, "toy")
				EventBus.publish("pet.interacted", player, { action = "toy" })
				-- A little squish so everyone sees the toy being played with.
				local original = part.Size
				part.Size = original * Vector3.new(1.2, 0.7, 1.2)
				task.delay(0.25, function()
					part.Size = original
				end)
			end
		end,
	},
	MissionBoard = {
		action = "Missions",
		object = "Mission Board",
		run = function(player: Player)
			S.Net.push(player, Remotes.PushKinds.OpenMissions)
		end,
	},
}

function Props.init(services, activity)
	S = services
	Activity = activity
end

function Props.start()
	for tag, handler in HANDLERS do
		local function setup(part: Instance)
			if not part:IsA("BasePart") or part:FindFirstChild("PropPrompt") then
				return
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "PropPrompt"
			prompt.ActionText = handler.action
			prompt.ObjectText = handler.object
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt.Parent = part
			prompt.Triggered:Connect(function(player)
				if near(player, part, 16) then
					handler.run(player, part)
				end
			end)
		end
		CollectionService:GetInstanceAddedSignal(tag):Connect(setup)
		for _, p in CollectionService:GetTagged(tag) do
			setup(p)
		end
	end
end

return Props
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">TrickTraining</string>
            <string name="Source"><![CDATA[--[[
	TrickTraining: a timing game on the Training Grounds' training mat.

	Three rounds. A marker sweeps across a bar; press when it's in the green
	zone. The SERVER decides hits from its own clock (with a small allowance
	for the player's ping), so clients can't fake success. Two hits out of
	three = success: the dog performs the move and the activity pays out.

	Difficulty rises with each completion (narrower zone, faster marker).
	Moves practiced: "sit" for everyone, plus every trick the dog has
	unlocked through Bond Levels.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BondCatalog = require(ReplicatedStorage.Shared.Catalogs.BondCatalog)
local PetActions = require(ReplicatedStorage.Shared.Catalogs.PetActions)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ROUNDS = 3
local NEEDED = 2
local LEASH = 22
local SLACK = 0.05 -- extra zone width to forgive tiny timing differences

local Training = {}
local S, Activity

local function movesFor(player: Player): { { id: string, label: string } }
	local moves = { { id = "sit", label = "Sit" } }
	local level = S.Bond.level(player)
	for _, id in PetActions.TrickOrder do
		if BondCatalog.isUnlocked(level, "trick", id) then
			table.insert(moves, { id = id, label = PetActions.Tricks[id].label })
		end
	end
	return moves
end

local function startRound(player: Player, session)
	local d = session.data
	d.round += 1
	d.pressed = false
	d.startAt = workspace:GetServerTimeNow() + 0.6
	local width = d.width
	d.zoneStart = 0.2 + math.random() * (0.75 - width)
	d.zoneEnd = d.zoneStart + width
	S.Net.push(player, Remotes.PushKinds.Training, {
		state = "round",
		round = d.round,
		rounds = ROUNDS,
		move = d.move.label,
		zoneStart = d.zoneStart,
		zoneEnd = d.zoneEnd,
		period = d.period,
		startAt = d.startAt,
	})
	local round = d.round
	-- No press in time counts as a miss.
	task.delay(0.6 + d.period * 3, function()
		if Activity.current(player) == session and d.round == round and not d.pressed then
			Training.press(player, true)
		end
	end)
end

local function finishSession(player: Player, session)
	local d = session.data
	Activity.finish(player, session)
	local success = d.hits >= NEEDED
	S.Net.push(player, Remotes.PushKinds.Training, { state = "done", success = success, hits = d.hits, rounds = ROUNDS })
	if success then
		if d.move.id == "sit" then
			S.Pet.setState(player, "Sitting", { force = true })
			task.delay(1.5, function()
				local state = S.Pet.getState(player)
				if state == "Sitting" then
					S.Pet.setState(player, "Following", { force = true })
				end
			end)
		else
			S.Pet.setState(player, "PerformingTrick", { force = true, trick = d.move.id, duration = PetActions.Tricks[d.move.id].duration })
		end
		Activity.complete(player, "trick_training")
	else
		S.Pet.settle(player)
		S.Net.toast(player, `So close! {S.Pet.name(player)} wants to try again.`, "info")
	end
end

-- Called by the TrainPress request (or by the timeout with missed = true).
function Training.press(player: Player, missed: boolean?): (boolean, string?)
	local session = Activity.current(player)
	if not session or session.id ~= "trick_training" then
		return false, nil
	end
	local d = session.data
	if d.pressed then
		return false, nil
	end
	d.pressed = true
	local hit = false
	if not missed then
		local ping = math.clamp(player:GetNetworkPing(), 0, 0.4)
		local t = workspace:GetServerTimeNow() - ping - d.startAt
		if t >= 0 then
			local pos = (t / d.period) % 1
			hit = pos >= d.zoneStart - SLACK and pos <= d.zoneEnd + SLACK
		end
	end
	if hit then
		d.hits += 1
		S.Pet.react(player, "happy")
	end
	S.Net.push(player, Remotes.PushKinds.Training, { state = "result", hit = hit, round = d.round })
	task.delay(1.1, function()
		if Activity.current(player) ~= session then
			return
		end
		if d.round >= ROUNDS then
			finishSession(player, session)
		else
			startRound(player, session)
		end
	end)
	return true, nil
end

local function begin(player: Player, mat: BasePart)
	local ok, reason = Activity.canStart(player, "trick_training")
	if not ok then
		S.Net.toast(player, reason or "Not right now.", "info")
		return
	end
	local hrp = Activity.hrp(player)
	if not hrp or (hrp.Position - mat.Position).Magnitude > 14 then
		return
	end
	local profile = S.Data.get(player)
	local done = profile and profile.activities.trick_training and profile.activities.trick_training.count or 0
	local tier = math.min(done, 4)
	local moves = movesFor(player)

	local session = Activity.begin(player, "trick_training", function()
		S.Net.push(player, Remotes.PushKinds.Training, { state = "cancel" })
		S.Pet.settle(player)
	end)
	session.data = {
		round = 0,
		hits = 0,
		pressed = false,
		move = moves[math.random(1, #moves)],
		width = math.max(0.12, 0.3 - 0.045 * tier),
		period = math.max(0.95, 1.6 - 0.15 * tier),
		mat = mat,
	}
	S.Pet.setState(player, "Idle", { force = true })
	S.Net.push(player, Remotes.PushKinds.Training, { state = "start", tier = tier + 1, move = session.data.move.label })
	startRound(player, session)
end

function Training.init(services, activity)
	S = services
	Activity = activity
end

function Training.start()
	local function setup(mat: Instance)
		if not mat:IsA("BasePart") or mat:FindFirstChild("TrainPrompt") then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "TrainPrompt"
		prompt.ActionText = "Practice tricks"
		prompt.ObjectText = "Training Mat"
		prompt.HoldDuration = 0.25
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = mat
		prompt.Triggered:Connect(function(player)
			begin(player, mat)
		end)
	end
	CollectionService:GetInstanceAddedSignal("TrainingMat"):Connect(setup)
	for _, m in CollectionService:GetTagged("TrainingMat") do
		setup(m)
	end
	S.Net.on(Remotes.RequestKinds.TrainPress, function(player)
		local session = Activity.current(player)
		local hrp = Activity.hrp(player)
		if session and session.id == "trick_training" and (not hrp or (hrp.Position - session.data.mat.Position).Magnitude > LEASH) then
			Activity.interrupt(player, "walked away")
			return false, nil
		end
		return Training.press(player, false)
	end, 0.2)
end

return Training
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Content</string>
          <string name="Source"><![CDATA[--[[
	Content index: everything writers/reviewers edit lives in this folder.
	Validated at server start (see EncounterService) and in tests.
]]

local encountersModule = require(script.Encounters)

local encounters = {}
for id, def in encountersModule do
	if id ~= "SafetyFeedback" then
		encounters[id] = def
	end
end

return {
	npcs = require(script.NPCs),
	arcs = require(script.StoryArcs),
	encounters = encounters,
	safetyFeedback = encountersModule.SafetyFeedback,
}
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Activities</string>
            <string name="Source"><![CDATA[--[[
	ActivityDefinitions: rewards and rules for every activity. The mechanics
	(how fetch or grooming actually plays) live in Server/Activities/*; this
	file is only the data, so balancing never touches game code.

	  location        Places id where the activity counts (optional)
	  requires        Conditions (see Logic.Conditions) to start it
	  rewards.coins   Paw Coins per completion
	  rewards.firstBonus  extra coins the very first time (claimed once)
	  rewards.bond    BondCatalog source for Bond XP
	  rewardCooldown  seconds after a paid completion before coins pay again
	                  (stops reward loops; the activity still works)
	  medals          optional time-based bonus tiers (each claimed once)
]]

return {
	fetch = {
		id = "fetch",
		name = "Fetch",
		location = "dog_park",
		goal = 3, -- catches in the park for one completion
		requires = { { type = "hasPet" } },
		rewards = { coins = 8, firstBonus = 17, bond = "activity" },
		rewardCooldown = 20,
	},
	frisbee = {
		id = "frisbee",
		name = "Frisbee Catch",
		location = "frisbee_field",
		goal = 3, -- mid-air catches for one completion
		requires = { { type = "hasPet" } },
		rewards = { coins = 8, firstBonus = 17, bond = "activity" }, -- same as fetch
		rewardCooldown = 20,
	},
	agility = {
		id = "agility",
		name = "Agility Course",
		location = "agility",
		minSeconds = 6,
		requires = { { type = "hasPet" }, { type = "unlocked", activityId = "agility" } },
		rewards = { coins = 12, firstBonus = 18, bond = "activity" },
		rewardCooldown = 10,
		medals = {
			{ id = "gold", label = "Gold", under = 16, bonus = 15 },
			{ id = "silver", label = "Silver", under = 24, bonus = 8 },
		},
	},
	grooming = {
		id = "grooming",
		name = "Spa Day",
		location = "salon",
		requires = { { type = "hasPet" } },
		rewards = { coins = 6, firstBonus = 14, bond = "groom_spa" },
		rewardCooldown = 30,
	},
	trick_training = {
		id = "trick_training",
		name = "Trick Training",
		location = "agility",
		requires = { { type = "hasPet" } },
		rewards = { coins = 5, firstBonus = 10, bond = "training" },
		rewardCooldown = 10,
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Encounters</string>
            <string name="Source"><![CDATA[--[[
	EncounterDefinitions: all NPC dialogue, as reviewed, predefined data.
	No generated text, no free-form chat.

	ALL EDUCATIONAL TEXT IS PROVISIONAL until reviewed by Present Age Ministries.
	Each encounter carries `curriculum.reviewStatus` so reviewers can track it.

	Text may use {petName}. speaker "npc" = the NPC talking; "tip" = a short,
	gentle Ranger Tip card (never a lecture, never a score).
]]

local PROVISIONAL = "provisional"

local Encounters = {}

----------------------------------------------------------------------------
-- Jordan's story arc (see StoryArcs.jordan_arc)
----------------------------------------------------------------------------

Encounters.jordan_e1_park = {
	id = "jordan_e1_park",
	npcId = "jordan",
	arcId = "jordan_arc",
	conditions = {
		{ type = "atLocation", locationId = "dog_park" },
		{ type = "activityCompleted", activityId = "fetch", min = 1 },
	},
	start = "hello",
	curriculum = { program = "none", note = "Ordinary friendly meeting. No warning signs.", reviewStatus = PROVISIONAL },
	nodes = {
		hello = {
			speaker = "npc",
			text = "Whoa, nice throw! Your dog is super fast.",
			choices = {
				{ id = "intro", text = "Thanks! This is {petName}.", next = "intro" },
				{ id = "thanks", text = "Thanks!", next = "intro" },
			},
		},
		intro = {
			speaker = "npc",
			text = "Hi, {petName}! I'm Jordan. I come here all the time to watch the dogs. If you like fetch, you'd love the Agility Course!",
			choices = {
				{ id = "cool", text = "Cool, I'll check it out!", outcome = "friendly", actions = { { action = "pet_react", mood = "happy" } } },
				{ id = "later", text = "Maybe later.", outcome = "friendly" },
			},
		},
	},
}

Encounters.jordan_e2_agility = {
	id = "jordan_e2_agility",
	npcId = "jordan",
	arcId = "jordan_arc",
	conditions = {
		{ type = "atLocation", locationId = "agility" },
		{ type = "activityCompleted", activityId = "agility", min = 1 },
	},
	start = "again",
	curriculum = { program = "none", note = "Builds familiarity through normal play.", reviewStatus = PROVISIONAL },
	nodes = {
		again = {
			speaker = "npc",
			text = "Hey, it's you and {petName} again! I saw that run. You two are awesome.",
			choices = {
				{ id = "thanks", text = "Thanks, Jordan!", next = "cheer" },
				{ id = "watching", text = "You were watching?", next = "watching" },
			},
		},
		watching = {
			speaker = "npc",
			text = "Ha, yeah! I hang out here a lot. You're getting really good.",
			choices = {
				{ id = "thanks", text = "Thanks!", next = "cheer" },
			},
		},
		cheer = {
			speaker = "npc",
			text = "Try one more run! I'll cheer for you.",
			choices = {
				{ id = "ok", text = "Okay!", outcome = "friendly", actions = { { action = "pet_react", mood = "happy" } } },
				{ id = "later", text = "Maybe later.", outcome = "friendly" },
			},
		},
	},
}

Encounters.jordan_e3_boundary = {
	id = "jordan_e3_boundary",
	npcId = "jordan",
	arcId = "jordan_arc",
	conditions = {
		{ type = "activitiesSinceStage", min = 1 },
	},
	start = "flattery",
	onWalkAway = "tip_leave",
	completeOnSafetyTool = true,
	curriculum = {
		program = "The Illusion of Love; A Child's Choice",
		warningSigns = { "off_platform", "secrecy", "special_attention", "persistence" },
		objectives = {
			"A friendly history does not create an obligation to say yes.",
			"Requests to switch apps and keep secrets are signs to pause and get help.",
			"Saying no, leaving, blocking, reporting, and asking a trusted adult are all okay.",
		},
		reviewStatus = PROVISIONAL,
	},
	nodes = {
		flattery = {
			speaker = "npc",
			text = "Honestly? You're the coolest person here. I like hanging out with you way more than anyone else.",
			choices = {
				{ id = "aw", text = "Aw, thanks!", next = "ask" },
				{ id = "ok", text = "Um, okay...", next = "ask" },
			},
		},
		ask = {
			speaker = "npc",
			text = "Let's talk on Snapchat instead. It's way easier. But keep it just between us, okay? Don't tell any grown-ups.",
			choices = {
				{
					id = "decline",
					text = "No thanks. I'd rather play here.",
					next = "pushback",
					actions = { { action = "record_learning", topic = "off_platform" } },
				},
				{
					id = "agree",
					text = "Um... okay, I guess.",
					next = "reconsider",
					actions = { { action = "set_arc_flag", key = "agreed_at_first", value = true } },
				},
				{ id = "unsure", text = "I'm not sure...", next = "reconsider" },
				{ id = "go", text = "I have to go.", next = "tip_leave" },
			},
		},
		pushback = {
			speaker = "npc",
			text = "Come on, I thought we were friends. It's not a big deal.",
			choices = {
				{ id = "firm", text = "I said no.", next = "jordan_fine" },
				{ id = "go", text = "I have to go.", next = "tip_leave" },
			},
		},
		jordan_fine = {
			speaker = "npc",
			text = "...Fine. Whatever.",
			choices = {
				{ id = "continue", text = "(Keep playing)", next = "tip_decline" },
			},
		},
		tip_decline = {
			speaker = "tip",
			text = "A good friend respects your boundaries. You said no, and you didn't have to explain why. Being asked to keep secrets from grown-ups is a sign to tell a trusted adult.",
			choices = {
				{ id = "got_it", text = "Got it", outcome = "declined", actions = { { action = "pet_react", mood = "love" } } },
				{
					id = "help",
					text = "Talk to a trusted adult",
					outcome = "declined",
					actions = { { action = "open_help" } },
				},
			},
		},
		reconsider = {
			speaker = "tip",
			text = "Hmm. Jordan asked you to switch apps AND keep it secret from grown-ups. It's okay to change your mind, even after saying yes.",
			choices = {
				{ id = "change", text = "Actually, no thanks.", next = "jordan_fine", actions = { { action = "record_learning", topic = "off_platform" } } },
				{ id = "help", text = "I'll ask a trusted adult first.", outcome = "sought_help", actions = { { action = "open_help" } } },
				{ id = "think", text = "I need to think.", next = "tip_leave" },
			},
		},
		tip_leave = {
			speaker = "tip",
			text = "Walking away is always okay. You don't owe anyone an answer. If someone asks you to keep secrets or move to another app, tell a trusted adult.",
			choices = {
				{ id = "okay", text = "Okay", outcome = "left", actions = { { action = "pet_react", mood = "love" } } },
				{ id = "help", text = "Talk to a trusted adult", outcome = "left", actions = { { action = "open_help" } } },
			},
		},
	},
	onComplete = {
		{ action = "record_learning", topic = "secrecy" },
		{ action = "record_learning", topic = "special_attention" },
	},
}

----------------------------------------------------------------------------
-- Riley: a healthy friendship. Riley takes "no" for an answer.
----------------------------------------------------------------------------

Encounters.riley_hi = {
	id = "riley_hi",
	npcId = "riley",
	conditions = { { type = "hasPet" } },
	start = "hi",
	curriculum = { program = "Discovering Your Value", note = "Models a friend who respects a no.", reviewStatus = PROVISIONAL },
	nodes = {
		hi = {
			speaker = "npc",
			text = "Hi! I'm Riley. Is that your dog? So cute!",
			choices = {
				{ id = "yes", text = "Yep! This is {petName}.", next = "race" },
				{ id = "hi", text = "Hi, Riley!", next = "race" },
			},
		},
		race = {
			speaker = "npc",
			text = "Want to race our dogs to the big tree?",
			choices = {
				{ id = "sure", text = "Sure!", next = "raced" },
				{ id = "no", text = "Not right now.", next = "respect" },
			},
		},
		raced = {
			speaker = "npc",
			text = "Ha! {petName} won! Good game!",
			choices = {
				{ id = "gg", text = "Good game!", outcome = "friendly", actions = { { action = "pet_react", mood = "happy" } } },
			},
		},
		respect = {
			speaker = "npc",
			text = "No problem! Maybe another time. Have fun!",
			choices = {
				{ id = "bye", text = "You too!", outcome = "friendly" },
			},
		},
	},
}

Encounters.riley_again = {
	id = "riley_again",
	npcId = "riley",
	repeatable = true,
	conditions = { { type = "not", condition = { type = "hasPet" } } },
	start = "hi",
	nodes = {
		hi = {
			speaker = "npc",
			text = "Hi! You should adopt a dog at the Pet Store. Then we can play!",
			choices = { { id = "ok", text = "Okay!" } },
		},
	},
}

----------------------------------------------------------------------------
-- Helpers around the world
----------------------------------------------------------------------------

Encounters.maya_chat = {
	id = "maya_chat",
	npcId = "maya",
	repeatable = true,
	conditions = { { type = "hasPet" } },
	start = "hi",
	nodes = {
		hi = {
			speaker = "npc",
			text = "How's {petName} doing? The Dog Park is to the left when you walk out. Dogs love fetch!",
			choices = { { id = "great", text = "Great!", actions = { { action = "pet_react", mood = "happy" } } } },
		},
	},
}

Encounters.coach_locked = {
	id = "coach_locked",
	npcId = "coach_sam",
	repeatable = true,
	conditions = { { type = "not", condition = { type = "unlocked", activityId = "agility" } } },
	start = "hi",
	nodes = {
		hi = {
			speaker = "npc",
			text = "Welcome! Warm up with a game of fetch at Sunny Dog Park first, then come back and run the course.",
			choices = { { id = "ok", text = "Will do!", actions = { { action = "show_waypoint", placeId = "dog_park" } } } },
		},
	},
}

Encounters.coach_intro = {
	id = "coach_intro",
	npcId = "coach_sam",
	repeatable = true,
	start = "hi",
	nodes = {
		hi = {
			speaker = "npc",
			text = "Welcome to the Training Grounds! Run the course: START pad, every ring, then the checkered FINISH. Or practice tricks with {petName} on the training mat. The better you two get, the harder I'll make it!",
			choices = {
				{ id = "go", text = "Let's run the course!", actions = { { action = "pet_react", mood = "happy" } } },
				{ id = "tricks", text = "How do tricks work?", next = "tricks" },
			},
		},
		tricks = {
			speaker = "npc",
			text = "Spend time with {petName}: pet, feed, play, groom. Your Bond Level goes up and new tricks unlock. Spin comes first, at Bond Level 3!",
			choices = { { id = "ok", text = "Got it!" } },
		},
	},
}

Encounters.help_lee = {
	id = "help_lee",
	npcId = "ranger_lee",
	repeatable = true,
	start = "hi",
	curriculum = { program = "A Child's Choice", note = "Help-seeking. Always available, never locked.", reviewStatus = PROVISIONAL },
	nodes = {
		hi = {
			speaker = "npc",
			text = "Hi, I'm Ranger Lee. I'm always here, and you never need a reason to come talk. Is something on your mind?",
			choices = {
				{ id = "secret", text = "Someone asked me to keep a secret.", next = "secret" },
				{ id = "app", text = "Someone wants to chat on another app.", next = "app" },
				{ id = "tools", text = "How do I block or report on Roblox?", next = "tools" },
				{ id = "hi", text = "Just saying hi!", next = "bye" },
			},
		},
		secret = {
			speaker = "npc",
			text = "Thanks for telling me. You're not in trouble. A safe friend won't ask you to hide things from the grown-ups who care about you. A parent, caregiver, teacher, coach, or school counselor can help.",
			choices = {
				{ id = "more", text = "What else can I do?", next = "tools" },
				{ id = "thanks", text = "Thanks, Ranger Lee.", actions = { { action = "pet_react", mood = "love" } } },
			},
		},
		app = {
			speaker = "npc",
			text = "Good thinking to pause. If someone online wants to move to Snapchat, Discord, or any other app, especially in secret, talk to a trusted adult first.",
			choices = {
				{ id = "more", text = "What else can I do?", next = "tools" },
				{ id = "thanks", text = "Thanks, Ranger Lee.", actions = { { action = "pet_react", mood = "love" } } },
			},
		},
		tools = {
			speaker = "npc",
			text = "In this game, Block and Report are practice buttons. They don't send anything to Roblox. On real Roblox, you can block or report someone from the menu or their profile. And you can always tell a trusted adult.",
			choices = {
				{ id = "got_it", text = "Got it!", actions = { { action = "record_learning", topic = "real_tools" } } },
			},
		},
		bye = {
			speaker = "npc",
			text = "Hi back! Come see me anytime. {petName} is welcome too.",
			choices = { { id = "bye", text = "Bye!", actions = { { action = "pet_react", mood = "happy" } } } },
		},
	},
}

----------------------------------------------------------------------------
-- Feedback after a practice safety tool. Shown by EncounterService.
-- {npcName} is filled in. Short, supportive, and explicit that it's practice.
----------------------------------------------------------------------------

Encounters.SafetyFeedback = {
	block = "You blocked {npcName} in this game. Blocking is always okay, and you never need a reason. This was practice: on real Roblox, you can block someone from their profile or the chat menu.",
	report = "This was a practice report, so nothing was sent to Roblox. On real Roblox, use Report from the menu to tell Roblox's safety team. And tell a trusted adult too.",
}

return Encounters
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">NPCs</string>
            <string name="Source"><![CDATA[--[[
	NPCDefinitions. NPC models are built from `appearance` by NPCService and
	tagged "Interactable_NPC" with attributes NpcId and LocationId. An NPC may
	stand in several places (Jordan does); progress is still per player.

	role:
	  peer          another kid in the game. Dialogue shows the practice
	                Block / Report tools, the same as real player-to-player chat.
	  trusted_adult a safe grown-up character (help is always available here)
	  shopkeeper    runs a store

	interaction: "dialogue" (default) | "shop" | "adopt"
]]

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

return {
	maya = {
		id = "maya",
		displayName = "Maya",
		subtitle = "Pet Store Owner",
		role = "shopkeeper",
		interaction = "adopt",
		promptText = "Talk",
		appearance = { skin = rgb(141, 85, 36), shirt = rgb(255, 159, 67), pants = rgb(60, 70, 110), hair = rgb(30, 20, 15) },
		placements = {
			{ locationId = "pet_store", position = Vector3.new(0, 0, 63), faces = Vector3.new(0, 0, 40) },
		},
		encounters = { "maya_chat" },
		idleLine = "Take good care of your pup!",
	},
	priya = {
		id = "priya",
		displayName = "Priya",
		subtitle = "Groomer",
		role = "shopkeeper",
		interaction = "shop",
		promptText = "Shop",
