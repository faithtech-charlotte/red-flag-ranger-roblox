        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">StoryArcs</string>
            <string name="Source"><![CDATA[--[[
	StoryArcDefinitions. Bump `version` whenever stages change; players with
	older progress keep their completed encounters and resume at the first
	stage they haven't finished (see EncounterEngine.ensureArc).
]]

return {
	jordan_arc = {
		id = "jordan_arc",
		version = 1,
		title = "Jordan", -- internal only; never shown as "a predator story"
		npcIds = { "jordan" },
		entryConditions = { { type = "hasPet" } },
		stages = {
			{ id = "meet", encounter = "jordan_e1_park" },
			{ id = "again", encounter = "jordan_e2_agility" },
			{ id = "boundary", encounter = "jordan_e3_boundary", transitions = { default = "done" } },
		},
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="29">
        <Properties>
          <string name="Name">Core</string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ActionService</string>
            <string name="Source"><![CDATA[--[[
	ActionService: validated commands that content (quests, encounters) can
	trigger by name. Content never calls services directly; it lists actions:

	  { action = "grant_currency", amount = 10, reason = "quest" }

	Each action is registered by the service that owns that piece of state.
	run() executes a list in order on the server and stops at the first
	failure. Unknown actions are rejected at content-validation time.
]]

export type ActionSpec = { action: string, [string]: any }
export type Context = { [string]: any }
export type ActionFn = (player: Player, spec: ActionSpec, ctx: Context) -> (boolean, string?)

local ActionService = {}
local registry: { [string]: ActionFn } = {}

function ActionService.register(name: string, fn: ActionFn)
	assert(registry[name] == nil, `Action {name} registered twice`)
	registry[name] = fn
end

function ActionService.has(name: string): boolean
	return registry[name] ~= nil
end

function ActionService.names(): { string }
	local list = {}
	for name in registry do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

function ActionService.run(player: Player, actions: { ActionSpec }?, ctx: Context?): (boolean, string?)
	if not actions then
		return true, nil
	end
	for _, spec in actions do
		local fn = registry[spec.action]
		if not fn then
			warn(`[ActionService] unknown action {spec.action}`)
			return false, "unknown action"
		end
		local ok, result, err = pcall(fn, player, spec, ctx or {})
		if not ok then
			warn(`[ActionService] {spec.action} errored: {result}`)
			return false, "action error"
		end
		if not result then
			return false, err
		end
	end
	return true, nil
end

return ActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">EventBus</string>
            <string name="Source"><![CDATA[--[[
	EventBus: tiny synchronous pub/sub for "something happened" events.

	Event names in use:
	  pet.adopted         { petId, breedId }
	  activity.completed  { activityId, count, timeSeconds? }
	  item.purchased      { itemId, kind }
	  item.equipped       { itemId, slot, target }
	  quest.completed     { questId }
	  encounter.completed { encounterId, npcId, arcId?, outcome }

	Handlers run in their own thread so one failing handler can't break others.
]]

export type Handler = (player: Player, payload: { [string]: any }) -> ()

local EventBus = {}
local handlers: { [string]: { Handler } } = {}

function EventBus.subscribe(eventName: string, handler: Handler)
	handlers[eventName] = handlers[eventName] or {}
	table.insert(handlers[eventName], handler)
end

function EventBus.publish(eventName: string, player: Player, payload: { [string]: any }?)
	local list = handlers[eventName]
	if not list then
		return
	end
	for _, handler in list do
		task.spawn(function()
			local ok, err = pcall(handler, player, payload or {})
			if not ok then
				warn(`[EventBus] handler for {eventName} failed: {err}`)
			end
		end)
	end
end

return EventBus
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--[[
	Net: routes client requests to handlers and sends pushes to clients.

	Every request is rate-limited per player and per kind, wrapped in pcall,
	and refused until the player's profile has loaded. Handlers return
	(ok, error?, data?). Clients only ever receive { ok, error, data }.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

type Handler = (player: Player, payload: any) -> (boolean, string?, any?)

local Net = {}
local S
local handlers: { [string]: { fn: Handler, interval: number, needsProfile: boolean } } = {}
local lastCall: { [Player]: { [string]: number } } = {}
local push: RemoteEvent

function Net.init(services)
	S = services
	local request
	request, push = Remotes.create()
	request.OnServerInvoke = function(player: Player, kind: any, payload: any)
		if typeof(kind) ~= "string" then
			return { ok = false, error = "bad request" }
		end
		local entry = handlers[kind]
		if not entry then
			return { ok = false, error = "unknown request" }
		end
		local now = os.clock()
		local calls = lastCall[player]
		if not calls then
			calls = {}
			lastCall[player] = calls
		end
		if calls[kind] and now - calls[kind] < entry.interval then
			return { ok = false, error = "slow down", throttled = true }
		end
		calls[kind] = now
		if entry.needsProfile and not S.Data.get(player) then
			return { ok = false, error = "Still loading, one sec!" }
		end
		local ok, result, err, data = pcall(entry.fn, player, payload)
		if not ok then
			warn(`[Net] {kind} failed for {player.Name}: {result}`)
			return { ok = false, error = "Something went wrong. Try again!" }
		end
		return { ok = result == true, error = err, data = data }
	end
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

-- interval: minimum seconds between calls of this kind from one player.
function Net.on(kind: string, fn: Handler, interval: number?, needsProfile: boolean?)
	assert(handlers[kind] == nil, `Net handler {kind} registered twice`)
	handlers[kind] = { fn = fn, interval = interval or 0.2, needsProfile = needsProfile ~= false }
end

function Net.push(player: Player, kind: string, payload: any?)
	if player.Parent then
		push:FireClient(player, kind, payload)
	end
end

function Net.toast(player: Player, text: string, style: string?)
	Net.push(player, Remotes.PushKinds.Toast, { text = text, style = style or "info" })
end

return Net
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--[[
	ProfileSchema: the saved shape of a player, plus migrations. Pure logic,
	no Roblox services, so it is unit-tested.

	Rules:
	  * Store stable string ids only (breedId, itemId, npcId), never Instances.
	  * Bump CURRENT_VERSION and add a step to `migrations` for any shape change.
	  * reconcile() fills in keys added since the profile was saved.
]]

local ProfileSchema = {}

ProfileSchema.CURRENT_VERSION = 2

export type PetInstance = {
	id: string,
	breedId: string,
	name: string, -- raw name as typed; always filtered before display
	displayName: string, -- last filtered name (safe to show)
	equipped: { [string]: string }, -- slot -> itemId
	bondXp: number, -- never decreases
	xpLog: { day: number, counts: { [string]: number } }, -- daily XP caps
	adoptedAt: number,
}

export type ArcProgress = {
	contentVersion: number,
	stage: string?, -- current stage id; nil once done
	completed: { [string]: boolean }, -- encounterId -> true
	decisions: { [string]: string }, -- encounterId -> outcome
	flags: { [string]: any },
	activitiesSinceStage: number,
	done: boolean,
}

export type Profile = {
	schemaVersion: number,
	wallet: { [string]: number },
	pets: { [string]: PetInstance },
	activePetId: string?,
	inventory: { [string]: number },
	playerEquipped: { [string]: string },
	quests: { [string]: boolean },
	activities: { [string]: { count: number, best: number? } },
	unlocks: { [string]: boolean },
	claims: { [string]: boolean },
	arcs: { [string]: ArcProgress },
	npcs: { [string]: { blocked: boolean?, reported: boolean? } },
	learning: { topicsSeen: { [string]: boolean }, toolsPracticed: { [string]: boolean } },
	stats: { sessions: number, firstJoin: number },
}

function ProfileSchema.default(now: number?): Profile
	return {
		schemaVersion = ProfileSchema.CURRENT_VERSION,
		wallet = { paw_coins = 0 },
		pets = {},
		activePetId = nil,
		inventory = {},
		playerEquipped = {},
		quests = {},
		activities = {},
		unlocks = {},
		claims = {},
		arcs = {},
		npcs = {},
		learning = { topicsSeen = {}, toolsPracticed = {} },
		stats = { sessions = 0, firstJoin = now or 0 },
	}
end

-- Migration steps: migrations[n] upgrades a version-n profile to n+1.
local migrations: { [number]: (any) -> any } = {
	-- v1 -> v2: pets get Bond XP. Old "bond" points convert at 5 XP each,
	-- so nobody loses progress.
	[1] = function(data)
		for _, pet in data.pets or {} do
			if pet.bondXp == nil then
				pet.bondXp = math.max(0, math.floor((tonumber(pet.bond) or 0) * 5))
			end
			pet.bond = nil
			pet.xpLog = pet.xpLog or { day = 0, counts = {} }
		end
		return data
	end,
}

-- A new pet record (used at adoption).
function ProfileSchema.newPet(id: string, breedId: string, name: string, now: number): PetInstance
	return {
		id = id,
		breedId = breedId,
		name = name,
		displayName = name,
		equipped = {},
		bondXp = 0,
		xpLog = { day = 0, counts = {} },
		adoptedAt = now,
	}
end

local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
ProfileSchema.deepCopy = deepCopy

-- Adds any missing keys from the default template (does not remove extras).
local function reconcile(target: { [any]: any }, template: { [any]: any })
	for k, v in template do
		if target[k] == nil then
			target[k] = deepCopy(v)
		elseif typeof(v) == "table" and typeof(target[k]) == "table" and next(v) ~= nil then
			reconcile(target[k], v)
		end
	end
end

-- Returns (profile, readOnly). readOnly is true when data comes from a newer
-- game version; we must not overwrite it.
function ProfileSchema.migrate(data: any, now: number?): (Profile, boolean)
	if typeof(data) ~= "table" then
		return ProfileSchema.default(now), false
	end
	local profile = deepCopy(data)
	local version = tonumber(profile.schemaVersion) or 1
	if version > ProfileSchema.CURRENT_VERSION then
		reconcile(profile, ProfileSchema.default(now))
		return profile, true
	end
	while version < ProfileSchema.CURRENT_VERSION do
		local step = migrations[version]
		assert(step, `missing migration from schema {version}`)
		profile = step(profile)
		version += 1
	end
	profile.schemaVersion = ProfileSchema.CURRENT_VERSION
	reconcile(profile, ProfileSchema.default(now))
	return profile, false
end

function ProfileSchema.activePet(profile: Profile): PetInstance?
	if not profile.activePetId then
		return nil
	end
	return profile.pets[profile.activePetId]
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Conditions</string>
            <string name="Source"><![CDATA[--[[
	Conditions: pure evaluator for the small condition language used by
	encounters, story arcs and choices. A list of conditions means "all".

	Context fields:
	  profile     the player's Profile
	  locationId  where the NPC being talked to stands
	  arc         the player's ArcProgress for the arc being evaluated (optional)
]]

export type Condition = { type: string, [string]: any }
export type Context = {
	profile: any,
	locationId: string?,
	arc: any?,
}

local Conditions = {}

local evaluators: { [string]: (c: Condition, ctx: Context) -> boolean } = {}

local function evalOne(c: Condition, ctx: Context): boolean
	local fn = evaluators[c.type]
	if not fn then
		warn(`[Conditions] unknown condition type {c.type}`)
		return false
	end
	return fn(c, ctx)
end

function Conditions.evaluate(conditions: { Condition }?, ctx: Context): boolean
	if not conditions then
		return true
	end
	for _, c in conditions do
		if not evalOne(c, ctx) then
			return false
		end
	end
	return true
end

evaluators.all = function(c, ctx)
	return Conditions.evaluate(c.conditions, ctx)
end

evaluators.any = function(c, ctx)
	for _, sub in c.conditions do
		if evalOne(sub, ctx) then
			return true
		end
	end
	return false
end

evaluators["not"] = function(c, ctx)
	return not evalOne(c.condition, ctx)
end

evaluators.hasPet = function(_c, ctx)
	return ctx.profile.activePetId ~= nil
end

evaluators.activityCompleted = function(c, ctx)
	local a = ctx.profile.activities[c.activityId]
	return a ~= nil and a.count >= (c.min or 1)
end

evaluators.questDone = function(c, ctx)
	return ctx.profile.quests[c.questId] == true
end

evaluators.unlocked = function(c, ctx)
	return ctx.profile.unlocks[c.activityId] == true
end

evaluators.atLocation = function(c, ctx)
	return ctx.locationId == c.locationId
end

evaluators.encounterCompleted = function(c, ctx)
	local arc = ctx.profile.arcs[c.arcId]
	return arc ~= nil and arc.completed[c.encounterId] == true
end

evaluators.activitiesSinceStage = function(c, ctx)
	return ctx.arc ~= nil and ctx.arc.activitiesSinceStage >= (c.min or 1)
end

evaluators.arcFlag = function(c, ctx)
	return ctx.arc ~= nil and ctx.arc.flags[c.key] == c.equals
end

function Conditions.knownTypes(): { [string]: boolean }
	local set = {}
	for k in evaluators do
		set[k] = true
	end
	return set
end

return Conditions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">EncounterEngine</string>
            <string name="Source"><![CDATA[--[[
	EncounterEngine: the data-driven dialogue state machine. Pure logic over
	content tables and a Profile, so it is unit-tested without Studio.

	Content shapes (see Server.Content.*):

	  NPCDefinition   { id, displayName, role, arcs = {arcId}, encounters = {encId}, ... }
	  StoryArcDefinition {
	    id, version, npcIds, entryConditions?,
	    stages = { { id, encounter, transitions? = { [outcome] = stageId | "done" } } },
	  }
	  EncounterDefinition {
	    id, npcId, arcId?, repeatable?, conditions?, start, onWalkAway?,
	    completeOnSafetyTool?, curriculum?,
	    nodes = { [nodeId] = { speaker = "npc" | "tip", text, choices = {
	      { id, text, next? = nodeId, outcome?, actions?, conditions? } } } },
	    onComplete? = actions,
	  }

	A choice without `next` ends the encounter with its `outcome`
	(default "done"). Per-player progress lives in profile.arcs[arcId].
]]

local Conditions = require(script.Parent.Conditions)

export type Content = {
	npcs: { [string]: any },
	encounters: { [string]: any },
	arcs: { [string]: any },
}

local EncounterEngine = {}

local function stageIndex(arcDef, stageId): number?
	for i, stage in arcDef.stages do
		if stage.id == stageId then
			return i
		end
	end
	return nil
end

local function firstOpenStage(arcDef, progress): string?
	for _, stage in arcDef.stages do
		if not progress.completed[stage.encounter] then
			return stage.id
		end
	end
	return nil
end

-- Gets (creating or upgrading if needed) this player's progress on an arc.
function EncounterEngine.ensureArc(profile, arcDef)
	local progress = profile.arcs[arcDef.id]
	if not progress then
		progress = {
			contentVersion = arcDef.version,
			stage = arcDef.stages[1] and arcDef.stages[1].id,
			completed = {},
			decisions = {},
			flags = {},
			activitiesSinceStage = 0,
			done = false,
		}
		profile.arcs[arcDef.id] = progress
	elseif progress.contentVersion ~= arcDef.version then
		-- Content changed since this player's last visit: keep what they
		-- completed, and resume at the first stage they haven't done.
		progress.contentVersion = arcDef.version
		if not progress.done and (progress.stage == nil or stageIndex(arcDef, progress.stage) == nil) then
			progress.stage = firstOpenStage(arcDef, progress)
			progress.done = progress.stage == nil
		end
	end
	return progress
end

-- Which encounter (if any) should start when this player talks to this NPC.
-- Returns (encounterDef?, arcId?, reason?)
function EncounterEngine.select(content: Content, profile, npcId: string, locationId: string?)
	local npc = content.npcs[npcId]
	if not npc then
		return nil, nil, "unknown_npc"
	end
	local npcState = profile.npcs[npcId]
	if npcState and npcState.blocked then
		return nil, nil, "blocked"
	end

	for _, arcId in npc.arcs or {} do
		local arcDef = content.arcs[arcId]
		if arcDef then
			local progress = EncounterEngine.ensureArc(profile, arcDef)
			if not progress.done and progress.stage then
				local idx = stageIndex(arcDef, progress.stage)
				local stage = idx and arcDef.stages[idx]
				local enc = stage and content.encounters[stage.encounter]
				local ctx = { profile = profile, locationId = locationId, arc = progress }
				if
					enc
					and enc.npcId == npcId
					and Conditions.evaluate(arcDef.entryConditions, ctx)
					and Conditions.evaluate(enc.conditions, ctx)
				then
					return enc, arcId, nil
				end
			end
		end
	end

	for _, encId in npc.encounters or {} do
		local enc = content.encounters[encId]
		if enc and (enc.repeatable or not profile.claims["enc:" .. encId]) then
			local ctx = { profile = profile, locationId = locationId }
			if Conditions.evaluate(enc.conditions, ctx) then
				return enc, nil, nil
			end
		end
	end

	return nil, nil, "nothing"
end

-- Visible choices for a node (choices whose conditions pass).
function EncounterEngine.visibleChoices(enc, nodeId: string, ctx)
	local node = enc.nodes[nodeId]
	local list = {}
	if not node then
		return list
	end
	for _, choice in node.choices or {} do
		if Conditions.evaluate(choice.conditions, ctx) then
			table.insert(list, choice)
		end
	end
	return list
end

-- Validates a choice. Returns a result table or (nil, error).
function EncounterEngine.choose(enc, nodeId: string, choiceId: any, ctx)
	if typeof(choiceId) ~= "string" then
		return nil, "bad choice"
	end
	for _, choice in EncounterEngine.visibleChoices(enc, nodeId, ctx) do
		if choice.id == choiceId then
			local nextNode = choice.next
			if nextNode and not enc.nodes[nextNode] then
				return nil, "broken content"
			end
			return {
				nextNodeId = nextNode,
				ended = nextNode == nil,
				outcome = choice.outcome or "done",
				actions = choice.actions,
				choice = choice,
			}
		end
	end
	return nil, "choice not available"
end

-- Records completion and moves the arc forward. Idempotent: completing an
-- encounter twice has no further effect. Returns true if this call was the
-- first completion (so one-time rewards may be granted).
function EncounterEngine.complete(content: Content, profile, enc, arcId: string?, outcome: string): boolean
	if arcId then
		local arcDef = content.arcs[arcId]
		local progress = EncounterEngine.ensureArc(profile, arcDef)
		if progress.completed[enc.id] then
			return false
		end
		progress.completed[enc.id] = true
		progress.decisions[enc.id] = outcome
		local idx = stageIndex(arcDef, progress.stage)
		local stage = idx and arcDef.stages[idx]
		local nextStage: string? = nil
		if stage and stage.encounter == enc.id then
			local t = stage.transitions or {}
			nextStage = t[outcome] or t.default
			if nextStage == nil then
				local following = arcDef.stages[(idx :: number) + 1]
				nextStage = following and following.id or "done"
			end
		else
			nextStage = firstOpenStage(arcDef, progress) or "done"
		end
		if nextStage == "done" then
			progress.stage = nil
			progress.done = true
		else
			progress.stage = nextStage
		end
		progress.activitiesSinceStage = 0
		return true
	else
		local key = "enc:" .. enc.id
		local first = not profile.claims[key]
		if not enc.repeatable then
			profile.claims[key] = true
		end
		return first
	end
end

-- Called whenever the player completes an activity.
function EncounterEngine.noteActivity(profile)
	for _, progress in profile.arcs do
		if not progress.done then
			progress.activitiesSinceStage += 1
		end
	end
end

function EncounterEngine.format(text: string, vars: { [string]: string }): string
	return (text:gsub("{(%w+)}", function(key)
		return vars[key] or ""
	end))
end

-- Content validation: returns a list of problems (empty when content is sound).
function EncounterEngine.validate(content: Content, actionExists: (string) -> boolean): { string }
	local problems = {}
	local condTypes = Conditions.knownTypes()
	local function checkConditions(where, list)
		for _, c in list or {} do
			if not condTypes[c.type] then
				table.insert(problems, `{where}: unknown condition {c.type}`)
			end
			if c.conditions then
				checkConditions(where, c.conditions)
			end
			if c.condition then
				checkConditions(where, { c.condition })
			end
		end
	end
	local function checkActions(where, list)
		for _, a in list or {} do
			if not actionExists(a.action) then
				table.insert(problems, `{where}: unknown action {a.action}`)
			end
		end
	end

	for id, enc in content.encounters do
		if enc.id ~= id then
			table.insert(problems, `encounter {id}: id mismatch`)
		end
		if not content.npcs[enc.npcId] then
			table.insert(problems, `encounter {id}: unknown npc {enc.npcId}`)
		end
		if not enc.nodes[enc.start] then
			table.insert(problems, `encounter {id}: missing start node {enc.start}`)
		end
		if enc.onWalkAway and not enc.nodes[enc.onWalkAway] then
			table.insert(problems, `encounter {id}: missing walk-away node`)
		end
		checkConditions(`encounter {id}`, enc.conditions)
		checkActions(`encounter {id}`, enc.onComplete)
		for nodeId, node in enc.nodes do
			if typeof(node.text) ~= "string" or #node.text == 0 then
				table.insert(problems, `encounter {id}.{nodeId}: missing text`)
			end
			if not node.choices or #node.choices == 0 then
				table.insert(problems, `encounter {id}.{nodeId}: node has no choices (dead end)`)
			end
			for _, choice in node.choices or {} do
				if choice.next and not enc.nodes[choice.next] then
					table.insert(problems, `encounter {id}.{nodeId}: choice {choice.id} -> missing {choice.next}`)
				end
				checkActions(`encounter {id}.{nodeId}.{choice.id}`, choice.actions)
				checkConditions(`encounter {id}.{nodeId}.{choice.id}`, choice.conditions)
			end
		end
	end

	for id, arc in content.arcs do
		if typeof(arc.version) ~= "number" then
			table.insert(problems, `arc {id}: missing numeric version`)
		end
		local stageIds = {}
		for _, stage in arc.stages do
			stageIds[stage.id] = true
			if not content.encounters[stage.encounter] then
				table.insert(problems, `arc {id}: stage {stage.id} -> missing encounter {stage.encounter}`)
			end
		end
		for _, stage in arc.stages do
			for outcome, target in stage.transitions or {} do
				if target ~= "done" and not stageIds[target] then
					table.insert(problems, `arc {id}: stage {stage.id} outcome {outcome} -> missing stage {target}`)
				end
			end
		end
		checkConditions(`arc {id}`, arc.entryConditions)
	end

	for id, npc in content.npcs do
		for _, arcId in npc.arcs or {} do
			if not content.arcs[arcId] then
				table.insert(problems, `npc {id}: missing arc {arcId}`)
			end
		end
		for _, encId in npc.encounters or {} do
			if not content.encounters[encId] then
				table.insert(problems, `npc {id}: missing encounter {encId}`)
			end
		end
	end

	return problems
end

return EncounterEngine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">FetchMath</string>
            <string name="Source"><![CDATA[--[[
	FetchMath: pure helpers for throwing a ball. Unit-tested.
]]

local FetchMath = {}

local function finite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

--[[
	Turns a client-requested aim point into a safe throw target on the
	horizontal plane: between minDistance and maxDistance from the thrower,
	in the requested direction. Falls back to `facing` if the aim is
	unusable. Returns the target's X/Z (Y is set to origin.Y).
]]
function FetchMath.clampThrow(origin: Vector3, aim: any, facing: Vector3, minDistance: number, maxDistance: number): Vector3
	local dir: Vector3
	local dist: number
	if typeof(aim) == "Vector3" and finite(aim) then
		local flat = Vector3.new(aim.X - origin.X, 0, aim.Z - origin.Z)
		if flat.Magnitude > 0.5 then
			dir = flat.Unit
			dist = flat.Magnitude
		end
	end
	if not dir then
		local f = Vector3.new(facing.X, 0, facing.Z)
		dir = if f.Magnitude > 0.01 then f.Unit else Vector3.new(0, 0, -1)
		dist = (minDistance + maxDistance) / 2
	end
	dist = math.clamp(dist :: number, minDistance, maxDistance)
	local p = origin + dir * dist
	return Vector3.new(p.X, origin.Y, p.Z)
end

--[[
	Rolling resistance. Roblox contacts have sliding friction but no rolling
	resistance, so a ball rolling without slipping never slows down on flat
	ground. We fake it with a capped torque opposing the spin.

	ROLL_DECEL is how fast a rolling ball slows, in studs/s^2: a 30 studs/s
	roll (a long throw after its bounces) stops in about 15 studs.
]]
FetchMath.ROLL_DECEL = 30

-- Torque that slows a solid sphere (I = 2/5 m r^2) rolling without
-- slipping by `decel`: tau = (I/r + m*r) * a = 1.4 * m * r * a.
function FetchMath.rollingTorque(mass: number, radius: number, decel: number): number
	if mass <= 0 or radius <= 0 or decel <= 0 then
		return 0
	end
	return 1.4 * mass * radius * decel
end

-- How far a ball rolling at `speed` travels before stopping.
function FetchMath.rollDistance(speed: number, decel: number): number
	return speed * speed / (2 * decel)
end

-- Inside the playable square?
function FetchMath.inBounds(p: Vector3, halfSize: number): boolean
	return math.abs(p.X) <= halfSize and math.abs(p.Z) <= halfSize
end

return FetchMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">PetStateMachine</string>
            <string name="Source"><![CDATA[--[[
	PetStateMachine: the dog's behavior states and which changes are allowed.
	Pure logic (unit-tested). PetService applies it to the real model.

	Three kinds of state:
	  base       the dog's "home" behavior until told otherwise:
	             Following, Sitting, Staying
	  temporary  a short reaction that returns to the base state by itself:
	             Idle (paying attention to you), Eating, BeingPetted,
	             Grooming, PerformingTrick
	  activity   driven step by step by an activity (fetch, spa):
	             MovingToTarget, Fetching, Returning

	Movement: exactly ONE thing moves the dog (PetService's AlignPosition).
	Each state says where it points:
	  follow  behind the owner
	  hold    stay where it is
	  target  a point given by the activity
]]

export type State =
	"Following"
	| "Idle"
	| "Sitting"
	| "Staying"
	| "MovingToTarget"
	| "Fetching"
	| "Returning"
	| "Eating"
	| "BeingPetted"
	| "Grooming"
	| "PerformingTrick"

local M = {}

M.Kind = {
	Following = "base",
	Sitting = "base",
	Staying = "base",
	Idle = "temporary",
	Eating = "temporary",
	BeingPetted = "temporary",
	Grooming = "temporary",
	PerformingTrick = "temporary",
	MovingToTarget = "activity",
	Fetching = "activity",
	Returning = "activity",
}

M.Movement = {
	Following = "follow",
	Returning = "follow",
	Sitting = "hold",
	Staying = "hold",
	Idle = "hold",
	Eating = "hold",
	BeingPetted = "hold",
	Grooming = "hold",
	PerformingTrick = "hold",
	MovingToTarget = "target",
	Fetching = "target",
}

-- States in which the dog turns to look at its owner.
M.FacesOwner = {
	Idle = true,
	Eating = true,
	BeingPetted = true,
	PerformingTrick = true,
}

function M.isValid(state: any): boolean
	return typeof(state) == "string" and M.Kind[state] ~= nil
end

function M.isBase(state: string): boolean
	return M.Kind[state] == "base"
end

function M.isTemporary(state: string): boolean
	return M.Kind[state] == "temporary"
end

function M.isActivity(state: string): boolean
	return M.Kind[state] == "activity"
end

--[[
	Can the dog go from `current` to `target`?
	`byActivity` is true when an activity is driving the change (activities
	may move between their own states and into Grooming at the spa).
	Returns (ok, reason?) where reason is player-friendly.
]]
function M.canEnter(current: string, target: string, byActivity: boolean?): (boolean, string?)
	if not M.isValid(target) then
		return false, "unknown state"
	end
	if not M.isValid(current) then
		return true, nil -- recover from anything unexpected
	end
	-- Base commands (sit / stay / come) always work: they interrupt anything.
	if M.isBase(target) then
		return true, nil
	end
	if M.isActivity(current) and not byActivity then
		return false, "Busy playing!"
	end
	if M.isActivity(target) and not byActivity then
		return false, "Busy"
	end
	-- One reaction at a time, except "paying attention" which anything replaces.
	if M.isTemporary(current) and current ~= "Idle" and not byActivity then
		return false, "One thing at a time!"
	end
	return true, nil
end

-- What a temporary/activity state settles back into.
function M.settle(base: string): string
	if M.isBase(base) then
		return base
	end
	return "Following"
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Purchase</string>
            <string name="Source"><![CDATA[--[[
	Purchase: pure rules for "can this player buy this item, and what do they
	get?" The EconomyService applies the result. Unit-tested.
]]

local Purchase = {}

export type Plan = {
	price: number,
	grants: { string }, -- item ids to add to inventory
	service: boolean, -- applied immediately, not stored
}

local function owns(profile, itemId): boolean
	return (profile.inventory[itemId] or 0) > 0
end
Purchase.owns = owns

-- Returns (plan?, reason?)
function Purchase.plan(profile, item, catalog, maxStack: number): (Plan?, string?)
	if not item then
		return nil, "That item doesn't exist."
	end
	if item.unlockOnly then
		return nil, "This one is earned by bonding with your dog!"
	end
	if typeof(item.price) ~= "number" or item.price < 0 or item.price ~= math.floor(item.price) then
		return nil, "That item isn't for sale."
	end
	if item.target == "pet" and profile.activePetId == nil then
		return nil, "Adopt a dog first!"
	end

	local grants = {}
	if item.kind == "cosmetic" then
		if owns(profile, item.id) then
			return nil, "You already own this."
		end
		grants = { item.id }
	elseif item.kind == "bundle" then
		for _, id in item.contents or {} do
			local inner = catalog[id]
			if not inner or inner.kind ~= "cosmetic" then
				return nil, "That bundle is broken."
			end
			if inner.target == "pet" and profile.activePetId == nil then
				return nil, "Adopt a dog first!"
			end
			if not owns(profile, id) then
				table.insert(grants, id)
			end
		end
		if #grants == 0 then
			return nil, "You already own everything in this bundle."
		end
	elseif item.kind == "consumable" then
		if (profile.inventory[item.id] or 0) >= maxStack then
			return nil, "Your bag is full of these!"
		end
		grants = { item.id }
	elseif item.kind == "service" then
		grants = {}
	else
		return nil, "That item can't be bought."
	end

	local coins = profile.wallet.paw_coins or 0
	if coins < item.price then
		return nil, `You need {item.price - coins} more Paw Coins.`
	end

	return { price = item.price, grants = grants, service = item.kind == "service" }, nil
end

return Purchase
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ActivityService</string>
            <string name="Source"><![CDATA[--[[
	ActivityService: the shared activity framework.

	  * Definitions (rewards, rules) come from Content/Activities.
	  * Mechanics (Server/Activities/*) do the playing: Fetch, Frisbee, Agility,
	    Grooming, TrickTraining, and world Props that start them.
	  * One session per player at a time. Starting a new one interrupts the
	    old one, which cleans up after itself through its onInterrupt.
	  * complete() is the only place rewards are paid: coins (with a
	    first-time bonus and a cooldown against loops), medal bonuses, Bond
	    XP, and the "activity.completed" event that quests and Jordan's story
	    listen to.

	Mechanics are decoupled from world objects: e.g. Fetch.throw() is the same
	whether it starts from the pet menu, the park's ball bucket, or a quest.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ActionService = require(script.Parent.Parent.Core.ActionService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Conditions = require(script.Parent.Parent.Logic.Conditions)
local Definitions = require(script.Parent.Parent.Content.Activities)
local Places = require(ReplicatedStorage.Shared.Places)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local MechanicsFolder = script.Parent.Parent.Activities
local MECHANICS = { "Fetch", "Frisbee", "Agility", "Grooming", "TrickTraining", "Props" }

export type Session = {
	id: string,
	startedAt: number,
	data: { [string]: any },
	onInterrupt: ((reason: string) -> ())?,
}

local Activity = {}
local S
local sessions: { [Player]: Session } = {}
local lastPaid: { [Player]: { [string]: number } } = {}
local mechanics = {}

Activity.Definitions = Definitions

function Activity.def(id: string)
	return Definitions[id]
end

function Activity.hrp(player: Player): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Activity.isAt(player: Player, placeId: string, margin: number?): boolean
	local hrp = Activity.hrp(player)
	return hrp ~= nil and Places.isInside(placeId, hrp.Position, margin)
end

-- Eligibility for a defined activity. Returns (ok, reason?).
function Activity.canStart(player: Player, id: string): (boolean, string?)
	local def = Definitions[id]
	local profile = S.Data.get(player)
	if not def or not profile then
		return false, "Not available."
	end
	if not Conditions.evaluate(def.requires, { profile = profile }) then
		if not profile.activePetId then
			return false, "Adopt a dog first!"
		end
		return false, "Not unlocked yet."
	end
	return true, nil
end

function Activity.current(player: Player): Session?
	return sessions[player]
end

-- Starts a session, interrupting any other one first.
function Activity.begin(player: Player, id: string, onInterrupt: ((string) -> ())?): Session
	Activity.interrupt(player, "replaced")
	local session = { id = id, startedAt = os.clock(), data = {}, onInterrupt = onInterrupt }
	sessions[player] = session
	return session
end

-- Ends a session normally (no interrupt callback).
function Activity.finish(player: Player, session: Session?)
	if session == nil or sessions[player] == session then
		sessions[player] = nil
	end
end

-- Async mechanics pass their session so stale tasks cannot cancel a replacement.
function Activity.interrupt(player: Player, reason: string, expectedSession: Session?)
	local session = sessions[player]
	if not session or (expectedSession ~= nil and session ~= expectedSession) then
		return
	end
	sessions[player] = nil
	if session.onInterrupt then
		local ok, err = pcall(session.onInterrupt, reason)
		if not ok then
			warn(`[Activity] interrupt of {session.id} failed: {err}`)
		end
	end
end

-- Pays rewards for a completed activity. Only server mechanics call this.
function Activity.complete(player: Player, id: string, data: { [string]: any }?)
	local def = Definitions[id]
	local profile = S.Data.get(player)
	if not def or not profile then
		return
	end
	local record = profile.activities[id] or { count = 0 }
	record.count += 1
	local seconds = data and data.timeSeconds
	if seconds and (record.best == nil or seconds < record.best) then
		record.best = seconds
	end
	profile.activities[id] = record

	local coins = 0
	local now = os.clock()
	lastPaid[player] = lastPaid[player] or {}
	local paidAt = lastPaid[player][id]
	if paidAt == nil or now - paidAt >= (def.rewardCooldown or 0) then
		lastPaid[player][id] = now
		coins += def.rewards.coins or 0
	end
	local firstClaim = "first:" .. id
	if not profile.claims[firstClaim] then
		profile.claims[firstClaim] = true
		coins += def.rewards.firstBonus or 0
	end
	local medal = nil
	if seconds and def.medals then
		for _, m in def.medals do
			if seconds < m.under then
				medal = m
				local claim = `medal:{id}:{m.id}`
				if not profile.claims[claim] then
					profile.claims[claim] = true
					coins += m.bonus
				end
				break
			end
		end
	end

	if coins > 0 then
		S.Economy.grant(player, coins, id)
	end
	if def.rewards.bond then
		S.Bond.addXp(player, def.rewards.bond)
	end
	S.Pet.react(player, "happy")
	S.Net.push(player, Remotes.PushKinds.Celebrate, {
		title = `{def.name} complete!`,
		subtitle = medal and `{medal.label} time!` or nil,
		coins = coins > 0 and coins or nil,
	})
	EventBus.publish("activity.completed", player, {
		activityId = id,
		count = record.count,
		timeSeconds = seconds,
		medal = medal and medal.id or nil,
	})
	S.Data.pushState(player)
end

function Activity.init(services)
	S = services
	for _, name in MECHANICS do
		local module = require(MechanicsFolder:FindFirstChild(name) :: ModuleScript)
		mechanics[name] = module
		module.init(services, Activity)
	end
	Activity.Fetch = mechanics.Fetch
	Activity.Frisbee = mechanics.Frisbee

	ActionService.register("unlock_activity", function(player, spec)
		local profile = S.Data.get(player)
		local def = Definitions[spec.activityId]
		if not profile or not def then
			return false, "unknown activity"
		end
		if not profile.unlocks[spec.activityId] then
			profile.unlocks[spec.activityId] = true
			S.Net.toast(player, `New activity unlocked: {def.name}!`, "success")
			S.Data.pushState(player)
		end
		return true
	end)
end

function Activity.start()
	for _, name in MECHANICS do
		mechanics[name].start()
	end
	S.Net.on(Remotes.RequestKinds.ActivityCancel, function(player)
		Activity.interrupt(player, "cancelled")
		return true
	end, 0.3)
	Players.PlayerRemoving:Connect(function(player)
		Activity.interrupt(player, "left")
		lastPaid[player] = nil
	end)
end

return Activity
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService: Paw Coins and purchases. Server-authoritative.

	Purchases are serialized per player (one at a time) so double-clicks or
	spammed requests can't buy twice or overspend. The buy rules live in
	Logic.Purchase; this service checks location and applies the result.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ActionService = require(script.Parent.Parent.Core.ActionService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Purchase = require(script.Parent.Parent.Logic.Purchase)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local Places = require(ReplicatedStorage.Shared.Places)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local MAX_GRANT = 500

local Economy = {}
local S
local busy: { [Player]: boolean } = {}

local function validAmount(n: any): boolean
	return typeof(n) == "number" and n > 0 and n == math.floor(n) and n <= MAX_GRANT
end

function Economy.coins(player: Player): number
	local profile = S.Data.get(player)
	return profile and profile.wallet.paw_coins or 0
end

function Economy.grant(player: Player, amount: number, reason: string?): boolean
	local profile = S.Data.get(player)
	if not profile or not validAmount(amount) then
		return false
	end
	profile.wallet.paw_coins = (profile.wallet.paw_coins or 0) + amount
	S.Data.pushState(player)
	S.Net.toast(player, `+{amount} Paw Coins`, "coins")
	return true
end

function Economy.spend(player: Player, amount: number): boolean
	local profile = S.Data.get(player)
	if not profile or not validAmount(amount) then
		return false
	end
	local coins = profile.wallet.paw_coins or 0
	if coins < amount then
		return false
	end
	profile.wallet.paw_coins = coins - amount
	S.Data.pushState(player)
	return true
end

-- Items are bought at the store that sells them (ItemCatalog.shopOf).
local function atShop(player: Player, shopId: string): boolean
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return hrp ~= nil and Places.isInside(shopId, hrp.Position, 8)
end

function Economy.purchase(player: Player, itemId: any): (boolean, string?)
	if busy[player] then
		return false, "One thing at a time!"
	end
	local profile = S.Data.get(player)
	if not profile then
		return false, "Still loading."
	end
	local item = ItemCatalog.get(itemId)
	if item and not atShop(player, ItemCatalog.shopOf(item)) then
		local place = Places.get(ItemCatalog.shopOf(item))
		return false, `Visit {place and place.displayName or "the shop"} to buy this.`
	end
	local plan, reason = Purchase.plan(profile, item, ItemCatalog.Items, ItemCatalog.MaxStack)
	if not plan then
		return false, reason
	end
	busy[player] = true
	local ok, err = pcall(function()
		local it = item :: ItemCatalog.Item
		profile.wallet.paw_coins -= plan.price
		for _, grantId in plan.grants do
			profile.inventory[grantId] = (profile.inventory[grantId] or 0) + 1
		end
		if plan.service and it.effect then
			S.Pet.applyCare(player, it.effect, "care")
		end
		EventBus.publish("item.purchased", player, { itemId = it.id, kind = it.kind })
		-- Show new looks right away: equip what was just bought.
		for _, grantId in plan.grants do
			local granted = ItemCatalog.get(grantId)
			if granted and granted.kind == "cosmetic" then
				S.Inventory.equip(player, grantId)
			end
		end
		S.Net.toast(player, `You got {it.name}!`, "success")
	end)
	busy[player] = nil
	S.Data.pushState(player)
	if not ok then
		warn(`[Economy] purchase failed: {err}`)
		return false, "Something went wrong."
	end
	return true, nil
end

function Economy.init(services)
	S = services
	ActionService.register("grant_currency", function(player, spec)
		return Economy.grant(player, spec.amount, spec.reason), "invalid grant"
	end)
	ActionService.register("spend_currency", function(player, spec)
		return Economy.spend(player, spec.amount), "not enough coins"
	end)
end

function Economy.start()
	S.Net.on(Remotes.RequestKinds.Purchase, function(player, payload)
		local itemId = typeof(payload) == "table" and payload.itemId or nil
		return Economy.purchase(player, itemId)
	end, 0.3)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">EncounterService</string>
            <string name="Source"><![CDATA[--[[
	EncounterService: runs conversations. One active session per player.

	Flow: ProximityPrompt -> interact() -> EncounterEngine.select() picks the
	encounter for THIS player's progress -> nodes are sent to the client ->
	the client picks a choice id -> the server validates it against the
	current node, runs its actions, and moves on.

	Safety tools (Block / Report / Get help) are offered in every conversation
	with a "peer" NPC, not just suspicious ones, the way real chat tools are.
	"Get help" is also always available from the HUD with no conditions.

	Rewards and story progress can only change on the server, and completing
	an encounter is idempotent (EncounterEngine.complete).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ActionService = require(script.Parent.Parent.Core.ActionService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local Content = require(script.Parent.Parent.Content)
local EncounterEngine = require(script.Parent.Parent.Logic.EncounterEngine)
local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local TALK_DISTANCE = 16 -- prompt is 10; allow for latency
local WALK_AWAY_DISTANCE = 30
local HELP_NPC = "ranger_lee"
local HELP_ENCOUNTER = "help_lee"

type Session = {
	id: number,
	npcId: string,
	model: Model?,
	locationId: string?,
	remote: boolean,
	enc: any?,
	arcId: string?,
	nodeId: string?,
	feedback: { text: string, outcome: string, complete: boolean }?,
}

local Encounter = {}
local S
local sessions: { [Player]: Session } = {}
local nextSessionId = 0

local function vars(player: Player, npcDef): { [string]: string }
	local profile = S.Data.get(player)
	local pet = profile and ProfileSchema.activePet(profile)
	return {
		petName = pet and pet.displayName or "your dog",
		npcName = npcDef and npcDef.displayName or "them",
	}
end

local function ctxFor(player: Player, session: Session)
	local profile = S.Data.get(player)
	return {
		profile = profile,
		locationId = session.locationId,
		arc = session.arcId and profile and profile.arcs[session.arcId] or nil,
	}
end

local function currentNode(player: Player, session: Session)
	local npcDef = Content.npcs[session.npcId]
	if session.feedback then
		return {
			speaker = "tip",
			text = session.feedback.text,
			choices = {
				{ id = "ok", text = "Okay" },
				{ id = "help", text = "Talk to a trusted adult" },
			},
		}
	end
	if not session.enc then
		return {
			speaker = "npc",
			text = npcDef.idleLine or "Hi!",
			choices = { { id = "bye", text = "Bye!" } },
		}
	end
	local node = session.enc.nodes[session.nodeId]
	return {
		speaker = node.speaker,
		text = node.text,
		choices = EncounterEngine.visibleChoices(session.enc, session.nodeId :: string, ctxFor(player, session)),
	}
end

local function send(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	local npcDef = Content.npcs[session.npcId]
	local node = currentNode(player, session)
	local v = vars(player, npcDef)
	local choices = {}
	for _, c in node.choices do
		table.insert(choices, { id = c.id, text = EncounterEngine.format(c.text, v) })
	end
	S.Net.push(player, Remotes.PushKinds.Dialogue, {
		sessionId = session.id,
		npcId = session.npcId,
		npcName = npcDef.displayName,
		subtitle = npcDef.subtitle,
		speaker = node.speaker,
		text = EncounterEngine.format(node.text, v),
		choices = choices,
		safetyTools = npcDef.role == "peer",
	})
end

local function endSession(player: Player)
	if sessions[player] then
		sessions[player] = nil
		S.Net.push(player, Remotes.PushKinds.DialogueClose)
	end
end

local function finish(player: Player, outcome: string)
	local session = sessions[player]
	endSession(player)
	if not session or not session.enc then
		return
	end
	local profile = S.Data.get(player)
	if not profile then
		return
	end
	local first = EncounterEngine.complete(Content, profile, session.enc, session.arcId, outcome)
	if first then
		ActionService.run(player, session.enc.onComplete, { npcId = session.npcId, arcId = session.arcId, encounterId = session.enc.id })
		EventBus.publish("encounter.completed", player, {
			encounterId = session.enc.id,
			npcId = session.npcId,
			arcId = session.arcId,
			outcome = outcome,
		})
	end
	S.Data.pushState(player)
end

local function begin(player: Player, npcId: string, model: Model?, locationId: string?, remote: boolean, forced: any?)
	local profile = S.Data.get(player)
	local npcDef = Content.npcs[npcId]
	if not profile or not npcDef then
		return
	end
	local enc, arcId, reason
	if forced then
		enc = forced
	else
		enc, arcId, reason = EncounterEngine.select(Content, profile, npcId, locationId)
	end
	if reason == "blocked" then
		S.Net.toast(player, `You blocked {npcDef.displayName}. You can unblock them from the Help menu.`, "info")
		return
	end
	endSession(player)
	nextSessionId += 1
	sessions[player] = {
		id = nextSessionId,
		npcId = npcId,
		model = model,
		locationId = locationId,
		remote = remote,
		enc = enc,
		arcId = arcId,
		nodeId = enc and enc.start or nil,
	}
	send(player)
end

-- Opens Ranger Lee's help conversation from anywhere. Never gated.
function Encounter.startHelp(player: Player)
	local profile = S.Data.get(player)
	if profile then
		profile.learning.toolsPracticed.help = true
	end
	begin(player, HELP_NPC, nil, nil, true, Content.encounters[HELP_ENCOUNTER])
	S.Net.push(player, Remotes.PushKinds.Waypoint, { placeId = "ranger_station", reason = "help" })
	S.Pet.react(player, "comfort")
end

function Encounter.interact(player: Player, model: Model)
	local npcId = model:GetAttribute("NpcId")
	local npcDef = npcId and Content.npcs[npcId]
	local profile = S.Data.get(player)
	if not npcDef or not profile then
		return
	end
	if not S.NPC.isNear(player, model, TALK_DISTANCE) then
		return
	end
	if npcDef.interaction == "shop" then
		endSession(player)
		S.Net.push(player, Remotes.PushKinds.OpenShop, {
			npcName = npcDef.displayName,
			line = npcDef.idleLine,
			shop = npcDef.shop or "salon",
		})
		return
	end
	if npcDef.interaction == "adopt" and not profile.activePetId then
		endSession(player)
		S.Net.push(player, Remotes.PushKinds.OpenAdoption)
		return
	end
	begin(player, npcId, model, model:GetAttribute("LocationId"), false, nil)
end

local function validSession(player: Player, payload: any): Session?
	local session = sessions[player]
	if not session or typeof(payload) ~= "table" or payload.sessionId ~= session.id then
		return nil
	end
	if not session.remote and session.model and not S.NPC.isNear(player, session.model, WALK_AWAY_DISTANCE) then
		endSession(player)
		return nil
	end
	return session
end

local function choose(player: Player, payload: any): (boolean, string?)
	local session = validSession(player, payload)
	if not session then
		return false, nil
	end
	local choiceId = payload.choiceId

	if session.feedback then
		local fb = session.feedback
		if fb.complete then
			finish(player, fb.outcome)
		else
			endSession(player)
		end
		if choiceId == "help" then
			Encounter.startHelp(player)
		end
		return true
	end

	if not session.enc then
		endSession(player)
		return true
	end

	local result, err = EncounterEngine.choose(session.enc, session.nodeId :: string, choiceId, ctxFor(player, session))
	if not result then
		return false, err
	end
	local actx = { npcId = session.npcId, arcId = session.arcId, encounterId = session.enc.id, openHelp = false, endNow = false }
	ActionService.run(player, result.actions, actx)
	if result.ended or actx.endNow then
		finish(player, result.outcome)
		if actx.openHelp then
			Encounter.startHelp(player)
		end
	else
		session.nodeId = result.nextNodeId
		send(player)
		if actx.openHelp then
			Encounter.startHelp(player)
		end
	end
	S.Data.pushState(player)
	return true
end

-- Closing the window. Walking away is always allowed; in encounters with an
-- onWalkAway node the player sees one short, supportive note first.
local function close(player: Player, payload: any): (boolean, string?)
	local session = validSession(player, payload)
	if not session then
		endSession(player)
		return true
	end
	if session.feedback or not session.enc then
		return choose(player, { sessionId = session.id, choiceId = "ok" })
	end
	local enc = session.enc
	local node = enc.nodes[session.nodeId]
	if node.speaker == "tip" then
		-- Closing a tip card = its first choice (keeps the outcome recorded).
		local first = node.choices[1]
		return choose(player, { sessionId = session.id, choiceId = first.id })
	end
	if enc.onWalkAway and session.nodeId ~= enc.onWalkAway then
		session.nodeId = enc.onWalkAway
		send(player)
		return true
	end
	endSession(player)
	return true
end

local function safety(player: Player, payload: any): (boolean, string?)
	local session = validSession(player, payload)
	if not session then
		return false, nil
	end
	local tool = payload.tool
	local npcDef = Content.npcs[session.npcId]
	local enc = session.enc
	local completes = enc ~= nil and enc.completeOnSafetyTool == true

	if tool == "help" then
		if completes then
			finish(player, "sought_help")
		else
			endSession(player)
		end
		Encounter.startHelp(player)
		return true
	end
	if npcDef.role ~= "peer" or (tool ~= "block" and tool ~= "report") then
		return false, "Not available here."
	end
	local action = tool == "block" and "simulate_block" or "simulate_report"
	ActionService.run(player, { { action = action, npcId = session.npcId } }, { npcId = session.npcId })
	session.feedback = {
		text = EncounterEngine.format(Content.safetyFeedback[tool], vars(player, npcDef)),
		outcome = tool == "block" and "blocked" or "reported",
		complete = completes,
	}
	send(player)
	return true
end

function Encounter.init(services)
	S = services

	local function npcState(player: Player, npcId: string)
		local profile = S.Data.get(player)
		if not profile or not Content.npcs[npcId] then
			return nil, profile
		end
		profile.npcs[npcId] = profile.npcs[npcId] or {}
		return profile.npcs[npcId], profile
	end

	ActionService.register("simulate_block", function(player, spec, ctx)
		local state, profile = npcState(player, spec.npcId or ctx.npcId)
		if not state then
			return false, "unknown npc"
		end
		state.blocked = true
		profile.learning.toolsPracticed.block = true
		S.Data.pushState(player)
		return true
	end)
	ActionService.register("simulate_report", function(player, spec, ctx)
		local state, profile = npcState(player, spec.npcId or ctx.npcId)
		if not state then
			return false, "unknown npc"
		end
		state.reported = true
		profile.learning.toolsPracticed.report = true
		return true
	end)
	ActionService.register("open_help", function(player, _spec, ctx)
		if ctx.encounterId then
			ctx.openHelp = true -- opened after the current conversation closes
		else
			Encounter.startHelp(player)
		end
		return true
	end)
	ActionService.register("end_conversation", function(_player, _spec, ctx)
		ctx.endNow = true
		return true
	end)
	ActionService.register("record_learning", function(player, spec)
		local profile = S.Data.get(player)
		if profile and typeof(spec.topic) == "string" then
			profile.learning.topicsSeen[spec.topic] = true
		end
		return true
	end)
	ActionService.register("set_arc_flag", function(player, spec, ctx)
		local profile = S.Data.get(player)
		local arc = profile and ctx.arcId and profile.arcs[ctx.arcId]
		if not arc then
			return false, "no arc"
		end
		arc.flags[spec.key] = spec.value
		return true
	end)
	ActionService.register("show_waypoint", function(player, spec)
		S.Net.push(player, Remotes.PushKinds.Waypoint, { placeId = spec.placeId })
		return true
	end)
end

function Encounter.start()
	local problems = EncounterEngine.validate(Content, ActionService.has)
	for _, problem in problems do
		warn("[Content] " .. problem)
	end

	EventBus.subscribe("activity.completed", function(player)
		local profile = S.Data.get(player)
		if profile then
			EncounterEngine.noteActivity(profile)
		end
	end)

	S.Net.on(Remotes.RequestKinds.DialogueChoose, choose, 0.15)
	S.Net.on(Remotes.RequestKinds.DialogueClose, close, 0.15)
	S.Net.on(Remotes.RequestKinds.DialogueSafety, safety, 0.3)
	S.Net.on(Remotes.RequestKinds.RequestHelp, function(player)
		Encounter.startHelp(player)
		return true
	end, 1)
	S.Net.on(Remotes.RequestKinds.Unblock, function(player, payload)
		local profile = S.Data.get(player)
		local npcId = typeof(payload) == "table" and payload.npcId or nil
		local state = profile and typeof(npcId) == "string" and profile.npcs[npcId]
		if not state then
			return false, "Not blocked."
		end
		state.blocked = false
		S.Data.pushState(player)
		return true
	end, 0.5)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return Encounter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
	InventoryService: what a player owns and what is equipped. Visuals are
	delegated to PetAppearanceService; this service only changes data.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ActionService = require(script.Parent.Parent.Core.ActionService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Inventory = {}
local S

function Inventory.owns(player: Player, itemId: string): boolean
	local profile = S.Data.get(player)
	return profile ~= nil and (profile.inventory[itemId] or 0) > 0
end

function Inventory.grant(player: Player, itemId: string, count: number?): boolean
	local profile = S.Data.get(player)
	local item = ItemCatalog.get(itemId)
	if not profile or not item or item.kind == "service" or item.kind == "bundle" then
		return false
	end
	local n = count or 1
	if item.kind == "cosmetic" then
		profile.inventory[itemId] = 1
	else
		profile.inventory[itemId] = math.min((profile.inventory[itemId] or 0) + n, ItemCatalog.MaxStack)
	end
	S.Data.pushState(player)
	return true
end

function Inventory.consume(player: Player, itemId: string): boolean
	local profile = S.Data.get(player)
	if not profile then
		return false
	end
	local have = profile.inventory[itemId] or 0
	if have <= 0 then
		return false
	end
	profile.inventory[itemId] = if have > 1 then have - 1 else nil
	S.Data.pushState(player)
	return true
end

function Inventory.equip(player: Player, itemId: any): (boolean, string?)
	local profile = S.Data.get(player)
	local item = ItemCatalog.get(itemId)
	if not profile or not item or item.kind ~= "cosmetic" or not item.slot then
		return false, "You can't wear that."
	end
	if (profile.inventory[item.id] or 0) <= 0 then
		return false, "You don't own that yet."
	end
	if item.target == "pet" then
		local pet = ProfileSchema.activePet(profile)
		if not pet then
			return false, "Adopt a dog first!"
		end
		pet.equipped[item.slot] = item.id
		S.Appearance.refreshPet(player)
	else
		profile.playerEquipped[item.slot] = item.id
		S.Appearance.refreshPlayer(player)
	end
	EventBus.publish("item.equipped", player, { itemId = item.id, slot = item.slot, target = item.target })
	S.Data.pushState(player)
	return true, nil
end

function Inventory.unequip(player: Player, target: any, slot: any): (boolean, string?)
	local profile = S.Data.get(player)
	if not profile or typeof(slot) ~= "string" then
		return false, "Nothing to take off."
	end
	if target == "pet" then
		local pet = ProfileSchema.activePet(profile)
		if pet then
			pet.equipped[slot] = nil
			S.Appearance.refreshPet(player)
		end
	elseif target == "player" then
		profile.playerEquipped[slot] = nil
		S.Appearance.refreshPlayer(player)
	else
		return false, "Nothing to take off."
	end
	S.Data.pushState(player)
	return true, nil
end

function Inventory.init(services)
	S = services
	ActionService.register("grant_item", function(player, spec)
		return Inventory.grant(player, spec.itemId, spec.count), "invalid item"
	end)
	ActionService.register("equip_item", function(player, spec)
		return Inventory.equip(player, spec.itemId)
	end)
end

function Inventory.start()
	S.Net.on(Remotes.RequestKinds.Equip, function(player, payload)
		return Inventory.equip(player, typeof(payload) == "table" and payload.itemId or nil)
	end, 0.2)
	S.Net.on(Remotes.RequestKinds.Unequip, function(player, payload)
		if typeof(payload) ~= "table" then
			return false, "bad request"
		end
		return Inventory.unequip(player, payload.target, payload.slot)
	end, 0.2)
	S.Net.on(Remotes.RequestKinds.UseItem, function(player, payload)
		local item = ItemCatalog.get(typeof(payload) == "table" and payload.itemId or nil)
		if not item or item.kind ~= "consumable" then
			return false, "You can't use that."
		end
		if not S.Pet.getActive(player) then
			return false, "Adopt a dog first!"
		end
		return S.Interaction.feed(player, item.id)
	end, 1)
end

return Inventory
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">NPCService</string>
            <string name="Source"><![CDATA[--[[
	NPCService: builds NPC models from content and registers anything tagged
	"Interactable_NPC" (attributes NpcId, LocationId). Designers can also drop
	a hand-made model in the world with that tag and attributes; it will get
	a ProximityPrompt and work the same way.

	NPC models hold NO progress. Per-player state lives in each Profile.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local Content = require(script.Parent.Parent.Content)

local TAG = "Interactable_NPC"
local PROMPT_DISTANCE = 10

local NPC = {}
NPC.TAG = TAG
local S
local folder: Folder

local function addPart(model: Model, props: { [string]: any }, weldTo: BasePart): BasePart
	local p = Instance.new("Part")
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.Anchored = true
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = model
	if weldTo then
		local w = Instance.new("WeldConstraint")
		w.Part0 = weldTo
		w.Part1 = p
		w.Parent = p
	end
	return p
end

-- Simple blocky figure. Used when avatar loading isn't available.
local function blockyModel(look): Model
	local model = Instance.new("Model")
	local root = addPart(model, { Name = "HumanoidRootPart", Size = Vector3.new(2, 2, 1), Transparency = 1 }, nil :: any)
	root.CFrame = CFrame.new(0, 3, 0)
	model.PrimaryPart = root
	local torso = addPart(model, { Name = "Torso", Size = Vector3.new(2, 2, 1), Color = look.shirt, CFrame = CFrame.new(0, 3, 0) }, root)
	addPart(model, { Name = "Head", Size = Vector3.new(1.3, 1.3, 1.3), Color = look.skin, CFrame = CFrame.new(0, 4.65, 0) }, root)
	addPart(model, { Name = "LeftArm", Size = Vector3.new(0.9, 2, 0.9), Color = look.shirt, CFrame = CFrame.new(-1.45, 3, 0) }, torso)
	addPart(model, { Name = "RightArm", Size = Vector3.new(0.9, 2, 0.9), Color = look.shirt, CFrame = CFrame.new(1.45, 3, 0) }, torso)
	addPart(model, { Name = "LeftLeg", Size = Vector3.new(0.95, 2, 1), Color = look.pants, CFrame = CFrame.new(-0.5, 1, 0) }, torso)
	addPart(model, { Name = "RightLeg", Size = Vector3.new(0.95, 2, 1), Color = look.pants, CFrame = CFrame.new(0.5, 1, 0) }, torso)
	return model
end

local function avatarModel(look): Model?
	local ok, model = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = look.skin
		desc.TorsoColor = look.shirt
		desc.LeftArmColor = look.shirt
		desc.RightArmColor = look.shirt
		desc.LeftLegColor = look.pants
		desc.RightLegColor = look.pants
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok then
		warn(`[NPC] avatar build failed, using blocky NPC: {model}`)
		return nil
	end
	return model
end

local function decorate(model: Model, def)
	local head = model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local look = def.appearance
	local hair = addPart(model, {
		Name = "Hair",
		Size = Vector3.new(1.25, 0.45, 1.25),
		Color = look.hair,
		CFrame = head.CFrame * CFrame.new(0, head.Size.Y / 2, 0.05),
		Anchored = head.Anchored,
		Massless = true,
	}, head)
	if look.hat then
		addPart(model, {
			Name = "Hat",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.35, 1.9, 1.9),
			Color = look.hat,
			CFrame = hair.CFrame * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Anchored = head.Anchored,
			Massless = true,
		}, head)
		addPart(model, {
			Name = "HatTop",
			Size = Vector3.new(1.1, 0.6, 1.1),
			Color = look.hat,
			CFrame = hair.CFrame * CFrame.new(0, 0.55, 0),
			Anchored = head.Anchored,
			Massless = true,
		}, head)
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(200, 50)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 70
	gui.Adornee = head
	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, 0.6, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.3
	name.Text = def.displayName
	name.Parent = gui
	if def.subtitle then
		local sub = Instance.new("TextLabel")
		sub.Position = UDim2.fromScale(0, 0.6)
		sub.Size = UDim2.new(1, 0, 0.4, 0)
		sub.BackgroundTransparency = 1
		sub.Font = Enum.Font.GothamMedium
		sub.TextScaled = true
		sub.TextColor3 = Color3.fromRGB(255, 240, 200)
		sub.TextStrokeTransparency = 0.4
		sub.Text = def.subtitle
		sub.Parent = gui
	end
	gui.Parent = model
end

local function buildNPC(def, placement): Model
	local model = avatarModel(def.appearance) or blockyModel(def.appearance)
	model.Name = def.displayName
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") :: BasePart
	model.PrimaryPart = root
	-- Stand on the ground at the placement, facing the target.
	local box, size = model:GetBoundingBox()
	local pivotAboveFeet = model:GetPivot().Position.Y - (box.Position.Y - size.Y / 2)
	local pos = placement.position + Vector3.new(0, pivotAboveFeet, 0)
	local faces = Vector3.new(placement.faces.X, pos.Y, placement.faces.Z)
	model:PivotTo(CFrame.lookAt(pos, faces))
	decorate(model, def)
	model:SetAttribute("NpcId", def.id)
	model:SetAttribute("LocationId", placement.locationId)
	return model
end

local function register(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local npcId = model:GetAttribute("NpcId")
	local def = npcId and Content.npcs[npcId]
	if not def then
		warn(`[NPC] {model:GetFullName()} has unknown NpcId {npcId}`)
		return
	end
	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not anchor or anchor:FindFirstChild("TalkPrompt") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TalkPrompt"
	prompt.ActionText = def.promptText or "Talk"
	prompt.ObjectText = def.displayName
	prompt.MaxActivationDistance = PROMPT_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		S.Encounter.interact(player, model)
	end)
end

function NPC.getDefinition(npcId: string)
	return Content.npcs[npcId]
end

-- Is the player close enough to this NPC model to be talking to it?
function NPC.isNear(player: Player, model: Model, distance: number): boolean
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp or not model.Parent then
		return false
	end
	return (hrp.Position - model:GetPivot().Position).Magnitude <= distance
end

function NPC.init(services)
	S = services
end

function NPC.start()
	folder = Instance.new("Folder")
	folder.Name = "NPCs"
	folder.Parent = workspace
	CollectionService:GetInstanceAddedSignal(TAG):Connect(register)
	for _, existing in CollectionService:GetTagged(TAG) do
		register(existing)
	end
	for _, def in Content.npcs do
		for _, placement in def.placements or {} do
			task.spawn(function()
				local model = buildNPC(def, placement)
				model.Parent = folder
				CollectionService:AddTag(model, TAG)
			end)
		end
	end
end

return NPC
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PetAppearanceService</string>
            <string name="Source"><![CDATA[--[[
	PetAppearanceService: makes a pet model (and the owner's character) look
	like the saved data says. Rebuilds cosmetics from scratch each time, which
	is cheap at this scale and can't drift out of sync.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Accessories = require(ReplicatedStorage.Shared.Accessories)
local DogRig = require(ReplicatedStorage.Shared.DogRig)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)
local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)

local Appearance = {}
local S

local function clearCosmetics(container: Instance)
	for _, child in container:GetChildren() do
		if child.Name == "Cosmetic" or child.Name == "Leash" then
			child:Destroy()
		end
	end
end

local function visualFor(itemId: string?): { [string]: any }?
	local item = itemId and ItemCatalog.get(itemId)
	return item and item.visual or nil
end

-- Applies fur + accessories to any dog model built by DogRig.
function Appearance.applyPet(model: Model, pet: ProfileSchema.PetInstance, owner: Model?)
	local breed = PetCatalog.get(pet.breedId) or PetCatalog.get("golden")
	assert(breed, "missing default breed")
	clearCosmetics(model)

	local fur = visualFor(pet.equipped.fur)
	if fur and fur.color then
		DogRig.setFur(model, fur.color)
	else
		DogRig.setFur(model, breed.furColor, breed.accentColor)
	end

	for slot, itemId in pet.equipped do
		local visual = visualFor(itemId)
		local slotDef = PetCatalog.Slots[slot]
		if visual and slotDef and slotDef.attachment and Accessories.canBuild(visual) then
			local attachment = model:FindFirstChild(slotDef.attachment, true)
			if attachment and attachment:IsA("Attachment") then
				Accessories.attach(model, attachment, visual, breed.scale)
			end
		end
	end

	-- Leash: a beam from the owner's hand to the collar.
	local leash = visualFor(pet.equipped.leash)
	if leash and owner then
		local hand = owner:FindFirstChild("RightGripAttachment", true)
		local collar = model:FindFirstChild("CollarAttachment", true)
		if hand and collar then
			local beam = Instance.new("Beam")
			beam.Name = "Leash"
			beam.Attachment0 = hand :: Attachment
			beam.Attachment1 = collar :: Attachment
			beam.Color = ColorSequence.new(leash.color)
			beam.Width0 = 0.15
			beam.Width1 = 0.15
			beam.CurveSize0 = -1.5
			beam.CurveSize1 = 1.5
			beam.Segments = 12
			beam.FaceCamera = true
			beam.LightInfluence = 0
			beam.Parent = model
		end
	end
end

function Appearance.applyPlayer(character: Model, profile: ProfileSchema.Profile)
	clearCosmetics(character)
	for slot, itemId in profile.playerEquipped do
		local visual = visualFor(itemId)
		if slot == "player_head" and visual and Accessories.canBuild(visual) then
			local attachment = character:FindFirstChild("HatAttachment", true)
			if attachment and attachment:IsA("Attachment") then
				Accessories.attach(character, attachment, visual, 1.15)
			end
		end
	end
end

function Appearance.refreshPet(player: Player)
	local profile = S.Data.get(player)
	local model = S.Pet.getModel(player)
	local pet = profile and ProfileSchema.activePet(profile)
	if model and pet then
		Appearance.applyPet(model, pet, player.Character)
	end
end

function Appearance.refreshPlayer(player: Player)
	local profile = S.Data.get(player)
	if profile and player.Character then
		Appearance.applyPlayer(player.Character, profile)
	end
	-- The leash attaches to the character, so refresh the pet too.
	Appearance.refreshPet(player)
end

function Appearance.init(services)
	S = services
end

function Appearance.start() end

return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">PetBondService</string>
            <string name="Source"><![CDATA[--[[
	PetBondService: Bond XP and Bond Levels for the active pet.

	* XP comes only from positive interactions, via named sources in
	  BondCatalog.Sources (each with a cooldown and a soft daily cap).
	* Bond never goes down.
	* Level rewards (items, gifts) are granted once, tracked in
	  profile.claims, and re-checked on load so nothing is ever missed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EventBus = require(script.Parent.Parent.Core.EventBus)
local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)
local BondCatalog = require(ReplicatedStorage.Shared.Catalogs.BondCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local MAX_SINGLE_GRANT = 60

local Bond = {}
local S
local lastAt: { [Player]: { [string]: number } } = {}

local function today(): number
	return math.floor(os.time() / 86400)
end

local function grantUnlocks(player: Player, profile, level: number): { string }
	local labels = {}
	for _, u in BondCatalog.Unlocks do
		if u.level <= level then
			local claim = `bond:{u.kind}:{u.id}`
			if (u.kind == "item" or u.kind == "gift") and not profile.claims[claim] then
				profile.claims[claim] = true
				S.Inventory.grant(player, u.id, u.count or 1)
			end
		end
		if u.level == level then
			table.insert(labels, u.label)
		end
	end
	return labels
end

function Bond.level(player: Player): number
	local profile = S.Data.get(player)
	local pet = profile and ProfileSchema.activePet(profile)
	if not pet then
		return 0
	end
	return (BondCatalog.levelFor(pet.bondXp))
end

function Bond.has(player: Player, kind: string, id: string): boolean
	return BondCatalog.isUnlocked(Bond.level(player), kind, id)
end

-- True while `sourceId` would give 0 XP because of its per-source cooldown.
function Bond.coolingDown(player: Player, sourceId: string): boolean
	local source = BondCatalog.Sources[sourceId]
	local last = lastAt[player] and lastAt[player][sourceId]
	return source ~= nil and last ~= nil and os.clock() - last < source.cooldown
end

--[[
	Awards Bond XP from a named source. `amount` may override the source's
	base XP (e.g. a fancier treat); it is server-defined, never from a client.
	Returns the XP actually gained (0 when cooling down or capped for today).
]]
function Bond.addXp(player: Player, sourceId: string, amount: number?): number
	local profile = S.Data.get(player)
	local pet = profile and ProfileSchema.activePet(profile)
	local source = BondCatalog.Sources[sourceId]
	if not pet or not source then
		return 0
	end
	local now = os.clock()
	local times = lastAt[player]
	if not times then
		times = {}
		lastAt[player] = times
	end
	if times[sourceId] and now - times[sourceId] < source.cooldown then
		return 0
	end
	times[sourceId] = now

	if pet.xpLog.day ~= today() then
		pet.xpLog = { day = today(), counts = {} }
	end
	local count = pet.xpLog.counts[sourceId] or 0
	pet.xpLog.counts[sourceId] = count + 1
	local base = math.clamp(math.floor(amount or source.xp), 0, MAX_SINGLE_GRANT)
	local gained = BondCatalog.xpAfterCap(base, count, source.dailyCap)
	if gained <= 0 then
		S.Net.push(player, Remotes.PushKinds.Bond, { gained = 0 })
		return 0
	end

	local oldLevel = BondCatalog.levelFor(pet.bondXp)
	pet.bondXp += gained
	local newLevel, into, need = BondCatalog.levelFor(pet.bondXp)
	S.Net.push(player, Remotes.PushKinds.Bond, { gained = gained, level = newLevel, into = into, need = need })

	for level = oldLevel + 1, newLevel do
		local labels = grantUnlocks(player, profile, level)
		EventBus.publish("pet.levelUp", player, { level = level })
		local unlocked = #labels > 0 and ("Unlocked: " .. table.concat(labels, ", ")) or nil
		S.Net.push(player, Remotes.PushKinds.Celebrate, {
			title = `Bond Level {level}!`,
			subtitle = unlocked,
		})
		S.Pet.react(player, "love")
	end
	S.Data.pushState(player)
	return gained
end

function Bond.init(services)
	S = services
end

function Bond.start()
	S.Data.onLoaded(function(player, profile)
		local pet = ProfileSchema.activePet(profile)
		if pet then
			local level = BondCatalog.levelFor(pet.bondXp)
			grantUnlocks(player, profile, level)
			-- Let level-based quests catch up for pets that leveled before
			-- those quests existed (no celebration, just the event).
			for l = 2, level do
				EventBus.publish("pet.levelUp", player, { level = l, catchUp = true })
			end
		end
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastAt[player] = nil
	end)
end

return Bond
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">PetInteractionService</string>
            <string name="Source"><![CDATA[--[[
	PetInteractionService: everything the pet menu can ask for.

	Request: petAction { action, food?, trick? }
	There is no pet id in the request: a player can only ever act on their
	own active dog. Every action is checked for: having a dog, the action
	existing, Bond Level unlocks, distance (for hands-on actions), cooldowns,
	the dog's current behavior state, and owned items (treats).

	The menu also tells the dog to pay attention ("attend") while it's open,
	so it doesn't wander off, and lets it go again ("dismiss").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local EventBus = require(script.Parent.Parent.Core.EventBus)
local BondCatalog = require(ReplicatedStorage.Shared.Catalogs.BondCatalog)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local PetActions = require(ReplicatedStorage.Shared.Catalogs.PetActions)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local ATTEND_SECONDS = 25

local Interaction = {}
local S
local readyAt: { [Player]: { [string]: number } } = {} -- server time

local function coolingDown(player: Player, key: string): boolean
	local t = readyAt[player] and readyAt[player][key]
	return t ~= nil and workspace:GetServerTimeNow() < t
end

local function startCooldown(player: Player, key: string, seconds: number)
	readyAt[player] = readyAt[player] or {}
	readyAt[player][key] = workspace:GetServerTimeNow() + seconds
end

-- For the client's menu: { key = readyAtServerTime }.
function Interaction.cooldowns(player: Player): { [string]: number }
	local out = {}
	local now = workspace:GetServerTimeNow()
	for key, t in readyAt[player] or {} do
		if t > now then
			out[key] = t
		end
	end
	return out
end

local function bowl(player: Player, color: Color3)
	local pet = S.Pet.getActive(player)
	if not pet then
		return
	end
	local mouth = pet.model:FindFirstChild("MouthAttachment", true) :: Attachment?
	if not mouth then
		return
	end
	local base = mouth.WorldPosition
	local dish = Instance.new("Part")
	dish.Name = "FoodBowl"
	dish.Shape = Enum.PartType.Cylinder
	dish.Size = Vector3.new(0.35, 1.4, 1.4)
	dish.Color = Color3.fromRGB(80, 160, 255)
	dish.Anchored = true
	dish.CanCollide = false
	dish.CanQuery = false
	dish.CFrame = CFrame.new(base.X, base.Y - 0.9, base.Z) * CFrame.Angles(0, 0, math.rad(90))
	local food = Instance.new("Part")
	food.Name = "Food"
	food.Shape = Enum.PartType.Ball
	food.Size = Vector3.new(0.9, 0.5, 0.9)
	food.Color = color
	food.Anchored = true
	food.CanCollide = false
	food.CanQuery = false
	food.CFrame = CFrame.new(base.X, base.Y - 0.65, base.Z)
	food.Parent = dish
	dish.Parent = workspace
	Debris:AddItem(dish, 2.8)
end

-- Feeding is shared by the menu and the wardrobe's "Give" button.
function Interaction.feed(player: Player, food: any): (boolean, string?)
	if S.Pet.distanceToOwner(player) > PetActions.TOUCH_DISTANCE then
		return false, `Get closer to {S.Pet.name(player)} first.`
	end
	local item = nil
	if food ~= PetActions.FreeFood.id then
		item = ItemCatalog.get(food)
		if not item or item.kind ~= "consumable" then
			return false, "That isn't food!"
		end
		if not S.Inventory.owns(player, item.id) then
			return false, `You're out of {item.name}. The Treat Shop has more!`
		end
		-- Don't spend a treat that would give no Bond XP.
		if S.Bond.coolingDown(player, "feed_treat") then
			return false, `{S.Pet.name(player)} is still full. Try again in a few seconds!`
		end
	elseif coolingDown(player, "kibble") then
		return false, "The kibble bowl is refilling."
	end
	local ok, reason = S.Pet.setState(player, "Eating", { duration = 2.6 })
	if not ok then
		return false, reason
	end
	if item then
		S.Inventory.consume(player, item.id)
		bowl(player, Color3.fromRGB(240, 190, 120))
		local effect = item.effect or {}
		S.Pet.react(player, effect.mood or "happy")
		S.Bond.addXp(player, "feed_treat", effect.xp)
	else
		startCooldown(player, "kibble", PetActions.FreeFood.cooldown)
		bowl(player, Color3.fromRGB(150, 100, 60))
		S.Pet.react(player, "happy")
		S.Bond.addXp(player, "feed_kibble")
	end
	EventBus.publish("pet.interacted", player, { action = "feed", food = item and item.id or "kibble" })
	S.Data.pushState(player)
	return true, nil
end

local handlers: { [string]: (Player, any) -> (boolean, string?) } = {}

handlers.attend = function(player)
	local state = S.Pet.getState(player)
	if state == "Following" or state == "Sitting" then
		if S.Pet.distanceToOwner(player) <= PetActions.TOUCH_DISTANCE then
			S.Pet.setState(player, "Idle", { duration = ATTEND_SECONDS })
		end
	end
	return true, nil
end

handlers.dismiss = function(player)
	if S.Pet.getState(player) == "Idle" then
		S.Pet.settle(player)
	end
	return true, nil
end

--[[
	Petting is a hands-on session, not a button:
	  petStart   the dog settles in front of you (BeingPetted, no timer)
	  petStroke  { amount = 0..1 } a few times a second while you stroke it
	  petEnd     you're done (or walked away, or 30 s passed)
	The server limits how fast "petting" can accumulate, so XP only comes
	from a few seconds of real interaction. The Joy attribute (0..1) lets
	everyone nearby see how happy the dog is.
]]
local PET_SESSION_MAX = 30
local PET_MIN_SECONDS = 2.5
local PET_RATE = 0.5 -- progress per second at full intensity (2+ s of real petting)
local petting: { [Player]: { started: number, last: number, progress: number, token: number? } } = {}

local function endPetting(player: Player)
	local session = petting[player]
	petting[player] = nil
	local model = S.Pet.getModel(player)
	if model and (model:GetAttribute("Joy") or 0) ~= 0 then
		model:SetAttribute("Joy", 0) -- skip the replicated write when nothing changes
	end
	if session and S.Pet.getState(player) == "BeingPetted" then
		S.Pet.settle(player)
	end
end

handlers.petStart = function(player)
	if S.Pet.distanceToOwner(player) > PetActions.TOUCH_DISTANCE then
		return false, `Get closer to {S.Pet.name(player)} first.`
	end
	S.Activity.interrupt(player, "petting")
	local ok, reason, token = S.Pet.setState(player, "BeingPetted", {})
	if not ok then
		return false, reason
	end
	local now = os.clock()
	petting[player] = { started = now, last = now, progress = 0, token = token }
	S.Pet.react(player, "excited")
	task.delay(PET_SESSION_MAX, function()
		local session = petting[player]
		if session and session.started == now then
			endPetting(player)
		end
	end)
	return true, nil
end

handlers.petStroke = function(player, payload)
	local session = petting[player]
	if not session or not S.Pet.isCurrent(player, session.token) then
		petting[player] = nil
		return false, nil
	end
	local amount = typeof(payload.amount) == "number" and payload.amount == payload.amount and math.clamp(payload.amount, 0, 1) or 0
	local now = os.clock()
	local dt = math.min(now - session.last, 0.5)
	session.last = now
	session.progress += amount * dt * PET_RATE
	local model = S.Pet.getModel(player)
	if model then
		model:SetAttribute("Joy", math.clamp(amount * 1.5, 0, 1))
	end
	if session.progress >= 1 and now - session.started >= PET_MIN_SECONDS then
		session.progress = 0
		local gained = S.Bond.addXp(player, "pet")
		S.Pet.react(player, "love")
		EventBus.publish("pet.interacted", player, { action = "pet" })
		S.Net.push(player, Remotes.PushKinds.Petted, { xp = gained })
		S.Data.pushState(player)
	end
	return true, nil
end

handlers.feed = function(player, payload)
	return Interaction.feed(player, payload.food)
end

handlers.brush = function(player)
	local ok, reason = S.Pet.setState(player, "Grooming", { duration = 2.6 })
	if not ok then
		return false, reason
	end
	local model = S.Pet.getModel(player)
	if model then
		model:SetAttribute("GroomFx", "brush")
		local shine = workspace:GetServerTimeNow() + 30
		if (model:GetAttribute("ShinyUntil") or 0) < shine then
			model:SetAttribute("ShinyUntil", shine)
		end
		task.delay(2.6, function()
			if model.Parent and model:GetAttribute("GroomFx") == "brush" then
				model:SetAttribute("GroomFx", nil)
			end
		end)
	end
	S.Pet.react(player, "sparkle")
	S.Bond.addXp(player, "brush")
	return true, nil
end

local function command(state: string)
	return function(player)
		S.Activity.interrupt(player, "command")
		S.Pet.setState(player, state)
		return true, nil
	end
end
handlers.sit = command("Sitting")
handlers.stay = command("Staying")
handlers.come = command("Following")

-- The whistle always works: whatever the dog is doing (fetching, eating,
-- staying across the park), it drops it and runs back to you.
handlers.whistle = function(player)
	S.Activity.interrupt(player, "command")
	local ok, reason = S.Pet.setState(player, "Following", { force = true })
	if not ok then
		return false, reason
	end
	S.Pet.recall(player)
	return true, nil
end

handlers.trick = function(player, payload)
	local trick = PetActions.Tricks[payload.trick]
	if not trick then
		return false, "Unknown trick."
	end
	local need = BondCatalog.requiredLevel("trick", trick.id)
	if not need or S.Bond.level(player) < need then
		return false, `Reach Bond Level {need or "?"} to learn {trick.label}.`
	end
	if coolingDown(player, "trick") then
		return false, nil
	end
	local ok, reason = S.Pet.setState(player, "PerformingTrick", { duration = trick.duration, trick = trick.id })
	if not ok then
		return false, reason
	end
	startCooldown(player, "trick", trick.duration + 0.3)
	S.Pet.react(player, "happy")
	S.Bond.addXp(player, "trick")
	return true, nil
end

local function handle(player: Player, payload: any): (boolean, string?)
	if typeof(payload) ~= "table" or typeof(payload.action) ~= "string" then
		return false, nil
	end
	if not S.Pet.getActive(player) then
		return false, "Adopt a dog first!"
	end
	local action = payload.action
	local handler = handlers[action]
	if not handler then
		return false, nil
	end
	local def = PetActions.Actions[action == "trick" and "tricks" or action]
	if def then
		if def.unlock and not S.Bond.has(player, def.unlock.kind, def.unlock.id) then
			local need = BondCatalog.requiredLevel(def.unlock.kind, def.unlock.id)
			return false, `{def.label} unlocks at Bond Level {need}.`
		end
		if def.touch and S.Pet.distanceToOwner(player) > PetActions.TOUCH_DISTANCE then
			return false, `Get closer to {S.Pet.name(player)} first.`
		end
		if def.cooldown > 0 and coolingDown(player, def.id) then
			return false, nil
		end
	end
	local ok, err = handler(player, payload)
	if ok and def and def.cooldown > 0 then
		startCooldown(player, def.id, def.cooldown)
	end
	-- whistle: no quest or XP hangs on it, so it needn't publish or push state.
	-- (petEnd isn't a PetAction; it has its own PetEnd request kind.)
	local quiet = { attend = true, dismiss = true, feed = true, petStart = true, petStroke = true, whistle = true }
	if ok and not quiet[action] then -- feed and petting publish their own events
		EventBus.publish("pet.interacted", player, { action = action, trick = payload.trick })
		S.Data.pushState(player)
	end
	return ok, err
end

function Interaction.init(services)
	S = services
end

function Interaction.start()
	S.Net.on(Remotes.RequestKinds.PetAction, handle, 0.15)
	-- Ending has its own request kind (not PetAction) so it's never dropped by
	-- PetAction's rate limit right after a petStroke. Its own small limit only
	-- stops spam; with no session it does nothing.
	S.Net.on(Remotes.RequestKinds.PetEnd, function(player)
		endPetting(player)
		return true, nil
	end, 0.05)
	Players.PlayerRemoving:Connect(function(player)
		readyAt[player] = nil
		petting[player] = nil
	end)
end

return Interaction
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--[[
	PetService: adoption, naming, spawning, and the dog's behavior state.

	Movement (one controller, no competing movers):
	  The dog is one unanchored, non-colliding assembly. A single AlignPosition
	  pulls its Root toward one attachment, chosen by the behavior state
	  (Logic.PetStateMachine): behind the owner ("follow"), where it stands
	  ("hold"), or an activity's target ("target"). The owner's client has
	  network ownership, so motion is smooth and replicates to everyone.

	Behavior state is replicated as model attributes:
	  PetState, PetStateAt, Trick, FaceOwner
	and every client animates it (Client.PetController). Temporary states
	(petting, eating, tricks...) return to the base state (Following,
	Sitting, Staying) automatically. A token guards each change so a late
	timer can never undo a newer state.

	Recovery: following dogs that fall far behind are teleported; a staying
	dog whose owner wanders very far comes running; temporary interactions
	end if the owner walks away; respawning rebuilds the dog cleanly.

	Names: filtered with TextService for all-ages broadcast. If filtering is
	unavailable, the dog gets a safe default name instead of unfiltered text.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")

local ActionService = require(script.Parent.Parent.Core.ActionService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)
local StateMachine = require(script.Parent.Parent.Logic.PetStateMachine)
local DogRig = require(ReplicatedStorage.Shared.DogRig)
local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local TELEPORT_DISTANCE = 45
local STAY_RECALL_DISTANCE = 140
local INTERACTION_LEASH = 26
-- After a whistle the dog gets a few seconds to run back instead of being
-- popped next to you, unless it's so far away that the run would drag on.
local RECALL_SECONDS = 6
local RECALL_TELEPORT_DISTANCE = 200

type Active = {
	model: Model,
	root: BasePart,
	alignPosition: AlignPosition,
	alignOrientation: AlignOrientation,
	follow: Attachment,
	hold: Attachment,
	state: string,
	base: string,
	token: number,
	recallUntil: number?,
}

local Pet = {}
local S
local active: { [Player]: Active } = {}
-- Bumped on every spawn/despawn. A spawn that yielded (name filtering) and
-- finds the number changed has been superseded and must not build a dog.
local spawnGen: { [Player]: number } = {}
local petsFolder: Folder

-- Returns ("ok" | "rejected" | "unavailable", filteredText?)
local function filterName(player: Player, name: string): (string, string?)
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
	end)
	if not ok then
		warn(`[Pet] name filter unavailable: {result}`)
		return "unavailable", nil
	end
	local ok2, text = pcall(function()
		return (result :: TextFilterResult):GetNonChatStringForBroadcastAsync()
	end)
	if not ok2 then
		warn(`[Pet] name filter unavailable: {text}`)
		return "unavailable", nil
	end
	if text ~= name then
		return "rejected", text
	end
	return "ok", text
end

local function fallbackName(breedId: string): string
	local breed = PetCatalog.get(breedId)
	local names = breed and breed.defaultNames or { "Buddy" }
	return names[math.random(1, #names)]
end

local function groundOffset(character: Model, hrp: BasePart, scale: number): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character, petsFolder }
	local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -20, 0), params)
	local distance = hit and (hrp.Position.Y - hit.Position.Y) or 3
	return -distance + DogRig.GROUND_OFFSET * scale
end

local function nameTag(model: Model, text: string)
	local head = model:FindFirstChild("Head") :: BasePart
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(160, 34)
	gui.StudsOffset = Vector3.new(0, 1.9, 0)
	gui.MaxDistance = 60
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = text
	label.Parent = gui
	gui.Parent = model
end

local function ownerRoot(player: Player): BasePart?
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Point the single mover at the right attachment for a state.
local function applyMovement(a: Active, target: Attachment?)
	local mode = StateMachine.Movement[a.state] or "follow"
	if mode == "follow" then
		a.alignPosition.Attachment1 = a.follow
	elseif mode == "target" and target then
		a.alignPosition.Attachment1 = target
	else
		a.hold.WorldPosition = a.root.Position
		a.alignPosition.Attachment1 = a.hold
	end
end

function Pet.despawn(player: Player)
	spawnGen[player] = (spawnGen[player] or 0) + 1
	local a = active[player]
	if a then
		active[player] = nil
		a.token += 1
		a.model:Destroy()
		a.follow:Destroy()
		a.hold:Destroy()
	end
end

function Pet.spawn(player: Player)
	Pet.despawn(player)
	local gen = spawnGen[player]
	local profile = S.Data.get(player)
	local pet = profile and ProfileSchema.activePet(profile)
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not pet or not character or not hrp then
		return
	end
	local breed = PetCatalog.get(pet.breedId) or (PetCatalog.get("golden") :: PetCatalog.Breed)

	-- Re-filter the name each spawn (filters improve over time).
	local status, text = filterName(player, pet.name)
	if status == "ok" then
		pet.displayName = text :: string
	elseif status == "rejected" then
		pet.displayName = breed.defaultNames[1]
	end
	if spawnGen[player] ~= gen or not player.Parent then
		return -- another spawn/despawn ran while we were filtering
	end
	if player.Character ~= character or not hrp.Parent then
		return -- respawned while we were filtering
	end

	local model = DogRig.build({
		furColor = breed.furColor,
		accentColor = breed.accentColor,
		earStyle = breed.earStyle,
		scale = breed.scale,
	})
	model.Name = `{player.Name}_Pet`
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("PetId", pet.id)
	model:SetAttribute("PetName", pet.displayName)
	model:SetAttribute("GroundOffset", DogRig.GROUND_OFFSET * breed.scale)
	model:SetAttribute("PetState", "Following")
	model:SetAttribute("PetStateAt", workspace:GetServerTimeNow())
	nameTag(model, pet.displayName)
	S.Appearance.applyPet(model, pet, character)

	local root = model.PrimaryPart :: BasePart
	local follow = Instance.new("Attachment")
	follow.Name = "PetFollow"
	-- Beside you, a little behind: visible from the default camera instead of
	-- hidden behind your character.
	follow.Position = Vector3.new(3.2, groundOffset(character, hrp, breed.scale), 0.8)
	follow.Parent = hrp

	local hold = Instance.new("Attachment")
	hold.Name = `PetHold_{player.UserId}`
	hold.Parent = workspace.Terrain

	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.TwoAttachment
	ap.Attachment0 = root:FindFirstChild("RootAttachment") :: Attachment
	ap.Attachment1 = follow
	ap.MaxForce = 1e6
	ap.MaxVelocity = 60
	ap.Responsiveness = 16
	ap.Parent = root

	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = root:FindFirstChild("RootAttachment") :: Attachment
	ao.MaxTorque = 1e6
	ao.Responsiveness = 20
	ao.CFrame = hrp.CFrame - hrp.Position
	ao.Parent = root

	model:PivotTo(follow.WorldCFrame)
	model.Parent = petsFolder
	CollectionService:AddTag(model, "Pet")
	pcall(function()
		root:SetNetworkOwner(player)
	end)

	active[player] = {
		model = model,
		root = root,
		alignPosition = ap,
		alignOrientation = ao,
		follow = follow,
		hold = hold,
		state = "Following",
		base = "Following",
		token = 0,
	}
end

function Pet.getModel(player: Player): Model?
	local a = active[player]
	return a and a.model
end

-- The dog's (filtered) display name, for messages.
function Pet.name(player: Player): string
	local model = Pet.getModel(player)
	return model and model:GetAttribute("PetName") or "Your dog"
end

function Pet.getActive(player: Player): Active?
	return active[player]
end

function Pet.getState(player: Player): (string?, string?)
	local a = active[player]
	if not a then
		return nil, nil
	end
	return a.state, a.base
end

function Pet.distanceToOwner(player: Player): number
	local a = active[player]
	local hrp = ownerRoot(player)
	if not a or not hrp then
		return math.huge
	end
	return (a.root.Position - hrp.Position).Magnitude
end

export type StateOptions = {
	duration: number?, -- temporary states: seconds before settling back
	target: Attachment?, -- "target" movement states
	byActivity: boolean?, -- activities may chain their own states
	trick: string?, -- PerformingTrick: which trick to animate
	force: boolean?, -- skip transition rules (internal recovery only)
	fast: boolean?, -- sprint (fetch chase / return)
}

--[[
	Changes the dog's behavior state. Returns (ok, reason?, token).
	The token identifies this change; activities pass it back to check they
	are still in charge before their next step.
]]
function Pet.setState(player: Player, state: string, opts: StateOptions?): (boolean, string?, number?)
	local a = active[player]
	if not a then
		return false, "No dog yet!", nil
	end
	local o = opts or {}
	if not o.force then
		local ok, reason = StateMachine.canEnter(a.state, state, o.byActivity)
		if not ok then
			return false, reason, nil
		end
	end
	a.token += 1
	local token = a.token
	a.state = state
	if StateMachine.isBase(state) then
		a.base = state
	end
	a.model:SetAttribute("PetState", state)
	a.model:SetAttribute("PetStateAt", workspace:GetServerTimeNow())
	a.model:SetAttribute("Trick", o.trick)
	a.model:SetAttribute("FaceOwner", StateMachine.FacesOwner[state] == true)
	applyMovement(a, o.target)
	-- Chasing and bringing back a toy is a sprint; everything else is a trot.
	-- Fast enough to beat you there, slow enough that you can watch the run.
	a.alignPosition.MaxVelocity = o.fast and 30 or 60
	a.alignPosition.Responsiveness = o.fast and 24 or 16

	if o.duration and StateMachine.isTemporary(state) then
		task.delay(o.duration, function()
			if active[player] == a and a.token == token then
				Pet.settle(player)
			end
		end)
	end
	return true, nil, token
end

-- Ends whatever the dog is doing and goes back to its base behavior.
function Pet.settle(player: Player)
	local a = active[player]
	if a then
		Pet.setState(player, StateMachine.settle(a.base), { force = true })
	end
end

-- Is `token` still the current state change? (Activities check this.)
function Pet.isCurrent(player: Player, token: number?): boolean
	local a = active[player]
	return a ~= nil and token ~= nil and a.token == token
end

-- Plays a mood flourish on every client ("happy", "love", "sparkle",
-- "comfort", "confused"). Separate from state so it never fights movement.
function Pet.react(player: Player, mood: string)
	local a = active[player]
	if a then
		a.model:SetAttribute("Mood", mood)
		a.model:SetAttribute("MoodAt", workspace:GetServerTimeNow())
	end
end

-- Whistled back: a "!" over the dog, and a few seconds to run home before
-- the stuck-recovery check would teleport it.
function Pet.recall(player: Player)
	local a = active[player]
	if a then
		a.recallUntil = workspace:GetServerTimeNow() + RECALL_SECONDS
		Pet.react(player, "alert")
	end
end

-- Positive care from items/services: a reaction plus Bond XP.
function Pet.applyCare(player: Player, effect: { xp: number?, mood: string? }, source: string?)
	if effect.mood then
		Pet.react(player, effect.mood)
	end
	S.Bond.addXp(player, source or "care", effect.xp)
end

function Pet.adopt(player: Player, payload: any): (boolean, string?, any?)
	local profile = S.Data.get(player)
	if not profile then
		return false, "Still loading."
	end
	if profile.activePetId then
		return false, "You already have a dog!"
	end
	if typeof(payload) ~= "table" then
		return false, "Pick a dog first."
	end
	local breed = PetCatalog.get(payload.breedId)
	if not breed then
		return false, "Pick a dog first."
	end
	local name, problem = PetCatalog.cleanName(payload.name)
	if not name then
		return false, problem
	end

	local status, _ = filterName(player, name)
	local notice = nil
	if status == "rejected" then
		return false, "That name isn't allowed here. Try a different one!"
	elseif status == "unavailable" then
		name = fallbackName(breed.id)
		notice = `We couldn't check names right now, so your pup is called {name} for now.`
	end
	if profile.activePetId then
		return false, "You already have a dog!" -- re-check after yielding
	end

	local id = HttpService:GenerateGUID(false)
	profile.pets[id] = ProfileSchema.newPet(id, breed.id, name :: string, os.time())
	profile.activePetId = id
	Pet.spawn(player)
	Pet.react(player, "love")
	EventBus.publish("pet.adopted", player, { petId = id, breedId = breed.id })
	S.Data.pushState(player)
	S.Net.push(player, Remotes.PushKinds.Celebrate, { title = `Welcome home, {name}!` })
	if notice then
		S.Net.toast(player, notice, "warn")
	end
	return true, nil, { name = name }
end

local function onCharacter(player: Player, character: Model)
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.3)
	if player.Character == character then
		Pet.spawn(player)
		local profile = S.Data.get(player)
		if profile then
			S.Appearance.applyPlayer(character, profile)
		end
	end
end

local function monitor()
	for player, a in active do
		local hrp = ownerRoot(player)
		if not hrp or not a.root.Parent then
			continue
		end
		local distance = (a.root.Position - hrp.Position).Magnitude
		local mode = StateMachine.Movement[a.state]
		local recalling = a.recallUntil ~= nil and workspace:GetServerTimeNow() < a.recallUntil
		local leash = recalling and RECALL_TELEPORT_DISTANCE or TELEPORT_DISTANCE
		if a.state == "Following" and distance > leash then
			-- Stuck or left behind: pop back next to the owner.
			a.model:PivotTo(a.follow.WorldCFrame)
			a.root.AssemblyLinearVelocity = Vector3.zero
		elseif StateMachine.isBase(a.state) and a.state ~= "Following" and distance > STAY_RECALL_DISTANCE then
			Pet.setState(player, "Following", { force = true })
			S.Net.toast(player, `{Pet.name(player)} missed you and came running!`, "info")
		elseif StateMachine.isTemporary(a.state) and distance > INTERACTION_LEASH then
			Pet.settle(player) -- owner walked away mid-interaction
		end
	end
end

function Pet.init(services)
	S = services
	petsFolder = Instance.new("Folder")
	petsFolder.Name = "Pets"
	petsFolder.Parent = workspace

	ActionService.register("pet_react", function(player, spec)
		Pet.react(player, spec.mood or "happy")
		return true
	end)
end

function Pet.start()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		player.CharacterRemoving:Connect(function()
			Pet.despawn(player)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		Pet.despawn(player)
		spawnGen[player] = nil
	end)
	-- Profile may finish loading after the character exists.
	S.Data.onLoaded(function(player)
		if player.Character then
			onCharacter(player, player.Character)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			monitor()
		end
	end)

	S.Net.on(Remotes.RequestKinds.Adopt, Pet.adopt, 1)
end

return Pet
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--[[
	PlayerDataService: loads, holds, and saves the authoritative Profile.

	* DataStore key "player_<UserId>" stores { profile, session }.
	* Session lock: a server marks the record as in use. Another server waits
	  for it to be released (or to go stale) before loading, so two servers
	  never write the same player at once.
	* If DataStores are unavailable (e.g. Studio without API access), the
	  player gets a temporary profile and a notice; we never overwrite saved
	  data we failed to load.
	* Autosaves every 60 s and on leave / shutdown.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProfileSchema = require(script.Parent.Parent.Data.ProfileSchema)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)
local BondCatalog = require(ReplicatedStorage.Shared.Catalogs.BondCatalog)

local STORE_NAME = "RFR_PlayerProfiles_v1"
local SESSION_STALE_SECONDS = 300
local AUTOSAVE_SECONDS = 60
local LOAD_ATTEMPTS = 5

type Entry = {
	data: ProfileSchema.Profile,
	persistent: boolean,
	readOnly: boolean,
	pushQueued: boolean,
}

local Data = {}
local S
local store: DataStore? = nil
local entries: { [Player]: Entry } = {}
local loadedCallbacks: { (Player, ProfileSchema.Profile) -> () } = {}

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function isFatal(err: string): boolean
	-- Studio without "Enable Studio Access to API Services", or no permission.
	return err:find("StudioAccessToApisNotAllowed") ~= nil
		or err:find("403") ~= nil
		or err:find("Place has to be opened with Edit button") ~= nil
		or err:find("must publish") ~= nil
end

local function loadProfile(player: Player): (ProfileSchema.Profile?, boolean)
	if not store then
		return nil, false
	end
	for attempt = 1, LOAD_ATTEMPTS do
		local result
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(keyFor(player), function(old)
				local session = old and old.session
				local lockedElsewhere = session
					and session.jobId ~= game.JobId
					and os.time() - (session.updated or 0) < SESSION_STALE_SECONDS
				if lockedElsewhere and attempt < LOAD_ATTEMPTS then
					result = "locked"
					return nil -- cancel write; retry shortly
				end
				local profile, readOnly = ProfileSchema.migrate(old and old.profile, os.time())
				result = { profile = profile, readOnly = readOnly }
				if readOnly then
					return nil
				end
				return { profile = profile, session = { jobId = game.JobId, updated = os.time() } }
			end)
		end)
		if ok and typeof(result) == "table" then
			return result.profile, result.readOnly
		end
		if not ok then
			warn(`[Data] load attempt {attempt} failed for {player.Name}: {err}`)
			if isFatal(tostring(err)) then
				return nil, false
			end
		end
		task.wait(attempt * 1.5)
	end
	return nil, false
end

local function saveProfile(player: Player, release: boolean)
	local entry = entries[player]
	if not entry or not entry.persistent or entry.readOnly or not store then
		return
	end
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(keyFor(player), function(old)
			local session = old and old.session
			if session and session.jobId ~= game.JobId then
				return nil -- another server took over; don't clobber its data
			end
			return {
				profile = entry.data,
				session = if release then nil else { jobId = game.JobId, updated = os.time() },
			}
		end)
	end)
	if not ok then
		warn(`[Data] save failed for {player.Name}: {err}`)
	end
end

local function onPlayerAdded(player: Player)
	local profile, readOnly = loadProfile(player)
	local persistent = profile ~= nil
	if not profile then
		profile = ProfileSchema.default(os.time())
	end
	if player.Parent == nil then
		-- Left while loading: release the lock we just took.
		entries[player] = { data = profile :: any, persistent = persistent, readOnly = readOnly, pushQueued = false }
		saveProfile(player, true)
		entries[player] = nil
		return
	end
	local data = profile :: ProfileSchema.Profile
	data.stats.sessions += 1
	entries[player] = { data = data, persistent = persistent, readOnly = readOnly, pushQueued = false }
	for _, cb in loadedCallbacks do
		task.spawn(cb, player, data)
	end
	Data.pushState(player)
	if not persistent then
		task.delay(3, function()
			S.Net.toast(player, "Heads up: progress can't be saved right now, but you can still play!", "warn")
		end)
	end
end

function Data.init(services)
	S = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn(`[Data] DataStores unavailable: {result}`)
	end
end

function Data.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		saveProfile(player, true)
		entries[player] = nil
	end)
	game:BindToClose(function()
		local pending = 0
		for player in entries do
			pending += 1
			task.spawn(function()
				saveProfile(player, true)
				pending -= 1
			end)
		end
		local waited = 0
		while pending > 0 and waited < 25 do
			waited += task.wait(0.2)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player in entries do
				task.spawn(saveProfile, player, false)
			end
		end
	end)

	S.Net.on(Remotes.RequestKinds.GetState, function(player)
		if not entries[player] then
			return false, "loading"
		end
		return true, nil, Data.snapshot(player)
	end, 0.5, false)
end

function Data.get(player: Player): ProfileSchema.Profile?
	local entry = entries[player]
	return entry and entry.data
end

function Data.isPersistent(player: Player): boolean
	local entry = entries[player]
	return entry ~= nil and entry.persistent
end

function Data.onLoaded(cb: (Player, ProfileSchema.Profile) -> ())
	table.insert(loadedCallbacks, cb)
	for player, entry in entries do
		task.spawn(cb, player, entry.data)
	end
end

-- The client's read-only view of its own profile.
function Data.snapshot(player: Player)
	local data = entries[player].data
	local pet = ProfileSchema.activePet(data)
	local blocked = {}
	for npcId, state in data.npcs do
		if state.blocked then
			local def = S.NPC.getDefinition(npcId)
			blocked[npcId] = def and def.displayName or npcId
		end
	end
	local activities = {}
	for id, a in data.activities do
		activities[id] = { count = a.count, best = a.best }
	end
	local petView = nil
	if pet then
		local level, into, need = BondCatalog.levelFor(pet.bondXp)
		local nextUnlock = BondCatalog.nextUnlock(level)
		petView = {
			id = pet.id,
			breedId = pet.breedId,
			name = pet.displayName,
			equipped = table.clone(pet.equipped),
			bondXp = pet.bondXp,
			level = level,
			xpInto = into,
			xpNeed = need,
			nextUnlock = nextUnlock and { level = nextUnlock.level, label = nextUnlock.label } or nil,
			breedName = (PetCatalog.get(pet.breedId) or { displayName = "Dog" }).displayName,
		}
	end
	return {
		coins = data.wallet.paw_coins or 0,
		pet = petView,
		cooldowns = S.Interaction.cooldowns(player),
		inventory = table.clone(data.inventory),
		playerEquipped = table.clone(data.playerEquipped),
		quests = table.clone(data.quests),
		activities = activities,
		unlocks = table.clone(data.unlocks),
		blocked = blocked,
		persistent = entries[player].persistent,
	}
end

-- Coalesces many changes in one frame into one state push.
function Data.pushState(player: Player)
	local entry = entries[player]
	if not entry or entry.pushQueued then
		return
	end
	entry.pushQueued = true
	task.defer(function()
		entry.pushQueued = false
		if entries[player] == entry then
			S.Net.push(player, Remotes.PushKinds.State, Data.snapshot(player))
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--[[
	QuestService: completes Ranger Journal quests when matching events fire,
	then runs their reward actions once (profile.quests is the claim record).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ActionService = require(script.Parent.Parent.Core.ActionService)
local EventBus = require(script.Parent.Parent.Core.EventBus)
local QuestCatalog = require(ReplicatedStorage.Shared.Catalogs.QuestCatalog)

local Quest = {}
local S

local function matches(match: { [string]: any }?, payload: { [string]: any }): boolean
	if not match then
		return true
	end
	for key, expected in match do
		local actual = payload[key]
		if typeof(expected) == "table" then
			if not table.find(expected, actual) then
				return false
			end
		elseif actual ~= expected then
			return false
		end
	end
	return true
end
Quest.matches = matches

function Quest.complete(player: Player, questId: string): boolean
	local profile = S.Data.get(player)
	local quest = QuestCatalog.get(questId)
	if not profile or not quest or profile.quests[questId] then
		return false
	end
	profile.quests[questId] = true
	S.Net.toast(player, `Journal: {quest.title} ✔`, "success")
	ActionService.run(player, quest.rewards, { questId = questId })
	EventBus.publish("quest.completed", player, { questId = questId })
	S.Data.pushState(player)
	return true
end

function Quest.init(services)
	S = services
	ActionService.register("complete_quest", function(player, spec)
		Quest.complete(player, spec.questId)
		return true
	end)
end

function Quest.start()
	local byEvent: { [string]: { QuestCatalog.Quest } } = {}
	for _, quest in QuestCatalog.Ordered do
		local name = quest.completeOn.event
		byEvent[name] = byEvent[name] or {}
		table.insert(byEvent[name], quest)
	end
	for eventName, quests in byEvent do
		EventBus.subscribe(eventName, function(player, payload)
			local profile = S.Data.get(player)
			if not profile then
				return
			end
			for _, quest in quests do
				if not profile.quests[quest.id] and matches(quest.completeOn.match, payload) then
					Quest.complete(player, quest.id)
				end
			end
		end)
	end
end

return Quest
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--[[
	WorldBuilder: builds the small, colorful world from code at server start,
	so the whole game lives in this repo (no binary place edits needed).

	If Workspace already contains a "World" model (for example, one a builder
	made by hand in Studio), it is used as-is and nothing is generated. To
	hand-edit: play once, copy Workspace.World, stop, paste it into Workspace,
	and save. Keep the named parts the game looks for:
	  World.Agility.AgilityStart / AgilityFinish / parts with RingIndex 1..N
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DogRig = require(ReplicatedStorage.Shared.DogRig)
local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)
local Places = require(ReplicatedStorage.Shared.Places)
local WorldBounds = require(ReplicatedStorage.Shared.WorldBounds)

local World = {}
local root: Model

local C = {
	grass = Color3.fromRGB(110, 196, 92),
	grassLight = Color3.fromRGB(140, 214, 104),
	path = Color3.fromRGB(240, 214, 160),
	wood = Color3.fromRGB(176, 122, 76),
	white = Color3.fromRGB(255, 252, 245),
	cream = Color3.fromRGB(255, 244, 222),
	trunk = Color3.fromRGB(122, 84, 52),
	leaf = Color3.fromRGB(70, 170, 80),
	leaf2 = Color3.fromRGB(96, 196, 96),
	orange = Color3.fromRGB(255, 159, 67),
	pink = Color3.fromRGB(255, 120, 190),
	purple = Color3.fromRGB(155, 93, 229),
	blue = Color3.fromRGB(80, 160, 255),
	yellow = Color3.fromRGB(255, 209, 102),
	red = Color3.fromRGB(239, 71, 111),
	green = Color3.fromRGB(46, 160, 120),
	dark = Color3.fromRGB(50, 45, 60),
}

local function part(parent: Instance, props: { [string]: any }): BasePart
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent
	return p
end

-- A part whose bottom sits at `y` (handy for walls and props).
local function block(parent, name, size: Vector3, x, y, z, color, extra: { [string]: any }?): BasePart
	local props = { Name = name, Size = size, CFrame = CFrame.new(x, y + size.Y / 2, z), Color = color }
	for k, v in extra or {} do
		props[k] = v
	end
	return part(parent, props)
end

local function folder(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function sign(parent: Instance, text: string, cf: CFrame, size: Vector2, color: Color3, textColor: Color3?)
	local board = part(parent, {
		Name = "Sign",
		Size = Vector3.new(size.X, size.Y, 0.4),
		CFrame = cf,
		Color = color,
		CanCollide = false,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = textColor or Color3.new(1, 1, 1)
	label.Text = text
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = label
	label.Parent = gui
	gui.Parent = board
	return board
end

local function tree(parent: Instance, x: number, z: number, scale: number, leafColor: Color3)
	local m = folder("Tree", parent)
	local h = 6 * scale
	part(m, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(h, 1.4 * scale, 1.4 * scale),
		CFrame = CFrame.new(x, h / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
		Color = C.trunk,
	})
	part(m, { Name = "Leaves", Shape = Enum.PartType.Ball, Size = Vector3.one * 7 * scale, CFrame = CFrame.new(x, h + 2 * scale, z), Color = leafColor, Material = Enum.Material.Grass })
	part(m, { Name = "Leaves2", Shape = Enum.PartType.Ball, Size = Vector3.one * 4.5 * scale, CFrame = CFrame.new(x + 2 * scale, h + 3.5 * scale, z - 1 * scale), Color = leafColor:Lerp(Color3.new(1, 1, 1), 0.12), Material = Enum.Material.Grass })
end

local function flowers(parent: Instance, x: number, z: number, rng: Random)
	local colors = { C.pink, C.yellow, C.red, C.purple, C.white }
	for _ = 1, 5 do
		local fx, fz = x + rng:NextNumber(-2, 2), z + rng:NextNumber(-2, 2)
		part(parent, { Name = "Stem", Size = Vector3.new(0.15, 0.8, 0.15), CFrame = CFrame.new(fx, 0.4, fz), Color = C.leaf, CanCollide = false })
		part(parent, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, CFrame = CFrame.new(fx, 0.9, fz), Color = colors[rng:NextInteger(1, #colors)], CanCollide = false })
	end
end

local function bench(parent: Instance, x: number, z: number, rotY: number)
	local m = folder("Bench", parent)
	local base = CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(rotY), 0)
	part(m, { Name = "Seat", Size = Vector3.new(6, 0.4, 2), CFrame = base * CFrame.new(0, 1.6, 0), Color = C.wood })
	part(m, { Name = "Back", Size = Vector3.new(6, 1.6, 0.3), CFrame = base * CFrame.new(0, 2.6, 0.9), Color = C.wood })
	for _, sx in { -2.6, 2.6 } do
		part(m, { Name = "Leg", Size = Vector3.new(0.3, 1.4, 1.8), CFrame = base * CFrame.new(sx, 0.7, 0), Color = C.dark })
	end
end

local function fenceLine(parent: Instance, a: Vector3, b: Vector3, color: Color3)
	local dir = b - a
	local len = dir.Magnitude
	local n = math.max(1, math.floor(len / 6))
	for i = 0, n do
		local p = a + dir * (i / n)
		part(parent, { Name = "Post", Size = Vector3.new(0.6, 3.2, 0.6), CFrame = CFrame.new(p.X, 1.6, p.Z), Color = color })
	end
	local mid = (a + b) / 2
	for _, y in { 1.2, 2.5 } do
		part(parent, {
			Name = "Rail",
			Size = Vector3.new(0.3, 0.4, len),
			CFrame = CFrame.lookAt(Vector3.new(mid.X, y, mid.Z), Vector3.new(b.X, y, b.Z)),
			Color = color,
		})
	end
end

-- Four-walled building with a door gap on one side. `door` is "north" (-Z),
-- "west" (-X), etc. Returns the model.
local function building(parent: Instance, name: string, center: Vector3, size: Vector3, wallColor: Color3, roofColor: Color3, door: string, doorWidth: number)
	local m = folder(name, parent)
	local hx, hz, h = size.X / 2, size.Z / 2, size.Y
	local t = 1
	block(m, "Floor", Vector3.new(size.X, 0.3, size.Z), center.X, 0, center.Z, Color3.fromRGB(235, 200, 150), { Material = Enum.Material.WoodPlanks })
	local walls = {
		north = { Vector3.new(center.X, 0, center.Z - hz), Vector3.new(size.X, h, t), "x" },
		south = { Vector3.new(center.X, 0, center.Z + hz), Vector3.new(size.X, h, t), "x" },
		west = { Vector3.new(center.X - hx, 0, center.Z), Vector3.new(t, h, size.Z), "z" },
		east = { Vector3.new(center.X + hx, 0, center.Z), Vector3.new(t, h, size.Z), "z" },
	}
	for side, w in walls do
		local pos, wsize, axis = w[1], w[2], w[3]
		if side == door then
			local full = axis == "x" and wsize.X or wsize.Z
			local seg = (full - doorWidth) / 2
			for _, s in { -1, 1 } do
				local offset = (doorWidth / 2 + seg / 2) * s
				local segSize = axis == "x" and Vector3.new(seg, h, t) or Vector3.new(t, h, seg)
				local p = axis == "x" and pos + Vector3.new(offset, 0, 0) or pos + Vector3.new(0, 0, offset)
				block(m, "Wall", segSize, p.X, 0, p.Z, wallColor)
			end
			local lintel = axis == "x" and Vector3.new(doorWidth, h - 9, t) or Vector3.new(t, h - 9, doorWidth)
			block(m, "Lintel", lintel, pos.X, 9, pos.Z, wallColor)
		else
			block(m, "Wall", wsize, pos.X, 0, pos.Z, wallColor)
		end
	end
	block(m, "Roof", Vector3.new(size.X + 3, 1, size.Z + 3), center.X, h, center.Z, roofColor)
	-- Ceiling lights so interiors stay warm and welcoming. Kept soft because
	-- six of them overlap in each room.
	for lx = -1, 1 do
		for lz = -1, 1, 2 do
			local lamp = block(m, "CeilingLight", Vector3.new(3, 0.3, 3), center.X + lx * size.X / 3.2, h - 0.3, center.Z + lz * size.Z / 4.5, Color3.fromRGB(255, 240, 215), { Material = Enum.Material.Neon })
			local light = Instance.new("PointLight")
			light.Range = 18
			light.Brightness = 0.9
			light.Color = Color3.fromRGB(255, 244, 225)
			light.Parent = lamp
		end
	end
	-- Stripy awning trim
	for i = 0, 7 do
		local c = i % 2 == 0 and roofColor or C.white
		local x = center.X - hx - 1.5 + (size.X + 3) * (i + 0.5) / 8
		block(m, "Trim", Vector3.new((size.X + 3) / 8, 1.2, 0.4), x, h - 1.2, center.Z - hz - 1.6, c)
		block(m, "Trim", Vector3.new((size.X + 3) / 8, 1.2, 0.4), x, h - 1.2, center.Z + hz + 1.6, c)
	end
	return m
end

local function displayDog(parent: Instance, breedId: string, cf: CFrame)
	local breed = PetCatalog.get(breedId) :: PetCatalog.Breed
	local dog = DogRig.build({
		furColor = breed.furColor,
		accentColor = breed.accentColor,
		earStyle = breed.earStyle,
		scale = breed.scale,
		anchored = true,
	})
	dog.Name = "Display_" .. breedId
	dog:PivotTo(cf)
	dog.Parent = parent
end

local function buildPetStore(parent: Instance)
	local p = Places.get("pet_store") :: Places.Place
	local m = building(parent, "PetStore", p.center, Vector3.new(48, 14, 36), C.white, C.orange, "north", 12)
	sign(m, "Paws & Friends Pet Store", CFrame.new(p.center.X, 11.5, p.center.Z - 18.8), Vector2.new(22, 3), C.orange)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 0.4, 6)
	spawn.CFrame = CFrame.new(p.center.X, 0.35, p.center.Z - 2) * CFrame.Angles(0, 0, 0)
	spawn.Color = C.yellow
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = m

	block(m, "Counter", Vector3.new(14, 3.2, 2), p.center.X, 0, p.center.Z + 10, C.orange)
	block(m, "CounterTop", Vector3.new(14.4, 0.3, 2.4), p.center.X, 3.2, p.center.Z + 10, C.wood)

	-- Kennels with the three breeds on show.
	for i, breedId in PetCatalog.Order do
		local z = p.center.Z - 10 + (i - 1) * 9
		local x = p.center.X - 17
		block(m, "Pedestal", Vector3.new(6, 1.2, 6), x, 0, z, i == 1 and C.yellow or i == 2 and C.pink or C.blue)
		displayDog(m, breedId, CFrame.new(x, 1.2 + DogRig.GROUND_OFFSET, z) * CFrame.Angles(0, math.rad(-90), 0))
		local breed = PetCatalog.get(breedId) :: PetCatalog.Breed
		sign(m, breed.displayName, CFrame.new(x - 3.5, 4.5, z) * CFrame.Angles(0, math.rad(-90), 0), Vector2.new(5, 1.2), C.dark)
	end
	-- Right side: toys and bowls
	for i = 0, 2 do
		block(m, "Shelf", Vector3.new(2, 6, 7), p.center.X + 22, 0, p.center.Z - 8 + i * 9, C.wood)
		part(m, { Name = "Toy", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.2, CFrame = CFrame.new(p.center.X + 21.5, 6.6, p.center.Z - 8 + i * 9), Color = i == 1 and C.red or C.yellow })
	end
end

local function buildRangerHQ(parent: Instance)
	local p = Places.get("ranger_station") :: Places.Place
	local m = folder("RangerHQ", parent)
	local cx, cz = p.center.X, p.center.Z
	block(m, "Deck", Vector3.new(18, 0.6, 18), cx + 2, 0, cz, C.wood, { Material = Enum.Material.WoodPlanks })
	block(m, "BackWall", Vector3.new(1, 12, 18), cx + 10.5, 0.6, cz, C.green)
	block(m, "SideWall", Vector3.new(18, 12, 1), cx + 2, 0.6, cz - 8.5, C.green)
	block(m, "SideWall", Vector3.new(18, 12, 1), cx + 2, 0.6, cz + 8.5, C.green)
	block(m, "Roof", Vector3.new(21, 1, 21), cx + 2, 12.6, cz, C.wood)
	block(m, "RoofTrim", Vector3.new(21.4, 1.2, 0.5), cx + 2, 11.6, cz - 10.6, C.yellow)
	block(m, "RoofTrim", Vector3.new(21.4, 1.2, 0.5), cx + 2, 11.6, cz + 10.6, C.yellow)
	sign(m, "Ranger HQ  ♥  Help is always here", CFrame.new(cx - 7.2, 10, cz) * CFrame.Angles(0, math.rad(90), 0), Vector2.new(15, 2.4), C.green)
	block(m, "FlagPole", Vector3.new(0.4, 18, 0.4), cx - 6, 0, cz + 11, C.white)
	block(m, "Flag", Vector3.new(0.2, 2.5, 4), cx - 6, 15, cz + 13, C.yellow)

	-- Mission board: friendly adventure hub, not a classroom.
	local board = block(m, "MissionBoard", Vector3.new(0.6, 5, 7), cx + 9.6, 1.5, cz - 3, C.wood)
	CollectionService:AddTag(board, "MissionBoard")
	sign(m, "📜 MISSION BOARD", CFrame.new(cx + 9.2, 6, cz - 3) * CFrame.Angles(0, math.rad(90), 0), Vector2.new(6.6, 1.2), C.orange)
	for i = 0, 2 do
		block(m, "Note", Vector3.new(0.1, 1.2, 1.6), cx + 9.25, 2.4 + (i % 2) * 1.4, cz - 5.5 + i * 2.2, ({ C.yellow, C.pink, C.blue })[i + 1])
	end
	-- Campfire circle and logs (glowing "fire" is just a soft neon light).
	local fire = block(m, "Campfire", Vector3.new(1.6, 1, 1.6), cx - 2, 0.6, cz + 14, Color3.fromRGB(255, 140, 50), { Material = Enum.Material.Neon, Shape = Enum.PartType.Ball })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = 14
	light.Parent = fire
	for i = 0, 2 do
		local a = math.rad(i * 120)
		part(m, {
			Name = "Log",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(3.4, 1, 1),
			CFrame = CFrame.new(cx - 2 + math.cos(a) * 3, 0.5, cz + 14 + math.sin(a) * 3) * CFrame.Angles(0, -a + math.rad(90), 0),
			Color = C.trunk,
		})
	end
end

local function buildTreatShop(parent: Instance)
	local p = Places.get("treat_shop") :: Places.Place
	local m = building(parent, "TreatShop", p.center, Vector3.new(24, 12, 22), Color3.fromRGB(255, 236, 200), Color3.fromRGB(255, 159, 67), "east", 10)
	sign(m, "Bo's Treat Shop", CFrame.new(p.center.X + 12.8, 9.6, p.center.Z) * CFrame.Angles(0, math.rad(-90), 0), Vector2.new(13, 2.2), C.orange)
	block(m, "Counter", Vector3.new(2, 3.2, 10), p.center.X - 3, 0, p.center.Z, C.pink)
	block(m, "CounterTop", Vector3.new(2.4, 0.3, 10.4), p.center.X - 3, 3.2, p.center.Z, C.white)
	-- Treat displays
	local treatColors = { Color3.fromRGB(230, 190, 120), Color3.fromRGB(255, 140, 60), Color3.fromRGB(150, 95, 60) }
	for i, color in treatColors do
		local z = p.center.Z - 4 + (i - 1) * 4
		part(m, { Name = "Treat", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 0.8, 1.2), CFrame = CFrame.new(p.center.X - 3, 3.75, z), Color = color })
	end
	for i = 0, 1 do
		block(m, "Shelf", Vector3.new(6, 5, 1.5), p.center.X - 4 + i * 8, 0, p.center.Z - 10, C.wood)
		block(m, "Jar", Vector3.new(1.2, 1.5, 1.2), p.center.X - 5 + i * 8, 5, p.center.Z - 10, Color3.fromRGB(200, 230, 255), { Material = Enum.Material.Glass, Transparency = 0.3 })
	end
end

local function buildDogPark(parent: Instance, rng: Random)
	local p = Places.get("dog_park") :: Places.Place
	local m = folder("DogPark", parent)
	local hx, hz = p.size.X / 2, p.size.Z / 2
	block(m, "Lawn", Vector3.new(p.size.X, 0.2, p.size.Z), p.center.X, 0, p.center.Z, C.grassLight, { Material = Enum.Material.Grass })
	local x0, x1, z0, z1 = p.center.X - hx, p.center.X + hx, p.center.Z - hz, p.center.Z + hz
	local gate = 8 -- half-width of the entrance on the east side, at the cross street
	fenceLine(m, Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z0), C.white)
	fenceLine(m, Vector3.new(x0, 0, z1), Vector3.new(x1, 0, z1), C.white)
	fenceLine(m, Vector3.new(x0, 0, z0), Vector3.new(x0, 0, z1), C.white)
	fenceLine(m, Vector3.new(x1, 0, z0), Vector3.new(x1, 0, -30 - gate), C.white)
	fenceLine(m, Vector3.new(x1, 0, -30 + gate), Vector3.new(x1, 0, z1), C.white)
	sign(m, "Sunny Dog Park", CFrame.new(x1 + 1, 7, -30 - gate - 3) * CFrame.Angles(0, math.rad(-90), 0), Vector2.new(12, 2.6), C.green)
	block(m, "SignPost", Vector3.new(0.5, 6, 0.5), x1 + 1, 0, -30 - gate - 3, C.wood)
	sign(m, "Fetch Field: press Throw!", CFrame.new(p.center.X, 4, p.center.Z + 14) * CFrame.Angles(0, 0, 0), Vector2.new(10, 1.6), C.orange)
	block(m, "FetchPost", Vector3.new(0.4, 3.2, 0.4), p.center.X, 0, p.center.Z + 14.3, C.wood)

	tree(m, x0 + 8, z0 + 8, 1.2, C.leaf)
	tree(m, x0 + 10, z1 - 10, 1.0, C.leaf2)
	tree(m, x1 - 9, z0 + 9, 1.1, C.leaf2)
	tree(m, p.center.X - 22, p.center.Z + 4, 1.3, C.leaf) -- "the big tree"
	bench(m, -112, -8, 180)
	bench(m, -70, -12, 180)
	for _ = 1, 8 do
		flowers(m, rng:NextNumber(x0 + 3, x1 - 3), rng:NextNumber(z0 + 3, z0 + 10), rng)
	end
	-- Interactive props: ball bucket (fetch) and squeaky toys.
	local bucket = block(m, "BallBucket", Vector3.new(3, 2.4, 3), -60, 0, -22, C.blue, { Shape = Enum.PartType.Cylinder })
	bucket.CFrame = CFrame.new(-60, 1.2, -22) * CFrame.Angles(0, 0, math.rad(90))
	bucket.Size = Vector3.new(2.4, 3, 3)
	CollectionService:AddTag(bucket, "FetchStation")
	for i = 0, 3 do
		part(m, { Name = "Ball", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, CFrame = CFrame.new(-60.6 + (i % 2) * 1.2, 2.6, -22.6 + math.floor(i / 2) * 1.2), Color = Color3.fromRGB(200, 255, 60) })
	end
	sign(m, "🎾 Grab a ball!", CFrame.new(-60, 4.6, -22) * CFrame.Angles(0, math.rad(-90), 0), Vector2.new(4.5, 1), C.green)
	local duck = part(m, { Name = "SqueakyDuck", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.8, CFrame = CFrame.new(-96, 0.9, -56), Color = C.yellow })
	part(m, { Name = "DuckHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.1, CFrame = CFrame.new(-96, 2.1, -56.5), Color = C.yellow, CanCollide = false })
	part(m, { Name = "DuckBeak", Size = Vector3.new(0.5, 0.3, 0.6), CFrame = CFrame.new(-96, 2.0, -57.2), Color = C.orange, CanCollide = false })
	CollectionService:AddTag(duck, "PetToy")
	local bone = block(m, "ChewBone", Vector3.new(3, 0.6, 0.8), -74, 0, -62, C.white)
	part(m, { Name = "BoneEnd", Shape = Enum.PartType.Ball, Size = Vector3.one, CFrame = CFrame.new(-75.6, 0.5, -62), Color = C.white })
	part(m, { Name = "BoneEnd", Shape = Enum.PartType.Ball, Size = Vector3.one, CFrame = CFrame.new(-72.4, 0.5, -62), Color = C.white })
	CollectionService:AddTag(bone, "PetToy")

	-- Agility-style toys in the park
	part(m, { Name = "Tire", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 4, 4), CFrame = CFrame.new(-100, 2, -60), Color = C.dark })
	part(m, { Name = "BigBall", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, CFrame = CFrame.new(-78, 1.5, -58), Color = C.red })
end

local function buildSalon(parent: Instance)
	local p = Places.get("salon") :: Places.Place
	local m = building(parent, "GroomingSalon", p.center, Vector3.new(44, 13, 34), C.pink, C.purple, "west", 12)
	sign(m, "Fluff & Puff Salon", CFrame.new(p.center.X - 22.8, 10.8, p.center.Z) * CFrame.Angles(0, math.rad(90), 0), Vector2.new(18, 2.6), C.purple)
	block(m, "Counter", Vector3.new(2, 3.2, 12), p.center.X + 10, 0, p.center.Z, C.purple)
	for i, z in { p.center.Z - 11, p.center.Z + 11 } do
		block(m, "Tub", Vector3.new(7, 2.5, 5), p.center.X + 2, 0, z, C.white)
		block(m, "Water", Vector3.new(6, 0.3, 4), p.center.X + 2, 2.3, z, Color3.fromRGB(150, 220, 255), { Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
		block(m, "Mirror", Vector3.new(6, 5, 0.3), p.center.X + 2, 3, z + (i == 1 and -2.9 or 2.9), Color3.fromRGB(200, 230, 255), { Material = Enum.Material.Glass, Reflectance = 0.3 })
		local station = block(m, "GroomStation", Vector3.new(7, 0.6, 5), p.center.X + 2, 2.5, z, C.white, { Transparency = 1, CanCollide = false })
		local spot = Instance.new("Attachment")
		spot.Name = "DogSpot"
		spot.Parent = station
		spot.WorldPosition = Vector3.new(p.center.X + 2, 2.4 + DogRig.GROUND_OFFSET, z)
		CollectionService:AddTag(station, "GroomStation")
		sign(m, "🛁 Spa Tub", CFrame.new(p.center.X + 2, 6.5, z + (i == 1 and -2.7 or 2.7)) * CFrame.Angles(0, i == 1 and 0 or math.rad(180), 0), Vector2.new(4, 1), C.purple)
	end
	for i = 0, 3 do
		part(m, { Name = "Bubble", Shape = Enum.PartType.Ball, Size = Vector3.one * (0.6 + i * 0.2), CFrame = CFrame.new(p.center.X + 1 + i, 3.4 + i * 0.6, p.center.Z - 11), Color = Color3.new(1, 1, 1), Transparency = 0.4, CanCollide = false })
	end
end

local function hurdle(parent: Instance, x: number, z: number, alongX: boolean)
	local width = 8
	local bar = alongX and Vector3.new(0.6, 0.6, width) or Vector3.new(width, 0.6, 0.6)
	block(parent, "HurdleBar", bar, x, 1.2, z, C.red)
	block(parent, "HurdleBase", alongX and Vector3.new(0.6, 1.2, width) or Vector3.new(width, 1.2, 0.6), x, 0, z, C.white, { Transparency = 0.2 })
	for _, s in { -1, 1 } do
		local px = alongX and x or x + s * width / 2
		local pz = alongX and z + s * width / 2 or z
		block(parent, "HurdlePost", Vector3.new(0.6, 2.4, 0.6), px, 0, pz, C.white)
	end
end

local function ring(parent: Instance, index: number, x: number, z: number, alongX: boolean)
	local w, h = 9, 8
	local color = ({ C.yellow, C.pink, C.blue, C.purple })[((index - 1) % 4) + 1]
	local function bar(size, ox, oy, oz)
		part(parent, { Name = "RingBar", Size = size, CFrame = CFrame.new(x + ox, oy, z + oz), Color = color, Material = Enum.Material.Neon, CanCollide = false })
	end
	if alongX then
		bar(Vector3.new(0.6, h, 0.6), 0, h / 2, -w / 2)
		bar(Vector3.new(0.6, h, 0.6), 0, h / 2, w / 2)
		bar(Vector3.new(0.6, 0.6, w), 0, h, 0)
	else
		bar(Vector3.new(0.6, h, 0.6), -w / 2, h / 2, 0)
		bar(Vector3.new(0.6, h, 0.6), w / 2, h / 2, 0)
		bar(Vector3.new(w, 0.6, 0.6), 0, h, 0)
	end
	local trigger = part(parent, {
		Name = "Ring" .. index,
		Size = alongX and Vector3.new(1.5, h, w) or Vector3.new(w, h, 1.5),
		CFrame = CFrame.new(x, h / 2, z),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	trigger:SetAttribute("RingIndex", index)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(60, 60)
	gui.StudsOffset = Vector3.new(0, h / 2 + 1.5, 0)
	gui.MaxDistance = 120
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.2
	label.Text = tostring(index)
	label.Parent = gui
	gui.Parent = trigger
end

local function buildAgility(parent: Instance)
	local p = Places.get("agility") :: Places.Place
	local m = folder("Agility", parent)
	block(m, "Turf", Vector3.new(p.size.X, 0.2, p.size.Z), p.center.X, 0, p.center.Z, Color3.fromRGB(120, 200, 245), { Material = Enum.Material.SmoothPlastic })
	-- Lanes
	block(m, "Lane1", Vector3.new(90, 0.25, 10), 0, 0, -100, Color3.fromRGB(240, 120, 90))
	block(m, "Lane2", Vector3.new(90, 0.25, 10), 0, 0, -136, Color3.fromRGB(240, 120, 90))
	block(m, "Turn", Vector3.new(10, 0.25, 46), 40, 0, -118, Color3.fromRGB(240, 120, 90))

	local start = block(m, "AgilityStart", Vector3.new(8, 0.4, 9), -40, 0.1, -100, Color3.fromRGB(60, 220, 120), { Material = Enum.Material.Neon, CanCollide = false })
	sign(m, "START", CFrame.new(-40, 6, -95) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(6, 1.8), Color3.fromRGB(60, 200, 110))
	start:SetAttribute("Role", "start")

	hurdle(m, -27, -100, true)
	hurdle(m, -16, -100, true)
	ring(m, 1, -6, -100, true)
	hurdle(m, 5, -100, true)
	ring(m, 2, 16, -100, true)
	for i = 0, 4 do
		local wz = -100 + (i % 2 == 0 and -2.2 or 2.2)
		block(m, "WeavePole", Vector3.new(0.6, 4, 0.6), 22 + i * 3, 0, wz, i % 2 == 0 and C.yellow or C.white)
	end
	ring(m, 3, 40, -118, false)
	hurdle(m, 28, -136, true)
	hurdle(m, 16, -136, true)
	ring(m, 4, 2, -136, true)
	-- Tunnel
	block(m, "TunnelWall", Vector3.new(6, 6, 0.8), -12, 0, -140.6, C.purple)
	block(m, "TunnelWall", Vector3.new(6, 6, 0.8), -12, 0, -131.4, C.purple)
	block(m, "TunnelRoof", Vector3.new(6, 0.8, 10), -12, 6, -136, C.purple)

	local finish = folder("Finish", m)
	for i = 0, 3 do
		for j = 0, 3 do
			block(finish, "Check", Vector3.new(2, 0.3, 2.25), -33 + i * 2, 0.15, -140.5 + j * 2.25, (i + j) % 2 == 0 and C.white or C.dark, { CanCollide = false })
		end
	end
	block(m, "AgilityFinish", Vector3.new(8, 4, 9), -30, 0.1, -136, C.white, { Transparency = 1, CanCollide = false })
	sign(m, "FINISH", CFrame.new(-30, 7, -141) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(6, 1.8), C.dark)

	sign(m, "Training Grounds", CFrame.new(-20, 8, -89) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(14, 2.6), C.blue)

	-- Trick training mat in the infield.
	local mat = block(m, "TrainingMat", Vector3.new(10, 0.3, 8), -18, 0.1, -118, C.purple)
	CollectionService:AddTag(mat, "TrainingMat")
	for i = 0, 3 do
		block(m, "MatStar", Vector3.new(1, 0.32, 1), -21 + i * 2, 0.1, -118, C.yellow, { Material = Enum.Material.Neon })
	end
	sign(m, "⭐ Trick Training", CFrame.new(-18, 5, -122.5) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(7, 1.4), C.purple)
	block(m, "MatSignPost", Vector3.new(0.4, 4.2, 0.4), -18, 0, -122.7, C.wood)
	block(m, "SignPost", Vector3.new(0.5, 7, 0.5), -20, 0, -89, C.wood)
	-- Bleachers
	for i = 0, 2 do
		block(m, "Bleacher", Vector3.new(16, 1, 2.4), 10, i * 1, -146 - i * 2.4 + 2.4, i % 2 == 0 and C.blue or C.white)
	end
end

-- Frisbee Field, east of the Training Grounds. Players throw from the line
-- at the west end toward +X. Markings don't collide or block raycasts, so
-- the disc flies over them; only real obstacles (trees, buildings) stop it.
local function buildFrisbeeField(parent: Instance)
	local p = Places.get("frisbee_field") :: Places.Place
	local m = folder("FrisbeeField", parent)
	local hx, hz = p.size.X / 2, p.size.Z / 2
	local x0, x1, z0, z1 = p.center.X - hx, p.center.X + hx, p.center.Z - hz, p.center.Z + hz
	local mark = { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false }
	block(m, "Lawn", Vector3.new(p.size.X, 0.2, p.size.Z), p.center.X, 0, p.center.Z, C.grassLight, { Material = Enum.Material.Grass })
	-- Mowing stripes
	for i = 0, math.floor(p.size.X / 8) - 1, 2 do
		block(m, "Stripe", Vector3.new(8, 0.21, p.size.Z), x0 + 4 + i * 8, 0, p.center.Z, C.grass, { Material = Enum.Material.Grass, CanCollide = false, CanQuery = false, CanTouch = false })
	end
	local lineX = x0 + 6
	block(m, "ThrowLine", Vector3.new(0.6, 0.24, p.size.Z - 6), lineX, 0, p.center.Z, C.white, mark)
	-- Distance markers every 20 studs: cones at both sidelines and a number.
	for i, d in { 20, 40, 60 } do
		local x = lineX + d
		block(m, "DistanceLine", Vector3.new(0.4, 0.23, p.size.Z - 6), x, 0, p.center.Z, C.white, { CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Transparency = 0.5 })
		for _, z in { z0 + 2, z1 - 2 } do
			block(m, "Cone", Vector3.new(1, 1.4, 1), x, 0, z, C.orange, mark)
		end
		sign(m, `{d}`, CFrame.new(x, 2.6, z1 - 2) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(2.4, 1.4), ({ C.yellow, C.orange, C.red })[i])
	end
	for _, corner in { Vector3.new(x0, 0, z0), Vector3.new(x0, 0, z1), Vector3.new(x1, 0, z0), Vector3.new(x1, 0, z1) } do
		block(m, "FlagPole", Vector3.new(0.3, 5, 0.3), corner.X, 0, corner.Z, C.white)
		block(m, "Flag", Vector3.new(0.1, 1.2, 1.8), corner.X, 3.7, corner.Z + 0.9, C.pink, { CanCollide = false })
	end
	sign(m, "🥏 Frisbee Field", CFrame.new(x0 - 2, 7, p.center.Z + 10) * CFrame.Angles(0, math.rad(90), 0), Vector2.new(13, 2.6), C.pink)
	block(m, "SignPost", Vector3.new(0.5, 6, 0.5), x0 - 2, 0, p.center.Z + 10, C.wood)

	-- The frisbee stack: "Grab a frisbee" starts the game.
	local tx, tz = x0 + 3, p.center.Z - 8
	block(m, "FrisbeeTable", Vector3.new(3, 2.4, 3), tx, 0, tz, C.wood)
	local colors = { C.pink, C.yellow, C.blue, C.green }
	for i, color in colors do
		part(m, {
			Name = "StackedFrisbee",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.25, 2, 2),
			CFrame = CFrame.new(tx, 2.53 + (i - 1) * 0.26, tz) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			CanCollide = false,
		})
	end
	local station = block(m, "FrisbeeStation", Vector3.new(3.2, 3.6, 3.2), tx, 0, tz, C.white, { Transparency = 1, CanCollide = false })
	CollectionService:AddTag(station, "FrisbeeStation")
	sign(m, "🥏 Grab a frisbee!", CFrame.new(tx, 5.2, tz) * CFrame.Angles(0, math.rad(90), 0), Vector2.new(5, 1.1), C.pink)
	bench(m, x0 + 3, p.center.Z + 6, 90)
end

local function buildPaths(parent: Instance)
	local m = folder("Paths", parent)
	block(m, "Avenue", Vector3.new(10, 0.15, 124), 0, 0, -28, C.path)
	block(m, "CrossStreet", Vector3.new(114, 0.15, 10), 6, 0, -30, C.path)
	block(m, "StationPath", Vector3.new(10, 0.15, 6), 9, 0, 5, C.path)
	block(m, "TreatShopPath", Vector3.new(20, 0.15, 6), -14, 0, 14, C.path)

	-- Signpost at the crossroads, readable when walking out of the Pet Store.
	block(m, "SignPost", Vector3.new(0.6, 12, 0.6), 7, 0, -20, C.wood)
	local lines = {
		{ "▲ Training Grounds", C.blue },
		{ "◀ Sunny Dog Park", C.green },
		{ "Fluff & Puff Salon ▶", C.pink },
	}
	for i, line in lines do
		sign(m, line[1], CFrame.new(7, 11 - i * 1.7, -19.6) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(7.5, 1.4), line[2])
	end
	sign(m, "◀ Bo's Treat Shop", CFrame.new(-7, 4.5, 20) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(6.5, 1.3), C.orange)
	sign(m, "Ranger HQ ▶", CFrame.new(7, 4.5, 20) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(6.5, 1.3), C.green)
	for z = 24, -84, -18 do
		for _, x in { -7, 7 } do
			block(m, "LampPost", Vector3.new(0.5, 8, 0.5), x, 0, z, C.dark)
			part(m, { Name = "Lamp", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.4, CFrame = CFrame.new(x, 8.6, z), Color = C.yellow, Material = Enum.Material.Neon })
		end
	end
end

local function scatter(parent: Instance, rng: Random)
	local m = folder("Scenery", parent)
	local placed = 0
	local tries = 0
	while placed < 46 and tries < 600 do
		tries += 1
		-- Stay well inside WorldBounds.LANDING so wrapped players never land in a tree.
		local x, z = rng:NextNumber(-200, 200), rng:NextNumber(-200, 160)
		local pos = Vector3.new(x, 0, z)
		local onPath = math.abs(x) < 10 or math.abs(z + 30) < 9
		local inPlace = false
		for id in Places.All do
			if Places.isInside(id, pos, 8) then
				inPlace = true
			end
		end
		if not onPath and not inPlace then
			if rng:NextNumber() < 0.6 then
				tree(m, x, z, rng:NextNumber(0.8, 1.4), rng:NextNumber() < 0.5 and C.leaf or C.leaf2)
			else
				flowers(m, x, z, rng)
			end
			placed += 1
		end
	end
end

-- Single source of truth for world lighting. Keep default.project.json's
-- Lighting block in sync so Studio edit mode matches what players see.
-- (Lighting.Technology can't be set from scripts; it lives in the project file.)
local function applyLighting()
	Lighting.ClockTime = 13
	Lighting.Brightness = 2
	Lighting.ExposureCompensation = -0.15
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 130)
	Lighting.Ambient = Color3.fromRGB(40, 40, 48)
end

function World.init(_services)
	applyLighting()
	local existing = workspace:FindFirstChild("World")
	if existing then
		root = existing :: Model
		return
	end
	root = Instance.new("Model")
	root.Name = "World"

	local baseplate = workspace:FindFirstChild("Baseplate")
	if not baseplate then
		baseplate = Instance.new("Part")
		baseplate.Name = "Baseplate"
		baseplate.Anchored = true
		baseplate.Locked = true
		baseplate.Parent = workspace
	end
	if baseplate and baseplate:IsA("BasePart") then
		-- The world is built on a floor whose top is at Y = 0.
		local size = WorldBounds.HALF_SIZE * 2
		baseplate.Size = Vector3.new(size, 20, size)
		baseplate.CFrame = CFrame.new(0, -10, 0)
		baseplate.Color = C.grass
		baseplate.Material = Enum.Material.Grass
	end
	local rng = Random.new(7)
	buildPaths(root)
	buildPetStore(root)
	buildRangerHQ(root)
	buildTreatShop(root)
	buildDogPark(root, rng)
	buildSalon(root)
	buildAgility(root)
	buildFrisbeeField(root)
	scatter(root, rng)
	root.Parent = workspace
end

-- Safety net for the wrap-around edges (the client wraps its own character):
-- anyone who still ends up below the floor is put back on it instead of dying.
-- (Don't set workspace.FallenPartsDestroyHeight here: scripts can't write it,
-- and the error would abort every later service's start(). Its default of
-- -500 is far below RESCUE_HEIGHT anyway.)
function World.start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hrp and hrp.Position.Y < WorldBounds.RESCUE_HEIGHT then
					hrp.AssemblyLinearVelocity = Vector3.zero
					character:PivotTo(CFrame.new(WorldBounds.rescue(hrp.Position)) * hrp.CFrame.Rotation)
				end
			end
		end
	end)
end

function World.getAgilityCourse(): Instance?
	return root and root:FindFirstChild("Agility", true)
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
