  <Item class="ServerStorage" referent="54">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="55">
      <Properties>
        <string name="Name">Tests</string>
        <string name="Source"><![CDATA[--[[
	Tiny test runner for pure game logic. Synced to ServerStorage.Tests.

	Run from the Studio command bar (Edit mode is fine):
	  print(require(game.ServerStorage.Tests)())

	Each *.spec module returns function(t) and uses t.test / t.expect.
]]

local function deepEqual(a, b): boolean
	if typeof(a) ~= typeof(b) then
		return false
	end
	if typeof(a) ~= "table" then
		return a == b
	end
	for k, v in a do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function expect(actual)
	local e = {}
	function e.toBe(expected)
		if actual ~= expected then
			error(`expected {tostring(expected)}, got {tostring(actual)}`, 2)
		end
	end
	function e.toEqual(expected)
		if not deepEqual(actual, expected) then
			error("tables differ", 2)
		end
	end
	function e.toBeTruthy()
		if not actual then
			error(`expected truthy, got {tostring(actual)}`, 2)
		end
	end
	function e.toBeFalsy()
		if actual then
			error(`expected falsy, got {tostring(actual)}`, 2)
		end
	end
	return e
end

return function(): string
	local passed, failed = 0, 0
	local lines = {}
	for _, spec in script:GetChildren() do
		if spec:IsA("ModuleScript") and spec.Name:match("%.spec$") then
			local suite = require(spec) :: any
			local t = {
				expect = expect,
				test = function(name: string, fn: () -> ())
					local ok, err = pcall(fn)
					if ok then
						passed += 1
					else
						failed += 1
						table.insert(lines, `  FAIL {spec.Name} > {name}: {err}`)
					end
				end,
			}
			local ok, err = pcall(suite, t)
			if not ok then
				failed += 1
				table.insert(lines, `  ERROR loading {spec.Name}: {err}`)
			end
		end
	end
	table.insert(lines, 1, `Tests: {passed} passed, {failed} failed`)
	return table.concat(lines, "\n")
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">ActivitySession.spec</string>
          <string name="Source"><![CDATA[local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Activity = require(Server.Services.ActivityService)

return function(t)
	t.test("stale fetch interruption leaves the replacement session running", function()
		local player = {} :: any
		local fetchInterrupted, spaInterrupted = 0, 0
		local fetch = Activity.begin(player, "fetch_play", function()
			fetchInterrupted += 1
		end)
		local spa = Activity.begin(player, "grooming", function()
			spaInterrupted += 1
		end)
		Activity.interrupt(player, "interrupted", fetch)
		local current = Activity.current(player)
		Activity.finish(player, spa)
		t.expect(fetchInterrupted).toBe(1)
		t.expect(spaInterrupted).toBe(0)
		t.expect(current).toBe(spa)
	end)

	t.test("a matching session interrupts and cleans up only once", function()
		local player = {} :: any
		local interrupted = 0
		local reason
		local session = Activity.begin(player, "fetch_play", function(why)
			interrupted += 1
			reason = why
		end)
		Activity.interrupt(player, "no pet", session)
		Activity.interrupt(player, "interrupted", session)
		t.expect(Activity.current(player)).toBe(nil)
		t.expect(interrupted).toBe(1)
		t.expect(reason).toBe("no pet")
	end)

	t.test("player cancellation still interrupts the current session", function()
		local player = {} :: any
		local interrupted = false
		Activity.begin(player, "grooming", function()
			interrupted = true
		end)
		Activity.interrupt(player, "cancelled")
		t.expect(Activity.current(player)).toBe(nil)
		t.expect(interrupted).toBe(true)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">EncounterEngine.spec</string>
          <string name="Source"><![CDATA[local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local EncounterEngine = require(Server.Logic.EncounterEngine)
local ProfileSchema = require(Server.Data.ProfileSchema)
local Content = require(Server.Content)

return function(t)
	local expect = t.expect

	local function freshProfile()
		local p = ProfileSchema.default(0)
		p.activePetId = "pet1"
		p.pets.pet1 = { id = "pet1", breedId = "golden", name = "Sunny", displayName = "Sunny", equipped = {}, bond = 0, adoptedAt = 0 }
		return p
	end

	t.test("content validates with all known actions", function()
		local known = {
			grant_currency = true, spend_currency = true, grant_item = true, equip_item = true,
			complete_quest = true, unlock_activity = true, simulate_block = true, simulate_report = true,
			open_help = true, end_conversation = true, record_learning = true, set_arc_flag = true,
			show_waypoint = true, pet_react = true,
		}
		local problems = EncounterEngine.validate(Content, function(name)
			return known[name] == true
		end)
		if #problems > 0 then
			error(table.concat(problems, "; "))
		end
	end)

	t.test("Jordan does not appear before fetch", function()
		local p = freshProfile()
		local enc = EncounterEngine.select(Content, p, "jordan", "dog_park")
		expect(enc).toBe(nil)
	end)

	t.test("Jordan arc progresses per player through three stages", function()
		local p = freshProfile()
		p.activities.fetch = { count = 1 }
		local enc, arcId = EncounterEngine.select(Content, p, "jordan", "dog_park")
		expect(enc.id).toBe("jordan_e1_park")
		expect(EncounterEngine.complete(Content, p, enc, arcId, "friendly")).toBe(true)

		-- Encounter 2 needs the agility course and Jordan's agility spot.
		expect(EncounterEngine.select(Content, p, "jordan", "agility")).toBe(nil)
		p.activities.agility = { count = 1 }
		expect(EncounterEngine.select(Content, p, "jordan", "dog_park")).toBe(nil)
		enc, arcId = EncounterEngine.select(Content, p, "jordan", "agility")
		expect(enc.id).toBe("jordan_e2_agility")
		EncounterEngine.complete(Content, p, enc, arcId, "friendly")

		-- Encounter 3 needs one more activity after encounter 2.
		expect(EncounterEngine.select(Content, p, "jordan", "agility")).toBe(nil)
		EncounterEngine.noteActivity(p)
		enc, arcId = EncounterEngine.select(Content, p, "jordan", "agility")
		expect(enc.id).toBe("jordan_e3_boundary")
		EncounterEngine.complete(Content, p, enc, arcId, "declined")
		expect(p.arcs.jordan_arc.done).toBe(true)
		expect(p.arcs.jordan_arc.decisions.jordan_e3_boundary).toBe("declined")
		expect(EncounterEngine.select(Content, p, "jordan", "agility")).toBe(nil)
	end)

	t.test("two players get different Jordan encounters", function()
		local a, b = freshProfile(), freshProfile()
		a.activities.fetch = { count = 1 }
		b.activities.fetch = { count = 1 }
		local enc, arcId = EncounterEngine.select(Content, a, "jordan", "dog_park")
		EncounterEngine.complete(Content, a, enc, arcId, "friendly")
		a.activities.agility = { count = 1 }
		b.activities.agility = { count = 1 }
		expect(EncounterEngine.select(Content, a, "jordan", "agility").id).toBe("jordan_e2_agility")
		expect(EncounterEngine.select(Content, b, "jordan", "agility")).toBe(nil)
		expect(EncounterEngine.select(Content, b, "jordan", "dog_park").id).toBe("jordan_e1_park")
	end)

	t.test("completing twice is idempotent", function()
		local p = freshProfile()
		p.activities.fetch = { count = 1 }
		local enc, arcId = EncounterEngine.select(Content, p, "jordan", "dog_park")
		expect(EncounterEngine.complete(Content, p, enc, arcId, "friendly")).toBe(true)
		expect(EncounterEngine.complete(Content, p, enc, arcId, "friendly")).toBe(false)
		expect(p.arcs.jordan_arc.stage).toBe("again")
	end)

	t.test("blocked NPC offers nothing", function()
		local p = freshProfile()
		p.activities.fetch = { count = 1 }
		p.npcs.jordan = { blocked = true }
		local enc, _, reason = EncounterEngine.select(Content, p, "jordan", "dog_park")
		expect(enc).toBe(nil)
		expect(reason).toBe("blocked")
	end)

	t.test("choices are validated against the current node", function()
		local enc = Content.encounters.jordan_e3_boundary
		local ctx = { profile = freshProfile() }
		local ok = EncounterEngine.choose(enc, "ask", "decline", ctx)
		expect(ok.nextNodeId).toBe("pushback")
		local bad = EncounterEngine.choose(enc, "ask", "got_it", ctx)
		expect(bad).toBe(nil)
		local ending = EncounterEngine.choose(enc, "tip_decline", "got_it", ctx)
		expect(ending.ended).toBe(true)
		expect(ending.outcome).toBe("declined")
	end)

	t.test("agreeing first always leads to a chance to reconsider", function()
		local enc = Content.encounters.jordan_e3_boundary
		local ctx = { profile = freshProfile() }
		expect(EncounterEngine.choose(enc, "ask", "agree", ctx).nextNodeId).toBe("reconsider")
		expect(EncounterEngine.choose(enc, "ask", "unsure", ctx).nextNodeId).toBe("reconsider")
	end)

	t.test("every Jordan e3 path ends on a supportive tip, never on Jordan", function()
		local enc = Content.encounters.jordan_e3_boundary
		for nodeId, node in enc.nodes do
			for _, choice in node.choices do
				if choice.next == nil then
					expect(node.speaker).toBe("tip")
				end
			end
		end
	end)

	t.test("arc content version change keeps completed encounters", function()
		local p = freshProfile()
		p.arcs.jordan_arc = {
			contentVersion = 0,
			stage = "removed_stage",
			completed = { jordan_e1_park = true },
			decisions = {},
			flags = {},
			activitiesSinceStage = 0,
			done = false,
		}
		EncounterEngine.ensureArc(p, Content.arcs.jordan_arc)
		expect(p.arcs.jordan_arc.stage).toBe("again")
		expect(p.arcs.jordan_arc.contentVersion).toBe(Content.arcs.jordan_arc.version)
	end)

	t.test("help is available with a brand new profile", function()
		local p = ProfileSchema.default(0)
		local enc = EncounterEngine.select(Content, p, "ranger_lee", "ranger_station")
		expect(enc.id).toBe("help_lee")
	end)

	t.test("format fills pet name", function()
		expect(EncounterEngine.format("Hi, {petName}!", { petName = "Sunny" })).toBe("Hi, Sunny!")
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Frisbee.spec</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FrisbeeMath = require(ReplicatedStorage.Shared.FrisbeeMath)

return function(t)
	local expect = t.expect
	local EAST = Vector3.new(1, 0, 0)
	local HAND = Vector3.new(0, 3, 0) -- about hand height over ground at Y = 0

	local function fly(power: number, pitch: number)
		local launch = FrisbeeMath.launch(HAND, EAST, FrisbeeMath.elevationFromPitch(pitch), power)
		local points = FrisbeeMath.predict(launch, 0, 10)
		local maxHeight = 0
		for _, p in points do
			maxHeight = math.max(maxHeight, p.height)
		end
		return points[#points], maxHeight, launch, points
	end

	t.test("frisbee: launch speed follows power and clamps bad input", function()
		local soft = FrisbeeMath.launch(HAND, EAST, 10, 0)
		local hard = FrisbeeMath.launch(HAND, EAST, 10, 1)
		local junk = FrisbeeMath.launch(HAND, EAST, 0 / 0, 99)
		expect(math.abs(soft.velocity.Magnitude - FrisbeeMath.MIN_SPEED) < 1e-3).toBe(true)
		expect(math.abs(hard.velocity.Magnitude - FrisbeeMath.MAX_SPEED) < 1e-3).toBe(true)
		expect(math.abs(junk.velocity.Magnitude - FrisbeeMath.MAX_SPEED) < 1e-3).toBe(true)
		expect(math.abs(junk.normal.Magnitude - 1) < 1e-4).toBe(true)
	end)

	t.test("frisbee: aim pitch maps to a clamped launch angle", function()
		expect(FrisbeeMath.elevationFromPitch(-90)).toBe(FrisbeeMath.MIN_ELEVATION)
		expect(FrisbeeMath.elevationFromPitch(90)).toBe(FrisbeeMath.MAX_ELEVATION)
		expect(FrisbeeMath.elevationFromPitch("up") > 0).toBe(true)
		expect(FrisbeeMath.elevationFromPitch(10) > FrisbeeMath.elevationFromPitch(-10)).toBe(true)
	end)

	t.test("frisbee: distances fit the field (soft ~20, hard ~60 studs)", function()
		local soft = fly(0, -10)
		local hard = fly(1, -10)
		expect(soft.position.X > 12 and soft.position.X < 32).toBe(true)
		expect(hard.position.X > 45 and hard.position.X < 78).toBe(true)
		expect(hard.t > soft.t).toBe(true)
	end)

	t.test("frisbee: it glides (stays up longer than a thrown ball would)", function()
		local landing, _, launch = fly(0.5, -10)
		-- Same launch with gravity only: time to fall back to the ground.
		local v = launch.velocity
		local g = 9.81
		local y0 = HAND.Y / FrisbeeMath.STUDS_PER_METER
		local ballistic = (v.Y + math.sqrt(v.Y * v.Y + 2 * g * y0)) / g
		expect(landing.t > ballistic * 1.3).toBe(true)
	end)

	t.test("frisbee: aiming higher throws higher", function()
		local _, flat = fly(0.5, -20)
		local _, lofted = fly(0.5, 15)
		expect(lofted > flat + 2).toBe(true)
	end)

	t.test("frisbee: spinning disc curves sideways (turn and fade)", function()
		local soft = fly(0, 0)
		local hard = fly(1, -10)
		-- Right-hand backhand: slow throws fade left (-Z here), fast ones turn right (+Z).
		expect(soft.position.Z < -1).toBe(true)
		expect(hard.position.Z > 3).toBe(true)
	end)

	t.test("frisbee: replay is deterministic and lands on the ground", function()
		local landing, _, launch = fly(0.7, 0)
		expect(landing.height).toBe(0)
		local a, b = FrisbeeMath.start(launch), FrisbeeMath.start(launch)
		FrisbeeMath.advanceTo(a, 1.5)
		for i = 1, 10 do
			FrisbeeMath.advanceTo(b, 0.15 * i) -- in small hops, like a client frame by frame
		end
		expect(a.t).toBe(b.t)
		expect((a.offset - b.offset).Magnitude < 1e-6).toBe(true)
	end)

	t.test("frisbee: dog runs to a reachable catch point, or the landing spot", function()
		local landing, _, _, points = fly(0.5, -10)
		local near, okNear = FrisbeeMath.pickIntercept(points, landing.position, 30, 0.35, 3.4, 6)
		expect(okNear).toBe(true)
		expect(near ~= nil and near.height <= 3.4).toBe(true)
		local far, okFar = FrisbeeMath.pickIntercept(points, Vector3.new(-200, 0, 0), 30, 0.35, 3.4, 6)
		expect(okFar).toBe(false)
		expect(far).toBe(landing)
		local none, okNone = FrisbeeMath.pickIntercept({}, Vector3.zero, 30, 0.35, 3.4, 6)
		expect(none).toBe(nil)
		expect(okNone).toBe(false)
	end)

	t.test("frisbee: flat direction falls back to facing", function()
		local d = FrisbeeMath.flatDirection(Vector3.zero, "nope", Vector3.new(0, 0, -2))
		expect((d - Vector3.new(0, 0, -1)).Magnitude < 1e-6).toBe(true)
		local d2 = FrisbeeMath.flatDirection(Vector3.zero, Vector3.new(10, 50, 0), Vector3.new(0, 0, -1))
		expect((d2 - EAST).Magnitude < 1e-6).toBe(true)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">Logic.spec</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local Conditions = require(Server.Logic.Conditions)
local Purchase = require(Server.Logic.Purchase)
local ProfileSchema = require(Server.Data.ProfileSchema)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local PetCatalog = require(ReplicatedStorage.Shared.Catalogs.PetCatalog)
local QuestCatalog = require(ReplicatedStorage.Shared.Catalogs.QuestCatalog)

return function(t)
	local expect = t.expect

	local function withPet(coins)
		local p = ProfileSchema.default(0)
		p.activePetId = "pet1"
		p.pets.pet1 = { id = "pet1", breedId = "golden", name = "A", displayName = "A", equipped = {}, bond = 0, adoptedAt = 0 }
		p.wallet.paw_coins = coins
		return p
	end

	-- ProfileSchema
	t.test("migrate(nil) gives a default profile", function()
		local p, readOnly = ProfileSchema.migrate(nil, 5)
		expect(p.schemaVersion).toBe(ProfileSchema.CURRENT_VERSION)
		expect(p.wallet.paw_coins).toBe(0)
		expect(readOnly).toBe(false)
	end)

	t.test("migrate fills new keys without losing old ones", function()
		local p = ProfileSchema.migrate({ schemaVersion = 1, wallet = { paw_coins = 42 } }, 0)
		expect(p.wallet.paw_coins).toBe(42)
		expect(typeof(p.learning.toolsPracticed)).toBe("table")
		expect(typeof(p.arcs)).toBe("table")
	end)

	t.test("future schema versions are read-only", function()
		local _, readOnly = ProfileSchema.migrate({ schemaVersion = 999 }, 0)
		expect(readOnly).toBe(true)
	end)

	-- Purchase
	t.test("can buy an affordable cosmetic once", function()
		local p = withPet(100)
		local plan = Purchase.plan(p, ItemCatalog.get("collar_cherry"), ItemCatalog.Items, 99)
		expect(plan.price).toBe(15)
		p.inventory.collar_cherry = 1
		local again, reason = Purchase.plan(p, ItemCatalog.get("collar_cherry"), ItemCatalog.Items, 99)
		expect(again).toBe(nil)
		expect(reason).toBe("You already own this.")
	end)

	t.test("can't buy without enough coins", function()
		local plan, reason = Purchase.plan(withPet(3), ItemCatalog.get("hat_party"), ItemCatalog.Items, 99)
		expect(plan).toBe(nil)
		expect(reason:find("more Paw Coins") ~= nil).toBe(true)
	end)

	t.test("pet items need a pet", function()
		local p = ProfileSchema.default(0)
		p.wallet.paw_coins = 100
		local plan = Purchase.plan(p, ItemCatalog.get("collar_sky"), ItemCatalog.Items, 99)
		expect(plan).toBe(nil)
	end)

	t.test("bundles grant only what's missing", function()
		local p = withPet(100)
		p.inventory.hat_sun_player = 1
		local plan = Purchase.plan(p, ItemCatalog.get("bundle_sun_caps"), ItemCatalog.Items, 99)
		expect(#plan.grants).toBe(1)
		expect(plan.grants[1]).toBe("hat_sun_pet")
		p.inventory.hat_sun_pet = 1
		expect(Purchase.plan(p, ItemCatalog.get("bundle_sun_caps"), ItemCatalog.Items, 99)).toBe(nil)
	end)

	t.test("services are applied, not stored", function()
		local plan = Purchase.plan(withPet(100), ItemCatalog.get("groom_bubble_bath"), ItemCatalog.Items, 99)
		expect(plan.service).toBe(true)
		expect(#plan.grants).toBe(0)
	end)

	t.test("unknown items are rejected", function()
		expect(Purchase.plan(withPet(100), ItemCatalog.get("free_robux"), ItemCatalog.Items, 99)).toBe(nil)
	end)

	-- Catalog integrity
	t.test("every item is well-formed", function()
		for id, item in ItemCatalog.Items do
			expect(item.id).toBe(id)
			expect(item.price >= 0).toBe(true)
			if item.kind == "cosmetic" then
				expect(item.slot ~= nil).toBe(true)
				if item.target == "pet" then
					expect(PetCatalog.Slots[item.slot] ~= nil).toBe(true)
				end
			end
			for _, inner in item.contents or {} do
				expect(ItemCatalog.get(inner) ~= nil).toBe(true)
			end
		end
	end)

	t.test("quest ids are unique", function()
		local seen = {}
		for _, q in QuestCatalog.Ordered do
			expect(seen[q.id]).toBe(nil)
			seen[q.id] = true
		end
	end)

	-- Conditions
	t.test("conditions: all / any / not", function()
		local ctx = { profile = withPet(0), locationId = "dog_park" }
		expect(Conditions.evaluate({ { type = "hasPet" }, { type = "atLocation", locationId = "dog_park" } }, ctx)).toBe(true)
		expect(Conditions.evaluate({ { type = "any", conditions = { { type = "atLocation", locationId = "x" }, { type = "hasPet" } } } }, ctx)).toBe(true)
		expect(Conditions.evaluate({ { type = "not", condition = { type = "hasPet" } } }, ctx)).toBe(false)
		expect(Conditions.evaluate(nil, ctx)).toBe(true)
	end)

	-- Pet names
	t.test("pet name cleaning", function()
		expect(PetCatalog.cleanName("  Sunny   Boy ")).toBe("Sunny Boy")
		expect(PetCatalog.cleanName("")).toBe(nil)
		expect(PetCatalog.cleanName("abcdefghijklmnopq")).toBe(nil)
		expect(PetCatalog.cleanName("hi@there")).toBe(nil)
		expect(PetCatalog.cleanName(42)).toBe(nil)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">PetSystems.spec</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Server = ServerScriptService:WaitForChild("Server")
local StateMachine = require(Server.Logic.PetStateMachine)
local FetchMath = require(Server.Logic.FetchMath)
local Purchase = require(Server.Logic.Purchase)
local ProfileSchema = require(Server.Data.ProfileSchema)
local Activities = require(Server.Content.Activities)
local BondCatalog = require(ReplicatedStorage.Shared.Catalogs.BondCatalog)
local ItemCatalog = require(ReplicatedStorage.Shared.Catalogs.ItemCatalog)
local PetActions = require(ReplicatedStorage.Shared.Catalogs.PetActions)
local QuestCatalog = require(ReplicatedStorage.Shared.Catalogs.QuestCatalog)
local Places = require(ReplicatedStorage.Shared.Places)

return function(t)
	local expect = t.expect

	-- Behavior state machine
	t.test("base commands always interrupt", function()
		for state in StateMachine.Kind do
			expect(StateMachine.canEnter(state, "Following")).toBe(true)
			expect(StateMachine.canEnter(state, "Sitting")).toBe(true)
		end
	end)

	t.test("players can't start reactions mid-fetch", function()
		expect(StateMachine.canEnter("Fetching", "BeingPetted")).toBe(false)
		expect(StateMachine.canEnter("Returning", "Eating")).toBe(false)
		expect(StateMachine.canEnter("Fetching", "Returning", true)).toBe(true)
	end)

	t.test("one reaction at a time, but attention can be replaced", function()
		expect(StateMachine.canEnter("Eating", "BeingPetted")).toBe(false)
		expect(StateMachine.canEnter("Idle", "BeingPetted")).toBe(true)
		expect(StateMachine.canEnter("Sitting", "PerformingTrick")).toBe(true)
	end)

	t.test("only activities can enter activity states", function()
		expect(StateMachine.canEnter("Following", "Fetching")).toBe(false)
		expect(StateMachine.canEnter("Following", "Fetching", true)).toBe(true)
	end)

	t.test("every state has a movement mode and settles to a base", function()
		for state in StateMachine.Kind do
			expect(StateMachine.Movement[state] ~= nil).toBe(true)
		end
		expect(StateMachine.settle("Staying")).toBe("Staying")
		expect(StateMachine.settle("Eating")).toBe("Following")
	end)

	-- Bond
	t.test("bond levels from XP", function()
		local level, into, need = BondCatalog.levelFor(0)
		expect(level).toBe(1)
		expect(into).toBe(0)
		expect(need).toBe(40)
		expect((BondCatalog.levelFor(40))).toBe(2)
		expect((BondCatalog.levelFor(99))).toBe(2)
		local max, _, none = BondCatalog.levelFor(999999)
		expect(max).toBe(BondCatalog.MaxLevel)
		expect(none).toBe(nil)
	end)

	t.test("level thresholds increase", function()
		for i = 2, #BondCatalog.LevelXp do
			expect(BondCatalog.LevelXp[i] > BondCatalog.LevelXp[i - 1]).toBe(true)
		end
	end)

	t.test("daily caps: full, then half, then zero", function()
		expect(BondCatalog.xpAfterCap(10, 0, 10)).toBe(10)
		expect(BondCatalog.xpAfterCap(10, 5, 10)).toBe(5)
		expect(BondCatalog.xpAfterCap(5, 6, 10)).toBe(3)
		expect(BondCatalog.xpAfterCap(10, 10, 10)).toBe(0)
	end)

	t.test("unlock gates", function()
		expect(BondCatalog.isUnlocked(1, "command", "stay")).toBe(false)
		expect(BondCatalog.isUnlocked(2, "command", "stay")).toBe(true)
		expect(BondCatalog.isUnlocked(4, "trick", "high_five")).toBe(false)
		expect(BondCatalog.isUnlocked(5, "trick", "high_five")).toBe(true)
		expect(BondCatalog.nextUnlock(2).id).toBe("spin")
	end)

	t.test("every unlock points at something real", function()
		for _, u in BondCatalog.Unlocks do
			if u.kind == "trick" then
				expect(PetActions.Tricks[u.id] ~= nil).toBe(true)
			elseif u.kind == "item" or u.kind == "gift" then
				expect(ItemCatalog.get(u.id) ~= nil).toBe(true)
			end
		end
		for _, id in PetActions.TrickOrder do
			expect(BondCatalog.requiredLevel("trick", id) ~= nil).toBe(true)
		end
		for _, a in PetActions.Actions do
			if a.unlock then
				expect(BondCatalog.requiredLevel(a.unlock.kind, a.unlock.id) ~= nil).toBe(true)
			end
		end
	end)

	t.test("activity rewards use real bond sources and places", function()
		for id, def in Activities do
			expect(def.id).toBe(id)
			if def.rewards.bond then
				expect(BondCatalog.Sources[def.rewards.bond] ~= nil).toBe(true)
			end
			if def.location then
				expect(Places.get(def.location) ~= nil).toBe(true)
			end
		end
	end)

	-- Saved data compatibility
	t.test("v1 profiles migrate to v2 without losing bond", function()
		local v1 = {
			schemaVersion = 1,
			wallet = { paw_coins = 70 },
			activePetId = "p",
			pets = { p = { id = "p", breedId = "husky", name = "Blizzard", displayName = "Blizzard", equipped = { collar = "collar_cherry" }, bond = 7, adoptedAt = 1 } },
			inventory = { collar_cherry = 1 },
		}
		local p = ProfileSchema.migrate(v1, 0)
		expect(p.schemaVersion).toBe(2)
		expect(p.wallet.paw_coins).toBe(70)
		expect(p.pets.p.bondXp).toBe(35)
		expect(p.pets.p.bond).toBe(nil)
		expect(p.pets.p.equipped.collar).toBe("collar_cherry")
		expect(typeof(p.pets.p.xpLog.counts)).toBe("table")
	end)

	t.test("new pets start with bond fields", function()
		local pet = ProfileSchema.newPet("x", "golden", "Sunny", 5)
		expect(pet.bondXp).toBe(0)
		expect(pet.xpLog.day).toBe(0)
	end)

	-- Shop
	t.test("bond reward items can't be bought", function()
		local p = ProfileSchema.default(0)
		p.activePetId = "x"
		p.wallet.paw_coins = 9999
		local plan = Purchase.plan(p, ItemCatalog.get("collar_best_friend"), ItemCatalog.Items, 99)
		expect(plan).toBe(nil)
	end)

	t.test("every shop item is sold at a real place", function()
		for _, item in ItemCatalog.Items do
			expect(Places.get(ItemCatalog.shopOf(item)) ~= nil).toBe(true)
		end
	end)

	-- Fetch
	t.test("rolling resistance torque gives the requested slowdown", function()
		-- Solid sphere rolling without slipping: tau = (I/r + m*r) * a = 1.4*m*r*a
		local tau = FetchMath.rollingTorque(2, 0.5, 10)
		expect(math.abs(tau - 14) < 1e-9).toBe(true)
		-- The ball stops within a sensible distance from a fast roll (v^2 / 2a).
		expect(FetchMath.rollDistance(30, FetchMath.ROLL_DECEL) < 20).toBe(true)
		expect(FetchMath.rollDistance(30, FetchMath.ROLL_DECEL) > 5).toBe(true)
		expect(FetchMath.rollingTorque(-1, 0.5, 10)).toBe(0)
	end)

	t.test("throws are clamped to a safe distance", function()
		local origin = Vector3.new(0, 3, 0)
		local far = FetchMath.clampThrow(origin, Vector3.new(500, 0, 0), Vector3.new(0, 0, -1), 8, 42)
		expect(math.floor(far.X + 0.5)).toBe(42)
		local near = FetchMath.clampThrow(origin, Vector3.new(1, 0, 0), Vector3.new(0, 0, -1), 8, 42)
		expect(math.floor(near.X + 0.5)).toBe(8)
	end)

	t.test("bad aim falls back to facing direction", function()
		local origin = Vector3.new(0, 3, 0)
		local p = FetchMath.clampThrow(origin, "hello", Vector3.new(0, 0, -1), 8, 42)
		expect(p.Z < 0).toBe(true)
		local nan = FetchMath.clampThrow(origin, Vector3.new(0 / 0, 0, 0), Vector3.new(1, 0, 0), 8, 42)
		expect(nan.X > 0).toBe(true)
		expect(FetchMath.inBounds(Vector3.new(300, 0, 0), 250)).toBe(false)
	end)

	-- Quests
	t.test("quest events match real event payloads", function()
		local known = {
			["pet.adopted"] = true,
			["pet.interacted"] = true,
			["pet.levelUp"] = true,
			["activity.completed"] = true,
			["item.purchased"] = true,
			["item.equipped"] = true,
		}
		for _, q in QuestCatalog.Ordered do
			expect(known[q.completeOn.event]).toBe(true)
			if q.waypoint then
				expect(Places.get(q.waypoint) ~= nil).toBe(true)
			end
			local m = q.completeOn.match
			if m and m.activityId then
				expect(Activities[m.activityId] ~= nil).toBe(true)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">WorldBounds.spec</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WorldBounds = require(ReplicatedStorage.Shared.WorldBounds)

return function(t)
	local expect = t.expect
	local L = WorldBounds.LANDING

	t.test("inside the map does not wrap", function()
		expect(WorldBounds.wrap(Vector3.new(0, 3, 0))).toBe(nil)
		expect(WorldBounds.wrap(Vector3.new(250, 3, -250))).toBe(nil)
	end)

	t.test("east edge wraps to west, keeping Y and Z", function()
		expect(WorldBounds.wrap(Vector3.new(255, 4, 12))).toBe(Vector3.new(-L, 4, 12))
	end)

	t.test("west edge wraps to east", function()
		expect(WorldBounds.wrap(Vector3.new(-255, 4, 12))).toBe(Vector3.new(L, 4, 12))
	end)

	t.test("Z edges wrap", function()
		expect(WorldBounds.wrap(Vector3.new(7, 3, 255))).toBe(Vector3.new(7, 3, -L))
		expect(WorldBounds.wrap(Vector3.new(7, 3, -255))).toBe(Vector3.new(7, 3, L))
	end)

	t.test("corner wraps both axes", function()
		expect(WorldBounds.wrap(Vector3.new(255, 3, 255))).toBe(Vector3.new(-L, 3, -L))
	end)

	t.test("landing spot is not a trigger (no ping-pong)", function()
		local landed = WorldBounds.wrap(Vector3.new(255, 3, -255)) :: Vector3
		expect(WorldBounds.wrap(landed)).toBe(nil)
	end)

	t.test("rescue puts a fallen character back on the floor", function()
		expect(WorldBounds.rescue(Vector3.new(10, -60, 20))).toBe(Vector3.new(10, 5, 20))
		expect(WorldBounds.rescue(Vector3.new(300, -60, 0))).toBe(Vector3.new(-L, 5, 0))
	end)
end
]]></string>
        </Properties>
