		subtitle = "Treat Baker",
		role = "shopkeeper",
		interaction = "shop",
		shop = "treat_shop",
		promptText = "Shop",
		appearance = { skin = rgb(160, 110, 75), shirt = rgb(255, 255, 255), pants = rgb(90, 70, 60), hair = rgb(30, 25, 20), hat = rgb(255, 255, 255) },
		placements = {
